# Application Service registration for Ruqqus's Chat backend. Lets Ruqqus
# (via the as_token below) register/log in as, and masquerade as, any user
# in the @ruqqus_* namespace with no password - see
# ruqqus/helpers/matrix_client.py. The hs_token is what Synapse uses to
# authenticate its event-push webhook calls back to Ruqqus
# (PUT /matrix/appservice/_matrix/app/v1/transactions/<txn_id> in
# ruqqus/routes/chat.py) - both tokens must match the MATRIX_AS_TOKEN /
# MATRIX_HS_TOKEN values set on the ruqqus service in docker-compose.yml.
#
# THIS IS A TEMPLATE. Do not put real tokens here (they would land in git).
# `python scripts/gen_dev_env.py` writes untracked .env and renders the real
# synapse/ruqqus-appservice.yaml from this file.

id: ruqqus_chat
url: "http://ruqqus/matrix/appservice"
as_token: "__MATRIX_AS_TOKEN__"
hs_token: "__MATRIX_HS_TOKEN__"
sender_localpart: ruqqus_bot
rate_limited: false

namespaces:
  users:
    - exclusive: true
      regex: "@ruqqus_.*"
  aliases: []
  rooms: []
