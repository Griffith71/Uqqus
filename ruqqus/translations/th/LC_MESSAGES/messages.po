#, machine, plain1, python-format
msgid "A Space can have at most %(num)s update a day."
msgid_plural "A Space can have at most %(num)s updates a day."
msgstr[0] "พื้นที่สามารถมีได้มากที่สุด %(num)s อัพเดทวัน"

#, machine, plain1
msgid "A Space can't be anonymous."
msgstr "พื้นที่ไม่ใช่นิรนาม."

#, machine, plain1
msgid "A Space can't be hosted in a Circle guild."
msgstr "พื้นที่ไม่สามารถถูกบรรจุใน วงกลมสโมสร."

#, machine, plain2
msgid "A Space can't have its name removed."
msgstr "พื้นที่ไม่สามารถลบชื่อได้."

#, machine, plain1
msgid "A Space can't start in the past."
msgstr "พื้นที่เริ่มต้นในอดีตไม่ได้."

#, machine, plain1
msgid "A Space for it <span class=\"text-muted font-weight-normal\">(optional: the Space's post link)</span>"
msgstr "ช่องว่างของมัน <span class=\"text-muted font-weight-normal\">(ตัวเลือก: ลิงก์ของอวกาศ)</span>"

#, machine, plain2
msgid "A Space is ended from its own page; it isn't deleted like a post."
msgstr "พื้นที่สิ้นสุดจากหน้าของตัวเอง มันไม่ได้ถูกลบเหมือนโพสต์."

#, machine, plain1
msgid "A Space is live for a while: a board, a live thread or a call. It is kept for replay, or it is gone when it ends."
msgstr "พื้นที่มีสิ่งมีชีวิตอยู่ระยะหนึ่ง: คณะกรรมการ, เส้นด้ายสดหรือการโทร มันเก็บไว้เล่นซ้ํา หรือจะหายไปเมื่อมันสิ้นสุด."

#, python-format
msgid "A Space you asked to be reminded of is live: [join it](/space/%(space)s)"
msgstr ""

#, python-format
msgid "A Space you follow is live: [join it](/space/%(space)s)"
msgstr ""

#, machine, plain1, python-format
msgid "A Subscriber badge next to your name on @%(name)s's profile and posts, shown to whoever your <a href=\"/settings/profile#lists\">\"Circles you subscribe to\"</a> setting allows"
msgstr "ตราผู้ประกาศข่าว ถัดจากชื่อของคุณ%(name)sประวัติและโพสต์ แสดงให้ใครก็ตาม <a href=\"/settings/profile#lists\">\"วงเวียนที่คุณสมัคร\"</a> อนุญาตให้ตั้งค่า"

#, machine, plain1
msgid "A Translate button shows under posts and comments in none of your languages. Nothing is translated unless you press it."
msgstr "ปุ่มแปล แสดงภายใต้โพสต์และคอมเม้นท์ในภาษาของคุณ ไม่มีอะไรแปลได้ นอกจากคุณกดมัน."

#, machine, plain2, python-format
msgid "A ban can cite up to %(max)s items."
msgstr "คํา สั่ง ห้าม อาจ อ้าง ถึง %(max)s ของ"

#, machine, plain1, python-format
msgid "A bio can be %(count)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A bio can be %(count)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "ชีวสามารถ %(count)s ตัวอักษร (Chinese, อักขระญี่ปุ่นและเกาหลี และอักษรเอมิจินับเป็น 2)"

#, machine, plain1, python-format
msgid "A bot can forward to at most %(num)s guild."
msgid_plural "A bot can forward to at most %(num)s guilds."
msgstr[0] "หุ่นสามารถไปข้างหน้าได้มากที่สุด %(num)s สโมสร."

#, machine, plain1, python-format
msgid "A bot can have at most %(num)s key. Revoke it first."
msgid_plural "A bot can have at most %(num)s keys. Revoke one first."
msgstr[0] "หุ่นสามารถมีได้มากที่สุด %(num)s กุญแจ เอาคืนก่อน"

#, machine, plain1, python-format
msgid "A bot can post at most %(num)s time a day."
msgid_plural "A bot can post at most %(num)s times a day."
msgstr[0] "หุ่นสามารถโพสต์ได้มากที่สุด %(num)s วันละครั้ง"

#, machine, plain1, python-format
msgid "A bot can read at most %(num)s feed."
msgid_plural "A bot can read at most %(num)s feeds."
msgstr[0] "หุ่นสามารถอ่านได้มากที่สุด %(num)s อาหาร"

#, machine, plain1
msgid "A bot can't post anonymously."
msgstr "หุ่นไม่สามารถโพสต์โดยไม่ระบุชื่อได้."

#, machine, plain1
msgid "A bot can't read this site itself."
msgstr "หุ่นไม่สามารถอ่านเว็บไซต์นี้ได้เอง."

#, machine, plain1
msgid "A bot can't run bots."
msgstr "หุ่นไม่สามารถคุมหุ่นได้."

#, machine, plain1
msgid "A bot gets keys once an admin has approved it."
msgstr "หุ่นได้รับกุญแจ เมื่อโฆษณาอนุมัติแล้ว."

#, machine, plain1
msgid "A bot is an account that posts by itself, approved by the site's admins."
msgstr "หุ่นเป็นบัญชีที่โพสต์เอง อนุมัติจากโฆษณาของเว็บไซต์."

#, machine, plain1
msgid "A bot's name is 3 to 25 letters, numbers or underscores."
msgstr "ชื่อของหุ่นคืออักษร 3 ถึง 25 ตัว ตัวเลข หรือเครื่องหมายเน้น."

#, machine, plain1
msgid "A bot's posts are public."
msgstr "โพสต์ของหุ่นเป็นสาธารณะ."

#, machine, plain1
msgid "A bot's posts can't have co-authors."
msgstr "โพสต์ของหุ่นไม่มีผู้เขียนร่วม."

#. %(listeners)s is the largest number of people listening
#, machine, plain1, python-format
msgid "A call has up to %(num)s person on stage and %(listeners)s listening, for at most 4 hours."
msgid_plural "A call has up to %(num)s people on stage and %(listeners)s listening, for at most 4 hours."
msgstr[0] "มีโทรศัพท์ถึง %(num)s คนบนเวที %(listeners)s ฟังนะ อย่างน้อย 4 ชั่วโมง"

#, machine, plain1
msgid "A cancelled event can't be changed."
msgstr "เหตุการณ์ที่ถูกยกเลิกไม่สามารถเปลี่ยนแปลงได้."

#, machine, plain1
msgid "A category"
msgstr "ประเภท"

#, machine, plain1, python-format
msgid "A category name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A category name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "ชื่อหมวดหมู่ %(num)s ตัวอักษร (Chinese, อักขระญี่ปุ่นและเกาหลี และอักษรเอมิจินับเป็น 2)"

#, machine, plain1, python-format
msgid "A category name can be at most %(num)s character."
msgid_plural "A category name can be at most %(num)s characters."
msgstr[0] "ชื่อหมวดหมู่สามารถใช้ได้มากที่สุด %(num)s ตัวละคร"

#, machine, plain1
msgid "A category name can't contain < or >."
msgstr "ชื่อหมวดหมู่ไม่สามารถบรรจุ < หรือ > ได้."

#, machine, plain1
msgid "A category name can't contain @: it would read as a handle."
msgstr "ชื่อหมวดหมู่ไม่สามารถบรรจุได้@: it will read as a hand."

#, machine, plain1
msgid "A category name can't contain control or invisible characters."
msgstr "ชื่อหมวดหมู่ไม่สามารถมีอักขระที่ควบคุมหรือมองไม่เห็นได้."

#, machine, plain1
msgid "A channel"
msgstr "ช่อง"

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s bot feeding it."
msgid_plural "A channel can have at most %(num)s bots feeding it."
msgstr[0] "ช่องทางสามารถมีได้มากที่สุด %(num)s หุ่นยนต์ให้อาหารมัน"

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s helper."
msgid_plural "A channel can have at most %(num)s helpers."
msgstr[0] "ช่องทางสามารถมีได้มากที่สุด %(num)s ผู้ช่วย"

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s message a day."
msgid_plural "A channel can have at most %(num)s messages a day."
msgstr[0] "ช่องทางสามารถมีได้มากที่สุด %(num)s ข้อความต่อวัน"

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s pinned message."
msgid_plural "A channel can have at most %(num)s pinned messages."
msgstr[0] "ช่องทางสามารถมีได้มากที่สุด %(num)s ติดข้อความ"

#, machine, plain1
msgid "A channel is one-to-many: its owner and helpers write, members read and react. A public channel is open to everyone and can be moderated; a channel for circles is end-to-end encrypted and only for the people in them."
msgstr "ช่องเป็นหนึ่งต่อหนึ่งหลาย: เจ้าของและผู้ช่วยเขียน สมาชิกอ่านและตอบสนอง ช่องทางสาธารณะเปิดรับทุกคน และสามารถรับบทกลางได้ ช่องสําหรับวงกลมมีการเข้ารหัสที่สิ้นสุด."

#, machine, plain1, python-format
msgid "A channel name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A channel name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "ชื่อทางช่อง %(num)s ตัวอักษร (Chinese, อักขระญี่ปุ่นและเกาหลี และอักษรเอมิจินับเป็น 2)"

#, machine, plain1, python-format
msgid "A channel name can be at most %(num)s character."
msgid_plural "A channel name can be at most %(num)s characters."
msgstr[0] "ชื่อทางช่องสามารถเป็นได้มากที่สุด %(num)s ตัวละคร"

#, machine, plain1
msgid "A channel name can't contain < or >."
msgstr "ชื่อทางช่องไม่สามารถบรรจุ < หรือ > ได้."

#, machine, plain1
msgid "A channel name can't contain @: it would read as a handle."
msgstr "ชื่อของช่องไม่สามารถบรรจุได้@: it will read as a hand."

#, machine, plain1
msgid "A channel name can't contain control or invisible characters."
msgstr "ชื่อทางช่องไม่สามารถมีตัวควบคุมหรือตัวพิมพ์ที่มองไม่เห็นได้."

#, machine, plain1, python-format
msgid "A chat app wants to sign in to your chats as <strong>@%(name)s</strong>."
msgstr "แอพพลิเคชั่นแชทต้องการลงชื่อในการสนทนาของคุณ <strong>@%(name)s</strong>."

#, python-format
msgid "A chat app was signed in to your %(site)s account. If that wasn't you, sign it out in [Settings > Chat apps](/settings/chat_apps) and change your password."
msgstr ""

#, machine, plain2, python-format
msgid "A chat can have at most %(num)s pinned messages. Unpin one first."
msgstr "การ พูด คุย อาจ ทํา ได้ มาก %(num)s ติดข้อความ ปลดชนวนก่อน"

#, machine, plain1, python-format
msgid "A circle can have %(num)s person at most."
msgid_plural "A circle can have %(num)s people at most."
msgstr[0] "วงเวทย์สามารถ %(num)s คนมากที่สุด"

#. %(label)s is the label people see on such a post, "Shared with a circle"
#, machine, plain1, python-format
msgid "A circle of your own. The people in it are not told, and nothing they see names it: your posts for it show as \"%(label)s\"."
msgstr "วงเวทย์เป็นของตัวเอง ไม่ มี ใคร บอก เล่า ให้ ประชาชน ใน เมือง นั้น ฟัง ไม่ เห็น สิ่ง ใด ตั้ง ชื่อ ให้ เหมือน \"%(label)s\"."

#, machine, plain1, python-format
msgid "A circle's name can be %(num)s character at most."
msgid_plural "A circle's name can be %(num)s characters at most."
msgstr[0] "ชื่อวงกลมนี้ %(num)s ตัวละครมากที่สุด"

#, machine, plain2
msgid "A comment"
msgstr "หมายเหตุ"

#, machine, plain2
msgid "A comment by an account you blocked or that blocked you."
msgstr "ความคิดเห็นจากบัญชีที่คุณบล็อก หรือที่บล็อกคุณ."

#, machine, plain2
msgid "A comment hidden by a guildmaster."
msgstr "ความคิดเห็นที่ซ่อนโดยเครื่องจัดอันดับของสมาคม."

#, machine, plain2
msgid "A comment hidden by your word filter."
msgstr "ความคิดเห็นที่ซ่อนโดยตัวกรองคําของคุณ."

#, machine, plain2
msgid "A comment its author deleted. What it said isn't shown here."
msgstr "ความคิดเห็นของผู้เขียนถูกลบ ที่มันบอก มันไม่ได้อยู่ที่นี่."

#, machine, plain1
msgid "A comment on a post for a Circle can't be forwarded to a guild."
msgstr "ความคิดเห็นเกี่ยวกับโพสต์สําหรับวงกลม ไม่สามารถส่งต่อให้กับสมาคม."

#, machine, plain1
msgid "A comment on a post for a Circle can't be reposted."
msgstr "ความคิดเห็นเกี่ยวกับโพสต์สําหรับเซอร์เคิลไม่สามารถเผยแพร่ได้."

#, machine, plain2
msgid "A comment removed by the site's admins."
msgstr "ความคิดเห็นที่ถูกลบออกไปโดยโฆษณาของเว็บไซต์."

#, python-format
msgid "A community note was added to a comment you asked about: [view it](%(link)s)"
msgstr ""

#, python-format
msgid "A community note was added to a post you asked about: [view it](%(link)s)"
msgstr ""

#, machine, plain2
msgid "A copy of this as it was when it was hidden, removed, deleted or relied on for a decision. Only its author, the guildmasters of the guild that decided and the site's administrators can open it here. Most copies are cleared after a while; the copy of something its author deleted stays in the public Log."
msgstr "สําเนานี้ขณะที่มันถูกซ่อน, ลบออก, ลบทิ้ง หรือขึ้นอยู่กับการตัดสินใจ เฉพาะผู้เขียนเท่านั้น ที่เป็นผู้กําหนดรูปแบบของ สมาคมที่ตัดสินใจ และผู้บริหารเว็บไซต์สามารถเปิดมันได้ที่นี่ หลัง จาก ผ่าน ไป สัก ระยะ หนึ่ง สําเนา ของ บาง สิ่ง ที่ ผู้ เขียน ได้ ลบ ออก จะ คง อยู่ ใน ล็อก ล็อก ของ สาธารณชน."

#, machine, plain1
msgid "A curation of the whole site needs an age limit of a month or less."
msgstr "อาหารที่ตัดแล้วของทั้งเว็บไซต์ ต้องจํากัดอายุของเดือนหรือน้อยกว่า."

#, machine, plain1
msgid "A day"
msgstr "วัน"

#, machine, plain2
msgid "A decision in the Log"
msgstr "การตัดสินใจในปูมบันทึก"

#, machine, plain2
msgid "A deleted post and what was said under it"
msgstr "โพสต์ที่ถูกลบทิ้ง และเรื่องที่พูดใต้มัน"

#, machine, plain1, python-format
msgid "A description can be %(num)s character at most."
msgid_plural "A description can be %(num)s characters at most."
msgstr[0] "คําบรรยายสามารถ %(num)s ตัวละครมากที่สุด"

#, machine, plain1, python-format
msgid "A description is at most %(num)s character."
msgid_plural "A description is at most %(num)s characters."
msgstr[0] "รายละเอียดส่วนใหญ่ %(num)s ตัวละคร"

#, machine, plain2
msgid "A different admin has to confirm a reveal."
msgstr "โฆษณาอื่นต้องยืนยันการเปิดเผย."

#, machine, plain1, python-format
msgid "A display name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A display name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "ชื่อที่ใช้แสดง %(num)s ตัวอักษร (Chinese, อักขระญี่ปุ่นและเกาหลี และอักษรเอมิจินับเป็น 2)"

#, machine, plain1
msgid "A display name can't contain < or >."
msgstr "ชื่อการแสดงผลไม่สามารถบรรจุ < หรือ > ได้."

#, machine, plain1
msgid "A display name can't contain @: it would read as a handle."
msgstr "ชื่อที่แสดงไม่สามารถบรรจุได้@: it will read as a hand."

#, machine, plain1
msgid "A display name can't contain control or invisible characters."
msgstr "ชื่อการแสดงผลไม่สามารถมีอักขระที่ควบคุมหรือมองไม่เห็นได้."

#, machine, plain1
msgid "A feed added now waits for an admin before it is read."
msgstr "รายการ ที่ เพิ่ม เข้า มา."

#, machine, plain1
msgid "A feed an admin adds is approved at once."
msgstr "Admin เพิ่มได้รับการอนุมัติในครั้งเดียว."

#, machine, plain1
msgid "A feed server address cannot hold a user name or password."
msgstr "ที่อยู่เซิร์ฟเวอร์แหล่งป้อนไม่สามารถใช้ชื่อหรือรหัสผ่านได้."

msgid "A feed server address must start with https://"
msgstr ""

#, machine, plain1
msgid "A feed server must use the usual https port."
msgstr "เซิร์ฟเวอร์แหล่งป้อนต้องใช้พอร์ตที่ https ปกติ."

#, machine, plain1
msgid "A feed server needs a public server name, like feeds.example.org"
msgstr "เซิร์ฟเวอร์แหล่งป้อนต้องการชื่อเซิร์ฟเวอร์สาธารณะ เช่น feed.example.org"

#, machine, plain1
msgid "A feed's address can't hold a user name or password."
msgstr "ที่อยู่ของแหล่งป้อนไม่สามารถใช้ชื่อหรือรหัสผ่านได้."

#, machine, plain1
msgid "A feed's address must start with https://"
msgstr "ที่อยู่ของแหล่งป้อนจะต้องเริ่มด้วย https/ >"

#, machine, plain1
msgid "A few words (optional)"
msgstr "ตัวเลือกข้อความ"

#, machine, plain1, python-format
msgid "A flair can be at most %(num)s character."
msgid_plural "A flair can be at most %(num)s characters."
msgstr[0] "ฉลากสามารถเป็นได้มากที่สุด %(num)s ตัวละคร"

#, machine, plain1, python-brace-format
msgid "A flair is plain text: no < > { } [ ] ` or \\."
msgstr "ป้ายข้อความธรรมดา: ไม่มี < > {} [] ~ หรือ /."

#, machine, plain1, python-format
msgid "A folder name can be %(num)s character at most."
msgid_plural "A folder name can be %(num)s characters at most."
msgstr[0] "ชื่อโฟลเดอร์ %(num)s ตัวละครมากที่สุด"

#, machine, plain1
msgid "A folder name can't hold control characters."
msgstr "ชื่อของโฟลเดอร์ไม่สามารถควบคุมตัวอักษรได้."

#, machine, plain1, python-format
msgid "A group can have at most %(num)s person."
msgid_plural "A group can have at most %(num)s people."
msgstr[0] "กลุ่มคนที่สามารถมีได้มากที่สุด %(num)s ผู้คน"

#, machine, plain1, python-format
msgid "A group name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
