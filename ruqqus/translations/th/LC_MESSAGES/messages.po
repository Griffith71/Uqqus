#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved. The admins said: %(note)s"
msgstr "หุ่นนั่น%(name)s คุณเสนอไม่ได้อนุมัติ โฆษณากล่าวว่า %(note)s"

#, machine, plain1
msgid "The bot already reads that feed."
msgstr "เจ้าหุ่นอ่านข่าวนั่นแล้ว."

#, python-format
msgid "The bot you proposed, [@%(name)s](/@%(name)s), was approved. It is run by the site from now on and starts posting from its feeds within a few minutes. Thank you!"
msgstr ""

#, machine, plain1
msgid "The bot's account no longer exists."
msgstr "บัญชีของหุ่นไม่มีอีกแล้ว."

#, machine, plain1
msgid "The bot's owner can't run it right now."
msgstr "เจ้าของหุ่นไม่สามารถดําเนินการได้ในขณะนี้."

#, machine, plain1, python-format
msgid "The category %(category)s was deleted; its channels stay."
msgstr "ประเภท %(category)s ถูกลบไปแล้ว ช่องของมันยังคงอยู่"

#, machine, plain1, python-format
msgid "The category %(category)s was made."
msgstr "ประเภท %(category)s ถูกสร้างขึ้น"

#, machine, plain1, python-format
msgid "The category was renamed %(category)s."
msgstr "หมวดหมู่ถูกเปลี่ยนชื่อ %(category)s."

#, machine, plain1, python-format
msgid "The coins go to the founder, <a href=\"%(url)s\">@%(name)s</a>."
msgstr "เหรียญนั้นไปที่ผู้ก่อตั้ง <a href=\"%(url)s\">@%(name)s</a>."

#, machine, plain1
msgid "The coins you earn from tips, paid circles and the creator fund, for the last 30 days and all time."
msgstr "เหรียญที่คุณได้จากทิป จ่ายเป็นวงกลม และกองทุนผู้สร้าง ตลอด 30 วันที่ผ่านมา."

#, machine, plain2
msgid "The comment stays where it is, with your name taken off it. Everyone who saw it with your name still knows it was you."
msgstr "ความคิดเห็นยังคงอยู่ที่มันอยู่ ด้วยชื่อของคุณถอดออก ทุกคนที่เห็นมันชื่อคุณ ยังคงรู้ว่าเป็นคุณ."

#, machine, plain1, python-format
msgid "The copy other people forwarded to guilds will stay there."
msgid_plural "The %(num)s copies other people forwarded to guilds will stay there."
msgstr[0] "เดอะ %(num)s คนอื่น ๆ ที่ส่งให้กับสมาคม จะอยู่ที่นั่น"

#. %(guilds)s is a list of guild names, such as "+a, +b and +c"
#, machine, plain1, python-format
msgid "The copy you forwarded to %(guilds)s will be taken down."
msgid_plural "The copies you forwarded to %(guilds)s will be taken down."
msgstr[0] "สําเนาที่คุณส่งถึง %(guilds)s จะถูกจับ"

#, machine, plain1
msgid "The dates leave no days."
msgstr "วัน ที่ เหลือ ไม่ มี วัน."

#, machine, plain2
msgid "The decision stands"
msgstr "การตัดสินใจยังคงอยู่"

#, machine, plain1
msgid "The decisions made about it, newest first: who, when, where, which rule and why. It never shows the title or the text of what was hidden or removed."
msgstr "การตัดสินใจเกี่ยวกับเรื่องนี้ใหม่ล่าสุด: ใคร, เมื่อที่, ที่, กฎและทําไม ไม่ เคย แสดง ชื่อ หรือ ข้อ ความ ของ สิ่ง ที่ ซ่อน หรือ เอา ออก."

#, machine, plain1
msgid "The draft has changes the post doesn't show yet."
msgstr "ร่างมีการเปลี่ยนแปลงโพสต์ยังไม่ได้แสดง."

#, machine, plain1
msgid "The earlier versions aren't shown while this is hidden."
msgstr "รุ่นก่อนหน้านี้ไม่ได้แสดง ในขณะที่มันถูกซ่อนไว้."

#, machine, plain2
msgid "The earlier versions aren't shown: this was deleted and its text has been cleared."
msgstr "ไม่แสดงรุ่นก่อนหน้านี้: มันถูกลบทิ้ง และข้อความก็ถูกลบออกไป."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was approved: it is read from now on."
msgstr "อาหาร %(url)s การโพสต์อัตโนมัติของบัญชีของคุณได้รับการอนุมัติ : มันอ่านจากนี้"

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was not approved."
msgstr "อาหาร %(url)s แอคเค้าท์ของคุณยังไม่อนุมัติ"

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was approved: it is read from now on."
msgstr "อาหาร %(url)s สําหรับหุ่นของคุณ%(name)s ได้รับอนุมัติแล้ว ตั้งแต่นี้ไปก็อ่านแล้ว"

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was not approved."
msgstr "อาหาร %(url)s สําหรับหุ่นของคุณ%(name)s ไม่ได้รับการอนุมัติ"

#, machine, plain1, python-format
msgid "The feed answered with an error (%(status)s)."
msgstr "การป้อนข้อมูลมีผลผิดพลาด%(status)s)"

#, machine, plain1
msgid "The feed asked us to slow down."
msgstr "สัญญาณบอกให้เราช้าลง."

#, machine, plain1
msgid "The feed did not answer in time."
msgstr "การ รับ อาหาร ไม่ ทัน เวลา."

#, machine, plain1
msgid "The feed is unavailable for now."
msgstr "ไม่สามารถรับสัญญาณได้ในตอนนี้."

#, machine, plain1
msgid "The feed server answered with a redirect, which is not followed."
msgstr "เซิร์ฟเวอร์แหล่งป้อนตอบรับด้วยการเปลี่ยนเส้นทาง ซึ่งไม่มีการปฏิบัติตาม."

#. status is an HTTP status code, such as 404
#, machine, plain1, python-format
msgid "The feed server answered with an error (%(status)s)."
msgstr "แม่ข่ายบริการแหล่งป้อนตอบกลับมาอย่างผิดพลาด%(status)s)"

#, machine, plain1, python-format
msgid "The feed server answered with more than %(num)s post at once."
msgid_plural "The feed server answered with more than %(num)s posts at once."
msgstr[0] "เซิร์ฟเวอร์แหล่งป้อนตอบมามากกว่า %(num)s โพสต์ทันที"

#, machine, plain1
msgid "The feed server did not answer in time."
msgstr "เซิร์ฟเวอร์แหล่งป้อนไม่ตอบรับทันเวลา."

#, machine, plain1
msgid "The feed server took too long to answer."
msgstr "แม่ข่ายบริการแหล่งป้อนใช้เวลาในการตอบนานเกินไป."

#, machine, plain1
msgid "The feed server's answer has no list of posts."
msgstr "คําตอบของเซิร์ฟเวอร์แหล่งป้อนไม่มีรายการของโพสต์."

#, machine, plain1
msgid "The feed server's answer holds something that is not a post id."
msgstr "คําตอบของเซิร์ฟเวอร์แหล่งป้อนเก็บบางอย่าง ที่ไม่ใช่หมายเลขไปรษณีย์."

#, machine, plain1
msgid "The feed server's answer is not JSON."
msgstr "คําตอบของเซิร์ฟเวอร์แหล่งป้อนไม่ใช่ JSON."

#, machine, plain1
msgid "The feed server's answer is not a JSON object."
msgstr "คําตอบของเซิร์ฟเวอร์แหล่งป้อนไม่ใช่ JSON วัตถุ"

#, machine, plain1
msgid "The feed server's answer is too large."
msgstr "คําตอบเซิร์ฟเวอร์แหล่งป้อนมีขนาดใหญ่เกินไป."

#, machine, plain1
msgid "The feed server's certificate could not be checked."
msgstr "ไม่สามารถตรวจสอบใบรับรองของเซิร์ฟเวอร์แหล่งป้อนได้."

#, machine, plain1
msgid "The feed server's cursor is not usable."
msgstr "เคอร์เซอร์ของเซิร์ฟเวอร์แหล่งป้อนไม่สามารถใช้ได้."

#, machine, plain1
msgid "The feed's address sends it somewhere else too many times."
msgstr "ที่อยู่ของเครื่องส่งมันไปที่อื่นบ่อยเกินไป."

#, machine, plain1
msgid "The feed's answer is too large."
msgstr "คําตอบมันใหญ่เกินไป."

#, machine, plain1
msgid "The feed's certificate could not be checked."
msgstr "ไม่สามารถตรวจสอบใบรับรองของแหล่งป้อนได้."

#, machine, plain1
msgid "The file's size is missing."
msgstr "ขนาดแฟ้มหายไป."

#, machine, plain1, python-format
msgid "The following users are approved to forward to +%(guild)s."
msgstr "ผู้ใช้ต่อไปนี้ได้รับการอนุมัติให้ส่งต่อไปยัง + %(guild)s."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s guild chat."
msgstr "ผู้ใช้ต่อไปนี้ถูกห้ามให้เข้าร่วมใน +%(guild)s พูดคุยสมาคม"

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s."
msgstr "ผู้ใช้ต่อไปนี้ถูกห้ามให้เข้าร่วมใน + %(guild)s."

#, machine, plain1
msgid "The guild"
msgstr "สมาคม"

#, machine, plain1
msgid "The guild already has a category with that name."
msgstr "สมาคมมีหมวดหมู่ชื่อนั้นอยู่แล้ว."

#, machine, plain1
msgid "The guild already has a channel with that name."
msgstr "สมาคมมีช่องชื่อนั่นอยู่แล้ว."

#, machine, plain1
msgid "The guild already has a role with that name."
msgstr "สมาคม ฯ มี บทบาท เกี่ยว กับ พระ นาม นั้น อยู่ แล้ว."

#, machine, plain1
msgid "The guild's own rules for what is written in its channels, on top of the site's word filter. Guildmasters are never held to them. A message that breaks one is refused with a short reason that never says which word."
msgstr "กฎของตัวเองของสมาคมสําหรับสิ่งที่เขียนในช่องของ ด้านบนของตัวกรองคําเว็บไซต์ เครื่องวางจําหน่ายของกิลเดอร์ไม่เคยถือให้พวกเขา ข้อความที่ทําลายหนึ่งถูกปฏิเสธด้วยเหตุผลสั้น ๆ ที่ไม่เคยกล่าวว่าคําใด."

#, machine, plain2
msgid "The hold on your account was lifted. You can post, comment and vote again."
msgstr "บัญชีของคุณถูกยกเลิก คุณสามารถโพสต์ความคิดเห็นและลงคะแนนเสียงอีกครั้ง."

#, machine, plain1
msgid "The host stays on stage."
msgstr "เจ้าภาพอยู่บนเวที."

#, machine, plain1
msgid "The independent social platform"
msgstr "เวทีสังคมอิสระ"

#, machine, plain1
msgid "The internet gremlins have led you to a dark, musty dead-end. There's nothing here."
msgstr "Internet Graemlins ได้นําคุณไปที่มืด, ต้องตาย ที่นี่ไม่มีอะไรเลย."

#, machine, plain1, python-format
msgid "The key that opens your messages in a new app. It is locked with your password and opened here, in this browser: %(site)s never sees it. Anyone with it and your account can read your chats, so never share it."
msgstr "กุญแจที่จะเปิดข้อความของคุณในแอพใหม่ มันถูกล็อคไว้ด้วยรหัสผ่านของคุณ และเปิดใช้ที่นี่ ในเบราว์เซอร์นี้: %(site)s ไม่เคยเห็นมัน ใครก็ตามที่มีมันและบัญชีของคุณสามารถอ่านการสนทนาของคุณจึงไม่เคยแบ่งปันมัน"

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s"
msgstr "ส่วนเชื่อมโยง `%(link)s` ห้ามเข้า เหตุผล: %(reason)s"

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s."
msgstr "ส่วนเชื่อมโยง `%(link)s` ห้ามเข้า เหตุผล: %(reason)s."

#, machine, plain1, python-format
msgid "The link can be at most %(num)s character."
msgid_plural "The link can be at most %(num)s characters."
msgstr[0] "ลิงก์สามารถอยู่มากที่สุด %(num)s ตัวละคร"

#, machine, plain1
msgid "The link can't contain a user name or password."
msgstr "ส่วนเชื่อมโยงไม่สามารถบรรจุชื่อหรือรหัสผ่านได้."

#, machine, plain1
msgid "The link can't contain spaces."
msgstr "ส่วนเชื่อมโยงไม่มีช่องว่าง."

msgid "The link must start with https:// or http://."
msgstr ""

#, machine, plain1
msgid "The link needs a full address, such as example.com."
msgstr "ลิ้งค์ต้องการที่อยู่เต็ม อย่างเช่น.com."

#, machine, plain1
msgid "The list is open to members so that anyone can see what the filter hides and why. Nothing on it is removed from the site: each member's own filter decides what they see."
msgstr "รายการ นี้ เปิด ให้ สมาชิก ได้ เห็น สิ่ง ที่ เครื่อง กรอง ซ่อน และ เหตุ ผล. ไม่มีอะไรบนเว็บไซต์นี้ ที่ถูกลบออกไป: ตัวกรองของสมาชิกแต่ละคน จะตัดสินใจสิ่งที่เห็น."

#, machine, plain1
msgid "The list isn't shown on the Child filter"
msgstr "รายการไม่ได้แสดงบนตัวกรองเด็ก"

#, machine, plain1, python-format
msgid "The most a circle can ask is %(num)s coin every 30 days."
msgid_plural "The most a circle can ask is %(num)s coins every 30 days."
msgstr[0] "วงกลมส่วนใหญ่สามารถถามได้ %(num)s เหรียญทุก 30 วัน"

#, machine, plain1
msgid "The most voted posts of the last seven days."
msgstr "โพสต์ที่ลงคะแนนมากที่สุด ของเจ็ดวันที่ผ่านมา."

#, machine, plain1, python-format
msgid "The name %(host)s could not be found."
msgstr "ชื่อ %(host)s ไม่พบ"

#, machine, plain1
msgid "The newest of what they have done. Only the names of who they chat with are shown, never what a chat says: chats are end-to-end encrypted."
msgstr "สิ่งใหม่ของสิ่งที่พวกเขาทํา มีเฉพาะชื่อที่พวกเขาคุยด้วยเท่านั้น ที่จะถูกแสดง ไม่เคยมีการแชท: การสนทนามีการเข้ารหัสไว้ตอนจบ."

#, machine, plain2
msgid "The number of an anonymous author"
msgstr "จํานวนของผู้เขียนนิรนาม"

#, machine, plain2
msgid "The number of items you confirmed doesn't match what was chosen. Nothing was changed."
msgstr "จํานวนของที่คุณยืนยันไม่ตรงกับที่เลือก ไม่มีอะไรเปลี่ยนแปลง."

#, machine, plain1
msgid "The numbers are always shown on your profile. This decides who can open each list and see the accounts on it. An account is only listed where its own setting allows it too."
msgstr "ตัวเลขแสดงในประวัติของคุณ นี่ เป็น การ ตัดสิน ใจ ว่า ใคร สามารถ เปิด รายการ แต่ ละ รายการ และ ดู เรื่อง ราว ได้. บัญชีมีรายการเฉพาะที่ที่ตั้งของมันเองเท่านั้น."

#, machine, plain1
msgid "The open-source platform for independent internet communities"
msgstr "เวทีโอเพนซอร์สสําหรับชุมชนอินเตอร์เน็ตอิสระ"

#, machine, plain1
msgid "The original content is not retained anywhere, including in this history."
msgstr "เนื้อ ความ เดิม ไม่ ได้ ถูก เก็บ ไว้ ที่ ใด ๆ รวม ทั้ง ใน ประวัติศาสตร์ นี้ ด้วย."

#, machine, plain1
msgid "The other authors of a shared draft removed you as an author. What you wrote stays credited to you."
msgstr "ผู้เขียนคนอื่น ๆ ของร่างร่วม ลบคุณเป็นนักเขียน สิ่งที่เธอเขียน ต้องให้เครดิตเธอ."

#, machine, plain1
msgid "The owner deletes a channel instead of leaving it."
msgstr "เจ้าของ ลบ ช่อง แทน ที่ จะ ทิ้ง ไว้."

#, machine, plain1
msgid "The owner's role can't be changed."
msgstr "บทบาทของเจ้าของไม่สามารถเปลี่ยนแปลงได้."

#, machine, plain1
msgid "The page's current text isn't shown here; what you save replaces it."
msgstr "ข้อความปัจจุบันของหน้านี้ยังไม่ได้ถูกแสดงที่นี่ สิ่งที่คุณบันทึกจะแทนที่ข้อความนั้น."

#, machine, plain1
msgid "The picture could not be stored. Try again later."
msgstr "ไม่สามารถจัดเก็บภาพได้ ลองใหม่ทีหลัง."

#, machine, plain1
msgid "The picture goes to your own linked storage, not to this site. You can add a few words under it."
msgstr "รูปนี้เอาไปเก็บไว้เอง ไม่ใช่ที่เว็บไซต์นี้ คุณสามารถเพิ่มคําภายใต้มัน."

#, machine, plain1
msgid "The picture you chose"
msgstr "รูปที่คุณเลือก"

#, machine, plain1
msgid "The post appears on the profile of whoever publishes it first. Optionally forward it into guilds for community discussion: each guild gets its own independent copy with its own votes and comments. Guilds are forwarded to when the draft is first published."
msgstr "โพสต์นี้ปรากฏในประวัติ ของใครก็ตามที่ตีพิมพ์มันก่อน วิธี เลือก อื่น ๆ ที่ จะ ส่ง ไป ยัง สมาคม สําหรับ การ อภิปราย ของ ชุมชน: สมาคม แต่ ละ แห่ง ได้ รับ สําเนา ของ ตน เอง โดย มี การ ลง คะแนน เสียง และ ความ เห็น ของ ตน เอง. Guilds ถูกส่งต่อไปเมื่อฉบับร่างได้รับการตีพิมพ์ครั้งแรก."

#, machine, plain1
msgid "The post carries your name and is listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your name."
msgstr "โพสต์นี้มีชื่อของคุณ และอยู่ในประวัติของคุณ มี การ ให้ ความ เห็น และ การ ส่ง ข้อ ความ ต่อ ไป นี้ แก่ ผู้ เขียน ผู้ ซึ่ง แก้ไข และ ลบ ออก. คุณ สามารถ ก้าว ออก ไป ใน เวลา ใด ก็ ได้: โพสต์ อยู่ โดย ไม่ มี ชื่อ ของ คุณ."

#, machine, plain2
msgid "The post is not listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your credit."
msgstr "โพสต์ไม่ได้อยู่บนประวัติของคุณ มี การ ให้ ความ เห็น และ การ ส่ง ข้อ ความ ต่อ ไป นี้ แก่ ผู้ เขียน ผู้ ซึ่ง แก้ไข และ ลบ ออก. คุณ สามารถ ก้าว ออก ไป ใน เวลา ใด ก็ ได้: โพสต์ อยู่ โดย ไม่ ได้ รับ ความ รู้."

#, machine, plain1
msgid "The post refused the change."
msgstr "โพสต์ปฏิเสธการเปลี่ยนแปลง."

#, machine, plain2
msgid "The post stays where it is, with your name taken off it, and leaves your profile. Its Rep leaves you too. Everyone who saw it with your name still knows it was you."
msgstr "โพสต์อยู่ที่เดิม พร้อมกับชื่อของคุณ และทิ้งประวัติไว้ มันทิ้งคุณเหมือนกัน ทุกคนที่เห็นมันชื่อคุณ ยังคงรู้ว่าเป็นคุณ."

#, machine, plain2
msgid "The post's author"
msgstr "ผู้เขียนไปรษณีย์"

#, machine, plain2
msgid "The post's author deleted it, so it is shown as Anonymous: no name and no link. The comments under it stay as they were; one its author deleted is shown as Anonymous too."
msgstr "ผู้เขียนไปรษณีย์ลบมัน ดังนั้นมันจะถูกแสดงเป็นนิรนาม: ไม่มีชื่อและไม่มีส่วนเชื่อมโยง ข้อ คิด เห็น ข้าง ล่าง ยัง คง เป็น อยู่ ผู้ เขียน ที่ ถูก ลบ ออก ไป คน หนึ่ง ก็ ได้ รับ การ แสดง ว่า เป็น ผู้ ไม่ มี ชื่อ เช่น กัน."

#, machine, plain1, python-format
msgid "The promo code `%(code)s` is not currently valid. Please begin a new transaction."
msgstr "รหัส โพรโป `%(code)s` ปัจจุบันยังใช้ไม่ได้ กรุณาเริ่มต้นการทําธุรกรรมใหม่"

#, machine, plain1, python-format
msgid "The proposal for @%(name)s has been withdrawn."
msgstr "ข้อเสนอสําหรับ%(name)s ถูกถอนกําลัง"

#, machine, plain1, python-format
msgid "The role %(role)s was deleted."
msgstr "บทบาท %(role)s ถูกลบไปแล้ว"

#, machine, plain1, python-format
msgid "The role %(role)s was made."
msgstr "บทบาท %(role)s ถูกสร้างขึ้น"

#, machine, plain1, python-format
msgid "The role %(role)s was saved."
msgstr "บทบาท %(role)s ปลอดภัยแล้ว"

#, machine, plain1
msgid "The royal bank has told us that you owe them some coin. You'll need to pay off your debts before you can continue."
msgstr "ธนาคารหลวงได้บอกเราว่าคุณเป็นหนี้พวกเขาบางเหรียญ คุณจะต้องชําระหนี้ของคุณ ก่อนที่คุณจะสามารถดําเนินการ."

#, machine, plain1
msgid "The rules"
msgstr "กฎ"

#, machine, plain1
msgid "The rules below"
msgstr "กฎด้านล่างนี้"

#, machine, plain1, python-format
msgid "The rules can be at most %(count)s character."
msgid_plural "The rules can be at most %(count)s characters."
msgstr[0] "กฎสามารถเป็นได้มากที่สุด %(count)s ตัวละคร"

#, machine, plain1
msgid "The rules can't contain control or invisible characters."
msgstr "กฎไม่มีตัวควบคุมหรือตัวละครที่มองไม่เห็น."

#, machine, plain1
msgid "The screenshot you are sending"
msgstr "ภาพหน้าจอที่คุณส่ง"

#. %(status)s is an HTTP status code
#, machine, plain1, python-format
msgid "The server answered %(status)s."
msgstr "เซิร์ฟเวอร์ตอบรับ %(status)s."

#, machine, plain1, python-format
msgid "The server answers with the posts to show and their order; %(site)s still hides anything a viewer may not see, and tells the server nothing about who is looking. Everyone is told that an outside server ranks this curation."
msgstr "เซิร์ฟเวอร์ตอบคําถามด้วยโพสต์ที่จะแสดงและสั่งซื้อ %(site)s ยังคงซ่อนสิ่งที่ผู้แสดงอาจมองไม่เห็น และไม่บอกอะไรเซิร์ฟเวอร์เลยเกี่ยวกับคนที่กําลังมองหา ทุก ๆ คน ได้ รับ การ แจ้ง ว่า เครื่อง บิน ที่ อยู่ นอก เครื่อง รับ ส่ง สัญญาณ การ รักษา นี้."

#, machine, plain1, python-format
msgid "The server named %(num)s post; you can see %(seen)s of them."
msgid_plural "The server named %(num)s posts; you can see %(seen)s of them."
msgstr[0] "เซิร์ฟเวอร์ชื่อ %(num)s โพสต์, คุณสามารถดู %(seen)s ของพวกมัน"

#, machine, plain1
msgid "The server thinks you're asking something silly. It might take you more seriously if you take off the jester outfit."
msgstr "เซิร์ฟเวอร์คิดว่าคุณขออะไรโง่ๆ คุณ อาจ ต้อง เอา จริง เอา จัง กว่า นี้ ถ้า คุณ ถอด เสื้อ ผ้า ที่ ชอบ ล้อ เล่น ออก."

#, machine, plain1
msgid "The site refused the bot's session."
msgstr "เว็บไซต์ปฏิเสธการประชุมของหุ่น."

#, machine, plain2
msgid "The site's admins have it already."
msgstr "เว็บไซต์ของ admins มีแล้ว."

#, machine, plain1
msgid "The site's admins marked this guild sensitive, so only an admin can change this."
msgstr "เว็บไซต์ของ admins ทําเครื่องหมายความไวของสมาคมนี้ ดังนั้นมีเพียงโฆษณาเท่านั้นที่สามารถเปลี่ยนแปลงนี้."

#, machine, plain2
msgid "The site's admins will read it. They are never told who reported."
msgstr "Admins เว็บไซต์จะอ่านมัน ไม่มีใครบอกหรอกว่าใครรายงาน."

#, machine, plain1, python-format
msgid "The stage is full (%(num)s person)."
msgid_plural "The stage is full (%(num)s people)."
msgstr[0] "เวทีเต็มแล้ว%(num)s คน)."

#, machine, plain1
msgid "The storage service is not answering right now. Try again in a moment."
msgstr "ตอนนี้บริการเก็บของยังไม่ตอบรับ ลองอีกครั้งในสักครู่."

#, machine, plain1, python-format
msgid "The summary can be at most %(num)s character."
msgid_plural "The summary can be at most %(num)s characters."
msgstr[0] "ข้อสรุปสามารถเป็นที่มากที่สุด %(num)s ตัวละคร"

#, machine, plain1
msgid "The summary can be changed while the Space is live."
msgstr "การสรุปสามารถเปลี่ยนแปลงได้ ในขณะที่อวกาศยังอยู่."

#, machine, plain1
msgid "The text isn't shown: this was removed by the site's administrators."
msgstr "ไม่ได้แสดงข้อความ: ถูกเอาออกไปโดยผู้ดูแลระบบของเว็บไซต์."

#, machine, plain1
msgid "The text of this version was hidden by a site administrator."
msgstr "The text of this version ถูกซ่อนโดยผู้ดูแลระบบเว็บไซต์."

#, machine, plain1, python-format
msgid "The time before links must be a whole number of days, 0 to %(max)s."
msgstr "เวลาก่อนที่จะมีลิงก์เป็นจํานวนวัน, 0 ถึง %(max)s."

#, machine, plain1, python-format
msgid "The time in the guild must be a whole number of days, 0 to %(max)s."
msgstr "เวลาในสมาคมต้องเป็นจํานวนวัน, 0 ถึง %(max)s."

#, machine, plain1, python-format
msgid "The title can be at most %(num)s character."
msgid_plural "The title can be at most %(num)s characters."
msgstr[0] "ชื่อเรื่องสามารถเป็นได้มากที่สุด %(num)s ตัวละคร"

#, machine, plain1
msgid "The two revisions have the same text."
msgstr "ทั้ง สอง ฉบับ ปรับ ปรุง ใหม่ มี ข้อ ความ เดียว กัน."

#, machine, plain1
msgid "The upload did not arrive in your Google Drive. Try again."
msgstr "การอัปโหลดยังไม่มาถึงของคุณ Google Driveลองอีกครั้ง"

#, machine, plain1
msgid "The upload did not arrive in your OneDrive. Try again."
msgstr "การอัปโหลดยังไม่มาถึงของคุณ OneDriveลองอีกครั้ง"

#, machine, plain1
msgid "The upload did not arrive. Try again."
msgstr "การอัปโหลดยังไม่มาถึง ลองอีกที."

#, machine, plain1, python-format
msgid "The username @%(name)s has been pre-emptively reserved for: %(who)s"
msgstr "ชื่อผู้ใช้@ label%(name)s ถูกจองไว้ก่อนแล้ว %(who)s"

#, machine, plain1
msgid "The usual order - everything from the guilds and accounts you add"
msgstr "ลําดับปกติ ทุกอย่างจากสมาคมและบัญชีที่คุณเพิ่ม"

#, machine, plain1
msgid "The video did not finish uploading to Dailymotion. Add it again."
msgstr "วิดีโอยังไม่เสร็จสิ้นการอัปโหลดไปยัง Dailymotion เพิ่มอีกที."

#, machine, plain1
msgid "The video did not finish uploading. Add it again."
msgstr "วิดีโอยังไม่เสร็จสิ้นการอัปโหลด เพิ่มอีกที."

#, machine, plain1, python-format
msgid "The website can be at most %(num)s character."
msgid_plural "The website can be at most %(num)s characters."
msgstr[0] "เว็บไซต์สามารถเป็นส่วนใหญ่ %(num)s ตัวละคร"

#, machine, plain1
msgid "The website can't contain a user name or password."
msgstr "เว็บไซต์ไม่สามารถบรรจุชื่อหรือรหัสผ่านได้."

#, machine, plain1
msgid "The website can't contain spaces."
msgstr "เว็บไซต์ไม่สามารถบรรจุช่องว่าง."

#, machine, plain1
msgid "The website must start with https:// or http://."
msgstr "เว็บไซต์ต้องเริ่มด้วย https/Import หรือ http://."

#, machine, plain1
msgid "The website needs a full address, such as example.com."
msgstr "เว็บไซต์ต้องการที่อยู่เต็มรูปแบบ เช่น.com."

#, machine, plain1
msgid "The whole site <span class=\"text-muted\">(needs an age limit of a month or less)</span>"
msgstr "ทั้งเว็บไซต์ <span class=\"text-muted\">(ต้องการจํากัดอายุ 1 เดือนหรือน้อยกว่านั้น)</span>"

#, machine, plain1
msgid "The wiki is off: only guildmasters see it."
msgstr "Wiki ถูกปิด: เฉพาะผู้จัดวางแนวร่วมเท่านั้นที่เห็น."

#, machine, plain1
msgid "The wiki's first page can be emptied but not deleted."
msgstr "หน้าแรกของวิกิสามารถว่างได้แต่ยังไม่ถูกลบ."

#, machine, plain1
msgid "The word filter has no words at the moment."
msgstr "ตัวกรองคําว่าไม่มีคําในตอนนี้."

#, machine, plain1, python-format
msgid "The words for other languages are adapted from %(source)s (%(licence)s): words that are also ordinary, innocent words were left out."
msgstr "คํา สําหรับ ภาษา อื่น ๆ ได้ รับ การ ปรับ จาก %(source)s (%(licence)sคําพูดนั้นก็ธรรมดา คําพูดที่ไม่รู้อิโหน่อิเหน่ก็ถูกลืม"

#, machine, plain1
msgid "The working copy as it is now. Only its authors can see this until it's published."
msgstr "สําเนางานตอนนี้ เฉพาะผู้เขียนเท่านั้นที่สามารถเห็นสิ่งนี้ได้จนกว่าจะได้รับการตีพิมพ์."

#, machine, plain1
msgid "Theater"
msgstr "โรงละคร"

#, machine, plain1
msgid "Their commenting history will show here."
msgstr "ประวัติการให้ความเห็นของพวกเขา จะแสดงที่นี่."

#, machine, plain1
msgid "Their forwarding activity will show here."
msgstr "กิจกรรมของพวกเขาจะแสดงที่นี่."

#, machine, plain1
msgid "Their posting history will show here."
msgstr "ประวัติศาสตร์ของพวกเขาจะแสดงที่นี่."

#, machine, plain1
msgid "Their posts and comments are left out of your feeds and threads and they cannot notify you. They are not told, and they can still follow you, comment on your posts and message you. Their anonymous posts and comments are not hidden, as hiding only those would tell you who wrote them. Mute someone from the menu on any of their posts or comments, or from their profile."
msgstr "(คือ) บรรดาผู้โพสต์และผู้มีความคิดเห็น จงยึดถือไว้ซึ่งการให้อาหาร และด้ายเส้นหนึ่ง (ในการเผยแพร่) และพวกเขาไม่สามารถจะแจ้งข่าวได้ พวก เขา ไม่ ได้ รับ การ บอก และ ยัง คง ติด ตาม คุณ ได้ ให้ ความ เห็น เกี่ยว กับ โพสต์ และ ข่าวสาร ของ คุณ. โพสต์และความคิดเห็นของพวกเขาไม่ถูกซ่อนไว้ เพราะการซ่อนตัวเฉพาะผู้ที่จะบอกคุณว่า ใครเขียนพวกเขา พึมพําคนจากเมนู บนโพสต์หรือความคิดเห็น หรือจากโปรไฟล์."

#, machine, plain1
msgid "There are no approved users"
msgstr "ไม่มีผู้ใช้ที่อนุญาต"

#, machine, plain1
msgid "There are no exiled users"
msgstr "ไม่มีผู้ใช้ที่ถูกเนรเทศ"

#, machine, plain1
msgid "There are no guildmaster invitations."
msgstr "ไม่มีบัตรเชิญแบบมัลติมีเดีย."

#, machine, plain1
msgid "There are no guildmasters."
msgstr "ไม่มีช่างจัดอันดับสมาคม."

#, machine, plain1
msgid "There are no posts here."
msgstr "ไม่มีโพสต์ที่นี่."

#, machine, plain1, python-format
msgid "There is no account named @%(name)s."
msgstr "ไม่มีชื่อบัญชีผู้ใช้%(name)s."

#, machine, plain2
msgid "There is nothing here to appeal."
msgstr "ไม่มีอะไรที่นี่ที่จะอุทธรณ์."

#, machine, plain1
msgid "There is nothing to save yet."
msgstr "ยังไม่มีอะไรต้องช่วย."

#, machine, plain2
msgid "There is nothing waiting for this ban."
msgstr "ไม่มีอะไรรอการห้ามนี้."

#, machine, plain1
msgid "There was a problem. Please try again."
msgstr "มีปัญหา กรุณาลองอีกครั้ง."

#, machine, plain1
msgid "There were no names in that file."
msgstr "ในแฟ้มไม่มีชื่อ."

#, machine, plain1
msgid "There were no survivors."
msgstr "ไม่มีผู้รอดชีวิต."

#, machine, plain1
msgid "There's a shortage of perfect request entities in this world. Would be a pity to damage yours."
msgstr "มีการขาดแคลนองค์กรที่ต้องการอย่างสมบูรณ์แบบในโลกนี้ คงน่าเสียดายที่ทําให้คุณเสียหาย."

#, machine, plain1
msgid "There's already an open proposal like this one."
msgstr "มีข้อเสนอเปิดอยู่แล้วเช่นนี้."

#, machine, plain1
msgid "There's no account with that name."
msgstr "ไม่มีบัญชีชื่อนั้น."

#, machine, plain1
msgid "There's no invitation to speak."
msgstr "ไม่มีการเชิญให้พูด."

#, machine, plain2
msgid "There's no recovery code to keep yet."
msgstr "ยังไม่มีรหัสที่จะกู้ได้."

#, machine, plain1
msgid "There's nothing here right now."
msgstr "ตอนนี้ไม่มีอะไรเลย."

#, machine, plain1
msgid "There's nothing left here but a giant smouldering crater."
msgstr "ไม่มีอะไรเหลือที่นี่ นอกจากปล่องภูเขาไฟยักษ์."

#, machine, plain1
msgid "These are the users you are subscribed to."
msgstr "นี่คือผู้ใช้ที่คุณสมัคร."

#, machine, plain1
msgid "These counts start from the day guild insights were switched on: before that the site did not record when people left a guild or how often its page was opened."
msgstr "การ นับ เหล่า นี้ เริ่ม ตั้ง แต่ วัน ที่ มี การ เปิด การ หยั่ง เห็น เข้าใจ ของ สมาคม:."

#, machine, plain1
msgid "These filters are saved as your default"
msgstr "ตัวกรองเหล่านี้จะถูกบันทึกเป็นค่าปริยายของคุณ"

#, machine, plain1
msgid "These topics"
msgstr "หัวข้อเหล่านี้"

#, machine, plain1, python-format
msgid "These users have been invited to moderate +%(guild)s."
msgstr "ผู้ใช้เหล่านี้ได้รับเชิญให้เข้าร่วมงานระดับปานกลาง +%(guild)s."

#, machine, plain1
msgid "They already have this role."
msgstr "พวกเขามีบทบาทนี้อยู่แล้ว."

#, machine, plain1
msgid "They are 18 or over, so they can make their own account."
msgstr "พวกเขาอายุ 18 หรือมากกว่า ดังนั้นพวกเขาสามารถทําบัญชีของตนเอง."

#, machine, plain1
msgid "They are already in this circle."
msgstr "พวกมันอยู่ในวงกลมนี้แล้ว."

#, machine, plain1
msgid "They are not told. Anyone you block leaves your circles."
msgstr "พวกเขาไม่ได้บอก ใครก็ตามที่คุณปิดกั้น ออกจากวงกลมของคุณ."

#, machine, plain2
msgid "They are signed out everywhere, chat apps included. If they use chat, they may need their recovery code, or a browser where they've used chat, to read their old messages."
msgstr "พวกเขาตัดการเชื่อมต่อทุกที่ แอพการสนทนารวม ถ้าพวกเขาใช้การสนทนา พวกเขาอาจจะต้องการรหัสการฟื้นตัว หรือเบราว์เซอร์ที่เคยใช้การสนทนา เพื่ออ่านข้อความเก่าๆ."

#, machine, plain1, python-format
msgid "They aren't in %(circle)s."
msgstr "พวกเขาไม่ได้อยู่ใน %(circle)s."

#, machine, plain1
msgid "They aren't in this group."
msgstr "พวกเขาไม่ได้อยู่ในกลุ่มนี้."

#, machine, plain1
msgid "They aren't muted here."
msgstr "มันไม่เงียบตรงนี้."

#, machine, plain1
msgid "They can buy and spend coins, tip, buy Premium and join or run paid circles."
msgstr "พวกเขาสามารถซื้อและใช้เหรียญ ทิป ซื้อ Premium และเข้าร่วมหรือวิ่งวงกลมจ่าย"

#, machine, plain2
msgid "They can join and listen to Spaces. They can't host one or post in one: a child account only reads. Voice calls in a Space also need Chat to be on."
msgstr "พวกเขาสามารถเข้าร่วมและฟังอวกาศ พวกเขาไม่สามารถเป็นเจ้าภาพหรือโพสต์ได้ แอคเค้าท์เด็กมีแต่การอ่าน เสียงเรียกในพื้นที่ยังต้องการแชตที่จะอยู่บน."

#, machine, plain1
msgid "They can message people, join group chats and make calls. The site never shows you what a chat says: chats are end-to-end encrypted. Whoever knows their password can still sign in and read them."
msgstr "พวกเขาสามารถส่งข้อความให้คน เข้าร่วมการสนทนาของกลุ่มและโทร เว็บไซต์ไม่เคยแสดงให้คุณเห็นสิ่งที่การสนทนากล่าวว่า การสนทนามีการเข้ารหัสสิ้นสุด ใครก็ตามที่รู้ว่ารหัสผ่านของพวกเขา ยังคงลงนามและอ่านได้."

#, machine, plain1
msgid "They can see what you do on the site: your posts, comments, votes, bookmarks, follows, guilds, who you chat with, that your account was reported, and your recent sign-ins. The site never shows them what your chats say, because chats are end-to-end encrypted. But anyone who knows your password, a parent who chose it included, can sign in as you: change it in Security so that only you know it. They choose which of these are on for your account:"
msgstr "พวกเขาจะเห็นสิ่งที่คุณทําในเว็บไซต์: โพสต์ของคุณ, ความเห็น, การลงคะแนนเสียง, ที่คั่นหน้า, ต่อไปนี้, สมาคมที่คุณพูดคุยกับ ที่บัญชีของคุณถูกรายงานและเครื่องหมายล่าสุดของคุณ เว็บไซต์ไม่เคยแสดงให้พวกเขาเห็นว่าการสนทนาของคุณพูดอย่างไร เพราะการสนทนามีการเข้ารหัสการสิ้นสุด แต่ ใคร ก็ ตาม ที่ รู้ จัก รหัส ผ่าน ของ คุณ บิดา มารดา ที่ เลือก รหัส นั้น ก็ สามารถ เซ็น ชื่อ ใน ฐานะ คุณ: เปลี่ยน รหัส นี้ ด้วย ความ ปลอด ภัย เพื่อ คุณ จะ รู้ เพียง คน เดียว. พวกเขาจะเลือกว่าอันไหนอยู่ในบัญชีของคุณ"

#, machine, plain2
msgid "They can start a guild. They still can't post or comment: a child account only reads."
msgstr "พวกเขาตั้งสมาคมได้ พวกเขายังคงไม่สามารถโพสต์หรือให้ความเห็นได้ แอคเค้าท์เด็กมีแต่การอ่าน."

#, machine, plain1
msgid "They can't comment on your posts or comments, chat with you or notify you by mentioning you. They are not told, but they may work it out if they try to comment on something of yours."
msgstr "พวกเขาไม่สามารถแสดงความเห็นในโพสต์หรือความคิดเห็นของคุณ พูดคุยกับคุณหรือแจ้งให้คุณทราบ โดยการกล่าวถึงคุณ ไม่ มี ใคร บอก พวก เขา แต่ พวก เขา อาจ ทํา ได้ หาก เขา พยายาม ออก ความ เห็น เกี่ยว กับ บาง สิ่ง ของ คุณ."

#, machine, plain1
msgid "They don't have this role."
msgstr "พวกเขาไม่มีบทบาทนี้."

#, machine, plain1
msgid "They go straight to your coin balance."
msgstr "มันตรงเข้าบัญชีเลย."

#, machine, plain1
msgid "They haven't asked for that."
msgstr "พวกเขาไม่ได้ขอแบบนั้น."

#, machine, plain2
msgid "They leave the site. What they said stays in the Log as Anonymous, except for anything made in the last five minutes that nobody has commented on, which is erased. This can't be undone."
msgstr "พวกเขาออกจากเว็บไซต์ สิ่งที่เขาพูดอยู่ในบันทึกเป็นนิรนามยกเว้นสําหรับสิ่งที่ทําในห้านาทีที่ผ่านมา ที่ไม่มีใครมีความคิดเห็นในเรื่องซึ่งถูกลบ มันแก้ไขไม่ได้."

#, machine, plain1
msgid "They need to be in the guild, and not exiled from it."
msgstr "พวกเขาต้องอยู่ในสมาคม และไม่ถูกเนรเทศจากบริษัท."

#, machine, plain1
msgid "They need to join the channel first."
msgstr "พวกเขาต้องเข้าทางช่องก่อน."

#, machine, plain1
msgid "They say they are 18 or over and asked you to release their account. If you do, it becomes their own and you can no longer see it."
msgstr "พวกเขาบอกว่าพวกเขาอายุ 18 หรือมากกว่า และขอให้คุณปล่อยบัญชี ถ้าคุณรู้ มันจะกลายเป็นของพวกเขา และคุณมองไม่เห็นมัน."

#, machine, plain2
msgid "They stay where they are, with your name taken off them. This can't be undone. Posts that need your name (for a Circle, or with tips) are listed afterwards as not changed."
msgstr "พวกเขาอยู่ในที่ที่พวกเขาอยู่ โดยชื่อของคุณถอดออกจากพวกเขา มันแก้ไขไม่ได้ โพสต์ ที่ ต้องการ ชื่อ ของ คุณ (สําหรับ วง กลม หรือ ด้วย ทิป) ถูก จัด รายการ ไว้ หลัง จาก นั้น ไม่ เปลี่ยน."

#, machine, plain2, python-format
msgid "They wrote: %(note)s"
msgstr "พวกเขาเขียนว่า %(note)s"

#, machine, plain1
msgid "They're already a helper."
msgstr "พวกเขาเป็นผู้ช่วยอยู่แล้ว."

#, machine, plain1
msgid "They're already on stage."
msgstr "พวกเขาอยู่บนเวทีแล้ว."

#, machine, plain1
msgid "They've already been invited to speak."
msgstr "พวกเขาได้รับเชิญให้ไปพูดแล้ว."

#, machine, plain1
msgid "This Circle guild is by invitation only."
msgstr "วงเวียนนี้แค่ได้รับเชิญเท่านั้น."

#, machine, plain1
msgid "This Google account has no YouTube channel yet. Create one at youtube.com, then try again."
msgstr "นี่ Google บัญชีไม่มี YouTube ช่องทางยัง สร้างหนึ่งที่ YouTube.com แล้วลองใหม่อีกครั้ง"

#, machine, plain1
msgid "This Space"
msgstr "ช่องว่างนี้"

#, machine, plain1
msgid "This Space can't take a replay now."
msgstr "พื้นที่นี้รับบทไม่ได้."

#, machine, plain1
msgid "This Space has already started."
msgstr "พื้นที่นี้ได้เริ่มต้นแล้ว."

#, machine, plain1
msgid "This Space has ended."
msgstr "พื้นที่นี้สิ้นสุดลงแล้ว."

#, machine, plain1
msgid "This Space has ended. Its board is still here to read."
msgstr "พื้นที่นี้สิ้นสุดลงแล้ว คณะกรรมการยังคงอยู่ที่นี่ที่จะอ่าน."

#, machine, plain1
msgid "This Space has ended. Its chat is still here to read."
msgstr "พื้นที่นี้สิ้นสุดลงแล้ว การสนทนายังคงอยู่ที่นี่ที่จะอ่าน."

#, machine, plain1
msgid "This Space hasn't started yet."
msgstr "พื้นที่นี้ยังไม่ได้เริ่มต้น."

#, machine, plain1, python-format
msgid "This Space is full (%(num)s listener)."
msgid_plural "This Space is full (%(num)s listeners)."
msgstr[0] "พื้นที่นี้เต็มแล้ว%(num)s ผู้ฟัง)."

#, machine, plain1, python-format
msgid "This Space is live until %(time)s."
msgstr "พื้นที่นี้ยังคงอยู่จนกระทั่ง %(time)s."

#, machine, plain1
msgid "This Space is live."
msgstr "พื้นที่นี้ถ่ายทอดสด."

#, machine, plain1
msgid "This Space is not recorded: when it ends, it is gone, with everything in it."
msgstr "ไม่ มี การ บันทึก สเปซ นี้ ไว้ เมื่อ สิ้น สุด มัน ก็ สูญ ไป พร้อม กับ ทุก สิ่ง ที่ อยู่ ใน นั้น."

#, machine, plain1
msgid "This Space is recorded"
msgstr "พื้นที่นี้ถูกบันทึก"

#, machine, plain1
msgid "This Space is recorded: its board stays to read when it ends."
msgstr "พื้นที่นี้ถูกบันทึก: คณะกรรมการต้องอ่านเมื่อสิ้นสุด."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay with the video."
msgstr "สเปซนี้ถูกบันทึก: เจ้าภาพเก็บวิดีโอไว้เล่นต่อ."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay."
msgstr "สเปซนี้ถูกบันทึกว่าโฮสต์ยังเล่นซ้ําอีก."

#, machine, plain1
msgid "This Space isn't available."
msgstr "พื้นที่นี้ไม่ว่าง."

#, machine, plain1
msgid "This Space isn't waiting to start."
msgstr "พื้นที่นี้ไม่ได้รอที่จะเริ่มต้น."

#, machine, plain1
msgid "This Space keeps its sound only."
msgstr "พื้นที่นี้ให้เสียงเท่านั้น."

#, machine, plain1
msgid "This access will expire in one hour, or earlier if you revoke it."
msgstr "การเข้าถึงนี้จะหมดอายุภายในหนึ่งชั่วโมง หรือก่อนหน้านี้ หากคุณเพิกถอนมัน."

#, machine, plain1
msgid "This account can't use chat apps."
msgstr "บัญชีนี้ไม่สามารถใช้โปรแกรมแชทได้."

#, machine, plain1, python-format
msgid "This account has been marked 18 or over since %(date)s."
msgstr "บัญชีนี้ได้รับการทําเครื่องหมาย 18 หรือมากกว่าตั้งแต่ %(date)s."

#, machine, plain1, python-format
msgid "This account has been permanently suspended from %(site)s."
msgstr "บัญชีนี้ถูกระงับชั่วคราวชั่วคราวจาก %(site)s."

#, machine, plain1, python-format
msgid "This account has been temporarily suspended from %(site)s. Check back later."
msgstr "บัญชีนี้ถูกระงับชั่วคราวจาก %(site)sเช็คดูทีหลัง"

#, machine, plain1
msgid "This account is private"
msgstr "บัญชีนี้เป็นเรื่องส่วนตัว"

#, machine, plain1
msgid "This account is suspended."
msgstr "บัญชีนี้ถูกยกเลิก."

#, machine, plain1
msgid "This account owes money, so it can't be deleted yet."
msgstr "บัญชีนี้เป็นหนี้ ดังนั้นมันจะไม่สามารถลบได้."

#, machine, plain1
msgid "This account posts about sensitive topics"
msgstr "บัญชีผู้ใช้นี้โพสต์เกี่ยวกับหัวข้อที่ละเอียดอ่อน"

#, machine, plain2
msgid "This also signs out chat everywhere else, chat apps included, except the chat this browser has used since you signed in here."
msgstr "นี่ยังยุติการสนทนาทุกหนทุกแห่ง รวมทั้งโปรแกรมสนทนา ยกเว้นการสนทนาที่เบราว์เซอร์นี้ใช้ ตั้งแต่คุณเซ็นที่นี่."

#. %(time)s is a length of time, such as "6 months"
#, machine, plain1, python-format
msgid "This author hasn't been active for %(time)s, so isn't counted."
msgstr "ผู้เขียนคนนี้ไม่ได้ทํางานอยู่ %(time)sไม่นับ"

#, machine, plain2
msgid "This ban relies on:"
msgstr "คํา สั่ง ห้าม นี้ ขึ้น อยู่ กับ:"

#, machine, plain1
msgid "This bot can't take tips right now."
msgstr "เจ้าหุ่นนี่ใช้ทิปตอนนี้ไม่ได้."

#, machine, plain1
msgid "This bot has not been approved."
msgstr "หุ่นตัวนี้ไม่ได้รับอนุมัติ."

#, machine, plain1
msgid "This bot is not running."
msgstr "หุ่นตัวนี้ไม่ได้วิ่ง."

#, machine, plain1
msgid "This bot's owner can't run it right now."
msgstr "เจ้าของหุ่นตัวนี้ยังคุมตอนนี้ไม่ได้."

#, machine, plain2
msgid "This bot's owner can't run it while their account is on hold."
msgstr "เจ้าของตัวนี้ไม่สามารถดําเนินการได้ ในขณะที่บัญชีของพวกเขายังอยู่."

#, machine, plain2
msgid "This browser was signed out. Sign in again to carry on."
msgstr "เบราว์เซอร์นี้ถูกตัดการเชื่อมต่อ ลงชื่ออีกครั้ง."

#, machine, plain2
msgid "This browser's notifications couldn't be turned on. Try again."
msgstr "การแจ้งให้ทราบของเบราว์เซอร์นี้ไม่สามารถเปิดใช้งานได้ ลองอีกที."

#, machine, plain1, python-format
msgid "This call is full (%(num)s person)."
msgid_plural "This call is full (%(num)s people)."
msgstr[0] "เสียงเรียกเต็มแล้ว%(num)s คน)."

#, machine, plain1
msgid "This can't be translated right now."
msgstr "นี้ไม่สามารถแปลได้ในขณะนี้."

#, machine, plain2
msgid "This can't be undone. The site's admins can always see who wrote something, and if an admin bans or suspends the account for it, the Log may name the account for it."
msgstr "มันแก้ไขไม่ได้ admins เว็บไซต์สามารถดูได้เสมอว่าใครเขียนบางสิ่งบางอย่าง และถ้าโฆษณาแบนหรือระงับบัญชีสําหรับมัน ปูมบันทึกอาจจะชื่อบัญชีสําหรับมัน."

#, machine, plain1
msgid "This channel doesn't ask for its rules to be accepted."
msgstr "ช่องนี้ไม่ได้ร้องขอ ให้ยอมรับกฎ."

#, machine, plain1
msgid "This channel has no messages."
msgstr "ช่องนี้ไม่มีข้อความ."

#, machine, plain1
msgid "This channel is end-to-end encrypted: it is read and written in Chat, where your messages are unlocked."
msgstr "ช่องทางนี้ถูกเข้ารหัสไว้แบบปลายสุด: คืออ่านและเขียนใน Chart ซึ่งจดหมายของคุณไม่ได้ล็อค."

#, machine, plain1
msgid "This channel is end-to-end encrypted: the site can't read it, so it has no word filter, slow mode, pins, search or reports."
msgstr "ช่องทางนี้ถูกเข้ารหัสไว้ตลอด: เว็บไซต์ไม่สามารถอ่านได้ ดังนั้นจึงไม่มีตัวกรองคํา, โหมดช้า, เข็มหมุด, สืบค้นหรือรายงาน."

#, machine, plain1
msgid "This channel is full."
msgstr "ช่องนี้เต็มแล้ว."

#, machine, plain1
msgid "This channel is written from the chat itself."
msgstr "ช่องนี้เขียนจากการสนทนาเอง."

#, machine, plain1
msgid "This channel isn't available."
msgstr "ช่องนี้ไม่ว่าง."

#, machine, plain1
msgid "This circle isn't taking subscribers."
msgstr "วงเวทย์นี้ไม่ได้รับสมาชิก."

#, machine, plain1
msgid "This code can't be used. Get a new one on the computer, or sign in there with your password."
msgstr "รหัสนี้ใช้ไม่ได้ หาอันใหม่ในคอมพิวเตอร์ หรือเซ็นด้วยรหัสผ่าน."

#, machine, plain1
msgid "This code has run out."
msgstr "รหัสนี้หมด."

#, machine, plain1
msgid "This comment and the comments under it"
msgstr "ความคิดเห็นนี้และความคิดเห็นภายใต้"

#, machine, plain1, python-format
msgid "This comment breaks %(site)s policy"
msgstr "ความคิดเห็นนี้ไม่ตรง %(site)s นโยบาย"

#, machine, plain1
msgid "This comment can't be forwarded."
msgstr "ความเห็นนี้ไม่สามารถส่งต่อได้."

#, machine, plain1
msgid "This comment can't be reposted."
msgstr "ความคิดเห็นนี้ไม่สามารถเผยแพร่ได้."

#, machine, plain1
msgid "This comment is on a copy forwarded to a guild - ask that guild's guildmasters to remove it instead."
msgstr "หมายเหตุนี้อยู่บนสําเนาที่ถูกส่งต่อไปยังคลังสื่อ - ให้ถามตัวจัดรูปแบบของมัลติมีเดียเพื่อลบออกแทน."

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a>"
msgstr "ส่วนความคิดเห็นนี้ เป็นเมืองผี <a href=\"%(url)s\">เข้าสู่ระบบ</a>"

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a> to comment!"
msgstr "ส่วนความคิดเห็นนี้ เป็นเมืองผี <a href=\"%(url)s\">เข้าสู่ระบบ</a> ให้ความเห็น!"

#, machine, plain1
msgid "This comment section is a ghost town. Be the first to comment!"
msgstr "ส่วนความคิดเห็นนี้ เป็นเมืองผี จง ออก ความ เห็น เป็น ครั้ง แรก!"

#, machine, plain1
msgid "This comment section is a ghost town..."
msgstr "ส่วนความคิดเห็นนี้ เป็นเมืองผี."

#, machine, plain1
msgid "This content has already been posted"
msgstr "เนื้อหานี้ถูกโพสต์แล้ว"

#, machine, plain1
msgid "This copy is no longer kept."
msgstr "สําเนานี้ไม่ได้เก็บไว้แล้ว."

#, machine, plain2
msgid "This couldn't be changed right now."
msgstr "นี้ไม่สามารถเปลี่ยนแปลงได้ในขณะนี้."

#, machine, plain1
msgid "This creates a new, independent post in that guild with its own votes and comments. The title is generated from the comment's text. A link back to the original comment will be shown on the new post."
msgstr "นี่สร้างตําแหน่งใหม่ที่อิสระในสมาคม พร้อมเสียงและความคิดเห็นของตนเอง ชื่อเรื่องถูกสร้างจากข้อความของความคิดเห็น จะแสดงลิงก์กลับไปที่หมายเหตุเดิมบนโพสต์ใหม่."

#, machine, plain1
msgid "This creates an independent copy of the post with its own votes and comments in that guild. You can forward to any guild that accepts forwards from you."
msgstr "การ ทํา เช่น นี้ ทํา ให้ มี สําเนา ของ ไปรษณีย์ แบบ อิสระ พร้อม ด้วย การ ลง คะแนน เสียง และ ความ เห็น ของ ตน เอง ใน สมาคม นั้น. คุณสามารถส่งต่อไปยังสมาคมใด ๆ ที่ยอมรับไปข้างหน้าจากคุณ."

#, machine, plain1
msgid "This curation's feed server has been asked too often. Try again in a minute."
msgstr "มีการถามเซิร์ฟเวอร์ของแหล่งป้อนที่ถูกแก้ไขบ่อยเกินไป ลองอีกครั้งในหนึ่งนาที."

#, machine, plain1
