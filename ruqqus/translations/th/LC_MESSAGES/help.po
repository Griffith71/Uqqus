msgid "Header %(level)s"
msgstr "หัวจดหมาย %(level)s"

#, machine, plain1
msgid "Headers 1-6"
msgstr "ส่วนหัว 1-6"

#, machine, plain1, python-format
msgid "Help %(site)s Grow"
msgstr "ช่วยเหลือ %(site)s โต"

#, machine, plain1
msgid "Help support the future of online discourse"
msgstr "ช่วย สนับสนุน การ บรรยาย ทาง อินเทอร์เน็ต ใน อนาคต"

#, machine, plain1
msgctxt "formatting"
msgid "Highlight"
msgstr "เน้น"

