msgid "unhid a %(target)s in this guild"
msgstr "unhid a %(target)s en este gremio"

#. follows the moderator's name in a guild's moderation log; %(target)s is a
#. link
#, machine, python-format
msgid "unhid post %(target)s in this guild"
msgstr "unhid post %(target)s en este gremio"

#, machine, plain2, python-format
msgid "until %(date)s"
msgstr "hasta %(date)s"

#, machine, plain2, python-format
msgid "up to %(max)s at a time"
msgstr "hasta %(max)s a la vez"

#. %(people)s is the largest number of people a call may have for video
#, machine, python-format
msgid "up to %(num)s person on stage can turn their camera on while the call has %(people)s people or fewer."
msgid_plural "up to %(num)s people on stage can turn their camera on while the call has %(people)s people or fewer."
msgstr[0] "hasta %(num)s persona en el escenario puede encender su cámara mientras la llamada tiene %(people)s gente o menos."
msgstr[1] "hasta %(num)s personas en el escenario pueden encender su cámara mientras la llamada tiene %(people)s gente o menos."

#. after the moderator's name in a guild's moderation log
#, machine
msgid "updated appearance"
msgstr "apariencia actualizada"

#. after the moderator's name in a guild's moderation log
#, machine
msgid "updated setting"
msgstr "ajuste actualizado"

#. after the moderator's name in a guild's moderation log
#, machine
msgid "updated the stylesheet"
msgstr "actualizada la hoja de estilo"

#. url: is a search operator and stays as it is
#, machine, python-format
msgid "url: can be at most %(num)s character."
msgid_plural "url: can be at most %(num)s characters."
msgstr[0] "url: puede ser en la mayoría de %(num)s carácter."
msgstr[1] "url: puede ser en la mayoría de %(num)s caracteres."

#, machine
msgid "username"
msgstr "nombre de usuario"

#. "v." is short for version; the name is the company that runs the site
#, machine, python-format
msgid "v. %(version)s, © 2021 %(company)s"
msgstr "v. %(version)s, © 2021 %(company)s"

#, machine
msgid "video"
msgstr "video"

#, glossary, machine, plain2
msgid "video preview"
msgstr "vista previa del vídeo"

#, machine
msgid "voice, up to 8 people"
msgstr "voz, hasta 8 personas"

#, machine
msgid "waiting for them to accept"
msgstr "esperando que acepten"

#. follows the app's name, shown just above as a heading
#, machine, python-format
msgid "wants to access your @%(name)s account."
msgstr "quiere acceder a su cuenta @%(name)s."

#, machine
msgctxt "time filter"
msgid "week"
msgstr "semana"

#, machine
msgid "when it ends it disappears, with everything in it"
msgstr "cuando termina desaparece, con todo en ella"

#, machine
msgid "who wrote what"
msgstr "que escribió lo"

#. beside a post's author, its co-authors: names is their names, linked
#, machine, python-format
msgid "with %(names)s"
msgstr "con %(names)s"

#. beside a post's author, its co-authors: names is the first five, linked; num
#. is how many more there are
#, machine, python-format
msgid "with %(names)s and <a href=\"%(url)s\">%(num)s other</a>"
msgid_plural "with %(names)s and <a href=\"%(url)s\">%(num)s others</a>"
msgstr[0] "con %(names)s y <a href=\"%(url)s\">%(num)s otra</a>"
msgstr[1] "con %(names)s y <a href=\"%(url)s\">%(num)s otros</a>"

#, machine, python-format
msgid "with promo code <code>%(code)s</code>"
msgstr "con código promo <code>%(code)s</code>"

#, machine
msgid "words or phrases, separated by commas"
msgstr "palabras o frases, separadas por coma"

#. follows the moderator's name in a guild's moderation log; %(target)s is a
#. link
#, machine, python-format
msgid "yanked post %(target)s"
msgstr "yanked post %(target)s"

#, machine
msgctxt "time filter"
msgid "year"
msgstr "año"

#, machine
msgctxt "badge beside your own name"
msgid "you"
msgstr "tú"

#, machine
msgid "you voted no"
msgstr "votaste no"

#, machine
msgid "you voted yes"
msgstr "votaste si"

#, machine
msgid "you were posting too fast, and it couldn't wait any longer."
msgstr "estabas publicando demasiado rápido, y no podía esperar más."

#, machine, plain2
msgid "you were signed out."
msgstr "estabas desconectado."

#, machine
msgid "you're invited to write it"
msgstr "estás invitado a escribirlo"

#, machine, plain2
msgid "your account couldn't post it at that moment (it is on hold or suspended, or the rules of a guild it was forwarded to). Open it and press Post to see what."
msgstr "su cuenta no pudo publicarlo en ese momento (está en espera o suspendida, o las reglas de un gremio a las que fue enviado). Ábrelo y presione Post para ver qué."

#. "~" means about; an action is a post or comment counted towards the posting
#. cooldown
#, machine, python-format
msgid "~%(num)s action left before a cooldown"
msgid_plural "~%(num)s actions left before a cooldown"
msgstr[0] "~%(num)s acción izquierda antes de una refrigeración"
msgstr[1] "~%(num)s acciones que quedan antes de una refrigeración"

#, machine, python-format
msgid "“%(name)s” is already used for a view of your bookmarks. Pick another name."
msgstr "“%(name)s” ya se utiliza para una vista de sus marcadores. Escoge otro nombre."

#, machine, python-format
msgid "“%(name)s” isn't a guild name."
msgstr "“%(name)s” no es un nombre de gremio."

