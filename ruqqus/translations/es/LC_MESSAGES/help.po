#, machine, python-format
msgid "\"%(site)s\" is pronounced identically to the standard English word \"ruckus\""
msgstr "\"%(site)s\" se pronuncia idénticamente a la palabra estándar Inglés \"ruckus\""

#, machine
msgid "\"Ruqqie\" is pronounced \"RUCK-ee\""
msgstr "\"Ruqqie\" se pronuncia \"RUCK-ee\""

#. a cryptocurrency's name, then the word for the address to send it to.
#, machine, python-format
msgid "%(coin)s Address"
msgstr "%(coin)s Dirección"

#, machine, plain1, python-format
msgid "%(coin)s receiving address QR code"
msgstr "%(coin)s dirección de recepción QR código"

#, machine, python-format
msgid "%(company)s is outside your jurisdiction. Sucks to be you."
msgstr "%(company)s está fuera de su jurisdicción. Sucks para ser tú."

#, machine, python-format
msgid "%(company)s is, always has been, and always will be 100%% outside your jurisdiction. You must obtain legal process that is valid in the state of New Hampshire. Then, submit your United States legal process document to our [legal requests portal](/legal)."
msgstr "%(company)s es, siempre ha sido, y siempre será 100 %% fuera de su jurisdicción. Usted debe obtener un proceso legal que es válido en el estado de New Hampshire. Entonces, envíe su documento de proceso legal de los Estados Unidos a nuestro [ portal de peticiones legales](/legal)."

#, machine, python-format
msgid "%(company)s may revoke your License at any time and for any reason."
msgstr "%(company)s puede revocar su Licencia en cualquier momento y por cualquier razón."

#, machine, plain1, python-format
msgid "%(curation)s: a public curation, by its name or the short name under it. Search %(curation)s to find them; <code>%(in_curation)s</code> narrows a post search to that curation's guilds and accounts. Private curations are never found."
msgstr "%(curation)s: un alimento curado público, por su nombre o el nombre corto debajo de él. Búsqueda %(curation)s encontrarlos; <code>%(in_curation)s</code> estrecha una búsqueda de correo a los gremios y cuentas de ese alimento curado. Los alimentos curados privados nunca se encuentran."

