#, machine, python-format
msgid "\"%(site)s\" is pronounced identically to the standard English word \"ruckus\""
msgstr "\"%(site)s\" wird identisch mit dem englischen Standardwort \"ruckus\" ausgesprochen"

#, machine
msgid "\"Ruqqie\" is pronounced \"RUCK-ee\""
msgstr "\"Ruqqie\" wird \"RUCK-ee\" ausgesprochen"

#. a cryptocurrency's name, then the word for the address to send it to.
#, machine, python-format
msgid "%(coin)s Address"
msgstr "%(coin)s Adresse"

#, machine, plain1, python-format
msgid "%(coin)s receiving address QR code"
msgstr "%(coin)s empfangsadresse QR code"

#, machine, python-format
msgid "%(company)s is outside your jurisdiction. Sucks to be you."
msgstr "%(company)s außerhalb Ihrer Gerichtsbarkeit liegt. Sucks to be you."

#, machine, python-format
msgid "%(company)s is, always has been, and always will be 100%% outside your jurisdiction. You must obtain legal process that is valid in the state of New Hampshire. Then, submit your United States legal process document to our [legal requests portal](/legal)."
msgstr "%(company)s ist, war immer, und wird immer 100 %% außerhalb Ihrer Gerichtsbarkeit sein. Sie müssen ein rechtliches Verfahren erhalten, das im Bundesstaat New Hampshire gültig ist. Senden Sie dann Ihr US-Rechtsprozessdokument an unser [Portal für Rechtsanfragen](/legal)."

#, machine, python-format
msgid "%(company)s may revoke your License at any time and for any reason."
msgstr "%(company)s kann Ihre Lizenz jederzeit und aus irgendeinem Grund widerrufen."

#, machine, plain1, python-format
msgid "%(curation)s: a public curation, by its name or the short name under it. Search %(curation)s to find them; <code>%(in_curation)s</code> narrows a post search to that curation's guilds and accounts. Private curations are never found."
msgstr "%(curation)s: ein öffentliches kuratiertes Futter mit seinem Namen oder dem Kurznamen darunter. Suche %(curation)s um sie zu finden; <code>%(in_curation)s</code> verengt eine Postsuche auf die Gilden und Konten dieses kuratierten Feeds. Private kuratierte Feeds werden nie gefunden."

#, machine, python-format
