#, machine, plain1
msgid "You can read this channel but not write in it."
msgstr "Můžete si přečíst tento kanál, ale ne do něj psát."

#, machine, plain1
msgid "You can see who is here, but you can't speak in this channel."
msgstr "Můžete vidět, kdo je tady, ale nemůžete mluvit v tomto kanálu."

#, glossary, machine, plain2
msgid "You can't do that."
msgstr "To nemůžete udělat."

#, machine, plain1
msgid "You can't message that person."
msgstr "Tomu člověku nemůžeš vzkázat."

#, machine, plain1
msgid "You can't send to that chat."
msgstr "Nemůžeš na ten rozhovor poslat."

#, machine, plain1
msgid "You can't start a chat with them."
msgstr "Nemůžeš s nimi začít mluvit."

#, machine, plain1
msgid "You can’t edit this draft any more (you may have left it or been removed)."
msgstr "Tento návrh už nelze upravovat (můžete ho opustit nebo být odstraněn)."

#, machine, plain1
msgid "You ended the Space."
msgstr "Ukončil jsi vesmír."

#, machine, plain1
msgid "You have no curations yet."
msgstr "Zatím nemáte žádné kurátory."

#, machine, plain1
msgid "You have no stories yet. Share one first."
msgstr "Ještě nemáš žádné příběhy. Nejdřív se dělíme."

#, machine, plain1
msgid "You haven't made a circle of your own yet. Your Friends circle is automatic: it is everyone you follow who follows you back."
msgstr "Ještě jsi neudělal vlastní kruh. Kruh vašich přátel je automatický: je to každý, koho sledujete, kdo vás sleduje."

#, machine, plain1
msgid "You left the Space."
msgstr "Opustil jsi vesmír."

#, machine, plain1
msgid "You left the call."
msgstr "Opustil jsi hovor."

#, machine, plain2
msgid "You logged out everywhere from another device, so chat is starting again here."
msgstr "Odpojil jste se všude od jiného zařízení, takže chat začíná znovu."

#, machine, plain1
msgid "You signed in with your two-factor recovery code, so chat is starting again here."
msgstr "Přihlásila ses se svým dvoumístným návratovým kódem, takže tady zase začíná chat."

#, machine, plain1, python-format
msgid "You unfollowed @%(name)s."
msgstr "Nesledoval jsi @ %(name)s."

#, machine, plain1
msgid "You were removed from this Space."
msgstr "Byl jsi odstraněn z tohoto vesmíru."

#, machine, plain2
msgid "You'll get a new recovery code, and the old one will stop working."
msgstr "Dostaneš nový kód a ten starý přestane fungovat."

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "Děláš to až moc. Zkuste to později."

#, machine, plain1
msgid "You're no longer in this Space."
msgstr "Už nejsi v tomhle vesmíru."

#, machine, plain1
msgid "You're the only one here."
msgstr "Jsi tu jediný."

#, machine, plain1
msgid "Your app is verified"
msgstr "Vaše aplikace je ověřena"

#, machine, plain1
msgid "Your browser blocked the window for connecting. Allow pop-ups for this site, or connect in the settings."
msgstr "Váš prohlížeč zablokoval okno pro připojení. Povolit pop-ups pro tuto stránku, nebo připojit v nastavení."

#, machine, plain1
msgid "Your chat devices can't be listed right now."
msgstr "Vaše chat zařízení nemůže být uveden právě teď."

#, machine, plain2
msgid "Your chat recovery code"
msgstr "Váš chat recovery kód"

#, machine, plain1
msgid "Your chats"
msgstr "Vaše rozhovory"

#, machine, plain1
msgid "Your chats will work again on this device, but messages from before can't be read here (or anywhere without your old key)."
msgstr "Vaše rozhovory budou opět fungovat na tomto zařízení, ale zprávy z minulosti nelze číst zde (nebo kdekoli bez vašeho starého klíče)."

#, machine, plain1
msgid "Your comment could not be posted. Try again."
msgstr "Váš komentář nemohl být zveřejněn. Zkus to znovu."

#, machine, plain2
msgid "Your current recovery code will stop working."
msgstr "Váš současný kód přestane fungovat."

#, machine, plain1
msgid "Your edit couldn't be saved. Please check your connection and try again."
msgstr "Váš střih nemohl být uložen. Zkontrolujte prosím spojení a zkuste to znovu."

#, machine, plain1
msgid "Your edit couldn't be saved. Please try again."
msgstr "Váš střih nemohl být uložen. Prosím, zkuste to znovu."

#, machine, plain1
msgid "Your files stay in your own account there, using its free space. This site only shows them in your posts."
msgstr "Vaše soubory zůstávají na vašem vlastním účtu tam, pomocí svého volného prostoru. Tato stránka ukazuje pouze na vašich místech."

#, machine, plain1
msgid "Your guilds' chats"
msgstr "Vaše guilds 'chats"

#. placeholder text a member replaces: the headline of a "Call to action"
#. block, and its button's label
#, machine, plain1
msgid "Your headline"
msgstr "Váš titulek"

#, machine, plain1
msgid "Your key can't be shown right now."
msgstr "Tvůj klíč teď není vidět."

#, machine, plain1
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "Váš klíč byl zamčen starším heslem. Otevřete Chat na této stránce a zadejte svůj recovery kód jednou, pak se otevře zde."

#, machine, plain1, python-format
msgid "Your message will be sent once chat is unlocked on this device."
msgid_plural "Your %(num)s messages will be sent once chat is unlocked on this device."
msgstr[0] "Vaše zpráva bude odeslána, jakmile je na tomto zařízení odemčen chat."
msgstr[1] "Vaše %(num)s zprávy budou odeslány, jakmile je na tomto zařízení odemčen chat."
msgstr[2] "Vaše %(num)s zprávy budou odeslány, jakmile je na tomto zařízení odemčeno chat."

#, machine, plain2
msgid "Your name will show on this comment. Your own words can still give away that you wrote the post, and a comment under your name is not linked to the post by anything we show."
msgstr "Vaše jméno se ukáže v tomto komentáři. Vaše vlastní slova mohou stále dát pryč, že jste napsal příspěvek, a komentář pod vaším jménem není spojen s poštou o nic, co ukážeme."

#, machine, plain2
msgid "Your old recovery code no longer works."
msgstr "Tvůj starý kód už nefunguje."

#, machine, plain1
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "Heslo se změnilo, protože ten klíč byl zamčený. Ozdravný kód, který jste uložili, když byl ustaven chat, ho otevře."

#, machine, plain1
msgid "Your password was changed for you, so chat is starting again here."
msgstr "Vaše heslo bylo změněno, takže chat začíná znovu tady."

#, machine, plain1
msgid "Your password was changed, so chat is starting again here."
msgstr "Vaše heslo bylo změněno, takže chat začíná znovu tady."

#, machine, plain1
msgid "Your password was reset, so chat is starting again here."
msgstr "Vaše heslo bylo resetováno, takže chat začíná znovu tady."

#, machine, plain1
msgid "Your recovery code"
msgstr "Váš kód na zotavení"

#, machine, plain1
msgid "Your saved templates show up here."
msgstr "Tady jsou vaše uložené šablony."

#, machine, plain2
msgid "Your screen can be shared only while you're on video in this call."
msgstr "Vaše obrazovka může být sdílena pouze když jste na videu v tomto hovoru."

#, machine, plain2
msgid "Your screen couldn't be shared."
msgstr "Vaše obrazovka nemůže být sdílena."

#, machine, plain1
msgid "Your settings have been updated."
msgstr "Vaše nastavení bylo aktualizováno."

#, machine, plain1
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "Váš sklad potřebuje znovu připojit. Poslat zvuk na:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your pictures to:"
msgstr "Váš sklad potřebuje znovu připojit. Pošlete své fotografie na:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your videos to:"
msgstr "Váš sklad potřebuje znovu připojit. Pošlete svá videa na:"

#. %(zone)s is a time zone name such as Europe/London
#, machine, plain1, python-format
msgid "Your time zone: %(zone)s"
msgstr "Vaše časové pásmo: %(zone)s"

#, machine, plain1
msgid "Your vote is on another copy of this Space, or it can't change any more."
msgstr "Váš hlas je o další kopii tohoto vesmíru, nebo se už nemůže změnit."

#, machine, plain1
msgid "You’re all caught up"
msgstr "Všichni jste dohnali"

#, machine, plain1
msgid "You’re all caught up."
msgstr "Všichni jste dohnali."

