msgctxt "filter choice"
msgid "Only"
msgstr "Pouze"

#. %(kinds)s is a list of kinds of post ("pictures, video and sound").
#, machine, plain1, python-format
msgid "Only %(kinds)s."
msgstr "Pouze %(kinds)s."

#, machine, plain1
msgid "Only Premium accounts can comment on this post now."
msgstr "Pouze Premium účty mohou komentovat na tomto příspěvku nyní."

#, machine, plain1
msgid "Only Premium accounts can comment on this post."
msgstr "Pouze Premium účty mohou komentovat tento příspěvek."

#, machine, plain1
msgid "Only a call has a stage."
msgstr "Pouze hovor má jeviště."

#, machine, plain2
msgid "Only a group's owner and admins can change this."
msgstr "Pouze majitel skupiny a administrátoři to mohou změnit."

#, machine, plain1
msgid "Only a guild's copy of a post has a flair."
msgstr "Pouze cechy kopie post má štítek."

#, machine, plain1
msgid "Only a post on your own profile has an audience."
msgstr "Pouze příspěvek na vašem profilu má publikum."

#, machine, plain1
msgid "Only a post on your own profile has this setting. A copy in a guild follows that guild's rules."
msgstr "Pouze příspěvek na vašem vlastním profilu má toto nastavení. Kopie v cechu se řídí pravidly."

#, machine, plain1
msgid "Only a post on your profile can have co-authors."
msgstr "Pouze příspěvek na vašem profilu může mít spoluautory."

#, machine, plain1
msgid "Only a private or Circle guild's channels can be end-to-end encrypted."
msgstr "Pouze soukromé nebo Circle Guild kanály mohou být end- to- end šifrované."

#, machine, plain1
msgid "Only a public post can be forked."
msgstr "Jen veřejná pošta může být zfalšována."

#, machine, plain1
msgid "Only a running bot can be paused."
msgstr "Jen běžící robot může být zastaven."

#, machine, plain1
msgid "Only a text channel can be end-to-end encrypted."
msgstr "Pouze textový kanál může být zašifrován."

#, machine, plain1, python-format
msgid "Only accounts @%(name)s follows can comment on this post."
msgstr "K tomuto příspěvku se mohou vyjádřit pouze účty @ %(name)s."

#, machine, plain1
msgid "Only accounts you follow can comment on this post now."
msgstr "Pouze účty, které sledujete, mohou komentovat tento příspěvek nyní."

#, machine, plain2
msgid "Only an admin can confirm a reveal."
msgstr "Pouze admin může potvrdit odhalení."

#, machine, plain1
msgid "Only an admin can start it again."
msgstr "Pouze admin může začít znovu."

#, machine, plain1
msgid "Only an announcement channel takes a bot's posts."
msgstr "Pouze hlásicí kanál zaujme pozice robota."

#, machine, plain1, python-format
msgid "Only approved contributors can forward posts and comments to +%(guild)s."
msgstr "Pouze schválené přispěvatelé mohou předávat příspěvky a komentáře na + %(guild)s."

#, machine, plain1
msgid "Only approved members write in this channel."
msgstr "Do tohoto kanálu napište pouze schválené členy."

#, machine, plain1
msgid "Only continue if you started signing in to a chat app just now."
msgstr "Pokračovat pouze tehdy, pokud jste se začali přihlašovat k aplikaci chatu právě teď."

#, machine, plain1
msgid "Only continue if you started this yourself on a screen in front of you. If a post, comment, message or website asked you to scan this, someone may be trying to take your account."
msgstr "Pokračujte, jen když to začnete na obrazovce před vámi. Pokud vás o to požádal příspěvek, komentář, zpráva nebo webové stránky, může se někdo snažit vzít váš účet."

#, machine, plain1, python-format
msgid "Only counts are shown, never who. Day-by-day figures appear once a guild has %(num)s member, so a small guild's numbers can't point at one person."
msgid_plural "Only counts are shown, never who. Day-by-day figures appear once a guild has %(num)s members, so a small guild's numbers can't point at one person."
msgstr[0] "Ukazují se jen počty, nikdy kdo. Day-by-day čísla se objeví jakmile cechy mají %(num)s člen, takže malé cechy čísla nemohou ukazovat na jednu osobu."
msgstr[1] "Ukazují se jen počty, nikdy kdo. Day-by-day čísla se objeví jakmile cechy mají %(num)s členy, takže malé cechy čísla nemohou ukazovat na jednu osobu."
msgstr[2] "Ukazují se jen počty, nikdy kdo. Day-by-day čísla se objeví jakmile cechy mají %(num)s členů, takže malé cechy čísla nemohou ukazovat na jednu osobu."

#, machine, plain1
msgid "Only counts are shown. You never see who looked at a post or how anyone voted."
msgstr "Jsou uvedeny pouze počty. Nikdy nevidíte, kdo se díval na poštu nebo jak někdo hlasoval."

#, machine, plain1
msgid "Only counts are shown. You never see who tipped, who subscribed or who looked at a post."
msgstr "Jsou uvedeny pouze počty. Nikdy neuvidíte, kdo dal dýško, kdo se přihlásil nebo kdo se podíval na poštu."

#, machine, plain1
msgid "Only does something with \"The whole site\"."
msgstr "Dělá jen něco s \"Celá stránka\"."

#, machine, plain1
msgid "Only its members see this guild, and they post straight into it, so what they write does not appear on their own profiles."
msgstr "Pouze jeho členové vidí tento cech a přímo do něj vstupují, takže to, co napíšou, se neobjevuje na jejich profilech."

#, machine, plain1, python-format
msgid "Only links to %(sites)s."
msgstr "Pouze odkazy na %(sites)s."

#, machine, plain1
msgid "Only links to these sites"
msgstr "Pouze odkazy na tyto stránky"

#, machine, plain1, python-format
msgid "Only links to: \"%(address)s\" is not a site name. Write it like example.org"
msgstr "Pouze odkazy na: \"%(address)s\" není název stránky. Napište to jako example.org"

#, machine, plain1, python-format
msgid "Only links to: %(num)s site at most."
msgid_plural "Only links to: %(num)s sites at most."
msgstr[0] "Pouze odkazy na: maximálně %(num)s web."
msgstr[1] "Pouze odkazy na: maximálně %(num)s stránky."
msgstr[2] "Pouze odkazy na: nejvýše %(num)s stránek."

#, machine, plain1
msgid "Only me"
msgstr "Jen já"

#, machine, plain1, python-format
msgid "Only members of +%(guild)s can post in it."
msgstr "Pouze členové + %(guild)s mohou do něj vložit."

#, machine, plain1
msgid "Only people on stage can turn their camera on."
msgstr "Jen lidé na pódiu mohou zapnout kameru."

#, machine, plain1
msgid "Only people you follow who follow you back are listed. Downvotes are never shown."
msgstr "Jediní lidé, které sleduješ, kteří tě sledují, jsou na seznamu. Downvoice se nikdy neukazují."

#, machine, plain1, python-format
msgid "Only posts that mention %(words)s."
msgstr "Pouze příspěvky, které zmiňují %(words)s."

#, machine, plain1, python-format
msgid "Only posts that mention all of %(words)s."
msgstr "Pouze příspěvky, které zmiňují všechny %(words)s."

#, machine, plain1
msgid "Only public posts and comments count: not Circle posts or posts in private guilds, and not anything removed or deleted."
msgstr "Pouze veřejné příspěvky a připomínky se počítají: ne Circle příspěvky nebo příspěvky v soukromých cech, a ne nic odstraněny nebo smazány."

#, machine, plain1
msgid "Only someone in the call can be invited to speak."
msgstr "Jen někdo v hovoru může být pozván, aby promluvil."

#, machine, plain1
msgid "Only the author can see who upvoted."
msgstr "Pouze autor může vidět, kdo byl povýšen."

#, machine, plain1
msgid "Only the author can share this post"
msgstr "Pouze autor může sdílet tento příspěvek"

#, machine, plain1
msgid "Only the author can share this: it isn't public."
msgstr "Toto může sdílet pouze autor: není veřejné."

#, machine, plain1
msgid "Only the automation and its feeds go. Your account and its posts stay."
msgstr "Pouze automatizace a její kanály jdou. Váš účet a jeho příspěvky zůstávají."

#, machine, plain1
msgid "Only the channel's owner and helpers write in it."
msgstr "Jen majitel kanálu a pomocníci do něj píšou."

#, machine, plain1
msgid "Only the channel's owner chooses its helpers."
msgstr "Pouze majitel kanálu si vybírá pomocníky."

#, glossary, machine, plain2
msgid "Only the circles you pick"
msgstr "Jen kruhy, které vyberete"

#, machine, plain1
msgid "Only the founder sets the price."
msgstr "Jen zakladatel stanoví cenu."

#, machine, plain1
msgid "Only the group's owner and admins can add people."
msgstr "Pouze majitel a administrátoři skupiny mohou přidat lidi."

#, machine, plain1
msgid "Only the group's owner and admins can remove people."
msgstr "Pouze majitel a administrátoři skupiny mohou odstranit lidi."

#, machine, plain1
msgid "Only the group's owner and admins can rename it."
msgstr "Pouze majitel skupiny a administrátoři ji mohou přejmenovat."

#, machine, plain1
msgid "Only the guild name capitalization can be changed."
msgstr "Pouze gildské jméno kapitalizace může být změněn."

#, machine, plain1
msgid "Only the guild's founder can set the price."
msgstr "Jen zakladatel cechu může stanovit cenu."

#, machine, plain1
msgid "Only the guild's guildmasters and approved members can edit this page."
msgstr "Tuto stránku mohou upravovat pouze guildští moderátoři a schváleni členové."

#, machine, plain1
msgid "Only the guild's guildmasters can edit this page."
msgstr "Pouze guildští moderátoři mohou tuto stránku upravit."

#, machine, plain1
msgid "Only the guild's guildmasters can make new pages."
msgstr "Jen guildovi moderátoři mohou vytvořit nové stránky."

#, machine, plain1
msgid "Only the guild's guildmasters write in this channel."
msgstr "V tomhle kanálu píšou jen guildovi moderátoři."

#, machine, plain1
msgid "Only the host and co-hosts can edit the summary."
msgstr "Pouze hostitel a co- hosts mohou upravit shrnutí."

#, machine, plain1
msgid "Only the host and co-hosts can invite people to speak."
msgstr "Pouze hostitelé a spoluhostitelé mohou lidi pozvat, aby mluvili."

#, machine, plain1
msgid "Only the host and co-hosts can move people off the stage."
msgstr "Pouze hostitelé a spoluhostitelé mohou přesunout lidi z jeviště."

#, machine, plain1
msgid "Only the host and co-hosts can mute speakers."
msgstr "Pouze hostitelé a spoluhostitelé mohou ztlumit reproduktory."

#, machine, plain1
msgid "Only the host and co-hosts can post updates."
msgstr "Pouze hostitelé a spoluhostitelé mohou zveřejňovat aktualizace."

#, machine, plain1
msgid "Only the host and co-hosts can remove messages."
msgstr "Pouze hostitelé a spoluhostitelé mohou odstranit zprávy."

#, machine, plain1
msgid "Only the host and co-hosts can remove people."
msgstr "Pouze hostitelé a spoluhostitelé mohou lidi odstranit."

#, machine, plain1
msgid "Only the host and co-hosts can set slow mode."
msgstr "Pouze hostitelé a spoluhostitelé mohou nastavit pomalý režim."

#, machine, plain1
msgid "Only the host can choose co-hosts."
msgstr "Pouze hostitel si může vybrat spoluhostitele."

#, machine, plain1
msgid "Only the host can end this Space."
msgstr "Pouze hostitel může tento prostor ukončit."

#, machine, plain1
msgid "Only the host can remove a co-host."
msgstr "Pouze hostitel může odstranit spoluhostitele."

#, machine, plain1
msgid "Only the host can start this Space."
msgstr "Pouze hostitel může začít tento prostor."

#, machine, plain1
msgid "Only the numbers are shown: nobody sees who answered. You'll get a reminder an hour before."
msgstr "Pouze čísla jsou uvedeny: nikdo nevidí, kdo odpověděl. Připomenu ti to hodinu předtím."

#, machine, plain1
msgid "Only the owner can choose the admins."
msgstr "Pouze majitel si může vybrat administrátory."

#, machine, plain1
msgid "Only the owner can remove an admin."
msgstr "Pouze majitel může odstranit admin."

#, machine, plain1
msgid "Only the people in them see it, and nobody is told which of your circles they are in. It can't be anonymous, forwarded, reposted or co-authored, and it stays off All, search and trending."
msgstr "Jen lidé v nich to vidí, a nikdo neví, ve kterých kruzích jsou. Nemůže to být anonymní, přeposílané, převysílané nebo spoluautorské, a zůstává to mimo All, vyhledávání a trendy."

#, machine, plain1
msgid "Only the post's author and co-authors can edit the summary."
msgstr "Souhrn lze upravit pouze autorem a spoluautory pošty."

#, machine, plain1
msgid "Only the post's author and co-authors can end its live updates."
msgstr "Pouze autor a spoluautoři pošty mohou ukončit své živé aktualizace."

#, machine, plain1
msgid "Only the post's author and co-authors can extend its live updates."
msgstr "Pouze autor pošty a spoluautoři mohou rozšířit jeho živé aktualizace."

#, machine, plain1
msgid "Only the post's author and co-authors can post updates."
msgstr "Pouze autor pošty a spoluautoři mohou publikovat aktualizace."

#, machine, plain1
msgid "Only the post's author and co-authors can run its live updates."
msgstr "Pouze autor pošty a spoluautoři mohou spustit své živé aktualizace."

#, machine, plain1
msgid "Only used to check their age. It isn't kept."
msgstr "Jen jsem kontroloval jejich věk. Není to zachováno."

#, machine, plain1
msgid "Only when I turn them on"
msgstr "Jen když je zapnu"

#, machine, plain1
msgid "Only whoever forwarded this post and the guild's guildmasters can change its flair."
msgstr "Pouze ten, kdo předal tento post a cechovní moderátoři mohou změnit jeho označení."

#, machine, plain1
msgid "Only you"
msgstr "Jen ty"

#, machine, plain1
msgid "Only you can see this. These are counts: nobody who looked, voted or answered a poll is named."
msgstr "Jen ty to můžeš vidět. To jsou počty: nikdo, kdo se díval, hlasoval nebo odpověděl na průzkum není jmenován."

#, machine, plain2
msgid "Only your credit changes: the other authors stay named. Admins and the post's author can still see it is you."
msgstr "Pouze vaše úvěrové změny: ostatní autoři zůstávají jmenováni. Administrátoři a autor pošty stále vidí, že jste to vy."

