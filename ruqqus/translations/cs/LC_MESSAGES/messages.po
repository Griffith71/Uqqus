msgstr "Your bot @%(name)s Přestal číst %(url)s po %(fails)s selhaly pokusy: %(reason)s Spustit znovu z Nastavení > Boty, jakmile to funguje."

#, python-format
msgid "Your bot [@%(name)s](/@%(name)s) was approved. It starts posting within a few minutes. Manage it in [Settings > Bots](/settings/bots)."
msgstr ""

#, machine, plain1
msgid "Your bots"
msgstr "Tví roboti"

#, glossary, machine, plain2
msgid "Your channels"
msgstr "Vaše kanály"

#, machine, plain1
msgid "Your chat apps"
msgstr "Vaše chatovací aplikace"

#, machine, plain1
msgid "Your chat devices"
msgstr "Vaše chat zařízení"

#, machine, plain1
msgid "Your chat devices can't be listed right now."
msgstr "Vaše chat zařízení nemůže být uveden právě teď."

#, machine, plain2
msgid "Your chat encryption was started over. Messages from before can't be read on your devices unless a browser where you used chat brings them back. If this wasn't you, change your password in [Settings > Security](/settings/security)."
msgstr "Vaše šifrování chatu začalo znovu. Zprávy z minulosti nelze číst na vašich zařízeních, pokud prohlížeč, kde jste použili chat, nepřinese zpět. Pokud jste to nebyli vy, změňte heslo v [Nastavení > Bezpečnost] (/settings/security)."

#, machine, plain1
msgid "Your chats and their keys have been removed from this browser."
msgstr "Vaše rozhovory a jejich klíče byly odstraněny z tohoto prohlížeče."

#, machine, plain1
msgid "Your chats are end-to-end encrypted, and the site can't read them. The key that opens them is kept locked: once with your password, and once with the recovery code you saved when chat was set up. If you forget your password, that code is the only way to read your old messages after a reset."
msgstr "Vaše rozhovory jsou až do konce zašifrované a stránky je nemohou přečíst. Klíč, který je otevře, je uzamčen: jednou heslem a jednou vráceným kódem, který jste uložili při navázání chatu. Pokud zapomenete heslo, tento kód je jediný způsob, jak číst staré zprávy po resetu."

#, machine, plain1, python-format
msgid "Your chats run on Matrix, an open standard, on %(site)s's own chat server. Besides Chat on this site, you can use them in a Matrix app such as Element (web, desktop and the classic phone apps), FluffyChat or Cinny. They stay end-to-end encrypted there too."
msgstr "Vaše rozhovory běží na Matrixu, otevřeném standardu, na vlastním chat serveru %(site)s. Kromě Chat na těchto stránkách je můžete použít v aplikaci Matrix jako Element (web, desktop a klasické telefonní aplikace), FluffyChat nebo Cinny. Zůstanou tam i zašifrované."

#, machine, plain1
msgid "Your child accounts will be deleted with yours."
msgstr "Vaše dětské účty budou smazány s vašimi."

#, glossary, machine, plain2
msgid "Your circles"
msgstr "Vaše kruhy"

#, machine, plain1, python-format
msgid "Your circles - %(site)s"
msgstr "Vaše kruhy - %(site)s"

#, machine, plain1
msgid "Your commenting history will show here."
msgstr "Vaše historie komentářů se ukáže zde."

#, machine, plain2
msgid "Your credit on this post is anonymous: other members see it as \"Anonymous #N\". Admins and the post's author can still see it is yours. This can't be undone."
msgstr "Vaše zásluhy na tomto příspěvku jsou anonymní: ostatní členové to vidí jako \"Anonymous #N\". Administrátoři a autor pošty stále vidí, že je váš. Tohle se nedá vrátit."

#, machine, plain1
msgid "Your curations"
msgstr "Vaše kurátory"

#, machine, plain1
msgid "Your custom filters have been updated"
msgstr "Vaše vlastní filtry byly aktualizovány"

#, machine, plain1
msgid "Your custom filters have been updated."
msgstr "Vaše vlastní filtry byly aktualizovány."

#, machine, plain1
msgid "Your database gnome took too long looking up your question. He's been.... dealt with."
msgstr "Vaše databáze Gnome trvalo příliš dlouho podívat se na vaši otázku. Byl... vyřešen."

#, machine, plain1
msgid "Your display name has been removed."
msgstr "Vaše jméno bylo odstraněno."

#, machine, plain1
msgid "Your display name has been updated."
msgstr "Vaše jméno bylo aktualizováno."

#, machine, plain1
msgid "Your drafts and scheduled posts"
msgstr "Vaše návrhy a plánovaná místa"

#, machine, plain1
msgid "Your email"
msgstr "Váš e-mail"

#, machine, plain1, python-format
msgid "Your email %(email)s has been verified. Thank you."
msgstr "Váš e-mail %(email)s byl ověřen. Děkuji."

#, machine, plain1, python-format
msgid "Your feedback was marked fixed: \"%(excerpt)s\""
msgstr "Vaše zpětná vazba byla opravena: \"%(excerpt)s\""

#, machine, plain1, python-format
msgid "Your feedback was marked fixed: \"%(excerpt)s\". Our response: %(response)s"
msgstr "Vaše zpětná vazba byla opravena: \"%(excerpt)s\". Naše odpověď: %(response)s"

#, machine, plain1
msgid "Your followers"
msgstr "Tví následovníci"

#, machine, plain1
msgid "Your guilds"
msgstr "Vaše cechy"

#, machine, plain1
msgid "Your inquiry has been saved."
msgstr "Vaše vyšetřování bylo zachráněno."

#, machine, plain1
msgid "Your language"
msgstr "Váš jazyk"

#. the English uses "sign-ins" for every number
#, python-format
msgid "Your last %(num)s sign-ins. The place is only the country, worked out from the connection. Don't recognise one? Change your password: that signs out every other device."
msgid_plural "Your last %(num)s sign-ins. The place is only the country, worked out from the connection. Don't recognise one? Change your password: that signs out every other device."
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#, machine, plain1
msgid "Your media storage is no longer connected."
msgstr "Vaše média už nejsou připojena."

#, machine, plain1
msgid "Your media storage needs connecting again."
msgstr "Vaše mediální úložiště potřebuje znovu připojit."

#, python-format
msgid "Your membership of [+%(guild)s](/+%(guild)s) ended: you didn't have the %(coins)s coins it renews for. You can join again from its page."
msgstr ""

#, machine, plain1
msgid "Your membership will renew again."
msgstr "Vaše členství bude obnoveno."

#, machine, plain1
msgid "Your membership won't renew. You keep access until the day you paid to."
msgstr "Vaše členství se neobnoví. Máte přístup až do dne, kdy jste zaplatil."

#, machine, plain1
msgid "Your message includes a word this guild doesn't allow."
msgstr "Vaše zpráva obsahuje slovo, které tento cech nedovoluje."

#, machine, plain1
msgid "Your new backup codes are below. The old ones no longer work."
msgstr "Vaše nové záložní kódy jsou níže. Ty staré už nefungují."

#, machine, plain1
msgid "Your new custom RSS Feed Token has been generated."
msgstr "Váš nový zvyk RSS Krmivo Token bylo vytvořeno."

#, machine, plain1
msgid "Your new key. Copy it now: it is not shown again."
msgstr "Tvůj nový klíč. Zkopírujte to: není znovu zobrazeno."

#, machine, plain1, python-format
msgid "Your original username will always stay reserved for you: <code>%(name)s</code>"
msgstr "Vaše původní uživatelské jméno bude vždy vyhrazeno pro vás: <code>%(name)s</code>"

#, machine, plain2
msgid "Your other devices have been signed out."
msgstr "Vaše další zařízení byla odpojena."

#, machine, plain1
msgid "Your own circles"
msgstr "Vaše vlastní kruhy"

#. %(who)s is the @handle of the account being added, filled in by the page
#, machine, plain1, python-format
msgid "Your own circles. %(who)s is not told."
msgstr "Vaše vlastní kruhy. %(who)s není řečeno."

#, machine, plain1
msgid "Your own mix"
msgstr "Tvůj vlastní mix"

#, python-format
msgid "Your own mix ranks the newest %(num)s matching post. 0 switches a part off, 10 makes it count the most."
msgid_plural "Your own mix ranks the newest %(num)s matching posts. 0 switches a part off, 10 makes it count the most."
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#, machine, plain1
msgid "Your own password"
msgstr "Vaše vlastní heslo"

#, machine, plain1
msgid "Your parent or guardian didn't agree to release your account."
msgstr "Váš rodič nebo poručník nesouhlasil s uvolněním vašeho účtu."

#, machine, plain1
msgid "Your parent or guardian has been asked to release your account. Nothing changes until they answer."
msgstr "Váš rodič nebo opatrovník byl požádán o uvolnění vašeho účtu. Nic se nezmění, dokud neodpoví."

#, machine, plain1
msgid "Your parent or guardian has turned this off for your account."
msgstr "Váš rodič nebo opatrovník to vypnul kvůli vašemu účtu."

#, machine, plain1
msgid "Your parent or guardian made this account for you. They can see what you do on the site (your posts, comments, votes, bookmarks, follows, guilds, who you chat with, that your account was reported and your recent sign-ins; the site never shows them what your chats say) and they choose which features are on. You can see which in [Settings > Content](/settings/content). They chose your password: change it in [Settings > Security](/settings/security) so that only you know it, because anyone who knows it can sign in as you and read your chats."
msgstr "Váš rodič nebo opatrovník vám udělal tento účet. Mohou vidět, co děláte na webových stránkách (vaše příspěvky, komentáře, hlasy, záložky, následuje, cechy, s kým si povídáte, že váš účet byl nahlášen a vaše nedávné signály, web nikdy ukazuje jim, co vaše chaty říkají) a oni si vybrat, které funkce jsou na. Můžete vidět, který z [Nastavení > Obsah] (/settings/content). Zvolili si vaše heslo: změňte ho v [Nastavení > Bezpečnost] (/settings/security), abyste to věděli pouze vy, protože každý, kdo to zná, se může přihlásit jako vy a přečíst si vaše rozhovory."

#, machine, plain2
msgid "Your parent or guardian set a new password for your account and you were signed out. Sign in with the new password, then change it in [Settings > Security](/settings/security) so that only you know it."
msgstr "Váš rodič nebo opatrovník nastavil pro váš účet nové heslo a byl jste odpojen. Přihlaste se s novým heslem a pak jej změňte v [Nastavení > Bezpečnost] (/settings/security), abyste ho znali pouze vy."

#, machine, plain1
msgid "Your parent or guardian stopped managing your account. It keeps the child lock until you confirm your age in Settings > Content. They chose your password: change it in [Settings > Security](/settings/security), or they can still sign in as you."
msgstr "Váš rodič nebo poručník přestal spravovat váš účet. Udržuje dětský zámek, dokud nepotvrdíte svůj věk v Nastavení > Obsah. Zvolili si vaše heslo: změnit jej v [Nastavení > Bezpečnost] (/settings/security), nebo se mohou přihlásit jako vy."

#, machine, plain1
msgid "Your parent or guardian's account was suspended, so yours is suspended until theirs is back."
msgstr "Váš rodič nebo opatrovník byl suspendován, takže váš je suspendován, dokud se nevrátí."

#, machine, plain1
msgid "Your password"
msgstr "Vaše heslo"

#, machine, plain2
msgid "Your password has been changed. Your other devices have been signed out."
msgstr "Vaše heslo bylo změněno. Vaše další zařízení byla odpojena."

#, machine, plain1
msgid "Your password meets the requirements."
msgstr "Vaše heslo splňuje požadavky."

#, machine, plain1
msgid "Your payouts"
msgstr "Vaše výplaty"

#, machine, plain1
msgid "Your phone approved this. Only continue if this is your account."
msgstr "Váš telefon to schválil. Pokračujte, pokud je to váš účet."

#, machine, plain1
msgid "Your phone said no, so nobody was signed in."
msgstr "Váš telefon řekl ne, takže nikdo nebyl zapsán."

#, machine, plain1
msgid "Your post is listed on your profile either way. Choose My profile to have its comments there too, and add guilds to post it straight into them: each guild gets its own copy with its own votes and comments."
msgstr "Váš příspěvek je na vašem profilu tak jako tak. Vyberte Můj profil, aby se jeho komentáře tam také, a přidat cechy, aby ji přímo do nich: každý cech dostane svou vlastní kopii s vlastními hlasy a komentáři."

#, machine, plain1
msgid "Your posting history will show here."
msgstr "Vaše historie vysílání se ukáže zde."

#, machine, plain1
msgid "Your posts are kept out of All."
msgstr "Vaše pozice jsou mimo All."

#, machine, plain1
msgid "Your posts can appear in All."
msgstr "Vaše příspěvky se mohou objevit v All."

#, machine, plain1
msgid "Your posts from the last 28 days, with what each got (a post and its guild forwards added up). Only you can see this; these are counts, never names."
msgstr "Vaše příspěvky z posledních 28 dní, s tím, co každý dostal (příspěvek a jeho cechy dopředu sečteny). Jen vy to vidíte; to jsou počty, nikdy jména."

#, machine, plain1
msgid "Your posts stay on your profile and in the feeds of people who follow you, but All leaves them out. Copies you forward to a guild follow that guild's own setting, and anonymous posts always appear in All, so nobody can tell which ones are yours."
msgstr "Vaše příspěvky zůstávají na vašem profilu a v obrazech lidí, kteří vás sledují, ale všichni je vynechají. Kopíruje vás do cechu, následujte jeho vlastní nastavení, a anonymní příspěvky se vždy objeví ve Všech, takže nikdo neví, které jsou vaše."

#, machine, plain1
msgid "Your profile"
msgstr "Váš profil"

#, machine, plain1
msgid "Your profile details have been updated."
msgstr "Váš profil byl aktualizován."

#, machine, plain1
msgid "Your purchase was successful. A receipt will be emailed to you from Paypal."
msgstr "Váš nákup byl úspěšný. Účtenka vám bude zaslána z Paypal."

#, machine, plain1
msgid "Your roles"
msgstr "Vaše role"

#. a notification. %(title)s is the post's title; %(reason)s says why, as a
#. sentence starting in lowercase.
#, machine, plain1, python-format
msgid ""
"Your scheduled post \"%(title)s\" could not be published: %(reason)s\n"
"\n"
"It is saved in your drafts, so you can fix it and post it or schedule it again."
msgstr ""
"Vaše plánovaná pošta \"%(title)s\" nemohla být zveřejněna: %(reason)s\n"
"\n"
"Je uložen ve vašich návrzích, takže ho můžete opravit a odeslat nebo naplánovat znovu."

#. a notification about a post with no title. %(reason)s says why, as a
#. sentence starting in lowercase.
#, machine, plain1, python-format
msgid ""
"Your scheduled post \"Untitled\" could not be published: %(reason)s\n"
"\n"
"It is saved in your drafts, so you can fix it and post it or schedule it again."
msgstr ""
"Váš plánovaný post \"Untitled\" nemohl být publikován: %(reason)s\n"
"\n"
"Je uložen ve vašich návrzích, takže ho můžete opravit a odeslat nebo naplánovat znovu."

#, machine, plain1
msgid "Your security key"
msgstr "Váš bezpečnostní klíč"

#, machine, plain1
msgid "Your settings have been updated."
msgstr "Vaše nastavení bylo aktualizováno."

#, python-format
msgid "Your shared draft couldn't be published: %(error)s [Open the draft](%(link)s)"
msgstr ""

#, machine, plain1
msgid "Your shared drafts"
msgstr "Vaše společné návrhy"

#, machine, plain1, python-format
msgid "Your siege failed. One of the guildmasters created or edited a comment in +%(guild)s within the last 60 days. You may try again in 7 days."
msgstr "Vaše žádost o převzetí selhala. Jeden z moderátorů cechu vytvořil nebo upravil komentář v + %(guild)s během posledních 60 dnů. Můžete to zkusit znovu za 7 dní."

#, machine, plain1, python-format
msgid "Your siege failed. One of the guildmasters had a post forwarded to +%(guild)s, or edited one there, within the last 60 days. You may try again in 7 days."
msgstr "Vaše žádost o převzetí selhala. Jeden z moderátorů z cechu poslal příspěvek na +%(guild)s, nebo upravil jeden tam, v posledních 60 dnech. Můžete to zkusit znovu za 7 dní."

#, machine, plain1, python-format
msgid "Your siege failed. One of the guildmasters has performed a mod action in +%(guild)s within the last 60 days. You may try again in 7 days."
msgstr "Vaše žádost o převzetí selhala. Jeden z moderátorů cechu provedl v +%(guild)s během posledních 60 dnů. Můžete to zkusit znovu za 7 dní."

#, machine, plain1
msgid "Your story is up for 24 hours."
msgstr "Váš příběh trvá 24 hodin."

#. %(circle)s is the name of a paid circle someone subscribed to
#, python-format
msgid "Your subscription to %(circle)s by [@%(name)s](/@%(name)s) ended: you didn't have the %(coins)s coins it renews for. You can subscribe again from their profile."
msgstr ""

#, machine, plain1
msgid "Your subscription will renew again."
msgstr "Vaše předplatné bude obnoveno."

#, machine, plain1
msgid "Your subscription won't renew. You keep access until the day you paid to."
msgstr "Vaše předplatné se neobnoví. Máte přístup až do dne, kdy jste zaplatil."

#, machine, plain1
msgid "Your subscriptions"
