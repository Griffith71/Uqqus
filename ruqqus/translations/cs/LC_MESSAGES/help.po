msgstr[0] "`cursor`: jakýkoli text do %(num)s znaků, který vám umožní pokračovat. Nech to být, když už nic není."
msgstr[1] "`cursor`: jakýkoli text až %(num)s znaky, které vám umožní pokračovat. Nech to být, když už nic není."
msgstr[2] "`cursor`: jakýkoli text do %(num)s znaků, který vám umožní pokračovat. Nech to být, když už nic není."

#. the word in quotes is a value the application sends as it is: keep it in
#. English.
#, machine, plain1
msgid "`grant_type` - Set to the word \"code\""
msgstr "`grant_type` - Nastavte slovo \"kód\""

#. the word in quotes is a value the application sends as it is: keep it in
#. English.
#, machine, plain1
msgid "`grant_type` - set to the word \"refresh\""
msgstr "`grant_type` - nastavte slovo \"refresh\""

#, machine, plain1
msgid "`permanent` - optional. Set to `true` if you are requesting indefinite access. Omit if not."
msgstr "`permanent` - volitelné. Nastavte na `true`, pokud požadujete neomezený přístup. Omit, pokud ne."

#. keep the code between backticks exactly as it is
#, python-format
msgid "`posts`: up to %(num)s post ids. A post's id is the short code in its address: `/post/2k1/a-title` is `2k1`."
msgid_plural "`posts`: up to %(num)s post ids. A post's id is the short code in its address: `/post/2k1/a-title` is `2k1`."
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#, machine, plain1
msgid "`redirect_uri` - The redirect URI (or one of the URIs) specified in your application information. Must not use HTTP unless using localhost (use HTTPS instead)."
msgstr "`redirect_uri` - Přesměrování URI (nebo některé z URI) uvedené ve vašich aplikačních informacích. Nepoužívat HTTP, pokud místo toho nepoužíváte localhost (použijte HTTPS)."

#, machine, plain1
msgid "`refresh_token` - the refresh token which you obtained during Step 3"
msgstr "`refresh_token` - refresh token, který jste získali během kroku 3"

#, machine, plain1
msgid "`scope` - A comma-separated list of permission scopes that you are requesting. Valid scopes are: `identity`, `create`, `read`, `update`, `delete`, `vote`, and `guildmaster`."
msgstr "`scope` Platné senzory jsou: `identity`, `create`, `read`, `update`, `delete`, `vote` a `guildmaster`."

#, machine, plain1
msgid "`state` - The state token from earlier."
msgstr "`state` - Ten státní znak z dřívějška."

#, machine, plain1
msgid "`state` - This is your own anti-cross-site-forgery token. We don't do anything with this, except give it to the user to pass back to you later. You are responsible for generating and validating the state token."
msgstr "`state` Tohle je tvůj vlastní znak proti padělání. Neděláme s tím nic, kromě toho, že to dáme uživateli, aby vám to pak vrátil. Jste zodpovědný za generování a validaci státního znaku."

#, machine, plain1
msgid "a Redirect URI, or a comma-separated list of redirect URIs. May not use HTTP unless using localhost (use HTTPS instead)."
msgstr "redirect URI, nebo comma- oddělený seznam přesměrovaných URI. Nepoužívejte HTTP, pokud místo toho nepoužíváte localhost (použijte HTTPS)."

