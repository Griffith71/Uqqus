#, machine, plain1, python-format
msgid "Your siege failed. One of the guildmasters created or edited a comment in +%(guild)s within the last 60 days. You may try again in 7 days."
msgstr "Zure eskakizunek huts egin dute. Moderatzaile batek iruzkin bat sortu edo editatu du +-n%(guild)s Azken 60 egunetan. 7 egun barru berriro saiatuko zara."

#, machine, plain1, python-format
msgid "Your siege failed. One of the guildmasters had a post forwarded to +%(guild)s, or edited one there, within the last 60 days. You may try again in 7 days."
msgstr "Zure eskakizunek huts egin dute. Guild moderatzaileetako batek +%(guild)s(e)rako posta bat bidali du edo azken 60 egunetan editatu du. 7 egun barru berriro saiatuko zara."

#, machine, plain1, python-format
msgid "Your siege failed. One of the guildmasters has performed a mod action in +%(guild)s within the last 60 days. You may try again in 7 days."
msgstr "Zure eskakizunek huts egin dute. Azken 60 egunetan moderatzaile-ekintza bat egin du +%(guild)s-n. 7 egun barru berriro saiatuko zara."

