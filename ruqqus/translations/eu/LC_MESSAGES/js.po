#, machine, plain1
msgid "Your key can't be shown right now."
msgstr "Zure gakoa ezin da orain erakutsi."

#, machine, plain1
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "Zure gakoa pasahitz zahar batekin blokeatuta zegoen. Ireki berriketa gune honetan eta sartu berreskuratzeko kodea behin; gero hemen irekiko da."

#, machine, plain1, python-format
msgid "Your message will be sent once chat is unlocked on this device."
msgid_plural "Your %(num)s messages will be sent once chat is unlocked on this device."
msgstr[0] "Zure mezua bidaliko da gailu honetan berriketa desblokeatu ondoren."
msgstr[1] "Zure %(num)s mezuak bidaliko dira gailu honetan berriketa desblokeatu ondoren."

#, machine, plain2
msgid "Your name will show on this comment. Your own words can still give away that you wrote the post, and a comment under your name is not linked to the post by anything we show."
msgstr "Zure izena azalduko da iruzkin honetan. Zure hitzek oraindik ere eman dezakete mezua idatzi duzula, eta zure izenean egindako iruzkin bat ez dago lotuta guk erakusten dugunarekin."

#, machine, plain2
msgid "Your old recovery code no longer works."
msgstr "Zure berreskuratze-kode zaharrak ez du funtzionatzen."

#, machine, plain1
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "Zure pasahitza aldatu egin da berriketa-gako hau blokeatu zenetik. Berriketa hastean gorde zenuen berreskuratzeko kodea irekitzen da."

#, machine, plain1
msgid "Your password was changed for you, so chat is starting again here."
msgstr "Zure pasahitza aldatu da, beraz, berriketa hemen hasten da berriro."

#, machine, plain1
msgid "Your password was changed, so chat is starting again here."
msgstr "Zure pasahitza aldatu da, beraz, berriketa hemen hasten da berriro."

#, machine, plain1
msgid "Your password was reset, so chat is starting again here."
msgstr "Zure pasahitza berrezarri da, beraz, berriketa hemen hasten da berriro."

#, machine, plain1
msgid "Your recovery code"
msgstr "Zure berreskuratze-kodea"

#, machine, plain1
msgid "Your saved templates show up here."
msgstr "Gordetako txantiloiak hemen agertzen dira."

#, machine, plain2
msgid "Your screen can be shared only while you're on video in this call."
msgstr "Pantaila bakarrik parteka daiteke dei honetan bideoan zauden bitartean."

#, machine, plain2
msgid "Your screen couldn't be shared."
msgstr "Ezin izan da pantaila partekatu."

#, machine, plain1
msgid "Your settings have been updated."
msgstr "Zure ezarpenak eguneratu egin dira."

#, machine, plain1
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "Zure biltegiak berriro konektatu behar du. Bidali audioa hona:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your pictures to:"
msgstr "Zure biltegiak berriro konektatu behar du. Bidali zure argazkiak hona:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your videos to:"
msgstr "Zure biltegiak berriro konektatu behar du. Bidali zure bideoak hona:"

