msgctxt "verb"
msgid "Discuss"
msgstr "Eztabaida"

#, machine, plain1
msgid "Displays as"
msgstr "Bistaratu honela"

#, machine, plain1
msgid "Do not alter the title, text, or meaning of the content."
msgstr "Ez aldatu edukiaren titulua, testua edo esanahia."

#, machine, plain1
msgid "Do not display logos against a textured background."
msgstr "Ez erakutsi logotipoak testuratutako atzeko planoaren aurka."

#, machine, plain1
msgid "Do not modify the brand assets or use modified versions found elsewhere."
msgstr "Ez aldatu markaren aktiboak edo ez erabili beste inon aurkitutako bertsio aldatuak."

