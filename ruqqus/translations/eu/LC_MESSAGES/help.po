msgid "%(company)s may revoke your License at any time and for any reason."
msgstr "%(company)s(e)k zure Lizentzia edozein unetan eta edozein arrazoirengatik errebokatu dezake."

#, machine, plain1, python-format
msgid "%(curation)s: a public curation, by its name or the short name under it. Search %(curation)s to find them; <code>%(in_curation)s</code> narrows a post search to that curation's guilds and accounts. Private curations are never found."
msgstr "%(curation)sPublikoki zaindutako iturri bat, bere izenagatik edo izen laburragatik. Bilatu %(curation)s aurkitzeko; <code>%(in_curation)s</code> post-bilaketa bat estutzen du elikadura zainduaren koipe eta kontuetarako. Ez da inoiz aurkitu sendakuntza pribaturik."

