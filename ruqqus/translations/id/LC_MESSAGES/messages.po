msgstr "Peran %(role)s dibuat."

#, machine, plain1, python-format
msgid "The role %(role)s was saved."
msgstr "Peran %(role)s disimpan."

#, machine, plain1
msgid "The royal bank has told us that you owe them some coin. You'll need to pay off your debts before you can continue."
msgstr "Bank kerajaan telah mengatakan kepada kami bahwa Anda berutang mereka beberapa koin. Kau harus melunasi hutangmu sebelum kau bisa melanjutkan."

#, machine, plain1
msgid "The rules"
msgstr "Aturan"

#, machine, plain1
msgid "The rules below"
msgstr "Aturan di bawah"

#, machine, plain1, python-format
