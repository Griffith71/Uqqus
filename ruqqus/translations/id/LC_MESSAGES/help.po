msgid "To request ruqqus API keys, visit [this page](/help/apps)"
msgstr "Untuk meminta kunci ruqqus API, kunjungi [halaman ini] (/help/apps)"

#, machine, plain1
msgid "To search for the words themselves, put them in quotes: <code>\"#gaming\"</code>."
msgstr "Untuk mencari kata-kata itu sendiri, masukkan dalam tanda kutip: <code>\"#gaming\"</code>."

#, machine, plain1, python-format
msgid "To use the access token, include the following header in subsequent API requests to %(site)s: `Authorization: Bearer access_token_goes_here`"
msgstr "Untuk menggunakan token akses, sertakan header berikut dalam permintaan berikutnya API ke %(site)s: `Authorization: Bearer access_token_goes_here`"

