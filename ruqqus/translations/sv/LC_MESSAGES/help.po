#, machine, plain1, python-format
msgid "\"%(site)s\" is pronounced identically to the standard English word \"ruckus\""
msgstr "\"%(site)s\" uttalas identiskt till det vanliga engelska ordet \"ruckus\""

#, machine, plain1
msgid "\"Ruqqie\" is pronounced \"RUCK-ee\""
msgstr "\"Ruqqie\" uttalas \"RUCK-ee\""

#. a cryptocurrency's name, then the word for the address to send it to.
#, machine, plain1, python-format
msgid "%(coin)s Address"
msgstr "%(coin)s Adress"

#, machine, plain1, python-format
msgid "%(coin)s receiving address QR code"
msgstr "%(coin)s mottagande adress QR kod"

#, machine, plain1, python-format
msgid "%(company)s is outside your jurisdiction. Sucks to be you."
msgstr "%(company)s utanför din jurisdiktion. Sucks to be you."

#, machine, plain1, python-format
msgid "%(company)s is, always has been, and always will be 100%% outside your jurisdiction. You must obtain legal process that is valid in the state of New Hampshire. Then, submit your United States legal process document to our [legal requests portal](/legal)."
msgstr "%(company)s är, alltid har varit, och kommer alltid att vara 100 %% utanför din jurisdiktion. Du måste få juridisk process som är giltig i delstaten New Hampshire. Skicka sedan in ditt amerikanska rättsprocessdokument till vår [rättsliga förfrågningsportal](/legal)."

#, machine, plain1, python-format
msgid "%(company)s may revoke your License at any time and for any reason."
msgstr "%(company)s kan återkalla din licens när som helst och av någon anledning."

#, machine, plain1, python-format
msgid "%(curation)s: a public curation, by its name or the short name under it. Search %(curation)s to find them; <code>%(in_curation)s</code> narrows a post search to that curation's guilds and accounts. Private curations are never found."
msgstr "%(curation)sEtt offentligt kurerat foder, med dess namn eller kortnamn under det. Sök efter Sök %(curation)s att finna dem, <code>%(in_curation)s</code> begränsar en postsökning till det kurerade fodrets skulder och konton. Privata kurerade flöden finns aldrig."

#, machine, plain1, python-format
msgid "%(site)s - Contact"
msgstr "%(site)s - Kontakt"

#, machine, plain1, python-format
msgid "%(site)s - FAQ"
msgstr "%(site)s - FAQ"

