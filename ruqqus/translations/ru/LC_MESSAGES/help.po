#, machine, plain1
msgid "`redirect_uri` - The redirect URI (or one of the URIs) specified in your application information. Must not use HTTP unless using localhost (use HTTPS instead)."
msgstr "`redirect_uri` - Перенаправление URI (или одно из URI), указанное в информации о вашем приложении. Не использовать HTTP, если не использовать локальный хост (использовать HTTPS)."

#, machine
msgid "`refresh_token` - the refresh token which you obtained during Step 3"
msgstr "`refresh_token` - маркер обновления, который вы получили во время Шага 3"

#, machine
msgid "`scope` - A comma-separated list of permission scopes that you are requesting. Valid scopes are: `identity`, `create`, `read`, `update`, `delete`, `vote`, and `guildmaster`."
msgstr "`scope` - Отдельный список разрешений, которые вы запрашиваете. Действительные области: `identity`, `create`, `read`, `update`, `delete`, `vote` и `guildmaster`."

#, machine
msgid "`state` - The state token from earlier."
msgstr "`state` — государственный токен от более раннего."

#, machine
msgid "`state` - This is your own anti-cross-site-forgery token. We don't do anything with this, except give it to the user to pass back to you later. You are responsible for generating and validating the state token."
msgstr "`state` - Это ваш собственный токен против подделки сайта. Мы ничего не делаем с этим, за исключением того, чтобы дать его пользователю, чтобы передать вам позже. Вы несете ответственность за создание и проверку государственного токена."

#, machine, plain1
msgid "a Redirect URI, or a comma-separated list of redirect URIs. May not use HTTP unless using localhost (use HTTPS instead)."
msgstr "перенаправление URI, или разделённый запятой список перенаправления URI. Не использовать HTTP, если не использовать локальный хост (использовать HTTPS)."

