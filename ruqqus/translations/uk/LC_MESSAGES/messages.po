#, machine, plain1, python-format
msgid "<strong>P.S.</strong> Feel free to tweet at us on Twitter <a href=\"%(url)s\">%(handle)s</a>."
msgstr "<strong>П.С.</strong> Ми можемо самі зателефонувати одержувачу і узгодити зручний час і місце вручення <a href=\"%(url)s\">%(handle)s</a>й"

#, machine, plain1, python-format
msgid "<strong>Place:</strong> %(place)s (the country only, from the connection)"
msgstr "<strong>Місце проведення:</strong> %(place)s (тільки країна, з'єднання)"

#, machine, plain1
msgid "<strong>Read and write:</strong> your chats, groups, channels for circles and encrypted guild channels."
msgstr "<strong>Читати і писати:</strong> ваших чатів, груп, каналів для колів і зашифрованих прохідних каналів."

#, machine, plain1
msgid "<strong>Read only:</strong> public channels and other guild channels. Their messages go through the site's word filter and rules, so a message written there from an app is removed: write those on this site."
msgstr "<strong>Детальніше:</strong> публічні канали та інші прохідні канали. Повідомлень пройдуть через текстовий фільтр і правила сайту, тому повідомлення, написане ним з програми, знімається: напишіть ті на цьому сайті."

#, machine, plain1
msgid "<strong>Site bot</strong>: free feeds only. Once approved it is the site's: the admins run it and it is not linked to you."
msgstr "<strong>Веб-сайт</strong>: безкоштовні корми тільки. Після того, як це було схвалено: адміністратори запускають його і не пов'язані з вами."

