#, machine, plain1, python-format
msgid "A proposal to publish in a shared draft closed undecided. [Open the draft](%(link)s)"
msgstr "Пропозиція для публікації у спільному проекті закритого не визначилися. [Відкрити проект](%(link)s)"

#, machine, plain1, python-format
msgid "A proposal to publish in a shared draft didn't pass. [Open the draft](%(link)s)"
