#, machine, plain1, python-format
msgid "Titles can be %(count)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "Titles can be %(count)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Заголовки можуть бути символи %(count)s (Китайський, японський та корейський символи та список смайликів як 2)."
msgstr[1] "Без назви може бути %(count)s символи (китайська, японська та корейська символи та кількість смайликів як 2)."
msgstr[2] "Без назви може бути %(count)s символи (китайська, японська та корейська символи та кількість смайликів як 2)."

#, machine, plain1, python-format
msgid "Titles change the way your name is displayed across %(site)s, allowing you to show off a site achievement."
msgstr "Заголовки змініть спосіб Ваше ім'я відображається через %(site)s, дозволяючи вам показати досягнення сайту."

#, machine, plain1
msgctxt "end date"
msgid "To"
