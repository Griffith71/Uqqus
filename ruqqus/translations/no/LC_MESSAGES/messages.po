msgid_plural "A poll needs at least %(num)s options."
msgstr[0] "En undersøkelse trenger minst ett alternativ."
msgstr[1] "En undersøkelse trenger minst %(num)s alternativer."

#, machine, plain1, python-format
msgid "A poll option can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A poll option can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Et meningsmålingsalternativ kan være %(num)s tegn (kinesisk, japansk og koreanske tegn og emoji teller som 2)."
msgstr[1] "En meningsmåling alternativ kan være %(num)s tegn (kinesisk, japansk og koreanske tegn og emoji teller som 2)."

#, machine, plain1
