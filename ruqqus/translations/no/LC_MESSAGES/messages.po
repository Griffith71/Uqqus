"Your %(site)s account has been permanently suspended for the following reason:\n"
"\n"
"> ban evasion"
msgstr ""
"%(site)s-kontoen din er permanent suspendert av følgende grunn:\n"
"\n"
"Forbudsunndragelse"

#, machine, plain1, python-format
msgid "Your %(site)s account has been reinstated. Please carefully review and abide by the [terms of service](/help/terms) and [rules and guidelines](/help/rules) to ensure that you don't get suspended again."
msgstr "Din %(site)s-konto er gjeninnført. Vennligst gjennomfør nøye og følg servicefristene (/help/terms) og [regler og retningslinjer](/help/rules) for å sikre at du ikke blir suspendert igjen."

#, machine, plain1, python-format
msgid "Your %(site)s account has been suspended for %(days)s days due to a Terms of Service violation."
msgstr "Din %(site)s Kontoen er suspendert for %(days)s dager på grunn av et brudd på tjenesten."

#, machine, plain1, python-format
msgid ""
"Your %(site)s account has been suspended for %(days)s days for the following reason:\n"
"\n"
"> %(message)s"
msgstr ""
"Din %(site)s Kontoen er suspendert for %(days)s dager av følgende grunn:\n"
"\n"
"> %(message)s"

#, machine, plain1, python-format
msgid ""
"Your %(site)s account has been suspended for 1 day for the following reason:\n"
"\n"
"> Too much spam!"
msgstr ""
"%(site)s-kontoen din har blitt suspendert i 1 dag av følgende grunn:\n"
"\n"
"For mye spam!"

#, machine, plain1, python-format
msgid "Your %(site)s password"
msgstr "Ditt %(site)s passord"

#, machine, plain1
msgid "Your API Applications"
msgstr "Ditt API Søknader"

#, machine, plain1
msgid "Your Authorized Applications"
msgstr "Dine autoriserte programmer"

#, machine, plain1
msgid "Your Following feed is empty"
msgstr "Følgende feed er tomt"

#, machine, plain1
msgid "Your For You feed has been reset."
msgstr "Din For You feed har blitt tilbakestilt."

#, machine, plain1
msgid "Your Google Drive is full. Free some space and try again."
msgstr "Din Google Drive er full. Frigjør litt plass og prøv igjen."

#, machine, plain1
msgid "Your ID is verified so you can't change your username."
msgstr "ID-en din er verifisert slik at du ikke kan endre brukernavnet ditt."

#, machine, plain1
msgid "Your OneDrive is full. Free some space and try again."
msgstr "Din OneDrive er full. Frigjør litt plass og prøv igjen."

#, machine, plain1
msgid "Your Profile"
msgstr "Din profil"

#, machine, plain1
msgid "Your RSS feed address"
msgstr "Din RSS-feed adresse"

#, machine, plain1
msgid "Your Subscribed Users"
msgstr "Dine Abonnerte brukere"

#, glossary, machine, plain2
msgid "Your account"
msgstr "Kontoen din"

#, machine, plain1
msgid "Your account already posts automatically. Change its feeds on its page."
msgstr "Kontoen din legger allerede inn automatisk. Endre fôrene på siden."

#, machine, plain1, python-format
msgid "Your account balance is negative. You will not be able to participate on %(site)s until you bring your balance up to zero."
msgstr "Din kontobalanse er negativ. Du kan ikke delta på %(site)s til du tar balansen opp til null."

#, machine, plain1
msgid "Your account can also post new items from feeds by itself, while you keep using it as you do now. Each of those posts is marked as automated, and people who hide bot content don't see them. Your own posts, comments, votes and chats are unchanged. An admin approves it first."
msgstr "Kontoen din kan også legge ut nye elementer fra feeds av seg selv, mens du fortsetter å bruke det som du gjør nå. Hver av disse innleggene er merket som automatisert, og folk som skjuler bot innhold ikke ser dem. Dine egne innlegg, kommentarer, stemmer og chatter er uendret. En admin godkjenner det først."

#, machine, plain1
msgid "Your account can't post automatically while it is age-restricted."
msgstr "Kontoen din kan ikke poste automatisk mens den er aldersbegrenset."

#, machine, plain1
msgid "Your account can't post automatically while it is suspended."
msgstr "Kontoen din kan ikke poste automatisk mens den er suspendert."

#, machine, plain1
msgid "Your account can't publish right now."
msgstr "Din konto kan ikke publisere akkurat nå."

#, machine, plain1
msgid "Your account can't run a bot while it is age-restricted."
msgstr "Kontoen kan ikke kjøre en bot mens den er aldersbegrenset."

#, machine, plain1
msgid "Your account cannot upload right now."
msgstr "Din konto kan ikke lastes opp akkurat nå."

#, machine, plain1
msgid "Your account couldn't be created. Please try again."
msgstr "Din konto kan ikke opprettes. Prøv igjen."

#, machine, plain1
msgid "Your account doesn't owe anything."
msgstr "Din konto skylder ingenting."

#, machine, plain1
msgid "Your account has been checked and is ready: you can now post, comment, vote and follow. Welcome!"
msgstr "Din konto har blitt kontrollert og er klar: du kan nå legge inn, kommentere, stemme og følge. Velkommen!"

#, machine, plain1
msgid "Your account has been deleted"
msgstr "Din konto er slettet"

#, machine, plain1, python-format
msgid "Your account has the child lock on, held by your parent or guardian, since %(date)s."
msgstr "Din konto har barnelås på, holdt av din foreldre eller verge, siden %(date)s."

#, machine, plain1, python-format
msgid "Your account has the child lock on, since %(date)s."
msgstr "Din konto har barnet låse på, siden %(date)s."

#, machine, plain1
msgid "Your account is age-restricted, so its word filter stays on Child until you confirm your age in Settings."
msgstr "Din konto er aldersbegrenset, så dets ordfilter forblir på Barn til du bekrefter din alder i Innstillinger."

#, machine, plain1
msgid "Your account is age-restricted, so sensitive content stays hidden until you confirm your age in Settings."
msgstr "Kontoen din er aldersbegrenset, så sensitive innhold forblir skjult til du bekrefter alderen din i Innstillinger."

#, machine, plain1
msgid "Your account is being checked"
msgstr "Din konto kontrolleres"

#, machine, plain1
msgid "Your account is being checked."
msgstr "Kontoen din kontrolleres."

#, machine, plain1
msgid "Your account is marked sensitive."
msgstr "Din konto er merket følsom."

#, machine, plain1
msgid "Your account is no longer marked sensitive."
msgstr "Din konto er ikke lenger merket sensitiv."

#, machine, plain1
msgid "Your account is suspended."
msgstr "Din konto er suspendert."

#, machine, plain1
msgid "Your account is too new to write in this guild's channels yet."
msgstr "Din konto er for ny til å skrive i denne guildens kanaler ennå."

#, machine, plain1
msgid "Your account is waiting for a quick check before it can do this. To skip the wait, verify an email address in Settings > Security."
msgstr "Kontoen din venter på en rask sjekk før den kan gjøre dette. Hvis du vil hoppe over ventetiden, må du verifisere en e-postadresse i Innstillinger > Sikkerhet."

#, machine, plain1
msgid ""
"Your account is waiting for a quick check before you can post, comment, vote or follow. You can look around and set up your profile in the meantime.\n"
"\n"
"\n"
"To skip the wait, add and verify an email address in [Settings > Security](/settings/security)."
msgstr ""
"Din konto venter på en rask sjekk før du kan skrive, kommentere, stemme eller følge. Du kan se rundt og konfigurere profilen din i mellomtiden.\n"
"\n"
"\n"
"For å hoppe over ventetiden, legge til og verifisere en e-postadresse i [Innstillinger > Sikkerhet](/settings/security)."

#, machine, plain1
msgid "Your account is your own now. It no longer has the child lock and your parent or guardian can no longer see it. They chose your password: change it in [Settings > Security](/settings/security), or they can still sign in as you."
msgstr "Din konto er din egen nå. Det har ikke lenger barnelåsen, og foreldre eller verge kan ikke lenger se den. De valgte passordet ditt: Endre det i [Innstillinger > Sikkerhet](/settings/security), eller de kan fortsatt logge inn som deg."

#, machine, plain1
msgid "Your account needs to be at least 30 days old to post automatically."
msgstr "Din konto må være minst 30 dager gammel for å poste automatisk."

#, machine, plain1
msgid "Your account needs to be at least 30 days old to run a bot."
msgstr "Kontoen din må være minst 30 dager gammel for å kjøre en bot."

#, machine, plain1
msgid "Your account no longer posts automatically. Its posts stay."
msgstr "Din konto poster ikke lenger automatisk. Innleggene blir."

#, machine, plain2
msgid "Your account only reads for now, so it can't comment. You can still vote, follow and bookmark."
msgstr "Kontoen din leser bare nå, så det kan ikke kommentere. Du kan fortsatt stemme, følge og bokmerke."

#, machine, plain1
msgid "Your account posts from these feeds from now on."
msgstr "Dine kontoinnlegg fra disse feeds fra nå av."

#, machine, plain1
msgid "Your account was closed"
msgstr "Din konto ble stengt"

#, machine, plain1, python-format
msgid "Your account's automated posting has been paused: %(reason)s"
msgstr "Din kontos automatiske innlegg er satt i pause: %(reason)s"

#, machine, plain1
msgid "Your account's automated posting is running again."
msgstr "Kontoens automatiske innlegg kjører igjen."

#, machine, plain1, python-format
msgid "Your account's automated posting stopped reading %(url)s after %(fails)s failed tries: %(reason)s Start it again from Settings > Bots once it works."
msgstr "Din kontos automatiske innlegg sluttet å lese %(url)s etter at %(fails)s mislykkes prøver: %(reason)s Start det igjen fra Innstillinger > Bots når det virker."

#, machine, plain1
msgid "Your account's automated posting was approved. Your feeds' new posts appear on your profile, marked as automated, within a few minutes. Manage it in [Settings > Bots](/settings/bots)."
msgstr "Din kontos automatiske innlegg ble godkjent. Dine feeds nye innlegg vises på profilen din, merket som automatisert, i løpet av noen minutter. Administrer det i [Innstillinger > Bots](/settings/bots)."

#, machine, plain1
msgid "Your age"
msgstr "Din alder"

#, machine, plain1, python-format
msgid "Your age was confirmed on %(date)s."
msgstr "Din alder ble bekreftet på %(date)s."

#, machine, plain1
msgid "Your answer"
msgstr "Ditt svar"

#, machine, plain2
msgid "Your appeal is waiting to be read."
msgstr "Din appell venter på å bli lest."

