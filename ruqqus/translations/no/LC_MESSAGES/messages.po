msgstr[1] "Et sted kan være på de fleste %(num)s tegn."

#, machine, plain1
msgid "A place is plain text."
msgstr "Et sted er vanlig tekst."

#, machine, plain1, python-format
msgid "A point needs an account at least %(num)s day old that is not banned or deleted. Your own votes and comments never count."
msgid_plural "A point needs an account at least %(num)s days old that is not banned or deleted. Your own votes and comments never count."
msgstr[0] "Et punkt trenger en konto som ikke er forbudt eller slettet. Dine egne stemmer og kommentarer teller aldri."
msgstr[1] "Et punkt trenger en konto minst %(num)s dager gammel som ikke er forbudt eller slettet. Dine egne stemmer og kommentarer teller aldri."

#, machine, plain1, python-format
msgid "A poll can have %(num)s option at most."
msgid_plural "A poll can have %(num)s options at most."
msgstr[0] "En undersøkelse kan ha et alternativ på det meste."
msgstr[1] "En undersøkelse kan ha %(num)s alternativer på det meste."

#, machine, plain1, python-format
