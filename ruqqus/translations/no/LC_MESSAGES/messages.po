msgstr "Denne lagringen er ikke tilgjengelig her."

#, machine, plain1
msgid "That template doesn't exist."
msgstr "Denne malen eksisterer ikke."

#, machine, plain1
msgid "That upload can no longer be used."
msgstr "Denne opplastingen kan ikke lenger brukes."

#, machine, plain1
msgid "That upload can no longer be used. Add it again."
msgstr "Denne opplastingen kan ikke lenger brukes. Legg det til igjen."

#, machine, plain1
msgid "That upload expired. Add the video again."
msgstr "Denne opplastingen gikk ut. Legg til videoen igjen."

#, machine, plain1
msgid "That upload was not found."
msgstr "Denne opplastingen ble ikke funnet."

#, machine, plain1
msgid "That user deactivated their account."
msgstr "Denne brukeren deaktiverte kontoen sin."

#, machine, plain1
msgid "That user doesn't exist."
msgstr "Den brukeren eksisterer ikke."

#, machine, plain1
msgid "That user is banned"
msgstr "Denne brukeren er forbudt"

#, machine, plain1, python-format
msgid "That username is reserved for: %(reason)s"
msgstr "Dette brukernavnet er reservert for: %(reason)s"

#, machine, plain1
msgid "That userpage is private"
msgstr "Den brukersiden er privat"

#, machine, plain1, python-format
msgid "That was originally created in +%(original)s, not +%(guild)s"
msgstr "Dette ble opprinnelig opprettet i +%(original)s, ikke +%(guild)s"

#, machine, plain1
msgid "That wasn't an image!"
msgstr "Det var ikke et bilde!"

#, machine, plain1
msgid "That website address isn't valid."
msgstr "Nettstedets adresse er ikke gyldig."

#, machine, plain1
msgid "That's the host."
msgstr "Det er verten."

#, machine, plain1
msgid "That's the owner."
msgstr "Det er eieren."

#, machine, plain1
msgid "That's your own circle."
msgstr "Det er din egen sirkel."

#, machine, plain1
msgid "That's your own post."
msgstr "Det er din egen post."

#, machine, plain1
msgid "That's your own story."
msgstr "Det er din egen historie."

#, machine, plain1, python-format
msgid "The %(site)s Team"
msgstr "%(site)s Team"

#, machine, plain1
msgid "The BBC's technology headlines, from its public RSS feed."
msgstr "BBCs teknologioverskrifter, fra sin offentlige RSS feed."

#, machine, plain1
msgid "The Child word filter hides sensitive content everywhere, so this is off."
msgstr "Barneordfilteret skjuler følsomt innhold overalt, så dette er av."

#, glossary, machine, plain2
msgid "The Platform"
msgstr "Plattformen"

#, machine, plain1
msgid "The Royal Bank has minted your Coins. Here is a copy of your order."
msgstr "Den kongelige Bank har tatt myntene. Her er en kopi av bestillingen."

#, machine, plain1
msgid "The Sahel"
msgstr "Sahel"

#, machine, plain1
msgid "The Space could not be made."
msgstr "Rommet kan ikke lages."

#, machine, plain1, python-format
msgid "The account @%(name)s is deleted."
msgstr "Kontoen @%(name)s slettes."

#, machine, plain1, python-format
msgid "The account @%(name)s is made. They sign in with the username and password you gave."
msgstr "Kontoen @%(name)s er laget. De logger på med brukernavnet og passordet du ga."

#, machine, plain1, python-format
msgid "The account age must be a whole number of days, 0 to %(max)s."
msgstr "Kontoalderen må være et helt antall dager, 0 til %(max)s."

#, machine, plain1
msgid "The account is used as always: only posts from these feeds are made by themselves, each marked as automated."
msgstr "Kontoen brukes som alltid: Bare innlegg fra disse feeds er laget av seg selv, hver merket som automatisert."

#, machine, plain1
msgid "The account no longer exists."
msgstr "Kontoen eksisterer ikke lenger."

#, machine, plain1
msgid "The accounts on this list keep it to themselves."
msgstr "Regnskapet på denne listen holder det for seg selv."

#, machine, plain1, python-format
msgid "The admins said: %(note)s"
msgstr "Admins sa: %(note)s"

#, machine, plain1
msgid "The age check didn't finish. Nothing has changed, and you can try again."
msgstr "Alderskontrollen endte ikke. Ingenting har endret seg, og du kan prøve igjen."

#, machine, plain1
msgid "The age check found that you are under the youngest age allowed to have an account where you are."
msgstr "Alderskontrollen viste at du er under den yngste alderen tillatt å ha en konto der du er."

#, machine, plain1
msgid "The age check found that you're under 18, so the child lock stays on."
msgstr "Alderskontrollen viste at du er under 18 år, så barnelåsen fortsetter."

#, machine, plain1
msgid "The author"
msgstr "Forfatteren"

#, machine, plain1
msgid "The author of an anonymous post can't be added."
msgstr "Forfatteren av en anonym post kan ikke legges til."

#, machine, plain1
msgid "The author says this is commercial promotion: a paid partnership, sponsorship, affiliate link, or advertising of their own products or services"
msgstr "Forfatteren sier dette er kommersiell kampanje: et betalt partnerskap, sponsing, affiliate link, eller reklame av sine egne produkter eller tjenester"

#, machine, plain1
msgid "The author says this was made with AI"
msgstr "Forfatteren sier dette er laget med AI"

#, machine, plain1
msgid "The author turned comments off for this post."
msgstr "Forfatteren har avslått kommentarer til dette innlegget."

#. %(names)s is a comma-separated list of the draft's authors
#, machine, plain1, python-format
msgid "The authors agreed to invite you: %(names)s."
msgstr "Forfatterne var enige om å invitere deg: %(names)s."

#, machine, plain1
msgid "The auto-moderation was saved."
msgstr "Auto-moderasjon ble lagret."

#, machine, plain1, python-format
msgid "The base URL is <code>%(url)s</code>"
msgstr "Basen URL er <code>%(url)s</code>"

#, machine, plain1
msgid "The board is open while the Space is live."
msgstr "Styret er åpent mens rommet er levende."

#, machine, plain1, python-format
msgid "The body can be at most %(num)s character."
msgid_plural "The body can be at most %(num)s characters."
msgstr[0] "Kroppen kan være på det meste %(num)s tegn."
msgstr[1] "Kroppen kan være på de fleste %(num)s tegn."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved."
msgstr "Botten @%(name)s du foreslo ble ikke godkjent."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved. The admins said: %(note)s"
msgstr "Botten @%(name)s du foreslo ble ikke godkjent. Admins sa: %(note)s"

#, machine, plain1
msgid "The bot already reads that feed."
msgstr "Botten leser allerede det fôret."

#, machine, plain1
msgid "The bot was suspended for posting too much similar content."
msgstr "Botten ble suspendert for å legge for mye lignende innhold."

#, machine, plain1, python-format
msgid "The bot you proposed, [@%(name)s](/@%(name)s), was approved. It is run by the site from now on and starts posting from its feeds within a few minutes. Thank you!"
msgstr "Botten du foreslo, [@%(name)s](/@%(name)s), ble godkjent. Det drives av nettstedet fra nå av og begynner å poste fra sine fôr innen noen minutter. Takk!"

#, machine, plain1
msgid "The bot's account no longer exists."
msgstr "Bottens konto eksisterer ikke lenger."

#, machine, plain1
msgid "The bot's owner can't run it right now."
msgstr "Bots eier kan ikke styre det akkurat nå."

#, machine, plain1, python-format
msgid "The category %(category)s was deleted; its channels stay."
msgstr "Kategorien %(category)s ble slettet; kanalene blir."

#, machine, plain1, python-format
msgid "The category %(category)s was made."
msgstr "Kategorien %(category)s ble laget."

#, machine, plain1, python-format
msgid "The category was renamed %(category)s."
msgstr "Kategorien ble omdøpt %(category)s."

#, machine, plain1, python-format
msgid "The coins go to the founder, <a href=\"%(url)s\">@%(name)s</a>."
msgstr "myntene går til grunnleggeren, <a href=\"%(url)s\">@%(name)s</a>."

#, machine, plain1
msgid "The coins you earn from tips, paid circles and the creator fund, for the last 30 days and all time."
msgstr "Myntene du tjener fra tips, betalte sirkler og skaperfondet, de siste 30 dagene og hele tiden."

#, machine, plain2
msgid "The comment stays where it is, with your name taken off it. Everyone who saw it with your name still knows it was you."
msgstr "Kommentaren forblir der det er, med ditt navn tatt av det. Alle som så den med navnet ditt vet fortsatt at det var deg."

#, machine, plain1, python-format
msgid "The copy other people forwarded to guilds will stay there."
msgid_plural "The %(num)s copies other people forwarded to guilds will stay there."
msgstr[0] "Kopieringen andre mennesker som sendes til guilds vil bo der."
msgstr[1] "De %(num)s kopiene andre som sendes til guilds vil bo der."

#. %(guilds)s is a list of guild names, such as "+a, +b and +c"
#, machine, plain1, python-format
msgid "The copy you forwarded to %(guilds)s will be taken down."
msgid_plural "The copies you forwarded to %(guilds)s will be taken down."
msgstr[0] "Kopien du sendte til %(guilds)s vil bli tatt ned."
msgstr[1] "De kopiene du sender til %(guilds)s vil bli tatt ned."

#, machine, plain1
msgid "The dates leave no days."
msgstr "Datoene går ingen dager."

#, machine, plain2
msgid "The decision stands"
msgstr "Beslutningen står"

#, machine, plain1
msgid "The decisions made about it, newest first: who, when, where, which rule and why. It never shows the title or the text of what was hidden or removed."
msgstr "De avgjørelser som tas om det, nyeste først: hvem, når, hvor, hvilken regel og hvorfor. Den viser aldri tittelen eller teksten til det som var skjult eller fjernet."

#, machine, plain1
msgid "The draft has changes the post doesn't show yet."
msgstr "Utkastet har endringer i innlegget viser ikke ennå."

#, machine, plain1
msgid "The earlier versions aren't shown while this is hidden."
msgstr "De tidligere versjonene vises ikke mens dette er skjult."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was approved: it is read from now on."
msgstr "Feed %(url)s for kontoens automatiske innlegg ble godkjent: det leses fra nå av."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was not approved."
msgstr "Feed %(url)s for kontoens automatiske innlegg ble ikke godkjent."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was approved: it is read from now on."
msgstr "Fôren %(url)s for bot @ %(name)s ble godkjent: det leses fra nå av."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was not approved."
msgstr "Feed %(url)s for boten din @ %(name)s ble ikke godkjent."

#, machine, plain1, python-format
msgid "The feed answered with an error (%(status)s)."
msgstr "Feed svarte med en feil (%(status)s)."

#, machine, plain1
msgid "The feed asked us to slow down."
msgstr "Maten ba oss om å bremse."

#, machine, plain1
msgid "The feed did not answer in time."
msgstr "Maten svarte ikke i tide."

#, machine, plain1
msgid "The feed is unavailable for now."
msgstr "Maten er ikke tilgjengelig nå."

#, machine, plain1
msgid "The feed server answered with a redirect, which is not followed."
msgstr "Feed serveren svarte med en omdirigering, som ikke følges."

#. status is an HTTP status code, such as 404
#, machine, plain1, python-format
msgid "The feed server answered with an error (%(status)s)."
msgstr "Feed server svarte med en feil (%(status)s)."

#, machine, plain1, python-format
msgid "The feed server answered with more than %(num)s post at once."
msgid_plural "The feed server answered with more than %(num)s posts at once."
msgstr[0] "Feed serveren svarte med mer enn %(num)s post på én gang."
msgstr[1] "Feed serveren svarte med mer enn %(num)s innlegg på en gang."

#, machine, plain1
msgid "The feed server did not answer in time."
msgstr "Feed server svarte ikke i tide."

#, machine, plain1
msgid "The feed server took too long to answer."
msgstr "Feed server tok for lang tid å svare."

#, machine, plain1
msgid "The feed server's answer has no list of posts."
msgstr "Feed serverens svar har ingen liste over innlegg."

#, machine, plain1
msgid "The feed server's answer holds something that is not a post id."
msgstr "Feed serverens svar inneholder noe som ikke er et post-ID."

#, machine, plain1
msgid "The feed server's answer is not JSON."
msgstr "Feed serverens svar er ikke JSON."

#, machine, plain1
msgid "The feed server's answer is not a JSON object."
msgstr "Feed serverens svar er ikke et JSON-objekt."

#, machine, plain1
msgid "The feed server's answer is too large."
msgstr "Feed serverens svar er for stort."

#, machine, plain1
msgid "The feed server's certificate could not be checked."
msgstr "Fôr serverens sertifikat kunne ikke kontrolleres."

#, machine, plain1
msgid "The feed server's cursor is not usable."
msgstr "Markøren på feed server er ikke brukbar."

#, machine, plain1
msgid "The feed's address sends it somewhere else too many times."
msgstr "Matens adresse sender det et annet sted for mange ganger."

#, machine, plain1
msgid "The feed's answer is too large."
msgstr "Fôrens svar er for stort."

#, machine, plain1
msgid "The feed's certificate could not be checked."
msgstr "Fôrens sertifikat kunne ikke kontrolleres."

#, machine, plain1
msgid "The file's size is missing."
msgstr "Filens størrelse mangler."

#, machine, plain1, python-format
msgid "The following users are approved to forward to +%(guild)s."
msgstr "Følgende brukere er godkjent til å sende til +%(guild)s."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s guild chat."
msgstr "Følgende brukere er forbudt å delta i +%(guild)s guild chat."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s."
msgstr "Følgende brukere er forbudt å delta i +%(guild)s."

#, machine, plain1
msgid "The guild"
msgstr "Guild"

#, machine, plain1
msgid "The guild already has a category with that name."
msgstr "Guild har allerede en kategori med dette navnet."

#, machine, plain1
msgid "The guild already has a channel with that name."
msgstr "Den har allerede en kanal med det navnet."

#, machine, plain1
msgid "The guild already has a role with that name."
msgstr "Guild har allerede en rolle med dette navnet."

#, machine, plain1
msgid "The guild's own rules for what is written in its channels, on top of the site's word filter. Guildmasters are never held to them. A message that breaks one is refused with a short reason that never says which word."
msgstr "Guildens egne regler for det som er skrevet i sine kanaler, på toppen av nettstedets ordfilter. Guild moderatorene blir aldri holdt til dem. En melding som bryter en blir nektet med en kort grunn som aldri sier hvilket ord."

#, machine, plain1
msgid "The host stays on stage."
msgstr "Verten forblir på scenen."

#, machine, plain1
msgid "The independent social platform"
msgstr "Den uavhengige sosiale plattformen"

#, machine, plain1
msgid "The internet gremlins have led you to a dark, musty dead-end. There's nothing here."
msgstr "Internett-gremlinene har ført deg til en mørk, myk død-end. Det er ingenting her."

#, machine, plain1, python-format
msgid "The key that opens your messages in a new app. It is locked with your password and opened here, in this browser: %(site)s never sees it. Anyone with it and your account can read your chats, so never share it."
msgstr "Nøkkelen som åpner meldingene dine i en ny app. Det er låst med passordet ditt og åpnet her, i denne nettleseren: %(site)s ser det aldri. Alle som har det og kontoen din kan lese chatter, så aldri dele det."

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s"
msgstr "Linken `%(link)s` er ikke tillatt. Årsak: %(reason)s"

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s."
msgstr "Linken `%(link)s` er ikke tillatt. Grunn: %(reason)s."

#, machine, plain1, python-format
msgid "The link can be at most %(num)s character."
msgid_plural "The link can be at most %(num)s characters."
msgstr[0] "Linken kan være på det meste %(num)s tegn."
msgstr[1] "Linken kan være på de fleste %(num)s tegn."

#, machine, plain1
msgid "The link can't contain a user name or password."
msgstr "Linken kan ikke inneholde et brukernavn eller passord."

#, machine, plain1
msgid "The link can't contain spaces."
msgstr "Linken kan ikke inneholde mellomrom."

#, machine, plain1
msgid "The link must start with https:// or http://."
msgstr "Linken må starte med https:// eller http://."

#, machine, plain1
msgid "The link needs a full address, such as example.com."
msgstr "Linken trenger en full adresse, som example.com."

#, machine, plain1
msgid "The list is open to members so that anyone can see what the filter hides and why. Nothing on it is removed from the site: each member's own filter decides what they see."
msgstr "Listen er åpen for medlemmer slik at alle kan se hva filteret skjuler og hvorfor. Ingenting på det fjernes fra nettstedet: hvert medlems eget filter bestemmer hva de ser."

#, machine, plain1
msgid "The list isn't shown on the Child filter"
msgstr "Listen er ikke vist i barnefilteret"

#, machine, plain1, python-format
msgid "The most a circle can ask is %(num)s coin every 30 days."
msgid_plural "The most a circle can ask is %(num)s coins every 30 days."
msgstr[0] "Den meste sirkelen kan spørre er %(num)s mynt hver 30. dag."
msgstr[1] "Den mest en sirkel kan spørre er %(num)s mynter hver 30. dag."

#, machine, plain1
msgid "The most voted posts of the last seven days."
msgstr "De mest stemmede postene de siste syv dagene."

#, machine, plain1, python-format
msgid "The name %(host)s could not be found."
msgstr "Navnet %(host)s ble ikke funnet."

#, machine, plain1
msgid "The newest of what they have done. Only the names of who they chat with are shown, never what a chat says: chats are end-to-end encrypted."
msgstr "Det nyeste av det de har gjort. Bare navnene på hvem de prater med er vist, aldri hva en chat sier: chatter er slutt-til-end kryptert."

#, machine, plain2
msgid "The number of items you confirmed doesn't match what was chosen. Nothing was changed."
msgstr "Antall elementer du bekreftet samsvarer ikke med det som ble valgt. Ingenting ble endret."

#, machine, plain1
msgid "The numbers are always shown on your profile. This decides who can open each list and see the accounts on it. An account is only listed where its own setting allows it too."
msgstr "Tallene vises alltid på profilen din. Dette bestemmer hvem som kan åpne hver liste og se kontoene på den. En konto er bare oppført der sin egen innstilling tillater det også."

#, machine, plain1
msgid "The open-source platform for independent internet communities"
msgstr "Plattformen for åpen kildekode for uavhengige internettsamfunn"

#, machine, plain1
msgid "The original content is not retained anywhere, including in this history."
msgstr "Det opprinnelige innholdet lagres ikke noe sted, inkludert i denne historien."

#, machine, plain1
msgid "The other authors of a shared draft removed you as an author. What you wrote stays credited to you."
msgstr "De andre forfatterne av et delt utkast fjernet deg som forfatter. Det du skrev forblir kreditert deg."

#, machine, plain1
msgid "The owner deletes a channel instead of leaving it."
msgstr "Eieren sletter en kanal i stedet for å forlate den."

#, machine, plain1
msgid "The owner's role can't be changed."
msgstr "Eierens rolle kan ikke endres."

#, machine, plain1
msgid "The page's current text isn't shown here; what you save replaces it."
msgstr "Sidens gjeldende tekst er ikke vist her; det du lagrer erstatter den."

#, machine, plain1
msgid "The picture could not be stored. Try again later."
msgstr "Bildet kunne ikke lagres. Prøv igjen senere."

#, machine, plain1
msgid "The picture goes to your own linked storage, not to this site. You can add a few words under it."
msgstr "Bildet går til din egen linket lagring, ikke til dette nettstedet. Du kan legge til noen ord under det."

#, machine, plain1
msgid "The picture you chose"
msgstr "Bildet du valgte"

#, machine, plain1
msgid "The post appears on the profile of whoever publishes it first. Optionally forward it into guilds for community discussion: each guild gets its own independent copy with its own votes and comments. Guilds are forwarded to when the draft is first published."
msgstr "Posten vises på profilen til hvem som publiserer den først. Valgfritt videresende den til guilds til samfunnsdiskussioner: hver guild får sin egen uavhengig kopi med egne stemmer og kommentarer. Guilds sendes videre til når utkastet først publiseres."

#, machine, plain1
msgid "The post carries your name and is listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your name."
msgstr "Posten bærer navnet ditt og er oppført på profilen din. Stemninger, kommentarer og videresendinger deles med forfatteren, som redigerer og sletter det. Du kan gå av når som helst: innlegget blir, uten navnet ditt."

#, machine, plain2
msgid "The post is not listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your credit."
msgstr "Posten er ikke oppført på din profil. Stemninger, kommentarer og videresendinger deles med forfatteren, som redigerer og sletter det. Du kan gå av når som helst: innlegget forblir uten kreditt."

#, machine, plain1
msgid "The post refused the change."
msgstr "Posten nektet å endre."

#, machine, plain2
msgid "The post stays where it is, with your name taken off it, and leaves your profile. Its Rep leaves you too. Everyone who saw it with your name still knows it was you."
msgstr "Posten blir der det er, med navnet ditt tatt av den, og forlater profilen din. Reputasjonen forlater deg også. Alle som så den med navnet ditt vet fortsatt at det var deg."

#, machine, plain2
msgid "The post's author"
msgstr "Postens forfatter"

#, machine, plain2
msgid "The post's author deleted it, so it is shown as Anonymous: no name and no link. The comments under it stay as they were; one its author deleted is shown as Anonymous too."
msgstr "Postens forfatter slettet det, så det er vist som Anonym: Ingen navn og ingen link. Kommentarer under det blir som de var, en forfatter slettes også vises som Anonym."

#, machine, plain1, python-format
msgid "The promo code `%(code)s` is not currently valid. Please begin a new transaction."
msgstr "Promokoden `%(code)s` er for tiden ikke gyldig. Vennligst start en ny transaksjon."

#, machine, plain1, python-format
msgid "The proposal for @%(name)s has been withdrawn."
msgstr "Forslaget til @%(name)s er trukket tilbake."

#, machine, plain1, python-format
msgid "The role %(role)s was deleted."
msgstr "Rollen %(role)s ble slettet."

#, machine, plain1, python-format
msgid "The role %(role)s was made."
msgstr "Rollen %(role)s ble laget."

#, machine, plain1, python-format
msgid "The role %(role)s was saved."
msgstr "Rollen %(role)s ble reddet."

#, machine, plain1
msgid "The royal bank has told us that you owe them some coin. You'll need to pay off your debts before you can continue."
msgstr "Den kongelige banken har fortalt oss at du skylder dem penger. Du må betale av gjelden din før du kan fortsette."

#, machine, plain1
msgid "The rules"
msgstr "Reglene"

#, machine, plain1
msgid "The rules below"
msgstr "Reglene nedenfor"

#, machine, plain1, python-format
msgid "The rules can be at most %(count)s character."
msgid_plural "The rules can be at most %(count)s characters."
msgstr[0] "Reglene kan være på det meste %(count)s karakter."
msgstr[1] "Reglene kan være mest %(count)s tegn."

#, machine, plain1
msgid "The rules can't contain control or invisible characters."
msgstr "Reglene kan ikke inneholde kontroll eller usynlige tegn."

#, machine, plain1
msgid "The screenshot you are sending"
msgstr "Skjermbildet du sender"

#. %(status)s is an HTTP status code
#, machine, plain1, python-format
msgid "The server answered %(status)s."
msgstr "Serveren svarte %(status)s."

#, machine, plain1, python-format
msgid "The server answers with the posts to show and their order; %(site)s still hides anything a viewer may not see, and tells the server nothing about who is looking. Everyone is told that an outside server ranks this curation."
msgstr "Serveren svarer med innleggene å vise og deres ordre; %(site)s skjuler fortsatt noe en seer ikke kan se, og forteller serveren ingenting om hvem som leter. Alle blir fortalt at en ekstern server rangerer dette kurert feed."

#, machine, plain1, python-format
msgid "The server named %(num)s post; you can see %(seen)s of them."
msgid_plural "The server named %(num)s posts; you can see %(seen)s of them."
msgstr[0] "Serveren heter %(num)s post; du kan se %(seen)s av dem."
msgstr[1] "Serveren heter %(num)s innlegg; du kan se %(seen)s av dem."

#, machine, plain1
msgid "The server thinks you're asking something silly. It might take you more seriously if you take off the jester outfit."
msgstr "Serveren mener du spør noe dumt. Det kan ta deg mer alvorlig hvis du tar av jester antrekk."

#, machine, plain1
msgid "The site refused the bot's session."
msgstr "Nettstedet nektet bots sesjon."

#, machine, plain2
msgid "The site's admins have it already."
msgstr "Nettstedets administratorer har det allerede."

#, machine, plain1
msgid "The site's admins marked this guild sensitive, so only an admin can change this."
msgstr "Nettstedets admins markerte denne følsomheten, så bare en administrator kan endre dette."

#, machine, plain2
msgid "The site's admins will read it. They are never told who reported."
msgstr "Nettstedets administratorer vil lese det. De blir aldri fortalt hvem som rapporterte."

#, machine, plain1, python-format
msgid "The stage is full (%(num)s person)."
msgid_plural "The stage is full (%(num)s people)."
msgstr[0] "Scenen er full (%(num)s person)."
msgstr[1] "Scenet er fullt (%(num)s personer)."

#, machine, plain1
msgid "The storage service is not answering right now. Try again in a moment."
msgstr "Oppbevaringstjenesten svarer ikke akkurat nå. Prøv igjen om et øyeblikk."

#, machine, plain1, python-format
msgid "The summary can be at most %(num)s character."
msgid_plural "The summary can be at most %(num)s characters."
msgstr[0] "Sammendraget kan være på det meste %(num)s tegn."
msgstr[1] "Sammendraget kan være på de fleste %(num)s tegn."

#, machine, plain1
msgid "The summary can be changed while the Space is live."
msgstr "Sammendraget kan endres mens rommet er levende."

#, machine, plain1
msgid "The text isn't shown: this was removed by the site's administrators."
msgstr "Teksten er ikke vist: Dette ble fjernet av nettstedets administratorer."

#, machine, plain1
msgid "The text of this version was hidden by a site administrator."
msgstr "Teksten til denne versjonen ble skjult av en nettstedsadministrator."

#, machine, plain1, python-format
msgid "The time before links must be a whole number of days, 0 to %(max)s."
msgstr "Tiden før linkene må være et helt antall dager, 0 til %(max)s."

#, machine, plain1, python-format
msgid "The time in the guild must be a whole number of days, 0 to %(max)s."
msgstr "Tiden i lauget må være et helt antall dager, 0 til %(max)s."

#, machine, plain1, python-format
msgid "The title can be at most %(num)s character."
msgid_plural "The title can be at most %(num)s characters."
msgstr[0] "Tittelen kan være på det meste %(num)s tegn."
msgstr[1] "Tittelen kan være på de fleste %(num)s tegn."

#, machine, plain1
msgid "The two revisions have the same text."
msgstr "De to revisjonene har samme tekst."

#, machine, plain1
msgid "The upload did not arrive in your Google Drive. Try again."
msgstr "Opplastingen kom ikke i din Google Drive. Prøv igjen."

#, machine, plain1
msgid "The upload did not arrive in your OneDrive. Try again."
msgstr "Opplastingen kom ikke i din OneDrive. Prøv igjen."

#, machine, plain1
msgid "The upload did not arrive. Try again."
msgstr "Opplastingen kom ikke. Prøv igjen."

#, machine, plain1, python-format
msgid "The username @%(name)s has been pre-emptively reserved for: %(who)s"
msgstr "Brukernavnet @%(name)s er reservert på forhånd: %(who)s"

#, machine, plain1
msgid "The usual order - everything from the guilds and accounts you add"
msgstr "Den vanlige ordren - alt fra guilds og kontoer du legger til"

#, machine, plain1
msgid "The video did not finish uploading to Dailymotion. Add it again."
msgstr "Videoen var ikke ferdig med å laste opp til Dailymotion. Legg det til igjen."

#, machine, plain1
msgid "The video did not finish uploading. Add it again."
msgstr "Videoen var ikke ferdig med å laste opp. Legg det til igjen."

#, machine, plain1, python-format
msgid "The website can be at most %(num)s character."
msgid_plural "The website can be at most %(num)s characters."
msgstr[0] "Nettstedet kan være på det meste %(num)s tegn."
msgstr[1] "Nettstedet kan være på de fleste %(num)s tegn."

#, machine, plain1
msgid "The website can't contain a user name or password."
msgstr "Nettstedet kan ikke inneholde et brukernavn eller passord."

#, machine, plain1
msgid "The website can't contain spaces."
msgstr "Nettstedet kan ikke inneholde rom."

#, machine, plain1
msgid "The website must start with https:// or http://."
msgstr "Nettstedet må begynne med https:// eller http://."

#, machine, plain1
msgid "The website needs a full address, such as example.com."
msgstr "Nettstedet trenger en full adresse, som example.com."

#, machine, plain1
msgid "The whole site <span class=\"text-muted\">(needs an age limit of a month or less)</span>"
msgstr "Hele nettstedet <span class=\"text-muted\">(trenger aldersgrense på en måned eller mindre)</span>"

#, machine, plain1
msgid "The wiki is off: only guildmasters see it."
msgstr "Wikien er av: Bare guild moderators se det."

#, machine, plain1
msgid "The wiki's first page can be emptied but not deleted."
msgstr "Wikiens første side kan tømmes, men ikke slettes."

#, machine, plain1
msgid "The word filter has no words at the moment."
msgstr "Ordet filter har ingen ord i øyeblikket."

#, machine, plain1, python-format
msgid "The words for other languages are adapted from %(source)s (%(licence)s): words that are also ordinary, innocent words were left out."
msgstr "Ordene for andre språk er tilpasset %(source)s (%(licence)s): Ord som også er vanlige, uskyldige ord ble utelatt."

#, machine, plain1
msgid "The working copy as it is now. Only its authors can see this until it's published."
msgstr "Arbeidskopien som den er nå. Bare forfatterne kan se dette til det er publisert."

#, machine, plain1
msgid "Theater"
msgstr "Theater"

#, machine, plain1
msgid "Their commenting history will show here."
msgstr "Deres kommentarhistorie vil vise her."

#, machine, plain1
msgid "Their forwarding activity will show here."
msgstr "Deres videresending vil vise her."

#, machine, plain1
msgid "Their posting history will show here."
msgstr "Deres utgivelseshistorie vil vise her."

#, machine, plain1
msgid "Their posts and comments are left out of your feeds and threads and they cannot notify you. They are not told, and they can still follow you, comment on your posts and message you. Their anonymous posts and comments are not hidden, as hiding only those would tell you who wrote them. Mute someone from the menu on any of their posts or comments, or from their profile."
msgstr "Deres innlegg og kommentarer er utelatt fra dine fôr og tråder, og de kan ikke varsle deg. De blir ikke fortalt, og de kan fortsatt følge deg, kommentere på dine innlegg og meldinger. Deres anonyme innlegg og kommentarer er ikke skjult, som å skjule bare de som ville fortelle deg hvem som skrev dem. Slå noen fra menyen på noen av deres innlegg eller kommentarer, eller fra deres profil."

#, machine, plain1
msgid "There are no approved users"
msgstr "Det er ingen godkjente brukere"

#, machine, plain1
msgid "There are no exiled users"
msgstr "Det er ingen i eksilbrukere"

#, machine, plain1
msgid "There are no guildmaster invitations."
msgstr "Det er ingen guild moderator invitasjoner."

#, machine, plain1
msgid "There are no guildmasters."
msgstr "Det finnes ingen guild moderatorer."

#, machine, plain1
msgid "There are no posts here."
msgstr "Det er ingen innlegg her."

#, machine, plain1, python-format
msgid "There is no account named @%(name)s."
msgstr "Det er ingen konto som heter @%(name)s."

#, machine, plain2
msgid "There is nothing here to appeal."
msgstr "Det er ikke noe å appellere til."

#, machine, plain1
msgid "There is nothing to save yet."
msgstr "Det er ingenting å redde enda."

#, machine, plain2
msgid "There is nothing waiting for this ban."
msgstr "Det er ingenting som venter på dette forbudet."

#, machine, plain1
msgid "There was a problem. Please try again."
msgstr "Det var et problem. Prøv igjen."

#, machine, plain1
msgid "There were no names in that file."
msgstr "Det var ingen navn i den filen."

#, machine, plain1
msgid "There were no survivors."
msgstr "Det var ingen overlevende."

#, machine, plain1
msgid "There's a shortage of perfect request entities in this world. Would be a pity to damage yours."
msgstr "Det er mangel på perfekte forespørsler i denne verden. Det vil være synd å skade deg."

#, machine, plain1
msgid "There's already an open proposal like this one."
msgstr "Det finnes allerede et åpent forslag som denne."

#, machine, plain1
msgid "There's no account with that name."
msgstr "Det er ingen konto med navnet."

#, machine, plain1
msgid "There's no invitation to speak."
msgstr "Det er ingen invitasjon til å snakke."

#, machine, plain2
msgid "There's no recovery code to keep yet."
msgstr "Det er ingen gjenopprettingskode å holde ennå."

#, machine, plain1
msgid "There's nothing here right now."
msgstr "Det er ingenting her akkurat nå."

#, machine, plain1
msgid "There's nothing left here but a giant smouldering crater."
msgstr "Det er ingenting igjen her, men et enormt krater."

#, machine, plain1
msgid "These are the users you are subscribed to."
msgstr "Dette er brukerne du abonnerer på."

#, machine, plain1
msgid "These counts start from the day guild insights were switched on: before that the site did not record when people left a guild or how often its page was opened."
msgstr "Disse tellingene starter fra daggulde innsiktene ble slått på: før det ble nettstedet ikke registrert når folk forlot en guild eller hvor ofte siden ble åpnet."

#, machine, plain1
msgid "These filters are saved as your default"
msgstr "Disse filtrene lagres som standard"

#, machine, plain1
msgid "These topics"
msgstr "Disse emnene"

#, machine, plain1, python-format
msgid "These users have been invited to moderate +%(guild)s."
msgstr "Disse brukerne er invitert til moderat +%(guild)s."

#, machine, plain1
msgid "They already have this role."
msgstr "De har allerede denne rollen."

#, machine, plain1
msgid "They are 18 or over, so they can make their own account."
msgstr "De er 18 eller over, så de kan gjøre sin egen konto."

#, machine, plain1
msgid "They are already in this circle."
msgstr "De er allerede i denne sirkelen."

#, machine, plain1
msgid "They are not told. Anyone you block leaves your circles."
msgstr "De blir ikke fortalt. Alle du blokkerer forlater sirklene."

#, machine, plain2
msgid "They are signed out everywhere, chat apps included. If they use chat, they may need their recovery code, or a browser where they've used chat, to read their old messages."
msgstr "De er frakoblet overalt, chat apps inkludert. Hvis de bruker chat, kan de trenge sin gjenopprettingskode, eller en nettleser der de har brukt chat, for å lese sine gamle meldinger."

#, machine, plain1, python-format
msgid "They aren't in %(circle)s."
msgstr "De er ikke i %(circle)s."

#, machine, plain1
msgid "They aren't in this group."
msgstr "De er ikke i denne gruppen."

#, machine, plain1
msgid "They aren't muted here."
msgstr "De er ikke dempet her."

#, machine, plain1
msgid "They can buy and spend coins, tip, buy Premium and join or run paid circles."
msgstr "De kan kjøpe og bruke mynter, tip, kjøpe Premium og bli med eller kjøre betalte sirkler."

#, machine, plain1
msgid "They can host and join Spaces and run live threads. Voice calls in a Space also need Chat to be on."
msgstr "De kan være vert og bli med i Spaces og kjøre live tråder. Voice calls in a space trenger også å være på."

#, machine, plain1
msgid "They can message people, join group chats and make calls. The site never shows you what a chat says: chats are end-to-end encrypted. Whoever knows their password can still sign in and read them."
msgstr "De kan melde folk, bli med i gruppechatter og ringe. Nettstedet viser deg aldri hva en chat sier: chatter er end-to-end kryptert. Den som vet passordet kan fortsatt logge på og lese dem."

#, machine, plain1
msgid "They can see what you do on the site: your posts, comments, votes, bookmarks, follows, guilds, who you chat with, that your account was reported, and your recent sign-ins. The site never shows them what your chats say, because chats are end-to-end encrypted. But anyone who knows your password, a parent who chose it included, can sign in as you: change it in Security so that only you know it. They choose which of these are on for your account:"
msgstr "De kan se hva du gjør på nettstedet: innlegg, kommentarer, stemmer, bokmerker, følger, guilds, hvem du chatter med, at kontoen din ble rapportert, og dine nylige innlogginger. Siden viser dem aldri hva chatter sier, fordi chatter er slutt-til-ende kryptert. Men alle som vet passordet ditt, en forelder som valgte det inkludert, kan logge på som deg: Endre det i sikkerhet slik at bare du vet det. De velger hvilke av disse som er på for kontoen din:"

#, machine, plain2
msgid "They can start a guild. They still can't post or comment: a child account only reads."
msgstr "De kan starte en guild. De kan ikke skrive eller kommentere: en barnekonto bare leser."

#, machine, plain1
msgid "They can't comment on your posts or comments, chat with you or notify you by mentioning you. They are not told, but they may work it out if they try to comment on something of yours."
msgstr "De kan ikke kommentere på dine innlegg eller kommentarer, chatte med deg eller varsle deg ved å nevne deg. De blir ikke fortalt, men de kan trene det ut hvis de prøver å kommentere noe av din."

#, machine, plain1
msgid "They don't have this role."
msgstr "De har ikke denne rollen."

#, machine, plain1
msgid "They go straight to your coin balance."
msgstr "De går rett til myntbalansen."

#, machine, plain1
msgid "They haven't asked for that."
msgstr "De har ikke bedt om det."

#, machine, plain2
msgid "They leave the site. What they said stays in the Log as Anonymous, except for anything made in the last five minutes that nobody has commented on, which is erased. This can't be undone."
msgstr "De forlater siden. Det de sa holder seg i loggen som anonymt, bortsett fra alt som er gjort i de siste fem minuttene som ingen har kommentert, som er slettet. Dette kan ikke angres."

#, machine, plain1
msgid "They need to be in the guild, and not exiled from it."
msgstr "De trenger å være i guddommen, og ikke i eksil fra den."

#, machine, plain1
msgid "They need to join the channel first."
msgstr "De må først slutte seg til kanalen."

#, machine, plain1
msgid "They say they are 18 or over and asked you to release their account. If you do, it becomes their own and you can no longer see it."
msgstr "De sier de er 18 år eller eldre og ba deg om å frigi sin konto. Hvis du gjør det, blir det deres egen og du kan ikke lenger se det."

#, machine, plain2
msgid "They stay where they are, with your name taken off them. This can't be undone. Posts that need your name (for a Circle, or with tips) are listed afterwards as not changed."
msgstr "De blir der de er, med navnet ditt tatt av dem. Dette kan ikke angres. Poster som trenger ditt navn (for en sirkel eller med tips) er oppført etterpå som ikke endret."

#, machine, plain2, python-format
msgid "They wrote: %(note)s"
msgstr "De skrev: %(note)s"

#, machine, plain1
msgid "They're already a helper."
msgstr "De er allerede en hjelper."

#, machine, plain1
msgid "They're already on stage."
msgstr "De er allerede på scenen."

#, machine, plain1
msgid "They've already been invited to speak."
msgstr "De er allerede invitert til å snakke."

#, machine, plain1
msgid "This Circle guild is by invitation only."
msgstr "Denne sirkelen er kun av invitasjon."

#, machine, plain1
msgid "This Google account has no YouTube channel yet. Create one at youtube.com, then try again."
msgstr "Denne Google kontoen har ingen YouTube kanal ennå. Opprett en på youtube.com, og prøv deretter igjen."

#, machine, plain1
msgid "This Space"
msgstr "Dette rommet"

#, machine, plain1
msgid "This Space can't take a replay now."
msgstr "Dette rommet kan ikke spilles på nytt nå."

#, machine, plain1
msgid "This Space has already started."
msgstr "Dette rommet har allerede begynt."

#, machine, plain1
msgid "This Space has ended."
msgstr "Dette rommet er avsluttet."

#, machine, plain1
msgid "This Space has ended. Its board is still here to read."
msgstr "Dette rommet er avsluttet. Styret er fortsatt her for å lese."

#, machine, plain1
msgid "This Space has ended. Its chat is still here to read."
msgstr "Dette rommet er avsluttet. Chatten er fortsatt her for å lese."

#, machine, plain1
msgid "This Space hasn't started yet."
msgstr "Dette rommet har ikke begynt enda."

#, machine, plain1, python-format
msgid "This Space is full (%(num)s listener)."
msgid_plural "This Space is full (%(num)s listeners)."
msgstr[0] "Rommet er fullt (%(num)s lytter)."
msgstr[1] "Dette rommet er fullt (%(num)s lyttere)."

#, machine, plain1, python-format
msgid "This Space is live until %(time)s."
msgstr "Dette rommet er levende til %(time)s."

#, machine, plain1
msgid "This Space is live."
msgstr "Dette rommet er levende."

#, machine, plain1
msgid "This Space is not recorded: when it ends, it is gone, with everything in it."
msgstr "Dette rommet er ikke registrert: Når det slutter, er det borte, med alt i det."

#, machine, plain1
msgid "This Space is recorded"
msgstr "Dette rommet er registrert"

#, machine, plain1
msgid "This Space is recorded: its board stays to read when it ends."
msgstr "Dette rommet er registrert: styret forblir å lese når det slutter."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay with the video."
msgstr "Denne plassen er registrert: verten holder en replay med videoen."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay."
msgstr "Denne plassen er registrert: verten holder en replay."

#, machine, plain1
msgid "This Space isn't available."
msgstr "Dette rommet er ikke tilgjengelig."

#, machine, plain1
msgid "This Space isn't waiting to start."
msgstr "Dette rommet venter ikke på å begynne."

#, machine, plain1
msgid "This Space keeps its sound only."
msgstr "Dette rommet holder bare lyden."

#, machine, plain1
msgid "This access will expire in one hour, or earlier if you revoke it."
msgstr "Denne tilgangen vil utløpe om en time, eller tidligere hvis du trekker den tilbake."

#, machine, plain1
msgid "This account can't use chat apps."
msgstr "Denne kontoen kan ikke bruke chat-apper."

#, machine, plain1, python-format
msgid "This account has been marked 18 or over since %(date)s."
msgstr "Denne kontoen har blitt merket 18 eller over siden %(date)s."

#, machine, plain1, python-format
msgid "This account has been permanently suspended from %(site)s."
msgstr "Denne kontoen er permanent suspendert fra %(site)s."

#, machine, plain1, python-format
msgid "This account has been temporarily suspended from %(site)s. Check back later."
msgstr "Denne kontoen er midlertidig suspendert fra %(site)s. Sjekk tilbake senere."

#, machine, plain1
msgid "This account is private"
msgstr "Denne kontoen er privat"

#, machine, plain1
msgid "This account is suspended."
msgstr "Denne kontoen er suspendert."

#, machine, plain1
msgid "This account owes money, so it can't be deleted yet."
msgstr "Denne kontoen skylder penger, så det kan ikke slettes enda."

#, machine, plain1
msgid "This account posts about sensitive topics"
msgstr "Denne kontoen innlegg om sensitive emner"

#, machine, plain2
msgid "This also signs out chat everywhere else, chat apps included, except the chat this browser has used since you signed in here."
msgstr "Dette frakobler også chat overalt, chat apps inkludert, bortsett fra chatten denne nettleseren har brukt siden du logget på her."

#. %(time)s is a length of time, such as "6 months"
#, machine, plain1, python-format
msgid "This author hasn't been active for %(time)s, so isn't counted."
msgstr "Denne forfatteren har ikke vært aktiv for %(time)s, så er ikke talt."

#, machine, plain1
msgid "This bot can't take tips right now."
msgstr "Denne boten kan ikke ta tips akkurat nå."

#, machine, plain1
msgid "This bot has not been approved."
msgstr "Denne boten er ikke godkjent."

#, machine, plain1
msgid "This bot is not running."
msgstr "Denne boten kjører ikke."

#, machine, plain1
msgid "This bot's owner can't run it right now."
msgstr "Denne bots eieren kan ikke kjøre den akkurat nå."

#, machine, plain2
msgid "This browser was signed out. Sign in again to carry on."
msgstr "Denne nettleseren ble frakoblet. Logg inn igjen for å fortsette."

#, machine, plain2
msgid "This browser's notifications couldn't be turned on. Try again."
msgstr "Denne nettleserens varslinger kan ikke slås på. Prøv igjen."

#, machine, plain1, python-format
msgid "This call is full (%(num)s person)."
msgid_plural "This call is full (%(num)s people)."
msgstr[0] "Denne samtalen er full (%(num)s person)."
msgstr[1] "Dette er fullt (%(num)s personer)."

#, machine, plain1
msgid "This can't be translated right now."
msgstr "Dette kan ikke oversettes akkurat nå."

#, machine, plain2
msgid "This can't be undone. The site's admins can always see who wrote something, and if an admin bans or suspends the account for it, the Log may name the account for it."
msgstr "Dette kan ikke angres. Nettstedets administratorer kan alltid se hvem som har skrevet noe, og hvis en administrator forbyr eller suspenderer kontoen for det, kan loggen navngi kontoen for det."

#, machine, plain1
msgid "This channel doesn't ask for its rules to be accepted."
msgstr "Denne kanalen ber ikke om at reglene skal godtas."

#, machine, plain1
msgid "This channel has no messages."
msgstr "Denne kanalen har ingen meldinger."

#, machine, plain1
msgid "This channel is end-to-end encrypted: it is read and written in Chat, where your messages are unlocked."
msgstr "Denne kanalen er kryptert: den leses og skrives i Chat, der meldingene dine er låst opp."

#, machine, plain1
msgid "This channel is end-to-end encrypted: the site can't read it, so it has no word filter, slow mode, pins, search or reports."
msgstr "Denne kanalen er kryptert: nettstedet kan ikke lese den, så den har ingen ordfilter, langsom modus, pinner, søk eller rapporter."

#, machine, plain1
msgid "This channel is full."
msgstr "Denne kanalen er full."

#, machine, plain1
msgid "This channel is written from the chat itself."
msgstr "Denne kanalen er skrevet fra selve chatten."

#, machine, plain1
msgid "This channel isn't available."
msgstr "Denne kanalen er ikke tilgjengelig."

#, machine, plain1
msgid "This circle isn't taking subscribers."
msgstr "Denne sirkelen tar ikke abonnenter."

#, machine, plain1
msgid "This code can't be used. Get a new one on the computer, or sign in there with your password."
msgstr "Denne koden kan ikke brukes. Få en ny på datamaskinen, eller logg inn der med passordet ditt."

#, machine, plain1
msgid "This code has run out."
msgstr "Denne koden har gått ut."

#, machine, plain1
msgid "This comment and the comments under it"
msgstr "Denne kommentaren og kommentarene under den"

#, machine, plain1, python-format
msgid "This comment breaks %(site)s policy"
msgstr "Denne kommentaren bryter  %(site)s politikk"

#, machine, plain1
msgid "This comment can't be forwarded."
msgstr "Denne kommentaren kan ikke sendes videre."

#, machine, plain1
msgid "This comment can't be reposted."
msgstr "Denne kommentaren kan ikke skrives om."

#, machine, plain1
msgid "This comment is on a copy forwarded to a guild - ask that guild's guildmasters to remove it instead."
msgstr "Denne kommentaren er på en kopi som sendes til en guild - be om at guilds guild moderators å fjerne det i stedet."

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a>"
msgstr "Denne kommentaren er en spøkelsesby. <a href=\"%(url)s\">Logg inn</a>"

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a> to comment!"
msgstr "Denne kommentaren er en spøkelsesby. <a href=\"%(url)s\">Logg inn</a> For å kommentere!"

#, machine, plain1
msgid "This comment section is a ghost town. Be the first to comment!"
msgstr "Denne kommentaren er en spøkelsesby. Bli den første til å kommentere!"

#, machine, plain1
msgid "This comment section is a ghost town..."
msgstr "Denne kommentaren er en spøkelsesby..."

#, machine, plain1
msgid "This content has already been posted"
msgstr "Dette innholdet er allerede lagt ut"

#, machine, plain1
msgid "This copy is no longer kept."
msgstr "Denne kopien holdes ikke lenger."

#, machine, plain2
msgid "This couldn't be changed right now."
msgstr "Dette kan ikke endres akkurat nå."

#, machine, plain1
msgid "This creates a new, independent post in that guild with its own votes and comments. The title is generated from the comment's text. A link back to the original comment will be shown on the new post."
msgstr "Dette skaper et nytt, uavhengig innlegg i den gylden med egne stemmer og kommentarer. Tittelen genereres fra kommentarens tekst. En link tilbake til den opprinnelige kommentaren vil vises på det nye innlegget."

#, machine, plain1
msgid "This creates an independent copy of the post with its own votes and comments in that guild. You can forward to any guild that accepts forwards from you."
msgstr "Dette skaper en uavhengig kopi av innlegget med sine egne stemmer og kommentarer i den gylden. Du kan komme deg videre til alle dukker som tar imot fra deg."

#, machine, plain1
msgid "This curation's feed server has been asked too often. Try again in a minute."
msgstr "Denne kurert feed serveren har blitt spurt for ofte. Prøv igjen om et minutt."

#, machine, plain1
msgid "This curation's feed server has not been answering."
msgstr "Denne kurert feed-serveren har ikke svart."

#, machine, plain1
msgid "This curation's feed server has not been answering. Showing its last answer."
msgstr "Denne kurert feed-serveren har ikke svart. Viser sitt siste svar."

#, machine, plain1
msgid "This curation's guilds and accounts"
msgstr "Denne kurerte fôrets guilds og kontoer"

#, machine, plain1
msgid "This curation's rules took too long to run. Its owner can make them narrower."
msgstr "Dette kurerte fôrets regler tok for lang tid å løpe. Eieren kan gjøre dem smalere."

#, machine, plain2
msgid "This decision can't be appealed."
msgstr "Denne avgjørelsen kan ikke appelleres."

#, machine, plain2
msgid "This decision has already been lifted."
msgstr "Denne avgjørelsen er allerede fjernet."

