#, machine, plain1
msgid "Working it out…"
msgstr "یہ باہر کام …"

#. a tab: write the post's text (beside Preview)
#, machine, plain1
msgid "Write"
msgstr "لکھیں"

#, machine, plain1
msgid "Write something first."
msgstr "پہلے کچھ لکھیں ۔."

#, machine, plain1
msgid "Write what you want to tell us."
msgstr "آپ ہمیں بتانا چاہتے ہیں کیا لکھیں."

#, glossary, machine, plain1
msgid "Yes"
msgstr "ہاں"

#, machine, plain1
msgid "Yes, cancel it"
msgstr "جی ہاں، اسے منسوخ"

#. the name under your own picture in a call; "Someone" stands for a person
#. whose name is unknown
#. beside your own name in a group chat's list of people
#. in place of your own name among the people in a Space
#. the label on your own camera's picture in a Space's call
#. in place of your own name over your messages on a Space's board
#, machine, plain1
msgid "You"
msgstr "آپ"

#, glossary, machine, plain1
msgid "You already did that"
msgstr "آپ یہ پہلے ہی کر چکے ہیں"

#, machine, plain1
msgid "You already reported this comment."
msgstr "آپ نے پہلے ہی اس تبصرے کی اطلاع دی تھی۔."

#, machine, plain1
msgid "You already reported this post."
msgstr "آپ نے پہلے ہی اس پوسٹ کو رپورٹ کیا ہے."

#, machine, plain1
msgid "You already voted on this post."
msgstr "تم نے پہلے ہی اس پوسٹ پر ووٹ دیا."

#, glossary, machine, plain1, python-format
msgid "You are blocking @%(name)s"
msgstr "آپ نے @%(name)s کو بلاک کیا ہوا ہے"

#, machine, plain1, python-format
msgid "You are following @%(name)s."
msgstr "تم اس پر عمل کر رہے ہیں @%(name)s."

#, machine, plain1, python-format
msgid "You called · video · %(when)s · %(length)s"
msgstr "آپ کو ویڈیو. %(when)s * %(length)s"

#, machine, plain1, python-format
msgid "You called · voice · %(when)s · %(length)s"
msgstr "آپ × آواز بلند کرتے ہیں %(when)s * %(length)s"

#, machine, plain1
msgid "You can ask for a community note once for each comment, and not on your own comment."
msgstr "آپ ہر تبصرے کے لئے ایک بار پھر اپنے تبصرے کیلئے درخواست کر سکتے ہیں ۔."

#, machine, plain1
msgid "You can ask for a community note once for each post, and not on your own post."
msgstr "آپ ہر پوسٹ کے لئے ایک بار ایک کمیونٹی نوٹ طلب کر سکتے ہیں اور اپنی پوسٹ پر نہیں ۔."

#, machine, plain1, python-format
msgid "You can have %(num)s folder at most."
msgid_plural "You can have %(num)s folders at most."
msgstr[0] "آپ کے پاس %(num)s فولڈر ہو سکتا ہے."
msgstr[1] "آپ کو سب سے زیادہ میں %(num)s فولڈر ہو سکتا ہے."

#, machine, plain1
msgid "You can read this channel but not write in it."
msgstr "آپ اس چینل کو پڑھ سکتے ہیں مگر اس میں نہیں لکھتے۔."

#, machine, plain1
msgid "You can see who is here, but you can't speak in this channel."
msgstr "آپ دیکھ سکتے ہیں کہ یہاں کون ہے، لیکن آپ اس چینل میں بات نہیں کر سکتے."

#, glossary, machine, plain1
msgid "You can't do that."
msgstr "آپ یہ نہیں کر سکتے۔"

#, machine, plain1
msgid "You can't message that person."
msgstr "آپ اس شخص کو پیغام نہیں دے سکتے۔."

#, machine, plain1
msgid "You can't send to that chat."
msgstr "آپ اس گفتگو میں نہیں بھیج سکتے."

#, machine, plain1
msgid "You can't start a chat with them."
msgstr "آپ ان کے ساتھ گفتگو شروع نہیں کر سکتے."

#, machine, plain1
msgid "You can’t edit this draft any more (you may have left it or been removed)."
msgstr "آپ اِس ڈر میں کوئی تبدیلی نہیں کر سکتے کہ آپ نے اِسے چھوڑ دیا ہے یا آپ کو ہٹا دیا ہے ۔."

#, machine, plain1
msgid "You ended the Space."
msgstr "آپ نے اسپیس ختم کر دیا۔."

#, machine, plain1
msgid "You have no curations yet."
msgstr "آپ کو ابھی تک کوئی شفا‌بخش خوراک نہیں ملی ۔."

#, machine, plain1
msgid "You have no stories yet. Share one first."
msgstr "آپ کے پاس ابھی تک کوئی کہانیاں نہیں ہیں۔ سب سے پہلے شیئر کریں."

#, machine, plain1
msgid "You haven't made a circle of your own yet. Your Friends circle is automatic: it is everyone you follow who follows you back."
msgstr "آپ نے ابھی تک اپنا حلقہ نہیں بنایا تھا۔ آپ کا دوست حلقہ خودکار ہے: یہ سب آپ کی پیروی کرنے والے ہیں ۔."

#, machine, plain1
msgid "You left the Space."
msgstr "تم نے اسپیس چھوڑ دیا."

#, machine, plain1
msgid "You left the call."
msgstr "آپ نے دعوت چھوڑ دی۔."

#, machine, plain1, python-format
msgid "You unfollowed @%(name)s."
msgstr "آپ بغیر اجازت دیے @%(name)s."

#, machine, plain1
msgid "You were removed from this Space."
msgstr "آپ کو اس خلائی جہاز سے ہٹا دیا گیا۔."

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "تم بہت کر رہے ہیں. بعدازاں کوشش کریں ۔."

#, machine, plain1
msgid "You're no longer in this Space."
msgstr "اب آپ اس خلائی میں نہیں ہیں."

#, machine, plain1
msgid "You're the only one here."
msgstr "تم یہاں واحد ہو."

#, machine, plain1
msgid "Your app is verified"
msgstr "آپ کی app توثیق کی گئی ہے"

#, machine, plain1
msgid "Your browser blocked the window for connecting. Allow pop-ups for this site, or connect in the settings."
msgstr "آپ کے براؤزر نے متصل ہونے کے لیے ونڈو بلاک کیا. اس سائٹ کے لیے پاپ اپ اجازت دیں، یا پھر ترتیبات میں رابطہ کریں۔."

#, machine, plain1
msgid "Your chat devices can't be listed right now."
msgstr "آپ کے گفتگو کے اوزار ابھی درج نہیں کیے جا سکتے۔."

#, machine, plain1
msgid "Your chats"
msgstr "آپ کی گفتگو"

#, machine, plain1
msgid "Your chats will work again on this device, but messages from before can't be read here (or anywhere without your old key)."
msgstr "آپ کی گفتگو پھر سے اس اوزار پر کام کرے گی لیکن قبل از وقت یہاں (یا کسی بھی جگہ آپ کی پرانی کلید کے بغیر) پیغامات نہیں پڑھے جا سکتے۔."

#, machine, plain1
msgid "Your comment could not be posted. Try again."
msgstr "آپ کا تبصرہ پوسٹ نہیں کیا جا سکا۔ دوبارہ کوشش کریں."

#, machine, plain1
msgid "Your edit couldn't be saved. Please check your connection and try again."
msgstr "آپ کی تدوین نہ کی جا سکی۔ براہ کرم اپنا اتصال چیک کریں اور پھر کوشش کریں۔."

#, machine, plain1
msgid "Your edit couldn't be saved. Please try again."
msgstr "آپ کی تدوین نہ کی جا سکی۔ براہ مہربانی دوبارہ کوشش کریں."

#, machine, plain1
msgid "Your files stay in your own account there, using its free space. This site only shows them in your posts."
msgstr "آپ کی فائلیں وہاں آپ کے اکاؤنٹ میں رہیں، اس کی مفت فضا استعمال کرتے ہوئے. یہ سائٹ صرف آپ کے پوسٹ میں دکھائی دیتی ہے۔."

#, machine, plain1
msgid "Your guilds' chats"
msgstr "آپ کے گلوکاروں کی گفتگو"

#. placeholder text a member replaces: the headline of a "Call to action"
#. block, and its button's label
#, machine, plain1
msgid "Your headline"
msgstr "آپ کی شناخت"

#, machine, plain1
msgid "Your key can't be shown right now."
msgstr "آپ کی کلید کو ابھی ظاہر نہیں کیا جا سکتا۔."

#, machine, plain1
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "آپ کی کلید ایک بڑے پاس ورڈ سے اخذ کی گئی تھی۔ اس سائٹ پر گفتگو کریں اور ایک بار اپنے بحالی کوڈ میں داخل کریں، پھر یہ یہاں کھلتا ہے۔."

#, machine, plain1
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "آپ کا پاس ورڈ تبدیل ہوا جب سے اس گفتگو کی کلید بند کردی گئی تھی۔ جب گفتگو شروع کی گئی تو بحالی شدہ کوڈ آپ نے محفوظ کر لیا."

#, machine, plain1
msgid "Your recovery code"
msgstr "آپ کا دوبارہ حل"

#, machine, plain1
msgid "Your saved templates show up here."
msgstr "آپ کی محفوظ ٹیمپل یہاں ظاہر کرتے ہیں."

#, machine, plain1
msgid "Your settings have been updated."
msgstr "آپ کی ترتیبات تجدید کی گئیں۔."

#, machine, plain1
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "آپ کا ذخیرہ دوبارہ جوڑنے کی ضرورت ہے. اپنی آڈیو بھیجنے کے لئے:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your pictures to:"
msgstr "آپ کا ذخیرہ دوبارہ جوڑنے کی ضرورت ہے. اپنی تصاویر ارسال کریں:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your videos to:"
msgstr "آپ کا ذخیرہ دوبارہ جوڑنے کی ضرورت ہے. اپنے ویڈیوز بھیج دیں:"

#. %(zone)s is a time zone name such as Europe/London
