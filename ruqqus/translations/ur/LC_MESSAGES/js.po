msgid "Your time zone: %(zone)s"
msgstr "آپ کا وقت علاقہ: %(zone)s"

#, machine, plain1
msgid "Your vote is on another copy of this Space, or it can't change any more."
msgstr "آپ کا ووٹ اس اسپیس کی ایک اور نقل پر ہوتا ہے یا یہ مزید تبدیل نہیں ہو سکتا۔."

#, machine, plain1
msgid "You’re all caught up"
msgstr "آپ سب کو پکڑ لیا ہے"

#, machine, plain1
msgid "You’re all caught up."
msgstr "تم سب نے پکڑ لیا ہے."

