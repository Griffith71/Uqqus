msgstr[1] "آپ پہلے ہی گولوں کی سب سے زیادہ تعداد کی قیادت کرتے ہیں۔ اگر آپ %(num)s یا کم گولیوں کی قیادت نہیں کر سکتے تو آپ پہلے سے ہی ایک گول موڈر کو ختم کرنے کی کوشش کر سکتے ہیں۔."

#, machine, plain1, python-format
msgid "You are currently suspended from %(site)s. You cannot siege any guilds at this time."
msgstr "تم اس وقت کی (حالت کو) مہلت دیتے ہو۔ %(site)s. آپ اس وقت کسی گلوکار کا دعویٰ نہیں کر سکتے."

#, machine, plain1
msgid "You cannot siege any Guilds right now. You can only make one siege attempt every 7 days, and your account must be at least 7 days old."
msgstr "آپ اس وقت کوئی گولڈ کا دعویٰ نہیں کر سکتے۔ آپ ہر 7 دن کے بعد صرف ایک شخص کو اپنے عہدے پر فائز کر سکتے ہیں ۔."

#, machine, plain1
msgid "You may attempt to siege a guild once every 7 days. Any siege attempt - whether successful or not - will trigger this cool-down period."
msgstr "شاید آپ ہر 7 دن میں ایک مرتبہ ایک گول کا دعویٰ کرنے کی کوشش کریں ۔ کوئی بھی شخص کوشش کا دعویٰ کرتا ہے کہ خواہ وہ کامیاب ہو یا نہ ہو۔."

#, machine, plain1
msgid "You need to be logged in to siege a Guild."
msgstr "آپ کو گولڈ کا دعوی کرنے کے لیے لاگو ہونے کی ضرورت ہے۔."

#, machine, plain1
msgid "You should overwrite the previous access code and expiration timestamp with this new information. Continue to use the access token as in Step 5, until it expires."
msgstr "آپ کو اس نئی معلومات کے ساتھ سابقہ رسائی کوڈ اور تنصیب اوقات کو لکھنے چاہئیں. اِس میں کوئی شک نہیں کہ آپ اِس بات کا اندازہ لگا سکتے ہیں ۔."

