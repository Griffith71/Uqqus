msgid "Capitalize \"%(company)s\""
msgstr "دارالحکومت \"%(company)s\""

#, machine, plain1, python-format
msgid "Capitalize \"%(site)s\", except when using it as part of \"ruqqus.com\" or within links"
msgstr "دارالحکومت \"%(site)s\" سوائے اس وقت جب اسے \"ruqus.com\" یا تعلقات کے حصے کے طور پر استعمال کرتے ہیں۔"

#, machine, plain1
msgid "Capitalize \"ruqqus.com\""
msgstr "Capitalize \"ruqus.com\""

