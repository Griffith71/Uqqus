#, machine, plain1
msgid "You need more Reputation before you can make a Guild."
msgstr "گولڈ بنانے سے پہلے آپ کو مزید اصلاح کی ضرورت ہے۔."

#, machine, plain1
msgid "You need more Reputation."
msgstr "آپ کو مزید بحالی کی ضرورت ہے."

#, machine, plain1
msgid "You need to actually write something!"
msgstr "آپ کو اصل میں کچھ لکھنا ہوگا!"

#, machine, plain1
msgid "You need to log in if you want to get into this castle."
msgstr "اگر آپ اس قلعے میں داخل ہونا چاہتے ہیں تو آپ کو لاگ ان کرنے کی ضرورت ہے۔."

#, machine, plain1
msgid "You need to step down from a guild before you can make any more."
msgstr "اس سے پہلے کہ آپ مزید کچھ کر سکیں ایک گول سے نیچے قدم رکھ لیں۔."

#, machine, plain1
msgid "You need to wait 7 days between name changes."
msgstr "نام تبدیل کرنے کے درمیان 7 دن انتظار کرنا ہوگا۔."

#, machine, plain1
msgid "You need to wait 7 days between siege attempts."
msgstr "آپ کو اپنے دعوے کی کوششوں کے درمیان 7 دن انتظار کرنا ہوگا ۔."

#, machine, plain1
msgid "You need to wait a bit."
msgstr "آپ کو تھوڑا انتظار کرنے کی ضرورت ہے."

#, machine, plain1
msgid "You post timestamped updates as things happen; everyone comments under them."
msgstr "آپ نے وقتاًفوقتاً تجدید کی ہے جیسے کہ کچھ ہوتا ہے، سب ان کے تحت تبصرہ کرتے ہیں۔."

#, machine, plain1, python-format
msgid "You told us you wanted to change your %(site)s account email. To finish this process, please verify your new email address:"
msgstr "آپ نے ہمیں بتایا کہ آپ کو تبدیل کرنا چاہتا ہے %(site)s اکاؤنٹ ای میل. اس عمل کو ختم کرنے کے لیے، اپنے نئے ای میل کی تصدیق کریں:"

#, machine, plain1
msgid "You won't be notified of comments on this post."
msgstr "آپ کو اس پوسٹ پر تبصروں کی اطلاع نہیں دی جائے گی."

#, machine, plain1
msgid "You'll be notified of comments on this post."
msgstr "آپ کو اس پوسٹ پر تبصروں کی اطلاع نہیں ملے گی۔."

#, machine, plain1, python-format
msgid "You'll be told about everything @%(name)s does."
msgstr "آپ کو سب کچھ کے بارے میں بتایا جائے گا @%(name)s جی ہاں."

#, machine, plain1, python-format
msgid "You'll be told when +%(guild)s's guildmasters make an announcement."
msgstr "آپ کو کب + بتا دیا جائے گا%(guild)s' گولڈ مدارس ایک اعلان کرتے ہیں۔"

#, machine, plain1
msgid "You're all caught up"
msgstr "تم سب پکڑے گئے ہیں"

#, machine, plain1
msgid "You're already in this Space in another window."
msgstr "آپ پہلے ہی اسپیس میں ایک اور کھڑکی میں ہیں."

#, machine, plain1
msgid "You're already in this call in another window."
msgstr "آپ اس کال میں پہلے ہی ایک اور کھڑکی میں ہیں."

#, machine, plain1
msgid "You're already in this group."
msgstr "آپ پہلے ہی اس گروپ میں ہیں."

#, machine, plain1
msgid "You're blocking this user, but you can see this comment because it's an admin comment."
msgstr "آپ اس صارف کو بلاک کر رہے ہیں لیکن آپ اس تبصرے کو دیکھ سکتے ہیں کیونکہ یہ اشتہارین تبصرہ ہے۔."

#, machine, plain1
msgid "You're blocking this user, but you can see this comment because it's in your guild."
msgstr "آپ اس صارف کو بلاک کر رہے ہیں لیکن آپ اس تبصرے کو دیکھ سکتے ہیں کیونکہ یہ آپ کی گولائی میں موجود ہے۔."

#, machine, plain1
msgid "You're blocking this user, but you can see this comment because you're an admin."
msgstr "آپ اس صارف کو بلاک کر رہے ہیں، لیکن آپ کی وجہ سے یہ تبصرہ دیکھا جا سکتا ہے۔."

#, glossary, machine, plain1
msgid "You're blocking this user."
msgstr "آپ نے اس صارف کو بلاک کیا ہوا ہے۔"

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "تم بہت کر رہے ہیں. بعدازاں کوشش کریں ۔."

#, machine, plain1, python-format
msgid "You're in. It renews in 30 days for %(num)s coins unless you cancel."
msgid_plural "You're in. It renews in 30 days for %(num)s coins unless you cancel."
msgstr[0] "تم اندر ہو. یہ 30 دنوں میں %(num)s روپے کے لیے دوبارہ تعمیر کرتا ہے جب تک آپ منسوخ نہ کر لیں۔."
msgstr[1] "تم اندر ہو. یہ 30 دنوں میں %(num)s روپے کے لیے دوبارہ تعمیر کرتا ہے جب تک آپ کو ختم نہ کیا جائے۔."

#, machine, plain1
msgid "You're invited to speak."
msgstr "آپ کو بولنے کی دعوت دی جاتی ہے۔."

#, python-format
msgid "You're invited to write a shared draft with others. [See the invitation](%(link)s)"
msgstr ""

#, machine, plain1
msgid "You're not following any curations yet."
msgstr "آپ ابھی تک کسی بھی شفا یافتہ خوراک کی پیروی نہیں کر رہے ہیں."

#, machine, plain1
msgid "You're not in this Space."
msgstr "تم اس خلائی میں نہیں ہیں."

#, machine, plain1
msgid "You're sending messages too quickly. Wait a moment."
msgstr "آپ بہت جلد پیغامات بھیج رہے ہیں۔ ایک لمحے رکو."

#, machine, plain1, python-format
msgid "You're subscribed. It renews in 30 days for %(num)s coins unless you cancel."
msgid_plural "You're subscribed. It renews in 30 days for %(num)s coins unless you cancel."
msgstr[0] "تم ٹھیک کر رہے ہیں. یہ 30 دنوں میں %(num)s روپے کے لیے دوبارہ تعمیر کرتا ہے جب تک آپ منسوخ نہ کر لیں۔."
msgstr[1] "تم ٹھیک کر رہے ہیں. یہ 30 دنوں میں %(num)s روپے کے لیے دوبارہ تعمیر کرتا ہے جب تک آپ کو ختم نہ کیا جائے۔."

#, machine, plain1
msgid "You're writing very fast. Wait a moment."
msgstr "آپ بہت تیز لکھتے ہیں۔ ایک لمحے رکو."

#, machine, plain1
msgid "You've added a lot of people to groups today. Try again tomorrow."
msgstr "آپ نے بہت سے لوگوں کو گروہوں میں شامل کیا۔ کل پھر کوشش کریں."

#, machine, plain1
msgid "You've already reported this Space."
msgstr "آپ نے پہلے ہی اس خلائی جہاز کی اطلاع دی ہے۔."

#, machine, plain1
msgid "You've already reported this message."
msgstr "آپ نے پہلے ہی یہ پیغام سنایا ہے۔."

#, machine, plain1
msgid "You've already reposted this."
msgstr "تم نے پہلے ہی اس کو دوبارہ اپلوڈ کیا ہے."

#, machine, plain1, python-format
msgid "You've been in this voice channel for %(num)s hour. Join again if you're still here."
msgid_plural "You've been in this voice channel for %(num)s hours. Join again if you're still here."
msgstr[0] "آپ %(num)s گھنٹے تک اس آواز چینل میں رہے۔ اگر آپ ابھی بھی یہاں ہیں تو دوبارہ شامل."
msgstr[1] "آپ %(num)s گھنٹے اس آواز چینل میں رہے۔ اگر آپ ابھی بھی یہاں ہیں تو دوبارہ شامل."

#, machine, plain1, python-format
msgid "You've been invited to be a guildmaster of <span class=\"font-weight-bold\">+%(guild)s</span>. You will have full permissions over the guild."
msgstr "آپ کو گولڑ مدارس کی دعوت دی گئی۔ <span class=\"font-weight-bold\">+%(guild)s</span>. آپ کے پاس گولڈ پر مکمل اجازہ ہوگا."

#, machine, plain1
msgid "You've joined voice channels a lot in the last hour. Try again later."
msgstr "آپ آخری گھڑی میں آواز کے چینلوں میں کثرت سے شامل ہو گئے۔ بعدازاں کوشش کریں ۔."

#, machine, plain1
msgid "You've sent a lot of feedback today. Try again tomorrow."
msgstr "آپ نے آج بہت سے رد عمل بھیجے ہیں۔ کل پھر کوشش کریں."

#, machine, plain1
msgid "You've sent a lot of reports today. Try again tomorrow."
msgstr "آج آپ نے بہت سی اطلاعات بھیجیں۔ کل پھر کوشش کریں."

#, machine, plain1
msgid "You've started a lot of calls in the last hour. Try again later."
msgstr "آپ نے آخری گھڑی میں بہت سے دعوتوں کا آغاز کیا۔ بعدازاں کوشش کریں ۔."

#, machine, plain1
msgid "YouTube did not accept that video."
msgstr "YouTube اس ویڈیو کو قبول نہیں کیا۔"

#, machine, plain1
msgid "YouTube is not taking more uploads right now. Try again later."
msgstr "YouTube اب زیادہ اپ لوڈ نہیں کر رہا. بعدازاں کوشش کریں ۔"

#, machine, plain1
msgid "YouTube link"
msgstr "YouTube لنک"

#, machine, plain1, python-format
msgid "Your %(site)s account has been permanently suspended due to a Terms of Service violation."
msgstr "آپ %(site)s خدمات کی خلاف ورزی کی وجہ سے اکاؤنٹ مستقل طور پر معطل کر دیا گیا ہے۔"

