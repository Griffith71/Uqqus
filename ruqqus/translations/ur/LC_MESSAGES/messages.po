#, machine, plain1
msgid "This draft hasn't been published."
msgstr "یہ ڈرافٹ شائع نہیں ہو سکا ہے۔."

#, machine, plain1
msgid "This event is over."
msgstr "یہ واقعہ ختم ہو گیا۔."

#, machine, plain1
msgid "This event was cancelled."
msgstr "یہ واقعہ منسوخ کر دیا گیا۔."

#, machine, plain1
msgid "This exact phrase"
