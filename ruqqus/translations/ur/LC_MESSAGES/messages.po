msgstr "یہ تبصرہ پیش نہیں کیا جا سکتا۔."

#, machine, plain1
msgid "This comment can't be reposted."
msgstr "یہ تبصرہ دوبارہ نہیں کیا جا سکتا۔."

#, machine, plain1
msgid "This comment is on a copy forwarded to a guild - ask that guild's guildmasters to remove it instead."
msgstr "یہ تبصرہ ایک کاپی پر ہے جسے گولڈ میں درج کیا گیا ہے - کہ گولڈ کے گول موڈر اسے ہٹانے کے لئے."

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a>"
msgstr "اس تبصرے کا باب ایک دیوبندی شہر ہے۔ <a href=\"%(url)s\">نشانی</a>"

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a> to comment!"
msgstr "اس تبصرے کا باب ایک دیوبندی شہر ہے۔ <a href=\"%(url)s\">نشانی</a> جواب دیں !"

#, machine, plain1
msgid "This comment section is a ghost town. Be the first to comment!"
msgstr "اس تبصرے کا باب ایک دیوبندی شہر ہے۔ سب سے پہلے تبصرہ کریں !"

#, machine, plain1
msgid "This comment section is a ghost town..."
msgstr "یہ تبصرہ ایک متحرک شہر ہے..."

#, machine, plain1
