msgstr "یہ رائے ختم ہو گئی۔."

#, machine, plain1
msgid "This poll is no longer available."
msgstr "یہ مسئلہ اب دستیاب نہیں ہے ۔."

#, machine, plain1
msgid "This post and its comments are archived and can no longer be voted on."
msgstr "یہ پوسٹ اور اس کے تبصرے محفوظہ میں بنائے گئے ہیں اور اب ووٹ نہیں دیے جا سکتے۔."

#, machine, plain1, python-format
msgid "This post breaks %(site)s policy"
msgstr "یہ پوسٹ ٹوٹ جاتا ہے۔ %(site)s پالیسی"

#, machine, plain1
msgid "This post can't be forwarded."
msgstr "اس پوسٹ کو آگے نہیں چھوڑا جا سکتا۔."

#, machine, plain1
msgid "This post can't be reposted."
msgstr "یہ پوسٹ دوبارہ نہیں کیا جا سکتا۔."

#, machine, plain1
msgid "This post can't go live."
msgstr "یہ پوسٹ زندہ نہیں رہ سکتا۔."

#, machine, plain1
msgid "This post does not exist."
msgstr "یہ مضمون موجود نہیں ہے ۔."

#, machine, plain1
