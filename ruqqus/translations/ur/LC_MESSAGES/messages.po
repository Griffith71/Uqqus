msgstr "یہ تجویز بند ہے۔."

#, machine, plain1
msgid "This queue is empty. (That's a good thing.)"
msgstr "یہ قطر خالی ہے۔ (یہ ایک اچھی بات ہے۔"

#, machine, plain1
msgid "This requires entering a randomly-generated, 6-digit code and your password to login. See <a href=\"#\">Google Authenticator</a> or <a href=\"#\">Authy</a> for more details."
msgstr "اس میں داخل ہونے کے لیے ایک غیر واضح شناختی کوڈ، 6-digit code اور آپ کا پاس ورڈ لاگس کے لیے داخل کرنا ہوتا ہے۔ دیکھیں <a href=\"#\">Google ایتھنز</a> یا <a href=\"#\">Autho</a> مزید تفصیلات کے لیے."

#, machine, plain1
msgid "This revision was removed by the site's admins."
msgstr "اس ترمیم کو سائٹ کے ادیان نے ہٹا دیا تھا۔."

#. %(error)s is the reason, a whole sentence such as "You are posting too
#. fast."
#, machine, plain1, python-format
msgid "This scheduled post could not be published: %(error)s Fix it, then post it or schedule it again."
msgstr "یہ طے شدہ پوسٹ شائع نہیں ہو سکا: %(error)s Fix یہ، پھر اسے مرتب کریں یا پھر اسے دوبارہ ترتیب دیں۔"

#. from:, in: are search operators and stay as they are
#, machine, plain1
msgid "This search took too long. Add words, or narrow it with from:, in: or a date."
msgstr "یہ تلاش بہت طویل ہو گئی۔ الفاظ کو شامل کریں یا اس کو تنگ کریں : میں: یا تاریخ۔."

#, machine, plain1
msgid "This sign-in can't go on"
msgstr "یہ نشان آگے نہیں جا سکتا"

#, machine, plain1
msgid "This sign-in request didn't come from a chat app this site knows."
msgstr "یہ نشان درخواست چیت ایپ سے معلوم نہیں ہوتی تھی۔."

#, machine, plain1
msgid "This topic has dropped off the list. <a href=\"/trending\">See what is trending now</a>."
msgstr "اِس موضوع پر ایک فہرست ڈالی گئی ہے ۔ <a href=\"/trending\">دیکھیں کہ اب کیا رُجحان رہا ہے</a>."

#, machine, plain1
msgid "This user has blocked you"
msgstr "اس صارف نے آپ کو روک دیا ہے۔"

#, machine, plain1
