msgid "The feed server's answer is too large."
msgstr "کھانے والا سرور کا جواب بہت بڑا ہے۔."

#, machine, plain1
msgid "The feed server's certificate could not be checked."
msgstr "کھانے پینے والے سرور کی سند کا جائزہ نہیں لیا جا سکا۔."

#, machine, plain1
msgid "The feed server's cursor is not usable."
msgstr "کھانے کے سرور کی دیکھ بھال ہمارے قابل نہیں ہے."

#, machine, plain1
msgid "The feed's address sends it somewhere else too many times."
msgstr "کھانے کا پتہ کسی اور جگہ بھی بھیجا جاتا ہے۔."

#, machine, plain1
msgid "The feed's answer is too large."
msgstr "کھانے کا جواب بہت بڑا ہے۔."

#, machine, plain1
msgid "The feed's certificate could not be checked."
msgstr "روزینہ کی سند کا جائزہ نہیں لیا جا سکا۔."

#, machine, plain1
msgid "The file's size is missing."
msgstr "فائل کا حجم ناقص ہے۔."

#, machine, plain1, python-format
msgid "The following users are approved to forward to +%(guild)s."
msgstr "مندرجہ ذیل صارفین کو + کے آگے پیش کرنے کی منظوری دی جاتی ہے۔%(guild)s."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s guild chat."
msgstr "مندرجہ ذیل صارفین کو + میں حصہ لینے سے منع کیا گیا ہے۔%(guild)s گپ شپ."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s."
msgstr "مندرجہ ذیل صارفین کو + میں حصہ لینے سے منع کیا گیا ہے۔%(guild)s."

#, machine, plain1
msgid "The guild"
msgstr "گلاب"

#, machine, plain1
msgid "The guild already has a category with that name."
msgstr "اُس کا نام پہلے ہی سے ایک بیل ہے ۔."

#, machine, plain1
msgid "The guild already has a channel with that name."
msgstr "گولڈ پہلے ہی اس نام سے ایک چینل رکھتا ہے۔."

#, machine, plain1
msgid "The guild already has a role with that name."
msgstr "گووند پہلے ہی اس نام کے ساتھ ایک کردار رکھتا ہے۔."

#, machine, plain1
msgid "The guild's own rules for what is written in its channels, on top of the site's word filter. Guildmasters are never held to them. A message that breaks one is refused with a short reason that never says which word."
msgstr "گولڑ اپنے چینلوں میں جو کچھ لکھا جاتا ہے، اس کے لیے خود قوانین ہیں، سائٹ کے لفظ فیلڈر کے اوپر۔ گولڈ مدارس ان کے لیے کبھی منعقد نہیں کیے جاتے ہیں۔ ایک ایسا پیغام جو کسی شخص کو توڑ دیتا ہے ، اُسے ایک مختصر سی وجہ سے انکار کر دیا جاتا ہے جو کبھی یہ نہیں کہتا کہ کس لفظ کا مطلب ہے ۔."

#, machine, plain1
msgid "The host stays on stage."
msgstr "میزبان سٹیج پر رہتا ہے۔."

#, machine, plain1
msgid "The independent social platform"
msgstr "معاشرتی پلیٹ‌فارم"

#, machine, plain1
msgid "The internet gremlins have led you to a dark, musty dead-end. There's nothing here."
msgstr "انٹرنیٹ گرلز نے آپ کو ایک اندھیرے میں لے جایا ہے، ضروری ہے کہ مردہ. یہاں کچھ نہیں ہے."

#, machine, plain1, python-format
msgid "The key that opens your messages in a new app. It is locked with your password and opened here, in this browser: %(site)s never sees it. Anyone with it and your account can read your chats, so never share it."
msgstr "آپ کے پیغامات کو نئی ایپ میں کھولنے والی کلید۔ یہ آپ کے پاس ورڈ کے ساتھ پابند ہے اور یہاں کھل کر اس براؤزر میں، %(site)s یہ کبھی نہیں دیکھو. اِس کے ساتھ ساتھ آپ کے اکاؤنٹ بھی پڑھ سکتے ہیں ۔"

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s"
msgstr "لنک `%(link)s` اجازت نہیں دی گئی. وجہ: %(reason)s"

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s."
msgstr "لنک `%(link)s` اجازت نہیں دی گئی. وجہ: %(reason)s."

#, machine, plain1, python-format
msgid "The link can be at most %(num)s character."
msgid_plural "The link can be at most %(num)s characters."
msgstr[0] "تعلق زیادہ تر %(num)s حروف پر ہو سکتا ہے۔."
msgstr[1] "لنک سب سے زیادہ %(num)s حروف پر ہو سکتا ہے۔."

#, machine, plain1
msgid "The link can't contain a user name or password."
msgstr "لنک میں صارف کا نام یا پاس ورڈ نہیں ہو سکتا۔."

#, machine, plain1
msgid "The link can't contain spaces."
msgstr "لنک میں جگہ نہیں ہو سکتی۔."

#, machine, plain1
msgid "The link must start with https:// or http://."
msgstr "لنک کا آغاز https://s:// یا http://."

#, machine, plain1
msgid "The link needs a full address, such as example.com."
msgstr "لنک کو ایک مکمل پتہ کی ضرورت ہوتی ہے جیسے کہ مثال.com۔."

#, machine, plain1
msgid "The list is open to members so that anyone can see what the filter hides and why. Nothing on it is removed from the site: each member's own filter decides what they see."
msgstr "یہ فہرست ارکان کے لیے کھلی ہے تاکہ کوئی شخص یہ دیکھ سکے کہ فیلڈر کس چیز کو چھپاتے ہیں اور کیوں۔ اس پر کوئی بھی چیز اس جگہ سے دور نہیں کی جاتی: ہر عضو کے اپنے فیلڈر جو دیکھتے ہیں وہی فیصلہ کرتے ہیں۔."

#, machine, plain1
msgid "The list isn't shown on the Child filter"
msgstr "فہرست بچپن کے فیلڈر پر نہیں دکھائی گئی"

#, machine, plain1, python-format
msgid "The most a circle can ask is %(num)s coin every 30 days."
msgid_plural "The most a circle can ask is %(num)s coins every 30 days."
msgstr[0] "سب سے زیادہ چکر پوچھ سکتا ہے کہ ہر 30 دن میں %(num)s روپیہ ہوتا ہے۔."
msgstr[1] "سب سے زیادہ حلقے ہر 30 دن کے حساب سے %(num)s روپے کا ہوتا ہے۔."

#, machine, plain1
msgid "The most voted posts of the last seven days."
msgstr "آخری سات دنوں کے سب سے زیادہ ووٹ دیے گئے۔."

#, machine, plain1, python-format
msgid "The name %(host)s could not be found."
msgstr "نام %(host)s نہیں مل سکا۔"

#, machine, plain1
msgid "The numbers are always shown on your profile. This decides who can open each list and see the accounts on it. An account is only listed where its own setting allows it too."
msgstr "نمبر ہمیشہ آپ کے پرو فا ئل پر دکھائے جاتے هيں اس سے یہ فیصلہ ہوتا ہے کہ کون ہر لسٹ کھول کر اس پر اکاؤنٹ دیکھ سکتا ہے۔ اِس سلسلے میں ایک مثال پر غور کریں ۔."

#, machine, plain1
msgid "The open-source platform for independent internet communities"
msgstr "آزاد انٹرنیٹ کمیونٹیز کے لیے کھلا سرسید پلیٹ فارم"

#, machine, plain1
msgid "The original content is not retained anywhere, including in this history."
msgstr "اصل مواد کسی بھی جگہ برقرار نہیں رکھا جاتا، جس میں اس تاریخ میں شامل ہے۔."

#, machine, plain1
msgid "The other authors of a shared draft removed you as an author. What you wrote stays credited to you."
msgstr "ایک شعری ڈرافٹ کے دوسرے مصنفین نے آپ کو مصنف کے طور پر ہٹا دیا۔ جو آپ نے لکھا ہے وہ آپ پر قابلِ‌تعریف ہے ۔."

#, machine, plain1
msgid "The owner deletes a channel instead of leaving it."
msgstr "مالک اسے چھوڑنے کی بجائے چینل کو ختم کرتا ہے۔."

#, machine, plain1
msgid "The owner's role can't be changed."
msgstr "مالک کا کردار تبدیل نہیں کیا جا سکتا۔."

#, machine, plain1
msgid "The page's current text isn't shown here; what you save replaces it."
msgstr "صفحہ کا حالیہ متن یہاں نہیں دکھایا گیا ہے؛ جو آپ اس کی جگہ محفوظ کرتے ہیں۔."

#, machine, plain1
msgid "The picture could not be stored. Try again later."
msgstr "تصویر محفوظ نہ ہو سکی۔ بعدازاں کوشش کریں ۔."

#, machine, plain1
msgid "The picture goes to your own linked storage, not to this site. You can add a few words under it."
msgstr "تصویر آپ کے متصل ذخیرہ کی طرف جاتی ہے نہ کہ اس سائٹ پر۔ آپ اس کے تحت چند الفاظ شامل کر سکتے ہیں۔."

#, machine, plain1
msgid "The picture you chose"
msgstr "آپ نے منتخب کیا تصویر"

#, machine, plain1
msgid "The post appears on the profile of whoever publishes it first. Optionally forward it into guilds for community discussion: each guild gets its own independent copy with its own votes and comments. Guilds are forwarded to when the draft is first published."
msgstr "پوسٹ سب سے پہلے شائع ہونے والے شخص کے پروڈیوس پر ظاہر ہوتا ہے۔ اس کو عوامی گفتگو کے لئے تیار کِیا جاتا ہے : ہر گول کو اپنی خودی کی کاپی اپنے ووٹوں اور تبصروں سے ملتی ہے ۔ جب ڈرافٹ کو پہلی بار شائع کِیا جاتا ہے تو گِلدوں کو آگے بھیج دیا جاتا ہے ۔."

#, machine, plain1
msgid "The post carries your name and is listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your name."
msgstr "پوسٹ آپ کا نام لیتا ہے اور آپ کے پروڈیوس پر مشتمل ہوتا ہے۔ ویدوں، تبصروں اور پیشوں کو اس کے مصنف کے ساتھ مشترکہ طور پر کیا جاتا ہے، جو ترمیم کرتا ہے اور اسے حذف کرتا ہے۔ آپ کسی بھی وقت قدم اُٹھا سکتے ہیں: آپ کے نام کے بغیر پوسٹ باقی رہ سکتا ہے۔."

#, machine, plain1
msgid "The post refused the change."
msgstr "پوسٹ نے اس تبدیلی سے انکار کر دیا۔."

#, machine, plain1, python-format
msgid "The promo code `%(code)s` is not currently valid. Please begin a new transaction."
msgstr "پرمو کوڈ `%(code)s` فی الحال یہ درست نہیں ہے۔ برائے مہربانی نیا پلگ ان شروع کریں."

#, machine, plain1, python-format
msgid "The proposal for @%(name)s has been withdrawn."
msgstr "کی تجویز @%(name)s اِسے روک دیا گیا ہے ۔"

#, machine, plain1, python-format
msgid "The role %(role)s was deleted."
msgstr "کردار %(role)s حذف کر دیا گیا۔"

#, machine, plain1, python-format
msgid "The role %(role)s was made."
msgstr "کردار %(role)s بنایا گیا تھا."

#, machine, plain1, python-format
msgid "The role %(role)s was saved."
msgstr "کردار %(role)s بچ گیا ۔"

#, machine, plain1
msgid "The royal bank has told us that you owe them some coin. You'll need to pay off your debts before you can continue."
msgstr "شاہی بینک نے ہمیں بتایا ہے کہ تم انہیں کچھ روپیہ قرض دیتے ہو۔ جاری رہنے سے پہلے آپ کو قرضوں کا ادا کرنا پڑے گا۔."

#, machine, plain1
msgid "The rules"
msgstr "اصول"

#, machine, plain1
msgid "The rules below"
msgstr "درج ذیل قوانین"

#, machine, plain1, python-format
msgid "The rules can be at most %(count)s character."
msgid_plural "The rules can be at most %(count)s characters."
msgstr[0] "قوانین زیادہ تر پر ہو سکتے ہیں۔ %(count)s حرف"
msgstr[1] "قوانین زیادہ تر پر ہو سکتے ہیں۔ %(count)s حروف"

#, machine, plain1
msgid "The rules can't contain control or invisible characters."
msgstr "قوانین میں قابو یا ان دیکھے ہوئے حروف شامل نہیں ہو سکتے۔."

#, machine, plain1
msgid "The screenshot you are sending"
msgstr "آپ کو بھیجے ہوئے ہیں اسکرین شاٹ"

#. %(status)s is an HTTP status code
#, machine, plain1, python-format
msgid "The server answered %(status)s."
msgstr "سرور نے جواب دیا %(status)s."

#, machine, plain1, python-format
msgid "The server answers with the posts to show and their order; %(site)s still hides anything a viewer may not see, and tells the server nothing about who is looking. Everyone is told that an outside server ranks this curation."
msgstr "سرور نے پوسٹس کے ساتھ مل کر اور ان کی ترتیب کے لیے جواب دیا؛ %(site)s اب بھی کوئی منظر دیکھنے والا شاید نظر نہ آئے اور سرور کو کچھ بھی نہیں بتاتا کہ کون دیکھتا ہے۔ ہر شخص کو بتایا جاتا ہے کہ ایک بیرونی سرور اس ناقابلِ‌رسائی خوراک کی درجہ‌بندی کرتا ہے ۔"

#, machine, plain1, python-format
msgid "The server named %(num)s post; you can see %(seen)s of them."
msgid_plural "The server named %(num)s posts; you can see %(seen)s of them."
msgstr[0] "سرور نے %(num)s پوسٹ کا نام دیا؛ %(seen)s ان میں سے."
msgstr[1] "سرور نام %(num)s پوسٹ؛ آپ دیکھ سکتے ہیں۔ %(seen)s ان میں سے."

#, machine, plain1
msgid "The server thinks you're asking something silly. It might take you more seriously if you take off the jester outfit."
msgstr "سرور کا خیال ہے کہ آپ کو کچھ سوال کر رہے ہیں. اگر آپ مذاق اُڑایا کرتے ہیں تو شاید آپ کو زیادہ سنجیدہ لگے ۔."

#, machine, plain1
msgid "The site refused the bot's session."
msgstr "سائٹ نے بھٹو کے سیشن سے انکار کر دیا۔."

#, machine, plain1
msgid "The site's admins marked this guild sensitive, so only an admin can change this."
msgstr "اس سائٹ کے اراکین نے اس گولڈ حساسیت کی نشان دہی کی، اس لیے صرف ایک اشتہارین اس تبدیلی کو بدل سکتا ہے۔."

#, machine, plain1, python-format
msgid "The stage is full (%(num)s person)."
msgid_plural "The stage is full (%(num)s people)."
msgstr[0] "سٹیج مکمل (%(num)s فرد) ہے۔."
msgstr[1] "سٹیج پورہ (%(num)s افراد) ہے۔."

#, machine, plain1
msgid "The storage service is not answering right now. Try again in a moment."
msgstr "ذخیرہ بندی اس وقت جواب نہیں دے رہی ہے۔ ایک لمحے میں دوبارہ کوشش کریں."

#, machine, plain1, python-format
msgid "The summary can be at most %(num)s character."
msgid_plural "The summary can be at most %(num)s characters."
msgstr[0] "خلاصہ زیادہ تر %(num)s حروف پر ہو سکتا ہے۔."
msgstr[1] "خلاصہ سب سے زیادہ %(num)s حروف پر ہو سکتا ہے۔."

#, machine, plain1
msgid "The summary can be changed while the Space is live."
msgstr "اختصار کو تبدیل کیا جا سکتا ہے جبکہ اسپیس زندہ ہے۔."

#, machine, plain1
msgid "The text isn't shown: this was removed by the site's administrators."
msgstr "متن ظاہر نہیں کیا گیا: یہ جگہ کے منتظمین نے ہٹا دی تھی۔."

#, machine, plain1, python-format
msgid "The time before links must be a whole number of days, 0 to %(max)s."
msgstr "تعلقات سے پہلے وقت پوری تعداد کا ہونا ضروری ہے، 0 %(max)s."

#, machine, plain1, python-format
msgid "The time in the guild must be a whole number of days, 0 to %(max)s."
msgstr "گولڑہ میں وقت پورے دن، 0 ہونا ضروری ہے۔ %(max)s."

#, machine, plain1, python-format
msgid "The title can be at most %(num)s character."
msgid_plural "The title can be at most %(num)s characters."
msgstr[0] "عنوان زیادہ تر %(num)s حروف پر ہو سکتا ہے۔."
msgstr[1] "عنوان زیادہ تر %(num)s حروف پر ہو سکتا ہے۔."

#, machine, plain1
msgid "The two revisions have the same text."
msgstr "دونوں ترمیم شدہ ایک ہی عبارت ہے۔."

#, machine, plain1
msgid "The upload did not arrive in your Google Drive. Try again."
msgstr "اپ لوڈ آپ میں نہیں آ رہا تھا Google Driveدوبارہ کوشش کریں ۔"

#, machine, plain1
msgid "The upload did not arrive in your OneDrive. Try again."
msgstr "اپ لوڈ آپ میں نہیں آ رہا تھا OneDriveدوبارہ کوشش کریں ۔"

#, machine, plain1
msgid "The upload did not arrive. Try again."
msgstr "اپلوڈ نہیں آ رہا تھا۔ دوبارہ کوشش کریں."

#, machine, plain1, python-format
msgid "The username @%(name)s has been pre-emptively reserved for: %(who)s"
msgstr "کیا؟%(name)s پہلے سے تیار شدہ ہے: %(who)s"

#, machine, plain1
msgid "The usual order - everything from the guilds and accounts you add"
msgstr "عام ترتیب - گولوں کی طرف سے سب کچھ اور آپ کو شامل کرتے ہیں"

#, machine, plain1
msgid "The video did not finish uploading to Dailymotion. Add it again."
msgstr "ویڈیو اپ لوڈ نہیں کی گئی Dailymotion. اسے دوبارہ شامل کریں."

#, machine, plain1
msgid "The video did not finish uploading. Add it again."
msgstr "ویڈیو اپ لوڈ نہیں کی گئی۔ اسے دوبارہ شامل کریں."

#, machine, plain1, python-format
msgid "The website can be at most %(num)s character."
msgid_plural "The website can be at most %(num)s characters."
msgstr[0] "ویب سائٹ زیادہ تر %(num)s حروف پر ہو سکتی ہے۔."
msgstr[1] "ویب سائٹ زیادہ تر %(num)s حروف پر ہو سکتی ہے۔."

#, machine, plain1
msgid "The website can't contain a user name or password."
msgstr "ویب سائٹ میں صارف کا نام یا پاس ورڈ نہیں ہو سکتا۔."

#, machine, plain1
msgid "The website can't contain spaces."
msgstr "ویب سائٹ میں مقامات نہیں ہو سکتے۔."

#, machine, plain1
msgid "The website must start with https:// or http://."
msgstr "ویب سائٹ کا آغاز https:// یا http://."

#, machine, plain1
msgid "The website needs a full address, such as example.com."
msgstr "ویب سائٹ کو مثال کے طور پر مکمل پتہ کی ضرورت ہوتی ہے۔."

#, machine, plain1
msgid "The whole site <span class=\"text-muted\">(needs an age limit of a month or less)</span>"
msgstr "پوری جگہ <span class=\"text-muted\">(اس کی عمر ایک ماہ یا اس سے بھی کم ہوتی ہے۔</span>"

#, machine, plain1
