msgstr "اِس کے علاوہ اِس واقعے کے ساتھ ساتھ اِس بات کو بھی ختم کر دیا جائے گا کہ اِس کا تعلق کسی بھی طرح سے نہیں ہے ۔."

#, machine, plain1
msgid "This will hide your post and comment history from others. We will also ask search engines to not index your profile page. (Your content will still be accessible via direct link.)"
msgstr "اس سے آپ کی پوسٹنگ چھپ جائے گی اور دوسروں سے تاریخ پر تبصرہ چھپا دیا جائے گا۔ ہم تلاش کے انجن سے بھی پوچھیں گے کہ آپ کے پروڈیوس نہ کرنے کے لئے. ( آپ کا مواد ابھی تک براہِ‌راست لنک کے ذریعے دستیاب ہوگا ۔ )"

#, machine, plain1, python-format
msgid "This will permanently delete your %(site)s Account. Be careful, this cannot be undone."
msgstr "یہ ہمیشہ آپ کو حذف کر دے گا %(site)s اکاؤنٹ. محتاط رہو، یہ غلط نہیں ہو سکتا."

#, machine, plain1
msgid "Those are already the rules."
msgstr "یہ قوانین پہلے ہی ہیں۔."

#, machine, plain1
msgid "Those dates leave no days to search."
msgstr "یہ تاریخیں تلاش کے لئے کوئی دن نہیں چھوڑتا."

#, machine, plain1
msgid "Through the app"
msgstr "ایپ کے ذریعے"

#, machine, plain1
msgctxt "weekday"
msgid "Thu"
msgstr "چو"

#. a hint under the search box of the Categorical list, about the tick box of
#. each category
#, machine, plain1
msgid "Tick a category to tick all its subcategories. Untick them to keep only guilds filed under the category itself."
msgstr "اپنی تمام ذیلی گیج کو مارنے کے لئے ایک آلہ استعمال کریں. اُن کو یہ بھی پتہ نہیں تھا کہ اُن کے پاس صرف اُن کی لاشیں تھیں ۔."

#, machine, plain1
msgid "Tick the box to agree to the rules first."
msgstr "پہلے اصولوں پر عمل کرنے کیلئے بکس کو پڑھیں ۔."

#. the tooltip of a category's tick box in the Categorical list
#, machine, plain1
msgid "Ticks all its subcategories. Untick them to keep only the guilds filed under the category itself."
msgstr "اس کے تمام ذیلی گیج ٹیک. انہیں صرف گولوں کو خود نیچے نیچے رکھ دیا گیا تھا ۔."

#, glossary, machine, plain1
msgid "Time"
msgstr "وقت"

#, machine, plain1
msgid "Time range"
msgstr "مدت"

#, machine, plain1
msgctxt "how many times, table heading"
msgid "Times"
msgstr "زمانہ"

#, machine, plain1
msgid "Times are in your time zone."
msgstr "ٹائمز آپ کے وقت زون میں ہیں۔."

#, machine, plain1
