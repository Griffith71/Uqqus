msgstr "آپ کے پاس اس نام سے پہلے ہی ایک دائرے ہے."

#, machine, plain1, python-format
msgid "You already have a folder called %(name)s."
msgstr "آپ کے پاس پہلے ہی فولڈر ہے %(name)s."

#, machine, plain1, python-format
msgid "You already lead %(num)s guild."
msgid_plural "You already lead %(num)s guilds."
msgstr[0] "تم پہلے ہی %(num)s گول کی قیادت."
msgstr[1] "آپ پہلے ہی %(num)s گول کی قیادت کرتے ہیں."

#, machine, plain1, python-format
msgid "You already lead %(num)s guild. Step down from one before you lead another."
msgid_plural "You already lead %(num)s guilds. Step down from one before you lead another."
msgstr[0] "تم پہلے ہی %(num)s گول کی قیادت. ایک سے پہلے آپ ایک دوسرے کی رہنمائی کریں گے."
msgstr[1] "آپ پہلے ہی %(num)s گول کی قیادت کرتے ہیں. ایک سے پہلے آپ ایک دوسرے کی رہنمائی کریں گے."

#, machine, plain1, python-format
msgid "You already lead the maximum of %(num)s guild."
msgid_plural "You already lead the maximum of %(num)s guilds."
msgstr[0] "آپ پہلے ہی %(num)s گول کی سب سے زیادہ قیادت کرتے ہیں."
msgstr[1] "آپ پہلے ہی %(num)s گولوں کی سب سے زیادہ قیادت کرتے ہیں."

#, machine, plain1, python-format
msgid "You already made that comment: %(link)s"
msgstr "تم نے پہلے ہی یہ تبصرہ کیا ہے: %(link)s"

#, machine, plain1
msgid "You already reported this account."
msgstr "آپ نے یہ اکاؤنٹ پہلے ہی بتا دیا تھا۔."

#, machine, plain1
msgid "You already reported this story."
msgstr "آپ نے اس کہانی کو پہلے ہی بتا دیا تھا۔."

#, machine, plain1
msgid "You already voted in this poll."
msgstr "آپ نے پہلے ہی اس رائے میں ووٹ دیا۔."

#, machine, plain1, python-format
msgid "You already voted on this post, in %(guild)s, and that vote can't be changed any more."
msgstr "تم پہلے ہی اس پوسٹ پر ووٹ دیا، میں، %(guild)s، اور یہ کہ ووٹ زیادہ تبدیل نہیں کیا جا سکتا۔"

#, machine, plain1, python-format
msgid "You already voted on this post, in %(guild)s. Remove that vote to vote here."
msgstr "تم پہلے ہی اس پوسٹ پر ووٹ دیا، میں، %(guild)s. یہاں ووٹ ڈالنے کے لئے کہ ووٹ ہٹا."

#, machine, plain1
msgid "You already voted on this post, in the original post, and that vote can't be changed any more."
msgstr "آپ نے پہلے ہی اس پوسٹ پر ووٹ دیے تھے، اصل پوسٹ میں، اور یہ ووٹ تبدیل نہیں کیا جا سکتا۔."

#, machine, plain1
msgid "You already voted on this post, in the original post. Remove that vote to vote here."
msgstr "آپ نے پہلے ہی اس پوسٹ پر ووٹ دیے، اصل پوسٹ میں. کہ ووٹ یہاں لے."

#, machine, plain1, python-format
msgid "You and up to 3 helpers write; members read and react. For other circles, make it on <a href=\"%(url)s\">your channels page</a>. You can have up to 3 channels."
msgstr "آپ اور اُن کے 3 بہن‌بھائیوں کو لکھیں ۔ دوسرے حلقے کے لیے اسے اس پر بناتے ہیں۔ <a href=\"%(url)s\">آپ کے چینل</a>. آپ 3 چینل تک پہنچ سکتے ہیں."

#, machine, plain1, python-format
msgid "You are already a member of +%(guild)s"
msgstr "آپ پہلے ہی + کا حصہ ہیں%(guild)s"

#, machine, plain1
msgid "You are already a member of this guild."
msgstr "آپ پہلے ہی اس گلوکارہ کے رکن ہیں۔."

#, machine, plain1
msgid "You are already a member."
msgstr "آپ پہلے ہی ممبر ہیں."

#, machine, plain1
msgid "You are already subscribed."
msgstr "تم نے پہلے ہی سخت قسم کی."

#, machine, plain1
msgid "You are already the author."
msgstr "آپ پہلے ہی مصنف ہیں۔."

#, glossary, machine, plain1, python-format
msgid "You are blocking @%(name)s"
msgstr "آپ نے @%(name)s کو بلاک کیا ہوا ہے"

#, machine, plain1, python-format
msgid "You are blocking @%(name)s."
msgstr "آپ روک رہے ہیں @%(name)s."

#, machine, plain1, python-format
msgid "You are exiled from +%(guild)s and can't currently become a guildmaster."
msgstr "آپ + سے جلاوطن کر رہے ہیں%(guild)s اور فی الحال ایک گول موڈٹر نہیں بن سکتا."

#, machine, plain1, python-format
msgid "You are exiled from +%(guild)s."
msgstr "آپ + سے جلاوطن کر رہے ہیں%(guild)s."

#, machine, plain1
msgid "You are not a member of any guilds. Guilds you participate in will be displayed here."
msgstr "آپ کسی بھی گلوکارہ کے رکن نہیں ہیں۔ آپ یہاں شرکت میں حصہ لیں گے."

#, machine, plain1
msgid "You are taking part in the creator fund."
msgstr "آپ خالق فنڈ میں حصہ لے رہے ہیں۔."

#, machine, plain1
msgid "You are taking part."
msgstr "آپ حصہ لے رہے ہیں."

#, machine, plain1
msgid "You are tipping"
msgstr "اور بے شک تم لوگ جنگل میں پڑے ہوئے ہو۔"

#, machine, plain1, python-format
msgid "You aren't a guildmaster of +%(guild)s"
msgstr "آپ + کے گولڈ موڈٹر نہیں ہیں%(guild)s"

#, machine, plain1, python-format
msgid "You aren't a member of +%(guild)s"
msgstr "آپ + کے ممبر نہیں ہیں%(guild)s"

#, machine, plain1
msgid "You aren't a paying member of that guild."
msgstr "آپ اس گولڈ کے ایک اداکار نہیں ہیں."

#, machine, plain1, python-format
msgid "You aren't following @%(name)s"
msgstr "تم نے @%(name)s"

#, machine, plain1
msgid "You aren't subscribed to that circle."
msgstr "تم نے اس دائرے میں نہیں ہیں."

#, machine, plain1
msgid "You can add a custom avatar after earning 300 Rep."
msgstr "300 ریپیشن کی ادائیگی کے بعد آپ ایک دستور ساز شامل کر سکتے ہیں۔."

#, machine, plain1
msgid "You can add a custom banner after earning 500 Rep."
msgstr "آپ 500 ریپیشن کی ادائیگی کے بعد ایک رسمی بینر شامل کر سکتے ہیں۔."

#, machine, plain1
msgid "You can add pictures at 500 Rep, or earlier with Premium"
msgstr "آپ 500 ریپیشن میں تصاویر شامل کر سکتے ہیں یا پہلے سے ہی Premium"

#, machine, plain1
msgid "You can also change it from the line under an upload."
msgstr "اپ اپ لوڈ کے تحت لائن سے بھی اسے تبدیل کر سکتے ہیں۔."

#, machine, plain1
msgid "You can also remove this site's access any time in your Google account, under Security, Third-party access."
msgstr "آپ اس سائٹ کی رسائی کو بھی اپنے اندر کسی بھی وقت ہٹا سکتے ہیں۔ Google اکاؤنٹ، زیر سیکورٹی، تیسرا حصہ تک رسائی."

#, machine, plain1
msgid "You can always see your own posts."
msgstr "آپ اپنے پوسٹ ہمیشہ دیکھ سکتے ہیں."

#, machine, plain1
msgid "You can call once they've accepted your message request."
msgstr "آپ کو ایک بار کہ سکتے ہیں کہ انہوں نے آپ کا پیغام قبول کر لیا ہے."

#, machine, plain1
msgid "You can change the feed by replacing \"hot\" with either top, or disputed."
msgstr "آپ بالائی کے ساتھ \"ٹو\" کی جگہ تبدیل کر سکتے ہیں یا پھر بحث کر سکتے ہیں۔."

#, machine, plain1
msgid "You can change this any time in Settings."
msgstr "آپ اس کو کسی بھی بار تبدیل کرسکتے ہیں."

#, machine, plain1
msgid "You can change this for each video when you add it. Videos are uploaded as not made for kids."
msgstr "آپ اسے ہر ویڈیو کے لئے بدل سکتے ہیں جب آپ اسے جمع کرتے ہیں۔ بچوں کے لیے نہیں بنایا گیا ویڈیو اپلوڈ کی جاتی ہے۔."

#, machine, plain1
msgid "You can close this window."
msgstr "تم اس ونڈو بند کر سکتے ہیں."

#, machine, plain1, python-format
msgid "You can follow %(num)s post at most. Unfollow one first."
msgid_plural "You can follow %(num)s posts at most. Unfollow one first."
msgstr[0] "زیادہ تر آپ %(num)s پوسٹ کر سکتے ہیں. سب سے پہلے کسی کی پیروی نہ کریں ۔."
msgstr[1] "آپ %(num)s پوسٹ پر عمل کر سکتے ہیں. سب سے پہلے کسی کی پیروی نہ کریں ۔."

#, machine, plain1, python-format
msgid "You can fork %(num)s post a day."
msgid_plural "You can fork %(num)s posts a day."
msgstr[0] "آپ دن میں %(num)s پوسٹ کر سکتے ہیں."
msgstr[1] "آپ ایک دن کے لئے %(num)s پوسٹ کر سکتے ہیں."

#, machine, plain1, python-format
msgid "You can forward to at most %(num)s guild."
msgid_plural "You can forward to at most %(num)s guilds."
msgstr[0] "آپ زیادہ تر %(num)s گول پر آگے جا سکتے ہیں۔."
msgstr[1] "آپ زیادہ تر %(num)s گول پر آگے بڑھ سکتے ہیں۔."

#, machine, plain1, python-format
msgid "You can have %(num)s circle of your own at most."
msgid_plural "You can have %(num)s circles of your own at most."
msgstr[0] "آپ اپنے آپ کا %(num)s دائرے زیادہ سے زیادہ پر ہو سکتا ہے."
msgstr[1] "آپ اپنے آپ کے %(num)s دائرے زیادہ تر دائرے میں رکھ سکتے ہیں۔."

#, machine, plain1, python-format
msgid "You can have %(num)s folder at most."
msgid_plural "You can have %(num)s folders at most."
msgstr[0] "آپ کے پاس %(num)s فولڈر ہو سکتا ہے."
msgstr[1] "آپ کو سب سے زیادہ میں %(num)s فولڈر ہو سکتا ہے."

#, machine, plain1, python-format
msgid "You can have %(num)s highlight at most."
msgid_plural "You can have %(num)s highlights at most."
msgstr[0] "آپ کے پاس %(num)s نمایاں ہو سکتا ہے."
msgstr[1] "آپ کے پاس %(num)s قابل ذکر ہو سکتے ہیں۔."

#, machine, plain1, python-format
msgid "You can have %(num)s open proposal in a draft at a time."
msgid_plural "You can have %(num)s open proposals in a draft at a time."
msgstr[0] "آپ کو ایک ڈرافٹ میں %(num)s کھلا تجویز دی جا سکتی ہے۔."
msgstr[1] "آپ کسی ڈرافٹ میں %(num)s کھلا تجاویز حاصل کر سکتے ہیں۔."

#, machine, plain1, python-format
msgid "You can have %(num)s paid circle at most."
msgid_plural "You can have %(num)s paid circles at most."
msgstr[0] "آپ کے پاس %(num)s ادائیگی کا چکر زیادہ سے زیادہ ہے."
msgstr[1] "آپ %(num)s ادا کر سکتے ہیں اکثر اوقات."

#, machine, plain1, python-format
msgid "You can have at most %(num)s channel."
msgid_plural "You can have at most %(num)s channels."
msgstr[0] "آپ کے پاس زیادہ تر %(num)s چینل پر ہو سکتا ہے."
msgstr[1] "آپ اکثر %(num)s چینلوں میں ہو سکتے ہیں."

#, machine, plain1, python-format
msgid "You can host at most %(num)s Space a day."
msgid_plural "You can host at most %(num)s Spaces a day."
msgstr[0] "آپ دن میں زیادہ تر %(num)s اسپیس کی میزبانی کر سکتے ہیں."
msgstr[1] "آپ دن میں سب سے زیادہ %(num)s اسپیس کی میزبانی کر سکتے ہیں."

#, machine, plain1, python-format
msgid "You can keep %(limit)s drafts. Delete one to save another."
msgstr "آپ رکھ سکتے ہیں %(limit)s ڈرافٹ. دوسرے کو بچانے کے لئے حذف."

#, machine, plain1, python-format
msgid "You can keep %(num)s template. Delete one to save another."
msgid_plural "You can keep %(num)s templates. Delete one to save another."
msgstr[0] "آپ %(num)s ٹیمپل رکھ سکتے ہیں. دوسرے کو بچانے کے لئے حذف."
msgstr[1] "آپ %(num)s ٹیمپلز رکھ سکتے ہیں. دوسرے کو بچانے کے لئے حذف."

#, machine, plain1, python-format
msgid "You can list at most %(num)s word or phrase."
msgid_plural "You can list at most %(num)s words or phrases."
msgstr[0] "آپ زیادہ تر %(num)s لفظ یا جملے میں فہرست بنا سکتے ہیں۔."
msgstr[1] "آپ اکثر %(num)s الفاظ یا اصطلاحات میں فہرست بنا سکتے ہیں۔."

#, machine, plain1
msgid "You can look around and set up your profile; posting, comments, votes and follows open once the check is done."
msgstr "آپ اپنے اردگرد دیکھ سکتے ہیں اور اپنے پروڈیوس کر سکتے ہیں ؛ جواب ، ووٹ اور پھر چیک کرنے کے بعد کھل سکتے ہیں ۔."

#, machine, plain1, python-format
msgid "You can make %(num)s proposal a day."
msgid_plural "You can make %(num)s proposals a day."
msgstr[0] "آپ روزانہ %(num)s تجویز کر سکتے ہیں۔."
msgstr[1] "آپ دن میں %(num)s تجویز کر سکتے ہیں۔."

#, machine, plain1, python-format
msgid "You can make %(num)s wiki edit a day in a guild. Try again tomorrow."
msgid_plural "You can make %(num)s wiki edits a day in a guild. Try again tomorrow."
msgstr[0] "آپ ایک گولڈ میں ایک دن میں %(num)s ویکی ترمیم کر سکتے ہیں۔ کل پھر کوشش کریں."
msgstr[1] "آپ ایک گولڈ میں دن میں %(num)s ویکی ترمیم کر سکتے ہیں۔ کل پھر کوشش کریں."

#, machine, plain1
msgid "You can only create up to 2 guilds per day. Try again later."
msgstr "آپ روزانہ 2 گول تک ہی پیدا کرسکتے ہیں۔ بعدازاں کوشش کریں ۔."

#, machine, plain1
msgid "You can paste a screenshot here."
msgstr "آپ یہاں ایک اسکرین شاٹ دیکھ سکتے ہیں."

#, machine, plain1, python-format
msgid "You can run at most %(num)s bot."
msgid_plural "You can run at most %(num)s bots."
msgstr[0] "آپ زیادہ تر %(num)s بوٹ پر چل سکتے ہیں."
msgstr[1] "آپ زیادہ تر %(num)s بوٹوں پر چل سکتے ہیں۔."

#, machine, plain1
msgid "You can schedule a post up to a year ahead."
msgstr "آپ ایک سال آگے تک پوسٹ کرنے کا بندوبست کر سکتے ہیں ۔."

#, machine, plain1, python-format
msgid "You can send at most %(count)s message a day in a channel."
msgid_plural "You can send at most %(count)s messages a day in a channel."
msgstr[0] "آپ اکثر پر بھیج سکتے ہیں %(count)s چینل میں ایک دن پیغام بھیجیں."
msgstr[1] "آپ اکثر پر بھیج سکتے ہیں %(count)s چینل میں ایک دن پیغامات"

#, machine, plain1, python-format
msgid "You can share %(num)s story in a day. Try again later."
msgid_plural "You can share %(num)s stories in a day. Try again later."
msgstr[0] "آپ ایک دن میں %(num)s کہانی دے سکتے ہیں۔ بعدازاں کوشش کریں ۔."
msgstr[1] "ایک دن میں %(num)s کہانیاں شیئر کر سکتے ہیں۔ بعدازاں کوشش کریں ۔."

#, machine, plain1, python-format
msgid "You can start %(num)s shared draft a day."
msgid_plural "You can start %(num)s shared drafts a day."
msgstr[0] "آپ روزانہ %(num)s شیئر ڈرائنگ شروع کر سکتے ہیں."
msgstr[1] "آپ ہر روز %(num)s شیئر ڈرائنگ شروع کر سکتے ہیں."

#, machine, plain1, python-format
msgid "You can start at most %(num)s group a day."
msgid_plural "You can start at most %(num)s groups a day."
msgstr[0] "آپ دن میں زیادہ تر %(num)s گروپ سے شروع کر سکتے ہیں۔."
msgstr[1] "آپ دن میں سب سے زیادہ %(num)s گروپ شروع کر سکتے ہیں۔."

#, machine, plain1, python-format
msgid "You can turn these emails off in your <a href=\"%(url)s\">Security settings</a>."
msgstr "تم اپنے میں ان ای میل دور تبدیل کر سکتے ہیں <a href=\"%(url)s\">سیکورٹی ترتیبات</a>."

#, machine, plain1, python-format
msgid "You can write at most %(num)s message in Spaces a day."
msgid_plural "You can write at most %(num)s messages in Spaces a day."
msgstr[0] "آپ دن میں زیادہ تر %(num)s پیغام میں لکھ سکتے ہیں۔."
msgstr[1] "آپ دن میں زیادہ تر %(num)s پیغامات میں لکھ سکتے ہیں۔."

#, machine, plain1, python-format
msgid "You can write in this guild's channels once you've been in it for %(num)s day."
msgid_plural "You can write in this guild's channels once you've been in it for %(num)s days."
msgstr[0] "اس گولڑہ کے چینلوں میں %(num)s دن کے لیے ایک بار آپ لکھ سکتے ہیں۔."
msgstr[1] "اس گولڈ کے چینلوں میں آپ %(num)s دنوں تک اس میں موجود رہے۔."

#, machine, plain1
msgid "You can't add that account."
msgstr "آپ وہ اکاؤنٹ شامل نہیں کر سکتے."

#, machine, plain1
msgid "You can't answer this event."
msgstr "آپ اس واقعہ کا جواب نہیں دے سکتے۔."

#, machine, plain1
msgid "You can't apply for a bot while your account is suspended."
msgstr "آپ ایک بوٹ کے لئے درخواست نہیں کر سکتے جبکہ آپ کا اکاؤنٹ معطل ہے."

#, machine, plain1
msgid "You can't ask for a community note on your own post."
msgstr "آپ اپنی پوسٹ پر ایک کمیونٹی نوٹ نہیں پوچھ سکتے۔."

#, machine, plain1
msgid "You can't be in this call any more."
msgstr "آپ اس دعوت میں زیادہ نہیں ہو سکتے۔."

#, machine, plain1, python-format
msgid "You can't block @%(name)s."
msgstr "آپ کو بلاک نہیں کر سکتے @%(name)s."

#, machine, plain1
msgid "You can't block yourself."
msgstr "آپ خود کو بلاک نہیں کر سکتے."

