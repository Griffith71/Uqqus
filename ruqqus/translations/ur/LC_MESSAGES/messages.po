msgstr "اس پوسٹ میں profile پر کوئی تبصرہ نہیں ہے۔ گولڈ کا انتخاب کریں."

#, machine, plain1
msgid "This post has no comments on the profile. Its comments are in the guilds it was posted to."
msgstr "اس پوسٹ میں profile پر کوئی تبصرہ نہیں ہے۔ اس کے تبصرے ان گلوکاروں میں موجود ہیں جنہیں پوسٹ کیا گیا تھا۔."

#, machine, plain1
msgid "This post has no comments on your profile now. Its comments are in the guilds."
msgstr "اس پوسٹ کے پاس اب آپ کے profile پر کوئی تبصرہ نہیں ہے۔ اس کے تبصرے گبولوں میں ہیں۔."

#, machine, plain1
msgid "This post has no live thread."
msgstr "اس پوسٹ میں کوئی زندہ نعرہ نہیں ہے۔."

#, machine, plain1
msgid "This post is from an account you muted."
msgstr "یہ پوسٹ آپ کو ایک اکاؤنٹ کی طرف سے ہے."

#, machine, plain1
msgid "This post is live already."
msgstr "یہ پوسٹ پہلے ہی زندہ ہے۔."

#, machine, plain1
msgid "This post is public now."
msgstr "یہ پوسٹ اب عوام ہے."

#, machine, plain1
msgid "This post isn't available."
msgstr "یہ پوسٹ دستیاب نہیں ہے۔."

#, machine, plain1
msgid "This post isn't in any guild, so its comments can only be on your profile."
msgstr "یہ پوسٹ کسی گولڈ میں نہیں ہے، اس لیے اس کے تبصرے صرف آپ پر ہی ہو سکتے ہیں۔."

#, machine, plain1
msgid "This post isn't live."
msgstr "یہ پوسٹ زندہ نہیں ہے."

#, machine, plain1
msgid "This post was deleted."
msgstr "یہ پوسٹ ختم کر دیا گیا۔."

#, machine, plain1
