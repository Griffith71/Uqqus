msgid_plural "This voice channel is full (%(num)s people)."
msgstr[0] "یہ آواز چینل مکمل (%(num)s فرد) ہے۔."
msgstr[1] "یہ آواز چینل مکمل (%(num)s افراد) ہے۔."

#, machine, plain1
msgid "This voice channel isn't available right now."
msgstr "یہ آواز چینل ابھی دستیاب نہیں ہے۔."

#, machine, plain1
