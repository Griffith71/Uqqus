msgid "This guild discusses sensitive topics (every post here will be blurred by default)."
msgstr "اس گولڈ حساس موضوعات پر بحث کرتا ہے (ہر پوسٹ کو ڈیٹنگ کی طرف سے نامزد کیا جائے گا)۔."

#, machine, plain1
msgid "This guild is banned."
msgstr "اس گول پر پابندی ہے۔."

#, machine, plain1
msgid "This guild is private. Content posted prior to the guild being set to private is visible to everyone."
msgstr "یہ گولڑ نجی ہے۔ ہر شخص کو ذاتی طور پر پیش کئے جانے سے پہلے مواد دستیاب ہوتا ہے ۔."

#, machine, plain1
msgid "This guild's channels are closed."
msgstr "اس گولڈ کے چینل بند ہیں۔."

#, machine, plain1
msgid "This invitation was already answered."
msgstr "اس دعوت کا جواب پہلے ہی دیا گیا تھا۔."

#, machine, plain1
msgid "This is a Space: its discussion is in the Space."
msgstr "یہ ایک اسپیس ہے: اس کی بحث فلکیات میں ہے۔."

#, machine, plain1, python-format
msgid "This is a Space: its discussion is in the Space. <a href=\"%(url)s\">Open the Space</a>"
msgstr "یہ ایک اسپیس ہے: اس کی بحث فلکیات میں ہے۔ <a href=\"%(url)s\">اسپیس کھول دیں</a>"

#, machine, plain1
msgid "This is a Space: its host and co-hosts post its updates from the Space."
msgstr "یہ ایک فلکیاتی آلہ ہے: اس کی میزبانی اور ہمہ گیر فلکیات سے اس کی تجدیدات مرتب کرتا ہے۔."

#, machine, plain1, python-format
msgid "This is a log of moderator actions performed in +%(guild)s. What members deleted themselves is in the site-wide <a href=\"%(url)s\">deletion log</a>."
msgstr "یہ + میں کیے گئے موڈٹر عمل کا لاگو ہے۔%(guild)s۔۔ جو ارکان خود حذف ہو گئے وہ جگہ وسیع ہے۔ <a href=\"%(url)s\">غیر متصل لاگ</a>."

#, machine, plain1
msgid "This is already in your language."
msgstr "یہ آپ کی زبان میں پہلے سے موجود ہے۔."

#, machine, plain1
msgid "This is for the members of a Circle guild."
msgstr "یہ حلقے کے ارکان کے لیے ہے۔."

#. %(name)s is the username of the person who made the post
#, machine, plain1, python-format
msgid "This is for the people in one of <a href=\"%(url)s\">@%(name)s</a>'s circles."
msgstr "بیشک یہ قرآن کافی ہے سارے جہان والوں کو، <a href=\"%(url)s\">@ فرماتا ہوں:%(name)s</a>' دائرے."

#, machine, plain1
msgid "This is the guild's custom CSS file."
msgstr "یہ گولڑ کا دستور ہے۔ CSS فائل."

#, machine, plain1
msgid "This is too much like what was posted automatically today."
msgstr "یہ بات آجکل خودبخود مرتب کی گئی تھی ۔."

#, machine, plain1
msgid "This isn't shown at your current word filter level. You can review your word filter in your content settings."
msgstr "یہ آپ کے موجودہ لفظ فیلڈر سطح پر نہیں دکھایا گیا ہے. آپ اپنے الفاظ فیلڈر کو مواد کی ترتیبات میں جانچ سکتے ہیں۔."

#, machine, plain1, python-format
msgid "This live thread ended a moment ago. It can go live again in %(num)s min."
msgid_plural "This live thread ended a moment ago. It can go live again in %(num)s min."
msgstr[0] "یہ زندہ سانپ ایک لمحے پہلے ختم ہو گیا. یہ %(num)s منٹ میں دوبارہ زندہ رہ سکتا ہے۔."
msgstr[1] "یہ زندہ سانپ ایک لمحے پہلے ختم ہو گیا. یہ %(num)s منٹ میں دوبارہ زندہ ہو سکتا ہے۔."

#, machine, plain1
msgid "This live thread has ended"
msgstr "یہ زندہ سانپ ختم ہو گیا ہے"

#, machine, plain1
msgid "This may be misleading or needs context (request a community note)"
msgstr "یہ گمراہ‌کُن ہو سکتا ہے یا ضرورت کے پیشِ‌نظر ( ایک کمیونٹی نوٹ پر غور کریں )"

#, machine, plain1
msgid "This month"
msgstr "اس مہینے"

#, machine, plain1
msgid "This needs a verified email address."
msgstr "اس کی توثیقی ای میل پتہ کی ضرورت ہے."

#, machine, plain1
msgid "This page is empty."
msgstr "یہ صفحہ خالی ہے۔."

#, machine, plain1, python-format
msgid "This page is generated by the %(site)s application introspecting its own routing functions. Nifty."
msgstr "اس صفحے کی وجہ سے بنایا گیا ہے۔ %(site)s اِس سلسلے میں ایک مثال پر غور کریں ۔ انکار."

#, machine, plain1
msgid "This page lists offensive words"
msgstr "یہ صفحہ تلخ الفاظ کی فہرست ہے۔"

#, machine, plain1
msgid "This page may not be embedded in other webpages."
msgstr "یہ صفحہ شاید دیگر ویب پیجز میں داخل نہیں کیا جا سکتا۔."

#, machine, plain1
msgid "This permanently erases the comment text. It cannot be undone, even by an admin."
msgstr "اس سے تبصرہ‌جات ختم ہو جاتے ہیں ۔ اِس میں کوئی شک نہیں کہ اِس کی وجہ کیا ہے ۔."

#, machine, plain1
msgid "This permanently erases the post title, text and link. It cannot be undone, even by an admin."
msgstr "یہ مستقل طور پر پوسٹ عنوان ، متن اور لنک کو ختم کرتا ہے ۔ اِس میں کوئی شک نہیں کہ اِس کی وجہ کیا ہے ۔."

#, machine, plain1
msgid "This person is blocking you."
