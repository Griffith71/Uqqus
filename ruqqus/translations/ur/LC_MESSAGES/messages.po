msgid ""
"Your %(site)s account has been permanently suspended for the following reason:\n"
"\n"
"> %(message)s"
msgstr ""
"آپ %(site)s درج ذیل وجوہات کی بنا پر اکاؤنٹ مستقل طور پر معطل کیا گیا ہے:\n"
"\n"
"مزید %(message)s"

#, machine, plain1, python-format
msgid ""
"Your %(site)s account has been permanently suspended for the following reason:\n"
"\n"
"> ban evasion"
msgstr ""
"آپ %(site)s درج ذیل وجوہات کی بنا پر اکاؤنٹ مستقل طور پر معطل کیا گیا ہے:\n"
"\n"
"مزید معلومات"

#, python-format
msgid "Your %(site)s account has been reinstated. Please carefully review and abide by the [terms of service](/help/terms) and [rules and guidelines](/help/rules) to ensure that you don't get suspended again."
msgstr ""

#, machine, plain1, python-format
msgid "Your %(site)s account has been suspended for %(days)s days due to a Terms of Service violation."
msgstr "آپ %(site)s اکاؤنٹ بند کیا گیا ہے %(days)s خدمات کی خلاف ورزی کی وجہ سے دنوں."

#, machine, plain1, python-format
msgid ""
"Your %(site)s account has been suspended for %(days)s days for the following reason:\n"
"\n"
"> %(message)s"
msgstr ""
"آپ %(site)s اکاؤنٹ بند کیا گیا ہے %(days)s اِس کی کیا وجہ ہے ؟\n"
"\n"
"مزید %(message)s"

#, machine, plain1, python-format
msgid ""
"Your %(site)s account has been suspended for 1 day for the following reason:\n"
"\n"
"> Too much spam!"
msgstr ""
"آپ %(site)s درج ذیل وجوہات کے لیے 1 دن کے حساب کو معطل کیا گیا ہے:\n"
"\n"
"مزید معلومات !"

#, machine, plain1, python-format
msgid "Your %(site)s password"
msgstr "آپ %(site)s پاس ورڈ"

#, machine, plain1
msgid "Your API Applications"
msgstr "آپ API ایپلیکیشنز"

#, machine, plain1
msgid "Your Authorized Applications"
msgstr "آپ کے مصنفہ اطلاقات"

#, machine, plain1
msgid "Your Following feed is empty"
msgstr "آپ کی ذیلی غذا خالی ہے"

#, machine, plain1
msgid "Your For You feed has been reset."
msgstr "آپ کی خوراک دوبارہ تیار کی گئی ہے ۔."

#, machine, plain1
msgid "Your Google Drive is full. Free some space and try again."
msgstr "آپ Google Drive پورا ہے۔ کچھ جگہ خالی کریں اور پھر کوشش کریں۔"

#, machine, plain1
msgid "Your ID is verified so you can't change your username."
msgstr "آپ کا آئی ڈی تصدیق کر دیا گیا ہے تاکہ آپ اپنا ربط تبدیل نہیں کر سکتے۔."

#, machine, plain1
msgid "Your OneDrive is full. Free some space and try again."
msgstr "آپ OneDrive پورا ہے۔ کچھ جگہ خالی کریں اور پھر کوشش کریں۔"

#, machine, plain1
msgid "Your Profile"
msgstr "آپ کا پرو فا ئل"

#, machine, plain1
msgid "Your RSS feed address"
msgstr "آپ RSS پتے"

#, machine, plain1
msgid "Your Subscribed Users"
msgstr "آپ کی ذیلی تقسیم کار"

#, glossary, machine, plain1
msgid "Your account"
msgstr "آپ کا اکاؤنٹ"

#, machine, plain1
msgid "Your account already posts automatically. Change its feeds on its page."
msgstr "آپ کا اکاؤنٹ پہلے ہی خودبخود پوسٹ کر دیا گیا ہے ۔ اس کے صفحہ پر اس کی خوراک کو تبدیل کریں ۔."

#, machine, plain1, python-format
msgid "Your account balance is negative. You will not be able to participate on %(site)s until you bring your balance up to zero."
msgstr "آپ کا اکاؤنٹ توازن منفی ہے۔ آپ اس میں شرکت نہیں کر سکیں گے۔ %(site)s یہاں تک کہ آپ اپنا توازن صفر تک لے آئیں۔"

#, machine, plain1
msgid "Your account can also post new items from feeds by itself, while you keep using it as you do now. Each of those posts is marked as automated, and people who hide bot content don't see them. Your own posts, comments, votes and chats are unchanged. An admin approves it first."
msgstr "اِس کے علاوہ آپ اُس وقت بھی نئی نئی چیزیں اِستعمال کر سکتے ہیں جب آپ اِسے خود کھاتے ہیں ۔ ان ڈاک ٹکٹوں میں سے ہر ایک کی نشان دہی کی جاتی ہے اور وہ لوگ جو بٹ مواد چھپاتے ہیں انہیں نہیں دیکھتے آپ کے ذاتی پوسٹس، تبصرے، ووٹوں اور گفتگووں میں بے نظیر ہیں۔ ایک اذان اسے پہلے پسند کرتا ہے۔."

#, machine, plain1
msgid "Your account can't post automatically while it is suspended."
msgstr "آپ کا اکاؤنٹ خودکار طور پر پوسٹ نہیں کر سکتا جب تک اسے معطل نہیں کیا جاتا."

#, machine, plain1
msgid "Your account can't publish right now."
msgstr "آپ کا اکاؤنٹ ابھی شائع نہیں ہو سکا۔."

#, machine, plain1
msgid "Your account cannot upload right now."
msgstr "اب آپ کا اکاؤنٹ اپ لوڈ نہیں کر سکتے."

#, machine, plain1
msgid "Your account couldn't be created. Please try again."
msgstr "آپ کا اکاؤنٹ نہیں بنایا جا سکا۔ براہ مہربانی دوبارہ کوشش کریں."

#, machine, plain1
msgid "Your account doesn't owe anything."
msgstr "آپ کا اکاؤنٹ کچھ بھی واجب نہیں۔."

#, machine, plain1
msgid "Your account has been checked and is ready: you can now post, comment, vote and follow. Welcome!"
msgstr "آپ کا اکاؤنٹ چیک کیا گیا ہے اور تیار ہے: اب آپ پوسٹ، تبصرہ، ووٹ اور پیروی کر سکتے ہیں۔ خوش آمدید!"

#, machine, plain1
msgid "Your account is being checked"
msgstr "آپ کا اکاؤنٹ چیک کیا جا رہا ہے"

#, machine, plain1
msgid "Your account is being checked."
msgstr "آپ کا اکاؤنٹ چیک کیا جا رہا ہے."

#, machine, plain1
msgid "Your account is marked sensitive."
msgstr "آپ کا اکاؤنٹ نمایاں حساس ہے۔."

#, machine, plain1
msgid "Your account is no longer marked sensitive."
msgstr "اب آپ کے اکاؤنٹ میں کوئی حساس بات نہیں ہے ۔."

#, machine, plain1
msgid "Your account is suspended."
msgstr "آپ کا اکاؤنٹ معطل ہے."

#, machine, plain1
msgid "Your account is too new to write in this guild's channels yet."
msgstr "ابھی تک اس گولڈ کے چینلوں میں لکھنے کے لیے آپ کا اکاؤنٹ بھی نیا ہے۔."

#, machine, plain1
msgid "Your account is waiting for a quick check before it can do this. To skip the wait, verify an email address in Settings > Security."
msgstr "آپ کا اکاؤنٹ جلد چیک کرنے کا انتظار کر رہا ہے اِس شمارے میں سے . سیکورٹی."

msgid ""
"Your account is waiting for a quick check before you can post, comment, vote or follow. You can look around and set up your profile in the meantime.\n"
"\n"
"\n"
"To skip the wait, add and verify an email address in [Settings > Security](/settings/security)."
msgstr ""

#, machine, plain1
msgid "Your account needs to be at least 30 days old to post automatically."
msgstr "آپ کو ذاتی طور پر پوسٹ کرنے کے لئے کم‌ازکم ۳۰ دن کی عمر ہونی چاہئے ۔."

#, machine, plain1
msgid "Your account needs to be at least 30 days old to run a bot."
msgstr "آپ کا اکاؤنٹ کم از کم 30 دن پرانا ہونا ضروری ہے ایک بوٹ چلانے کے لئے."

#, machine, plain1
msgid "Your account no longer posts automatically. Its posts stay."
msgstr "اب آپ کا اکاؤنٹ خودبخود پوسٹ نہیں کِیا جا سکتا ۔ اس کے پوسٹ."

#, machine, plain1
msgid "Your account posts from these feeds from now on."
msgstr "اب آپ کا اکاؤنٹ اِن خوراک سے پوسٹ کرتا ہے ۔."

#, machine, plain1, python-format
msgid "Your account's automated posting has been paused: %(reason)s"
msgstr "آپ کی اکاؤنٹنگ کو روک دیا گیا ہے: %(reason)s"

#, machine, plain1
msgid "Your account's automated posting is running again."
msgstr "آپ کا اکاؤنٹ دوبارہ جاری ہے."

#, machine, plain1, python-format
msgid "Your account's automated posting stopped reading %(url)s after %(fails)s failed tries: %(reason)s Start it again from Settings > Bots once it works."
msgstr "آپ کے اکاؤنٹ کی لاگ ان پڑھ روک دیا %(url)s بعد %(fails)s ناکام کوشش نہیں کی گئی: %(reason)s اِسے دوبارہ سے شروع کریں : بوٹس ایک بار کام کرتا ہے۔"

msgid "Your account's automated posting was approved. Your feeds' new posts appear on your profile, marked as automated, within a few minutes. Manage it in [Settings > Bots](/settings/bots)."
msgstr ""

#, machine, plain1
msgid "Your answer"
msgstr "آپ کا جواب"

#, machine, plain1
msgid "Your backup codes"
msgstr "آپ کا بیک کوڈ"

#, machine, plain1
msgid "Your bio has been updated."
msgstr "آپ کا دیوان تجدید کیا گیا ہے۔."

#, machine, plain1
msgid "Your blocked and muted accounts as a file you can keep or bring to another account."
msgstr "آپ کی رکاوٹ ہو گئی اور آپ نے ایک فائل کے طور پر حساب لگا لیا یا آپ کسی دوسرے حساب کو پہنچا سکتے ہیں ۔."

#, machine, plain1, python-format
msgid "Your bot @%(name)s has been paused: %(reason)s"
msgstr "آپ کے بوٹ @%(name)s روک دیا گیا ہے: %(reason)s"

#, machine, plain1, python-format
msgid "Your bot @%(name)s is running again."
msgstr "آپ کے بوٹ @%(name)s دوبارہ دوڑ رہا ہے."

