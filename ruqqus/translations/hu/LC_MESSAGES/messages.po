#, machine, plain1, python-format
msgid "The most a circle can ask is %(num)s coin every 30 days."
msgid_plural "The most a circle can ask is %(num)s coins every 30 days."
msgstr[0] "A legtöbb kör kérhet %(num)s érmék 30 naponta."

#, machine, plain1
msgid "The most voted posts of the last seven days."
msgstr "Az elmúlt hét nap legszavazatosabb posztjai."

#, machine, plain1, python-format
msgid "The name %(host)s could not be found."
msgstr "A %(host)s név nem található."

#, machine, plain1
msgid "The numbers are always shown on your profile. This decides who can open each list and see the accounts on it. An account is only listed where its own setting allows it too."
msgstr "A számok mindig megjelennek a profilodon. Ez határozza meg, hogy ki nyithat meg minden listát, és láthatja a számlákat rajta. Egy fiókot csak akkor sorolnak fel, ha saját beállítása is lehetővé teszi."

#, machine, plain1
msgid "The open-source platform for independent internet communities"
msgstr "A független internetes közösségek nyílt forráskódú platformja"

#, machine, plain1
msgid "The original content is not retained anywhere, including in this history."
msgstr "Az eredeti tartalom nem marad meg sehol, beleértve ebben a történelemben."

#, machine, plain1
msgid "The other authors of a shared draft removed you as an author. What you wrote stays credited to you."
msgstr "A többi szerző egy közös vázlat eltávolította, mint egy szerző. Amit írtál, az a tiéd."

#, machine, plain1
msgid "The owner deletes a channel instead of leaving it."
msgstr "A tulaj kitöröl egy csatornát, ahelyett, hogy elhagyná."

#, machine, plain1
msgid "The owner's role can't be changed."
msgstr "A tulajdonos szerepét nem lehet megváltoztatni."

#, machine, plain1
msgid "The page's current text isn't shown here; what you save replaces it."
msgstr "Az oldal jelenlegi szövege nem látható itt; amit elmentesz, az helyettesíti."

#, machine, plain1
msgid "The picture could not be stored. Try again later."
msgstr "A képet nem lehetett tárolni. Próbáld meg később."

#, machine, plain1
msgid "The picture goes to your own linked storage, not to this site. You can add a few words under it."
msgstr "A kép a saját összekapcsolt tároló, nem ezen az oldalon. Hozzáadhatsz pár szót."

#, machine, plain1
msgid "The picture you chose"
msgstr "A kép, amit választottál"

#, machine, plain1
msgid "The post appears on the profile of whoever publishes it first. Optionally forward it into guilds for community discussion: each guild gets its own independent copy with its own votes and comments. Guilds are forwarded to when the draft is first published."
msgstr "A bejegyzés azon a profilon jelenik meg, aki először kiadja. A közösségi vitához opcionálisan továbbítjuk a céheket: minden céhnek saját szavazata és megjegyzései vannak. A bűntudatot továbbítják a tervezet első közzétételekor."

#, machine, plain1
msgid "The post carries your name and is listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your name."
msgstr "A poszt tartalmazza a nevét, és szerepel a profilján. Szavazatokat, megjegyzéseket és előre megosztják a szerző, aki szerkeszti és törli azt. Bármikor távozhat: a posta marad, a neve nélkül."

#, machine, plain1
msgid "The post refused the change."
msgstr "A posta elutasította a változtatást."

#, machine, plain1, python-format
msgid "The promo code `%(code)s` is not currently valid. Please begin a new transaction."
msgstr "Az `%(code)s` promo kód jelenleg nem érvényes. Kérem, kezdjen egy új tranzakciót."

#, machine, plain1, python-format
msgid "The proposal for @%(name)s has been withdrawn."
msgstr "A @ %(name)s -ra vonatkozó javaslatot visszavonták."

#, machine, plain1, python-format
msgid "The role %(role)s was deleted."
msgstr "A %(role)s szerepet törölték."

#, machine, plain1, python-format
msgid "The role %(role)s was made."
msgstr "A szerepet %(role)s hozták."

#, machine, plain1, python-format
msgid "The role %(role)s was saved."
msgstr "A %(role)s szerep megmenekült."

#, machine, plain1
msgid "The royal bank has told us that you owe them some coin. You'll need to pay off your debts before you can continue."
msgstr "A királyi bank azt mondta, hogy tartozik nekik egy kis pénzzel. Ki kell fizetnie az adósságait, mielőtt folytathatja."

#, machine, plain1
msgid "The rules"
msgstr "A szabályok"

#, machine, plain1
msgid "The rules below"
msgstr "Az alábbi szabályok"

#, machine, plain1, python-format
msgid "The rules can be at most %(count)s character."
msgid_plural "The rules can be at most %(count)s characters."
msgstr[0] "A szabályok lehetnek legfeljebb %(count)s karakterek."

#, machine, plain1
msgid "The rules can't contain control or invisible characters."
msgstr "A szabályok nem tartalmazhatnak kontrollt vagy láthatatlan karaktereket."

#, machine, plain1
msgid "The screenshot you are sending"
msgstr "A forgatókönyv, amit küldesz"

#. %(status)s is an HTTP status code
#, machine, plain1, python-format
msgid "The server answered %(status)s."
msgstr "A kiszolgáló válaszolt %(status)s."

#, machine, plain1, python-format
msgid "The server answers with the posts to show and their order; %(site)s still hides anything a viewer may not see, and tells the server nothing about who is looking. Everyone is told that an outside server ranks this curation."
msgstr "A kiszolgáló válaszol a megjelenítendő bejegyzésekkel és azok sorrendjével; %(site)s még mindig rejteget mindent, amit a nézõ nem lát, és nem mond semmit a szervernek arról, hogy ki keres. Mindenki azt mondja, hogy egy külső szerver rangsorolja ezt a kurált adást."

#, machine, plain1, python-format
msgid "The server named %(num)s post; you can see %(seen)s of them."
msgid_plural "The server named %(num)s posts; you can see %(seen)s of them."
msgstr[0] "A kiszolgáló neve %(num)s posts; láthatjuk %(seen)s közülük."

#, machine, plain1
msgid "The server thinks you're asking something silly. It might take you more seriously if you take off the jester outfit."
msgstr "A szerver szerint valami butaságot kérdezel. Lehet, hogy komolyabban venné, ha levenné a bohócruhát."

#, machine, plain1
msgid "The site refused the bot's session."
msgstr "Az oldal elutasította a robot foglalkozását."

#, machine, plain1
msgid "The site's admins marked this guild sensitive, so only an admin can change this."
msgstr "Az oldal adminisztrátorai ezt a céh érzékenységet jelölték, így csak egy adminisztrátor változtathat ezen."

#, machine, plain1, python-format
msgid "The stage is full (%(num)s person)."
msgid_plural "The stage is full (%(num)s people)."
msgstr[0] "A színpad tele van (%(num)s )."

#, machine, plain1
msgid "The storage service is not answering right now. Try again in a moment."
msgstr "A raktár nem veszi fel. Próbáld újra egy pillanat alatt."

#, machine, plain1, python-format
msgid "The summary can be at most %(num)s character."
msgid_plural "The summary can be at most %(num)s characters."
msgstr[0] "Az összefoglaló legfeljebb %(num)s karakter lehet."

#, machine, plain1
msgid "The summary can be changed while the Space is live."
msgstr "Az összefoglaló módosítható, amíg a tér él."

#, machine, plain1
msgid "The text isn't shown: this was removed by the site's administrators."
msgstr "A szöveg nem látható: ezt eltávolította a honlap adminisztrátorai."

#, machine, plain1, python-format
msgid "The time before links must be a whole number of days, 0 to %(max)s."
msgstr "A linkek előtti időnek teljes számú napnak kell lennie, 0-tól %(max)s -ig."

#, machine, plain1, python-format
msgid "The time in the guild must be a whole number of days, 0 to %(max)s."
msgstr "Az idő a céhben egy egész számú nap, 0-tól %(max)s."

#, machine, plain1, python-format
msgid "The title can be at most %(num)s character."
msgid_plural "The title can be at most %(num)s characters."
msgstr[0] "A cím legfeljebb %(num)s karakter lehet."

#, machine, plain1
msgid "The two revisions have the same text."
msgstr "A két felülvizsgálatnak ugyanaz a szövege."

#, machine, plain1
msgid "The upload did not arrive in your Google Drive. Try again."
msgstr "A feltöltés nem a Google Drive -ban érkezett. Próbáld újra."

#, machine, plain1
msgid "The upload did not arrive in your OneDrive. Try again."
msgstr "A feltöltés nem a OneDrive -ban érkezett. Próbáld újra."

#, machine, plain1
msgid "The upload did not arrive. Try again."
msgstr "A feltöltés nem érkezett meg. Próbáld újra."

#, machine, plain1, python-format
msgid "The username @%(name)s has been pre-emptively reserved for: %(who)s"
msgstr "A felhasználónév @ %(name)s már eleve lefoglalva: %(who)s"

#, machine, plain1
msgid "The usual order - everything from the guilds and accounts you add"
msgstr "A szokásos rendelés - mindent a céhek és számlák hozzá"

#, machine, plain1
msgid "The video did not finish uploading to Dailymotion. Add it again."
msgstr "A videó nem töltötte fel Dailymotion -ra. Még egyszer."

#, machine, plain1
msgid "The video did not finish uploading. Add it again."
msgstr "A videó nem fejezte be a feltöltést. Még egyszer."

#, machine, plain1, python-format
msgid "The website can be at most %(num)s character."
msgid_plural "The website can be at most %(num)s characters."
msgstr[0] "A honlap lehet legfeljebb %(num)s karakterek."

#, machine, plain1
msgid "The website can't contain a user name or password."
msgstr "A weboldal nem tartalmazhat felhasználónevet vagy jelszót."

#, machine, plain1
msgid "The website can't contain spaces."
msgstr "A honlap nem tartalmazhat szóközöket."

#, machine, plain1
msgid "The website must start with https:// or http://."
msgstr "A honlapnak a https: / / or http://. -vel kell kezdődnie"

#, machine, plain1
msgid "The website needs a full address, such as example.com."
msgstr "A honlapon kell egy teljes címet, mint például a péld.com."

#, machine, plain1
msgid "The whole site <span class=\"text-muted\">(needs an age limit of a month or less)</span>"
msgstr "Az egész oldal <span class=\"text-muted\">(legfeljebb egy hónapos korhatárt igényel)</span>"

#, machine, plain1
msgid "The wiki is off: only guildmasters see it."
msgstr "A wiki ki van kapcsolva, csak a guild moderátorok látják."

#, machine, plain1
msgid "The wiki's first page can be emptied but not deleted."
msgstr "A wiki első oldala kiüríthető, de nem törölhető."

#, machine, plain1
msgid "The word filter has no words at the moment."
msgstr "A szûrõnek jelenleg nincsenek szavai."

#, machine, plain1, python-format
msgid "The words for other languages are adapted from %(source)s (%(licence)s): words that are also ordinary, innocent words were left out."
msgstr "A többi nyelvre vonatkozó szavak a %(source)s (%(licence)s) -től módosulnak: azokat a szavakat, amelyek szintén szokatlanok, ártatlan szavakat kihagyták."

#, machine, plain1
msgid "The working copy as it is now. Only its authors can see this until it's published."
msgstr "Már így is működik a másolat. Csak a szerzők láthatják, amíg ki nem adják."

#, machine, plain1
msgid "Theater"
msgstr "Színház"

#, machine, plain1
msgid "Their commenting history will show here."
msgstr "A kommentáló történetük itt fog megjelenni."

#, machine, plain1
msgid "Their forwarding activity will show here."
msgstr "A továbbítási tevékenységük itt fog megjelenni."

#, machine, plain1
msgid "Their posting history will show here."
msgstr "A kiküldetési előzményeik itt fognak megjelenni."

#, machine, plain1
msgid "Their posts and comments are left out of your feeds and threads and they cannot notify you. They are not told, and they can still follow you, comment on your posts and message you. Their anonymous posts and comments are not hidden, as hiding only those would tell you who wrote them. Mute someone from the menu on any of their posts or comments, or from their profile."
msgstr "A hozzászólásaikat és megjegyzéseiket kihagyják az adataiból és a szálaiból, és nem tudják értesíteni. Nem mondják el nekik, és még mindig követhetnek, kommentálhatják a posztjukat, és üzenhetnek. A névtelen bejegyzéseik és megjegyzéseik nincsenek elrejtve, mivel csak azok rejtik el, akik megmondják, ki írta őket. Némítsen valakit a menüből a hozzászólásain vagy a profiljukon."

#, machine, plain1
msgid "There are no approved users"
msgstr "Nincs jóváhagyott felhasználó"

#, machine, plain1
msgid "There are no exiled users"
msgstr "Nincsenek száműzött felhasználók"

#, machine, plain1
msgid "There are no guildmaster invitations."
msgstr "Nincsenek guild moderátor meghívók."

#, machine, plain1
msgid "There are no guildmasters."
msgstr "Nincsenek guild moderátorok."

#, machine, plain1
msgid "There are no posts here."
msgstr "Itt nincsenek oszlopok."

#, machine, plain1, python-format
msgid "There is no account named @%(name)s."
msgstr "Nincs @ %(name)s nevű fiók."

#, machine, plain1
msgid "There is nothing to save yet."
msgstr "Még nincs mit megmenteni."

#, machine, plain1
msgid "There was a problem. Please try again."
msgstr "Volt egy kis probléma. Kérem, próbálja újra."

#, machine, plain1
msgid "There were no names in that file."
msgstr "Nem voltak nevek az aktában."

#, machine, plain1
msgid "There were no survivors."
msgstr "Nem voltak túlélők."

#, machine, plain1
msgid "There's a shortage of perfect request entities in this world. Would be a pity to damage yours."
msgstr "Hiányoznak a tökéletes keresési egységek a világon. Kár lenne tönkretenni a tiédet."

#, machine, plain1
msgid "There's already an open proposal like this one."
msgstr "Már van egy ilyen nyílt ajánlat."

#, machine, plain1
msgid "There's no account with that name."
msgstr "Nincs ilyen név."

#, machine, plain1
msgid "There's no invitation to speak."
msgstr "Nincs meghívó a beszédre."

#, machine, plain1
msgid "There's nothing here right now."
msgstr "Nincs itt semmi."

#, machine, plain1
msgid "There's nothing left here but a giant smouldering crater."
msgstr "Semmi sem maradt itt, csak egy hatalmas, kopár kráter."

#, machine, plain1
msgid "These are the users you are subscribed to."
msgstr "Ezek azok a felhasználók, akikre szerződtél."

#, machine, plain1
msgid "These counts start from the day guild insights were switched on: before that the site did not record when people left a guild or how often its page was opened."
msgstr "Ezek a számok attól a naptól kezdődnek, amikor a guild betekintést bekapcsolták: mielőtt az oldal nem rögzítette, amikor az emberek elhagyták a cild vagy milyen gyakran nyitották meg az oldalt."

#, machine, plain1
msgid "These filters are saved as your default"
msgstr "Ezek a szűrők menthetők az alapértelmezett"

#, machine, plain1
msgid "These topics"
msgstr "Ezek a témák"

#, machine, plain1, python-format
msgid "These users have been invited to moderate +%(guild)s."
msgstr "Ezeket a felhasználókat meghívták a közepesen súlyos + %(guild)s - ra."

#, machine, plain1
msgid "They already have this role."
msgstr "Már megvan nekik ez a szerep."

#, machine, plain1
msgid "They are already in this circle."
msgstr "Már ebben a körben vannak."

#, machine, plain1
msgid "They are not told. Anyone you block leaves your circles."
msgstr "Nem mondták el nekik. Bárki, akit blokkolsz, elhagyja a köröket."

#, machine, plain1, python-format
msgid "They aren't in %(circle)s."
msgstr "Nincsenek bent. %(circle)s."

#, machine, plain1
msgid "They aren't in this group."
msgstr "Nincsenek ebben a csoportban."

#, machine, plain1
msgid "They aren't muted here."
msgstr "Itt nincsenek elnémítva."

#, machine, plain1
msgid "They can't comment on your posts or comments, chat with you or notify you by mentioning you. They are not told, but they may work it out if they try to comment on something of yours."
msgstr "Nem nyilatkozhatnak a hozzászólásaidról vagy a hozzászólásaidról, nem beszélgethetnek veled, és nem is értesíthetnek. Nem mondták el nekik, de talán megoldják, ha megpróbálják kommentálni a tiédet."

#, machine, plain1
msgid "They don't have this role."
msgstr "Nekik nincs ilyen szerepük."

#, machine, plain1
msgid "They go straight to your coin balance."
msgstr "Egyenesen az érmére mennek."

#, machine, plain1
msgid "They need to be in the guild, and not exiled from it."
msgstr "A céhben kell lenniük, és nem száműzve."

#, machine, plain1
msgid "They need to join the channel first."
msgstr "Először be kell lépniük a csatornába."

#, machine, plain1
msgid "They're already a helper."
msgstr "Ők már segítők."

#, machine, plain1
msgid "They're already on stage."
msgstr "Már a színpadon vannak."

#, machine, plain1
msgid "They've already been invited to speak."
msgstr "Már meghívták őket beszélni."

#, machine, plain1
msgid "This Circle guild is by invitation only."
msgstr "Ez a Kör Gyár csak meghívással létezik."

#, machine, plain1
msgid "This Google account has no YouTube channel yet. Create one at youtube.com, then try again."
msgstr "Ez Google a számlának nincs YouTube csatorna még. Hozzon létre egyet a youtube.com-on, majd próbálja újra."

#, machine, plain1
msgid "This Space"
msgstr "Ez a tér"

#, machine, plain1
msgid "This Space can't take a replay now."
msgstr "Ez a hely nem tud visszajátszani."

#, machine, plain1
msgid "This Space has already started."
msgstr "Ez a tér már elkezdődött."

#, machine, plain1
msgid "This Space has ended."
msgstr "Ez a tér véget ért."

#, machine, plain1
msgid "This Space has ended. Its board is still here to read."
msgstr "Ez a tér véget ért. A deszkája még itt van, hogy olvasson."

#, machine, plain1
msgid "This Space has ended. Its chat is still here to read."
msgstr "Ez a tér véget ért. A beszélgetése még mindig itt van."

#, machine, plain1
msgid "This Space hasn't started yet."
msgstr "Ez a tér még nem kezdődött el."

#, machine, plain1, python-format
msgid "This Space is full (%(num)s listener)."
msgid_plural "This Space is full (%(num)s listeners)."
msgstr[0] "Ez a hely tele van (%(num)s hallgatók)."

#, machine, plain1, python-format
msgid "This Space is live until %(time)s."
msgstr "Ez a tér élőben van, egészen %(time)s -ig."

#, machine, plain1
msgid "This Space is live."
msgstr "Ez a tér élő."

#, machine, plain1
msgid "This Space is not recorded: when it ends, it is gone, with everything in it."
msgstr "Ez a tér nem kerül rögzítésre: amikor vége, eltűnik, és minden benne van."

#, machine, plain1
msgid "This Space is recorded"
msgstr "Ez a hely rögzítve van"

#, machine, plain1
msgid "This Space is recorded: its board stays to read when it ends."
msgstr "Ez a hely rögzített: a tábla marad olvasni, amikor véget ér."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay with the video."
msgstr "Ez a hely rögzített: a host megtartja a visszajátszás a videó."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay."
msgstr "Ez a hely rögzített: a host megtartja a visszajátszás."

#, machine, plain1
msgid "This Space isn't available."
msgstr "Ez a tér nem elérhető."

#, machine, plain1
msgid "This Space isn't waiting to start."
msgstr "Ez a tér nem vár a kezdésre."

#, machine, plain1
msgid "This Space keeps its sound only."
msgstr "Ez a tér csak a hangját tartja meg."

#, machine, plain1
msgid "This access will expire in one hour, or earlier if you revoke it."
msgstr "Ez a hozzáférés egy óra múlva lejár, vagy ha visszavonják."

#, machine, plain1
msgid "This account can't use chat apps."
msgstr "Ez a fiók nem használ chat alkalmazásokat."

#, machine, plain1, python-format
msgid "This account has been permanently suspended from %(site)s."
msgstr "Ezt a számlát véglegesen felfüggesztették %(site)s."

#, machine, plain1, python-format
msgid "This account has been temporarily suspended from %(site)s. Check back later."
msgstr "Ezt a számlát ideiglenesen felfüggesztették a %(site)s -ről. Később jelentkezz be."

#, machine, plain1
msgid "This account is private"
msgstr "Ez a számla privát"

#, machine, plain1
msgid "This account posts about sensitive topics"
msgstr "Ez a számla hozzászólások érzékeny témákról"

#. %(time)s is a length of time, such as "6 months"
#, machine, plain1, python-format
msgid "This author hasn't been active for %(time)s, so isn't counted."
msgstr "Ez a szerző nem aktív már %(time)s, így nem számít."

#, machine, plain1
msgid "This bot can't take tips right now."
msgstr "Ez a robot most nem fogad el borravalót."

#, machine, plain1
msgid "This bot has not been approved."
msgstr "Ezt a robotot nem hagyták jóvá."

#, machine, plain1
msgid "This bot is not running."
msgstr "Ez a robot nem fut."

#, machine, plain1
msgid "This bot's owner can't run it right now."
msgstr "Ennek a robotnak a tulaja most nem tudja vezetni."

#, machine, plain1, python-format
msgid "This call is full (%(num)s person)."
msgid_plural "This call is full (%(num)s people)."
msgstr[0] "Ez a hívás teljes (%(num)s )."

#, machine, plain1
msgid "This can't be translated right now."
msgstr "Ezt most nem lehet lefordítani."

#, machine, plain1
msgid "This channel doesn't ask for its rules to be accepted."
msgstr "Ez a csatorna nem kéri, hogy elfogadják a szabályait."

#, machine, plain1
msgid "This channel has no messages."
msgstr "Ezen a csatornán nincsenek üzenetek."

#, machine, plain1
msgid "This channel is end-to-end encrypted: it is read and written in Chat, where your messages are unlocked."
msgstr "Ez a csatorna endo-to-end kódolt: olvasott és írt Chat, ahol az üzenetek nyitva."

#, machine, plain1
msgid "This channel is end-to-end encrypted: the site can't read it, so it has no word filter, slow mode, pins, search or reports."
msgstr "Ez a csatorna endo-to-end kódolt: az oldal nem tudja elolvasni, így nincs szószűrő, lassú üzemmód, csapok, keresés vagy jelentések."

#, machine, plain1
msgid "This channel is full."
msgstr "A csatorna tele van."

#, machine, plain1
msgid "This channel is written from the chat itself."
msgstr "Ezt a csatornát maga a chat írta."

#, machine, plain1
msgid "This channel isn't available."
msgstr "Ez a csatorna nem elérhető."

#, machine, plain1
msgid "This circle isn't taking subscribers."
msgstr "Ez a kör nem fogad el előfizetőket."

#, machine, plain1
msgid "This comment and the comments under it"
msgstr "Ez az észrevétel és a benne foglalt észrevételek"

#, machine, plain1, python-format
msgid "This comment breaks %(site)s policy"
msgstr "Ez a megjegyzés törik %(site)s politika"

#, machine, plain1
msgid "This comment can't be forwarded."
msgstr "Ezt a megjegyzést nem lehet továbbítani."

#, machine, plain1
msgid "This comment can't be reposted."
msgstr "Ezt a megjegyzést nem lehet átküldeni."

#, machine, plain1
msgid "This comment is on a copy forwarded to a guild - ask that guild's guildmasters to remove it instead."
