msgstr "Бул %(site)s Админдер."

#, machine, plain1, python-format
msgid "These badges are automatically granted through different kinds of activity on %(site)s."
msgstr "Бул белгилер автоматтык түрдө ар кандай иш-аракеттер аркылуу берилет. %(site)s."

#, machine, plain1
