msgctxt "time filter"
msgid "year"
msgstr "жылдык жыл"

#, machine, plain1
msgctxt "badge beside your own name"
msgid "you"
msgstr "сен"

#, machine, plain1
msgid "you voted no"
msgstr "\"жок\" деп добуш бердиңиз"

#, machine, plain1
msgid "you voted yes"
msgstr "сиз \"ооба\" деп добуш бердиңиз"

#, machine, plain1
msgid "you were posting too fast, and it couldn't wait any longer."
