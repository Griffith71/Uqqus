#, machine, plain1
msgid "A bot's posts are public."
msgstr "Боттун билдирүүлөрү ачык."

#, machine, plain1
msgid "A bot's posts can't have co-authors."
msgstr "Боттун билдирүүлөрүнүн авторлору болушу мүмкүн эмес."

#. %(listeners)s is the largest number of people listening
#, machine, plain1, python-format
msgid "A call has up to %(num)s person on stage and %(listeners)s listening, for at most 4 hours."
msgid_plural "A call has up to %(num)s people on stage and %(listeners)s listening, for at most 4 hours."
msgstr[0] "Телефон чалуунун сахнасында %(num)s адамга чейин жана %(listeners)s Угуу, эң көп дегенде 4 саат."
msgstr[1] "Телефон чалуунун сахнасында %(num)sгө чейин адам бар. %(listeners)s Угуу, эң көп дегенде 4 саат."

#, machine, plain1
msgid "A cancelled event can't be changed."
msgstr "Жокко чыгарылган окуяны өзгөртүү мүмкүн эмес."

#, machine, plain1
msgid "A category"
msgstr "А категориясы"

