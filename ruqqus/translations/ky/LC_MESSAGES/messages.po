#, machine, plain1
msgid "who wrote what"
msgstr "эмне жазган"

#. beside a post's author, its co-authors: names is their names, linked
#, machine, plain1, python-format
msgid "with %(names)s"
msgstr "%(names)s менен"

#. beside a post's author, its co-authors: names is the first five, linked; num
#. is how many more there are
#, python-format
msgid "with %(names)s and <a href=\"%(url)s\">%(num)s other</a>"
msgid_plural "with %(names)s and <a href=\"%(url)s\">%(num)s others</a>"
msgstr[0] ""
msgstr[1] ""

