msgstr[1] "Аянтты эң көп дегенде %(num)s күн мурун пландаштырууга болот."

#, machine, plain1, python-format
msgid "A Space can have at most %(num)s co-host."
msgid_plural "A Space can have at most %(num)s co-hosts."
msgstr[0] "Бир мейкиндикте эң көп дегенде бир ко-хост болушу мүмкүн."
msgstr[1] "Бир мейкиндикте эң көп дегенде %(num)s ко-хост болушу мүмкүн."

