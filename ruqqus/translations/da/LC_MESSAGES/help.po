msgid "Users of the %(site)s platform may be informally called \"Ruqqies\", or formally \"%(site)s users\"."
msgstr "Brugere af %(site)s platform kan uformelt kaldes \"Rusyes\", eller formelt \"%(site)s brugere\"."

#, machine, plain1, python-format
msgid "Using the %(site)s name or brand assets as a name, or part of a name, of a company, product, service, application, website, domain name, or social media account."
msgstr "Brug %(site)s navn eller mærke aktiver som et navn, eller en del af et navn, af en virksomhed, produkt, service, program, hjemmeside, domænenavn, eller sociale medier konto."

