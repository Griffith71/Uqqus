#, machine, plain1
msgid "A public board for a set time: anyone who can see it writes on it."
msgstr "En offentlig bestyrelse for en bestemt tid: enhver, der kan se det skriver om det."

#, machine, plain1
msgid "A reason is required."
msgstr "Der er brug for en grund."

#, machine, plain1
msgid "A recorded call keeps the video too, on your own YouTube or Dailymotion; a call for circles keeps the sound only."
msgstr "Et optaget opkald holder videoen også, på din egen YouTube eller Dailymotion; et opkald til cirkler holder lyden kun."

#, machine, plain1, python-format
msgid "A role can have at most %(num)s person."
msgid_plural "A role can have at most %(num)s people."
msgstr[0] "En rolle kan højst have %(num)s person."
msgstr[1] "En rolle kan højst have %(num)s personer."

#, machine, plain1, python-format
msgid "A role is a coloured name beside someone's messages in +%(guild)s's channels. It can let its people skip slow mode, remove or pin messages, and on each channel (under <a href=\"%(url)s\">Channels</a>) allow or deny reading and writing over the channel's own rules. Where one role allows and another denies, allowing wins. A role never lets someone into a channel of a guild they can't see, and never changes what a guildmaster can do. Up to %(max)s."
msgstr "En rolle er et farvet navn ved siden af nogens beskeder i +%(guild)s's kanaler. Det kan lade sine folk springe langsom mode, fjerne eller pin meddelelser, og på hver kanal (under <a href=\"%(url)s\">Kanaler</a>) tillade eller nægte at læse og skrive over kanalens egne regler. Hvor en rolle tillader det, og en anden benægter, tillader det. En rolle aldrig lader nogen ind i en kanal af en guild de ikke kan se, og aldrig ændrer, hvad en guild moderator kan gøre. Op til %(max)s."

#, machine, plain1, python-format
msgid "A role name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A role name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Et rollenavn kan være %(num)s tegn (kinesiske, japanske og koreanske tegn og emoji tæller som 2)."
msgstr[1] "Et rollenavn kan være %(num)s tegn (kinesiske, japanske og koreanske tegn og emoji tæller som 2)."

#, machine, plain1, python-format
