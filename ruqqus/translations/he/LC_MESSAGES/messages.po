msgstr "וידאו מראה את שם הערוץ שלך, כך שזה לא יכול להמשיך פוסט אנונימי."

#, machine, plain1
msgid "A video uploaded to your YouTube or Dailymotion channel can't be kept to your circles: anyone with its link can watch it. Share it publicly, or use a picture."
msgstr "סרטון שהועלה לך YouTube או או Dailymotion ערוץ לא ניתן לשמור על המעגלים שלך: כל אחד עם הקישור שלו יכול לצפות בו. שתפו אותו בפומבי, או השתמשו בתמונה."

#, machine, plain1
msgid "A video uploaded to your YouTube or Dailymotion channel shows your channel's name, so it cannot be added to an anonymous post."
msgstr "סרטון שהועלה לך YouTube או או Dailymotion ערוץ מציג את שם הערוץ שלך, כך שלא ניתן להוסיף אותו לפוסט אנונימי."

#, machine, plain1
msgid "A week"
msgstr "שבוע"

#, machine, plain1
msgid "A word in another alphabet is matched in that alphabet. Words in scripts written without spaces, such as Chinese, Japanese, Korean and Thai, are found anywhere in the text."
msgstr "מילה באלפבית אחר תואמת באלפבית הזה. מילים בכתב ללא חללים, כגון סינית, יפנית, קוריאנית ותאילנדית, נמצאות בכל מקום בטקסט."

#, machine, plain1
msgid "A word is matched as a whole word, so an innocent longer word that contains it is not hidden, except where an entry says it is also found inside other words."
msgstr "מילה תואמת כמילה שלמה, כך שמילה תמימה יותר המכילה אותה אינה מוסתרת, למעט מקום שבו כניסה אומרת שהיא נמצאת גם בתוך מילים אחרות."

#, machine, plain1, python-format
msgid "A word or phrase can be %(num)s character at most: \"%(word)s...\""
msgid_plural "A word or phrase can be %(num)s characters at most: \"%(word)s...\""
