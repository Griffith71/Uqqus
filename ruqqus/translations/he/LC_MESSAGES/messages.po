#, machine, plain1
msgid "Invited On"
msgstr "הוזמן On"

#, machine, plain1
msgid "It can't see your password, your posts or your settings, and you can sign it out at any time from the same page."
msgstr "זה לא יכול לראות את הסיסמה שלך, את הפוסטים שלך או את ההגדרות שלך, ואתה יכול לחתום על זה בכל עת מאותו דף."

#, machine, plain1, python-format
msgid "It doesn't count towards your %(num)s bot."
msgid_plural "It doesn't count towards your %(num)s bots."
msgstr[0] "זה לא נחשב לבוט אחד שלך."
msgstr[1] "זה לא נחשב ל-%(num)s הבוטים שלך."

#, machine, plain1
msgid "It ends by itself after this. You can end it sooner."
msgstr "היא מסתיימת בעצמה אחרי זה. אתה יכול לסיים את זה מוקדם יותר."

#, machine, plain1
msgid "It is reviewed with the bot."
msgstr "הוא נבדק עם הבוט."

#, machine, plain2
msgid "It leaves the site's pages. If it is less than five minutes old and nobody else has commented on it, it is erased: only you and the site's admins can open a private copy, for 90 days. Otherwise what it said stays in the Log as Anonymous, with no name and no link, and anyone can read it there."
msgstr "זה משאיר את דפי האתר. אם זה פחות מ-5 דקות, ואף אחד אחר לא אמר על זה, הוא נמחק: רק אתה ומנהלי האתר יכולים לפתוח עותק פרטי למשך 90 יום. אחרת מה שאמר נשאר ב- Log as Anonymous, ללא שם וללא קישור, וכל אחד יכול לקרוא אותו שם."

#, machine, plain2
msgid "It leaves your profile, feeds and guilds. If it is less than five minutes old and nobody else has commented, it is erased: only you and the site's admins can open a private copy, for 90 days. Otherwise what it said stays in the Log as Anonymous, with no name and no link, and anyone can read it there."
msgstr "זה משאיר את הפרופיל שלך, להאכיל וגיללים. אם זה פחות מחמש דקות ואף אחד אחר לא אמר, הוא נמחק: רק אתה ומנהלי האתר יכולים לפתוח עותק פרטי למשך 90 יום. אחרת מה שאמר נשאר ב- Log as Anonymous, ללא שם וללא קישור, וכל אחד יכול לקרוא אותו שם."

#, machine, plain1
msgid "It lives on your profile, under Spaces. A guild shows its card, with votes and shares, and opens the Space."
msgstr "הוא חי על הפרופיל שלך, תחת החללים. גורל מציג את הכרטיס שלו, עם קולות ומניות, ופותח את החלל."

#, machine, plain1
msgid "It only orders posts you are allowed to see."
msgstr "זה רק הוראות שאתה יכול לראות."

#, machine, plain1
msgid "It shows, in full, every word and phrase the word filter looks for, in every language it covers. That includes slurs and other extremely offensive language."
msgstr "זה מראה, במלואו, כל מילה וביטוי המילה מסנן מחפשים, בכל שפה שהיא מכסה. זה כולל סלורים ושפה פוגענית אחרת."

#, machine, plain1
msgid "It stays a child account with the child lock, but you can no longer see it or change what it can do, and you can't link it again."
msgstr "זה נשאר חשבון ילדים עם מנעול הילדים, אבל אתה כבר לא יכול לראות את זה או לשנות מה זה יכול לעשות, ואתה לא יכול לקשר אותו שוב."

#, machine, plain2
msgid "It stays on the Child word filter, which hides profanity and anything marked sensitive. A child account only reads: it can't post or comment, but you can still vote, follow, join guilds, bookmark and report."
msgstr "הוא נשאר על מסנן המילים של הילד, המסתיר פרוטה וכל דבר רגיש. חשבון ילדים קורא רק: זה לא יכול לפרסם או להגיב, אבל אתה עדיין יכול להצביע, לעקוב, להצטרף גילידים, סימן ודיווח."

#, machine, plain1, python-format
msgid "It was not approved last time. The admins said: %(note)s"
msgstr "זה לא אושר בפעם האחרונה. המנהל אמר: %(note)s"

#, machine, plain1
msgid "It will be able to:"
msgstr "זה יהיה מסוגל:"

#, machine, plain1
msgid "It will be read again within a few minutes."
msgstr "הוא יקרא שוב בתוך כמה דקות."

#, machine, plain1
msgid "It will not be able to see your password or personal data, or change your account settings."
msgstr "זה לא יוכל לראות את הסיסמה או את הנתונים האישיים שלך, או לשנות את הגדרות החשבון שלך."

#, machine, plain1
msgid "It will see your chats, groups and channels and can send messages as you."
msgstr "זה יראה את הצ'אטים, הקבוצות והערוצים שלך ויכול לשלוח הודעות כמוך."

