msgstr "הכותב"

#, machine, plain1
msgid "The author of an anonymous post can't be added."
msgstr "המחבר של פוסט אנונימי לא ניתן להוסיף."

#, machine, plain1
msgid "The author says this is commercial promotion: a paid partnership, sponsorship, affiliate link, or advertising of their own products or services"
msgstr "המחבר אומר כי זהו קידום מסחרי: שותפות בתשלום, חסות, קישור שותפים או פרסום של המוצרים או השירותים שלהם"

#, machine, plain1
msgid "The author says this was made with AI"
msgstr "המחבר אומר שזה נעשה עם AI"

#, machine, plain1
msgid "The author turned comments off for this post."
msgstr "הכותב דחה הערות על הפוסט הזה."

#. %(names)s is a comma-separated list of the draft's authors
#, machine, plain1, python-format
msgid "The authors agreed to invite you: %(names)s."
msgstr "המחברים הסכימו להזמין אותך: %(names)s."

#, machine, plain1
msgid "The auto-moderation was saved."
msgstr "הרכב נשמר."

#, python-format
msgid "The ban relies on %(num)s of your anonymous posts and comments. If a second administrator approves (or, on a site with a single administrator, its owner), the Log will name your account beside them. [See which, and appeal](%(appeal)s)"
msgstr ""

#, machine, plain1, python-format
msgid "The base URL is <code>%(url)s</code>"
msgstr "הבסיס URL הוא <code>%(url)s</code>"

#, machine, plain1
msgid "The board is open while the Space is live."
msgstr "הלוח פתוח בזמן שהמרחב חי."

#, machine, plain1, python-format
msgid "The body can be at most %(num)s character."
msgid_plural "The body can be at most %(num)s characters."
msgstr[0] "הגוף יכול להיות ברוב אחד."
msgstr[1] "הגוף יכול להיות ברוב %(num)s תווים."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved."
msgstr "הבוט @ %(name)s הצעת לא אושרה."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved. The admins said: %(note)s"
msgstr "הבוט @ %(name)s הצעת לא אושרה. המנהל אמר: %(note)s"

#, machine, plain1
msgid "The bot already reads that feed."
msgstr "הבוט כבר קורא את האוכל הזה."

#, python-format
msgid "The bot you proposed, [@%(name)s](/@%(name)s), was approved. It is run by the site from now on and starts posting from its feeds within a few minutes. Thank you!"
msgstr ""

#, machine, plain1
msgid "The bot's account no longer exists."
msgstr "חשבון הבוט כבר לא קיים."

#, machine, plain1
msgid "The bot's owner can't run it right now."
msgstr "הבעלים של הבוטנים לא יכולים לרוץ עכשיו."

#, machine, plain1, python-format
msgid "The category %(category)s was deleted; its channels stay."
msgstr "קטגוריה %(category)s נמחק; הערוצים נשארים."

#, machine, plain1, python-format
msgid "The category %(category)s was made."
msgstr "קטגוריה %(category)s נעשה."

#, machine, plain1, python-format
msgid "The category was renamed %(category)s."
msgstr "שם הקטגוריה %(category)s."

#, machine, plain1, python-format
msgid "The coins go to the founder, <a href=\"%(url)s\">@%(name)s</a>."
msgstr "המטבעות הולכים למייסד, <a href=\"%(url)s\">@%(name)s</a>."

#, machine, plain1
msgid "The coins you earn from tips, paid circles and the creator fund, for the last 30 days and all time."
msgstr "המטבעות שאתה מרוויח מטיפים, מעגלים בתשלום וקרן היוצר, עבור 30 הימים האחרונים וכל הזמן."

#, machine, plain2
msgid "The comment stays where it is, with your name taken off it. Everyone who saw it with your name still knows it was you."
msgstr "התגובה נשארת היכן שהיא, עם השם שלך נלקח ממנה. כל מי שראה אותו עם השם שלך עדיין יודע שזה אתה."

#, machine, plain1, python-format
msgid "The copy other people forwarded to guilds will stay there."
msgid_plural "The %(num)s copies other people forwarded to guilds will stay there."
msgstr[0] "העותק של אנשים אחרים שהעבירו לגילדות יישאר שם."
msgstr[1] "%(num)s עותקים של אנשים אחרים שהועברו לגילדות יישארו שם."

#. %(guilds)s is a list of guild names, such as "+a, +b and +c"
#, machine, plain1, python-format
msgid "The copy you forwarded to %(guilds)s will be taken down."
msgid_plural "The copies you forwarded to %(guilds)s will be taken down."
msgstr[0] "העותק שהזמנת ל- %(guilds)s יילקח."
msgstr[1] "העותקים שציפיתם ל- %(guilds)s יתפסו."

#, machine, plain1
msgid "The dates leave no days."
msgstr "התאריכים לא יוצאים ימים."

#, machine, plain2
msgid "The decision stands"
msgstr "ההחלטה עומדת"

#, machine, plain1
msgid "The decisions made about it, newest first: who, when, where, which rule and why. It never shows the title or the text of what was hidden or removed."
msgstr "ההחלטות שהתקבלו על זה, קודם כל: מי, מתי, איפה, מי שולט ומדוע. זה אף פעם לא מראה את הכותרת או את הטקסט של מה שהוסתר או הוסר."

#, machine, plain1
msgid "The draft has changes the post doesn't show yet."
msgstr "הטיוטה משנה את הפוסט עדיין לא מופיעה."

#, machine, plain1
msgid "The earlier versions aren't shown while this is hidden."
msgstr "הגרסאות הקודמות אינן מוצגות בזמן שזה חבוי."

#, machine, plain2
msgid "The earlier versions aren't shown: this was deleted and its text has been cleared."
msgstr "הגרסאות הקודמות אינן מוצגות: זה נמחק והטקסט שלו הונקה."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was approved: it is read from now on."
msgstr "להאכיל %(url)s הפרסום האוטומטי של החשבון שלך אושר: הוא קורא מעתה ואילך."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was not approved."
msgstr "להאכיל %(url)s הפרסום האוטומטי של החשבון שלך לא אושר."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was approved: it is read from now on."
msgstr "להאכיל %(url)s לבוט שלך @%(name)s אושר: הוא קורא מעתה ואילך."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was not approved."
msgstr "להאכיל %(url)s לבוט שלך @%(name)s לא אושר."

#, machine, plain1, python-format
msgid "The feed answered with an error (%(status)s)."
msgstr "הזין ענה בטעות (%(status)s)."

#, machine, plain1
msgid "The feed asked us to slow down."
msgstr "להאכיל ביקשנו להאט."

#, machine, plain1
msgid "The feed did not answer in time."
msgstr "להאכיל לא ענה בזמן."

#, machine, plain1
msgid "The feed is unavailable for now."
msgstr "להאכיל כבר לא זמין."

#, machine, plain1
msgid "The feed server answered with a redirect, which is not followed."
msgstr "שרת ההזנה הגיבה בהפניה, שלא באה בעקבותיה."

#. status is an HTTP status code, such as 404
#, machine, plain1, python-format
msgid "The feed server answered with an error (%(status)s)."
msgstr "שרת ההזנה הגיבה בטעות (%(status)s)."

#, machine, plain1, python-format
msgid "The feed server answered with more than %(num)s post at once."
msgid_plural "The feed server answered with more than %(num)s posts at once."
msgstr[0] "שרת ההזנה ענתה עם יותר מ-%(num)s פוסטים בבת אחת."
msgstr[1] "שרת ההזנה ענה עם יותר מ %(num)s פוסטים בבת אחת."

#, machine, plain1
msgid "The feed server did not answer in time."
msgstr "שרת המזון לא הגיבה בזמן."

#, machine, plain1
msgid "The feed server took too long to answer."
msgstr "שרת ההזנה לקח זמן רב מדי לענות."

#, machine, plain1
msgid "The feed server's answer has no list of posts."
msgstr "התשובה של שרת להאכיל אין רשימה של פוסטים."

#, machine, plain1
msgid "The feed server's answer holds something that is not a post id."
msgstr "התשובה של שרת ההזנה היא משהו שאינו דואר."

#, machine, plain1
msgid "The feed server's answer is not JSON."
msgstr "התשובה של שרת ההזנה אינה JSON."

#, machine, plain1
msgid "The feed server's answer is not a JSON object."
msgstr "התשובה של שרת המזון היא לא JSON אובייקט."

#, machine, plain1
msgid "The feed server's answer is too large."
msgstr "התשובה של שרת המזון גדולה מדי."

#, machine, plain1
msgid "The feed server's certificate could not be checked."
msgstr "לא ניתן לבדוק את תעודת שרת ההזנה."

#, machine, plain1
msgid "The feed server's cursor is not usable."
msgstr "ה- cursor של שרת ההזנה אינה אפשרית."

#, machine, plain1
msgid "The feed's address sends it somewhere else too many times."
msgstr "כתובת ההזנה שולחת אותו למקום אחר יותר מדי פעמים."

#, machine, plain1
msgid "The feed's answer is too large."
msgstr "התשובה של להאכיל גדולה מדי."

#, machine, plain1
msgid "The feed's certificate could not be checked."
msgstr "לא ניתן לבדוק את תעודת המזון."

#, machine, plain1
msgid "The file's size is missing."
msgstr "גודל הקובץ חסר."

#, machine, plain1, python-format
msgid "The following users are approved to forward to +%(guild)s."
msgstr "המשתמשים הבאים אושרו ל- +%(guild)s."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s guild chat."
msgstr "המשתמשים הבאים אסורים להשתתף ב- +%(guild)s צ'אט נפוח"

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s."
msgstr "המשתמשים הבאים אסורים להשתתף ב- +%(guild)s."

#, machine, plain1
msgid "The guild"
msgstr "The guild"

#, machine, plain1
msgid "The guild already has a category with that name."
msgstr "למגור כבר יש קטגוריה עם השם הזה."

#, machine, plain1
msgid "The guild already has a channel with that name."
msgstr "יש לו כבר ערוץ עם השם הזה."

#, machine, plain1
msgid "The guild already has a role with that name."
msgstr "למגור כבר יש תפקיד עם השם הזה."

#, machine, plain1
msgid "The guild's own rules for what is written in its channels, on top of the site's word filter. Guildmasters are never held to them. A message that breaks one is refused with a short reason that never says which word."
msgstr "הכללים של הגורל עצמו על מה שנכתב בערוצים שלו, על גבי מסנן המילים של האתר. מעצבי הגילדה מעולם לא מוחזקים להם. הודעה שמפרקת אחד נדחתה מסיבה קצרה שמעולם לא אומרת איזו מילה."

#, machine, plain2
msgid "The hold on your account was lifted. You can post, comment and vote again."
msgstr "החשבון שלך הוסר. אתה יכול לכתוב, להגיב ולהצביע שוב."

#, machine, plain1
msgid "The host stays on stage."
msgstr "המארח נשאר על הבמה."

#, machine, plain1
msgid "The independent social platform"
msgstr "הפלטפורמה החברתית העצמאית"

#, machine, plain1
msgid "The internet gremlins have led you to a dark, musty dead-end. There's nothing here."
msgstr "הגרמלין באינטרנט הוביל אותך אל קצה אפל, חייב למות. אין כאן כלום."

#, machine, plain1, python-format
msgid "The key that opens your messages in a new app. It is locked with your password and opened here, in this browser: %(site)s never sees it. Anyone with it and your account can read your chats, so never share it."
msgstr "המפתח פותח את ההודעות שלך באפליקציה חדשה. הוא נעול עם הסיסמה שלך ופתח כאן, בדפדפן הזה: %(site)s אף פעם לא רואים את זה. כל אחד עם זה ואת החשבון שלך יכול לקרוא את הצ'אטים שלך, אז אף פעם לא לשתף אותו."

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s"
msgstr "הקישור `%(link)s` לא מותר. סיבה: %(reason)s"

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s."
msgstr "הקישור `%(link)s` לא מותר. סיבה: %(reason)s."

#, machine, plain1, python-format
msgid "The link can be at most %(num)s character."
msgid_plural "The link can be at most %(num)s characters."
msgstr[0] "הקישור יכול להיות ברוב אחד."
msgstr[1] "הקישור יכול להיות ברוב %(num)s תווים."

#, machine, plain1
msgid "The link can't contain a user name or password."
msgstr "הקישור לא יכול להכיל שם משתמש או סיסמה."

#, machine, plain1
msgid "The link can't contain spaces."
msgstr "הקישור לא יכול להכיל חללים."

#, machine, plain1
msgid "The link must start with https:// or http://."
msgstr "הקישור חייב להתחיל ב-https: או http://."

#, machine, plain1
msgid "The link needs a full address, such as example.com."
msgstr "הקישור צריך כתובת מלאה, כגון.com."

#, machine, plain1
msgid "The list is open to members so that anyone can see what the filter hides and why. Nothing on it is removed from the site: each member's own filter decides what they see."
msgstr "הרשימה פתוחה לחברים כך שכל אחד יכול לראות מה המסנן מסתתר ומדוע. שום דבר על זה לא הוסר מהאתר: כל מסנן משלו מחליט מה הם רואים."

#, machine, plain1
msgid "The list isn't shown on the Child filter"
msgstr "הרשימה לא מופיעה במסנן הילדים"

#, python-format
msgid "The most a circle can ask is %(num)s coin every 30 days."
msgid_plural "The most a circle can ask is %(num)s coins every 30 days."
msgstr[0] ""
msgstr[1] ""

#, machine, plain1
msgid "The most voted posts of the last seven days."
msgstr "הפוסטים הנבחרים ביותר של שבעת הימים האחרונים."

#, machine, plain1, python-format
msgid "The name %(host)s could not be found."
msgstr "השם %(host)s לא ניתן למצוא."

#, machine, plain1
msgid "The newest of what they have done. Only the names of who they chat with are shown, never what a chat says: chats are end-to-end encrypted."
msgstr "החדש של מה שהם עשו. רק השמות של מי הם משוחחים עם מוצגים, לעולם לא מה אומר צ'אט: צ'אטים הם מוצפנים מקצה לקצה."

#, machine, plain2
msgid "The number of an anonymous author"
msgstr "המספר של סופר אנונימי"

#, machine, plain2
msgid "The number of items you confirmed doesn't match what was chosen. Nothing was changed."
msgstr "מספר הפריטים שאתה אישר לא תואם את מה שנבחר. שום דבר לא השתנה."

#, machine, plain1
msgid "The numbers are always shown on your profile. This decides who can open each list and see the accounts on it. An account is only listed where its own setting allows it too."
msgstr "המספרים תמיד מופיעים בפרופיל שלך. זה מחליט מי יכול לפתוח כל רשימה ולראות את החשבונות. חשבון מופיע רק במקום שבו ההגדרה שלו מאפשרת זאת."

#, machine, plain1
msgid "The open-source platform for independent internet communities"
msgstr "פלטפורמת הקוד הפתוח לקהילות אינטרנט עצמאיות"

#, machine, plain1
msgid "The original content is not retained anywhere, including in this history."
msgstr "התוכן המקורי לא נשמר בשום מקום, כולל בהיסטוריה."

#, machine, plain1
msgid "The other authors of a shared draft removed you as an author. What you wrote stays credited to you."
msgstr "הכותבים האחרים של טיוטה משותפת הסירו אותך כסופר. מה שכתבת נשאר מחובר אליך."

#, machine, plain1
msgid "The owner deletes a channel instead of leaving it."
msgstr "הבעלים מחקים ערוץ במקום לעזוב אותו."

#, machine, plain1
msgid "The owner's role can't be changed."
msgstr "תפקידו של הבעלים לא ניתן לשנות."

#, machine, plain1
msgid "The page's current text isn't shown here; what you save replaces it."
msgstr "הטקסט הנוכחי של הדף אינו מוצג כאן; מה שאתה מציל מחליף אותו."

#, machine, plain1
msgid "The picture could not be stored. Try again later."
msgstr "לא ניתן לאחסן את התמונה. נסה שוב מאוחר יותר."

#, machine, plain1
msgid "The picture goes to your own linked storage, not to this site. You can add a few words under it."
msgstr "התמונה עוברת לאחסון מקושר משלך, לא לאתר זה. אפשר להוסיף כמה מילים מתחתיו."

#, machine, plain1
msgid "The picture you chose"
msgstr "התמונה שבחרת"

#, machine, plain1
msgid "The post appears on the profile of whoever publishes it first. Optionally forward it into guilds for community discussion: each guild gets its own independent copy with its own votes and comments. Guilds are forwarded to when the draft is first published."
msgstr "הפוסט מופיע בפרופיל של מי מפרסם אותו קודם. באופן אופציונלי, לקדם את זה ל guilds לדיון קהילתי: כל גורש מקבל עותק עצמאי משלו עם קולות והערות משלו. גיל ההתבגרות צפויים כאשר הטיוטה פורסמה לראשונה."

#, machine, plain1
msgid "The post carries your name and is listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your name."
msgstr "הפוסט נושא את שמך ורשום בפרופיל שלך. הצבעות, הערות ותוספות משותפות עם המחבר שלה, שעורך וממחק אותו. אתה יכול לצאת בכל עת: הפוסט נשאר, ללא השם שלך."

#, machine, plain2
msgid "The post is not listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your credit."
msgstr "הפוסט לא מופיע בפרופיל שלך. הצבעות, הערות ותוספות משותפות עם המחבר שלה, שעורך וממחק אותו. אתה יכול לרדת בכל עת: הפוסט נשאר, ללא האשראי שלך."

#, machine, plain1
msgid "The post refused the change."
msgstr "הפוסט סירב לשינוי."

#, machine, plain2
msgid "The post stays where it is, with your name taken off it, and leaves your profile. Its Rep leaves you too. Everyone who saw it with your name still knows it was you."
msgstr "הפוסט נשאר שם, עם השם שלך מוריד אותו, ומשאיר את הפרופיל שלך. גם המוניטין שלו משאיר אותך. כל מי שראה אותו עם השם שלך עדיין יודע שזה אתה."

#, machine, plain2
msgid "The post's author"
msgstr "מחבר הפוסט"

#, machine, plain2
msgid "The post's author deleted it, so it is shown as Anonymous: no name and no link. The comments under it stay as they were; one its author deleted is shown as Anonymous too."
msgstr "הכותב של הפוסט מחק אותו, כך שהוא מוצג כאנונימיות: אין שם ולא קישור. ההערות שתחתיו נשארו כפי שהיו; אחד מחברו נמחק גם הוא אנונימי."

#, machine, plain1, python-format
msgid "The promo code `%(code)s` is not currently valid. Please begin a new transaction."
msgstr "קוד קידום `%(code)s` כרגע לא חוקי. אנא התחילו עסקה חדשה."

#, machine, plain1, python-format
msgid "The proposal for @%(name)s has been withdrawn."
msgstr "ההצעה @%(name)s הוא נסוג."

#, machine, plain1, python-format
msgid "The role %(role)s was deleted."
msgstr "התפקיד %(role)s נמחק."

#, machine, plain1, python-format
msgid "The role %(role)s was made."
msgstr "התפקיד %(role)s נעשה."

#, machine, plain1, python-format
msgid "The role %(role)s was saved."
msgstr "התפקיד %(role)s הוא ניצל."

#, machine, plain1
msgid "The royal bank has told us that you owe them some coin. You'll need to pay off your debts before you can continue."
msgstr "הבנק המלכותי אמר לנו שאתה חייב להם מטבע. תצטרך לשלם את החובות שלך לפני שתוכל להמשיך."

#, machine, plain1
msgid "The rules"
msgstr "הכללים"

#, machine, plain1
msgid "The rules below"
msgstr "הכללים למטה"

#, machine, plain1, python-format
msgid "The rules can be at most %(count)s character."
msgid_plural "The rules can be at most %(count)s characters."
msgstr[0] "הכללים יכולים להיות ברוב %(count)s אופי."
msgstr[1] "הכללים יכולים להיות ברוב %(count)s דמויות"

#, machine, plain1
msgid "The rules can't contain control or invisible characters."
msgstr "הכללים לא יכולים להכיל שליטה או דמויות בלתי נראות."

#, machine, plain1
msgid "The screenshot you are sending"
msgstr "צילום מסך שאתה שולח"

#. %(status)s is an HTTP status code
#, machine, plain1, python-format
msgid "The server answered %(status)s."
msgstr "השרת ענה %(status)s."

#, machine, plain1, python-format
msgid "The server answers with the posts to show and their order; %(site)s still hides anything a viewer may not see, and tells the server nothing about who is looking. Everyone is told that an outside server ranks this curation."
msgstr "השרת עונה עם הפוסטים כדי להראות וסדר שלהם; %(site)s עדיין מסתיר שום דבר שצופה לא רואה, ואומר לשרת לא על מי מסתכל. כולם אומרים כי שרת חיצוני מדרג את הזין המחוספס הזה."

#, machine, plain1, python-format
msgid "The server named %(num)s post; you can see %(seen)s of them."
msgid_plural "The server named %(num)s posts; you can see %(seen)s of them."
msgstr[0] "שרת בשם %(num)s post; אתה יכול לראות %(seen)s של אותם."
msgstr[1] "שרת בשם %(num)s פוסטים; ניתן לראות %(seen)s מהם."

#, machine, plain1
msgid "The server thinks you're asking something silly. It might take you more seriously if you take off the jester outfit."
msgstr "השרת חושב שאתה שואל משהו טיפשי. זה יכול לקחת אותך יותר ברצינות אם אתה מוריד את התלבושת."

#, machine, plain1
msgid "The site refused the bot's session."
msgstr "האתר סירב לפגישת הבוטנים."

#, machine, plain2
msgid "The site's admins have it already."
msgstr "למנהלי האתר כבר יש את זה."

#, machine, plain1
msgid "The site's admins marked this guild sensitive, so only an admin can change this."
msgstr "מנהלי האתר ציינו את הרגישות הזו, כך שרק מנהל יכול לשנות זאת."

#, machine, plain2
msgid "The site's admins will read it. They are never told who reported."
msgstr "הנהלת האתר תקרא את זה. הם אף פעם לא אומרים מי דיווח."

#, machine, plain1, python-format
msgid "The stage is full (%(num)s person)."
msgid_plural "The stage is full (%(num)s people)."
msgstr[0] "הבמה מלאה (%(num)s אנשים)."
msgstr[1] "השלב מלא (%(num)s אנשים)."

#, machine, plain1
msgid "The storage service is not answering right now. Try again in a moment."
msgstr "שירות האחסון אינו עונה כרגע. נסה שוב לרגע."

#, machine, plain1, python-format
msgid "The summary can be at most %(num)s character."
msgid_plural "The summary can be at most %(num)s characters."
msgstr[0] "הסיכום יכול להיות ברוב אחד."
msgstr[1] "סיכום יכול להיות ברוב %(num)s תווים."

#, machine, plain1
msgid "The summary can be changed while the Space is live."
msgstr "ניתן לשנות את הסיכום בזמן שהמרחב חי."

#, machine, plain1
msgid "The text isn't shown: this was removed by the site's administrators."
msgstr "הטקסט לא מוצג: זה הוסר על ידי מנהלי האתר."

#, machine, plain1
msgid "The text of this version was hidden by a site administrator."
msgstr "הטקסט של גרסה זו הוסתר על ידי מנהל האתר."

#, machine, plain1, python-format
msgid "The time before links must be a whole number of days, 0 to %(max)s."
msgstr "הזמן לפני הקישורים חייב להיות מספר שלם של ימים, 0 ל %(max)s."

#, machine, plain1, python-format
msgid "The time in the guild must be a whole number of days, 0 to %(max)s."
msgstr "הזמן בגור חייב להיות מספר שלם של ימים, 0 עד %(max)s."

#, machine, plain1, python-format
msgid "The title can be at most %(num)s character."
msgid_plural "The title can be at most %(num)s characters."
msgstr[0] "הכותרת יכולה להיות במרבית הדמות."
msgstr[1] "הכותרת יכולה להיות ברוב %(num)s תווים."

#, machine, plain1
msgid "The two revisions have the same text."
msgstr "לשני השינויים יש את אותו הטקסט."

#, machine, plain1
msgid "The upload did not arrive in your Google Drive. Try again."
msgstr "ההעלאה לא הגיעה אליכם Google Driveנסה שוב."

#, machine, plain1
msgid "The upload did not arrive in your OneDrive. Try again."
msgstr "ההעלאה לא הגיעה אליכם OneDriveנסה שוב."

#, machine, plain1
msgid "The upload did not arrive. Try again."
msgstr "ההעלאה לא הגיעה. נסה שוב."

#, machine, plain1, python-format
msgid "The username @%(name)s has been pre-emptively reserved for: %(who)s"
msgstr "שם המשתמש @%(name)s כבר שמורה מראש: %(who)s"

#, machine, plain1
msgid "The usual order - everything from the guilds and accounts you add"
msgstr "הסדר הרגיל - הכל מהגילים והחשבונות שאתה מוסיף"

#, machine, plain1
msgid "The video did not finish uploading to Dailymotion. Add it again."
msgstr "הסרטון לא הגיע ל- Dailymotion הוסף אותו שוב."

#, machine, plain1
msgid "The video did not finish uploading. Add it again."
msgstr "הסרטון לא סיים להעלות. הוסף אותו שוב."

#, machine, plain1, python-format
msgid "The website can be at most %(num)s character."
msgid_plural "The website can be at most %(num)s characters."
msgstr[0] "האתר יכול להיות ברוב אחד האופי."
msgstr[1] "האתר יכול להיות ברוב %(num)s תווים."

#, machine, plain1
msgid "The website can't contain a user name or password."
msgstr "האתר לא יכול להכיל שם משתמש או סיסמה."

#, machine, plain1
msgid "The website can't contain spaces."
msgstr "האתר לא יכול להכיל חללים."

#, machine, plain1
msgid "The website must start with https:// or http://."
msgstr "האתר חייב להתחיל ב-https: או http://."

#, machine, plain1
msgid "The website needs a full address, such as example.com."
msgstr "האתר צריך כתובת מלאה, למשל.com."

#, machine, plain1
msgid "The whole site <span class=\"text-muted\">(needs an age limit of a month or less)</span>"
msgstr "כל האתר <span class=\"text-muted\">(צריך הגבלת גיל של חודש או פחות)</span>"

#, machine, plain1
msgid "The wiki is off: only guildmasters see it."
msgstr "Wiki הוא כבוי: רק מחוקקים נפוחים רואים אותו."

#, machine, plain1
msgid "The wiki's first page can be emptied but not deleted."
msgstr "העמוד הראשון של wiki יכול להיות מרוקן אך לא נמחק."

#, machine, plain1
msgid "The word filter has no words at the moment."
msgstr "למילה המסנן אין מילים כרגע."

#, machine, plain1, python-format
msgid "The words for other languages are adapted from %(source)s (%(licence)s): words that are also ordinary, innocent words were left out."
msgstr "המילים לשפות אחרות מותאמות %(source)s (()%(licence)sמילים שהן גם רגילות, מילים תמימות נותרו בחוץ."

#, machine, plain1
msgid "The working copy as it is now. Only its authors can see this until it's published."
msgstr "עותק העבודה כפי שהוא עכשיו. רק המחברים יכולים לראות את זה עד שהוא פורסם."

#, machine, plain1
msgid "Theater"
msgstr "תיאטרון Theater"

#, machine, plain1
msgid "Their commenting history will show here."
msgstr "ההיסטוריה שלהם תופיע כאן."

#, machine, plain1
msgid "Their forwarding activity will show here."
msgstr "הפעילות הצפויה שלהם תופיע כאן."

#, machine, plain1
msgid "Their posting history will show here."
msgstr "ההיסטוריה של הפרסום שלהם תופיע כאן."

#, machine, plain1
msgid "Their posts and comments are left out of your feeds and threads and they cannot notify you. They are not told, and they can still follow you, comment on your posts and message you. Their anonymous posts and comments are not hidden, as hiding only those would tell you who wrote them. Mute someone from the menu on any of their posts or comments, or from their profile."
msgstr "הפוסטים וההערות שלהם נותרו מתוך הזנות והחוטים שלך והם לא יכולים להודיע לך. הם לא אומרים, והם עדיין יכולים לעקוב אחריך, להגיב על הפוסטים שלך ולמסר לך. הפוסטים וההערות האנונימיים שלהם אינם נסתרים, כפי שמסתתרים רק אלה שיגידו לכם מי כתב אותם. הניחו מישהו מהתפריט על כל הפוסטים או ההערות שלהם, או מהפרופיל שלהם."

#, machine, plain1
msgid "There are no approved users"
msgstr "אין משתמשים מאושרים"

#, machine, plain1
msgid "There are no exiled users"
msgstr "אין משתמשים גולים"

#, machine, plain1
msgid "There are no guildmaster invitations."
msgstr "אין הזמנות ממותג."

#, machine, plain1
msgid "There are no guildmasters."
msgstr "אין משגיחים."

#, machine, plain1
msgid "There are no posts here."
msgstr "אין כאן פוסטים."

#, machine, plain1, python-format
msgid "There is no account named @%(name)s."
msgstr "אין חשבון בשם @%(name)s."

#, machine, plain2
msgid "There is nothing here to appeal."
msgstr "אין כאן מה לערער."

#, machine, plain1
msgid "There is nothing to save yet."
msgstr "עדיין אין מה לחסוך."

#, machine, plain2
msgid "There is nothing waiting for this ban."
msgstr "אין שום דבר לחכות לאיסור הזה."

#, machine, plain1
msgid "There was a problem. Please try again."
msgstr "הייתה בעיה. אנא נסה שוב."

#, machine, plain1
msgid "There were no names in that file."
msgstr "לא היו שמות בתיק הזה."

#, machine, plain1
msgid "There were no survivors."
msgstr "לא היו ניצולים."

#, machine, plain1
msgid "There's a shortage of perfect request entities in this world. Would be a pity to damage yours."
msgstr "יש מחסור בבקשות מושלמות בעולם הזה. אשמח לפגוע בך."

#, machine, plain1
msgid "There's already an open proposal like this one."
msgstr "יש כבר הצעה פתוחה כזו."

#, machine, plain1
msgid "There's no account with that name."
msgstr "אין חשבון עם השם הזה."

#, machine, plain1
msgid "There's no invitation to speak."
msgstr "אין הזמנה לדבר."

#, machine, plain2
msgid "There's no recovery code to keep yet."
msgstr "עדיין אין קוד התאוששות."

#, machine, plain1
msgid "There's nothing here right now."
msgstr "אין כאן שום דבר כרגע."

#, machine, plain1
msgid "There's nothing left here but a giant smouldering crater."
msgstr "אין כאן שום דבר מלבד מכתש ענק."

#, machine, plain1
msgid "These are the users you are subscribed to."
msgstr "אלה המשתמשים שאתה מנוי עליהם."

#, machine, plain1
msgid "These counts start from the day guild insights were switched on: before that the site did not record when people left a guild or how often its page was opened."
msgstr "ספירות אלה מתחילות מהיום שבו נעשות תובנות עצומות: לפני שהאתר לא הגיע לשיא כשאנשים עזבו את הגורל או באיזו תדירות נפתח הדף."

#, machine, plain1
msgid "These filters are saved as your default"
msgstr "מסננים אלה נשמרים כמו ברירת המחדל שלך"

#, machine, plain1
msgid "These topics"
msgstr "נושאים אלה"

#, machine, plain1, python-format
msgid "These users have been invited to moderate +%(guild)s."
msgstr "משתמשים אלה הוזמנו בינוני + %(guild)s."

#, machine, plain1
msgid "They already have this role."
msgstr "כבר יש להם את התפקיד הזה."

#, machine, plain1
msgid "They are 18 or over, so they can make their own account."
msgstr "הם 18 או יותר, כך שהם יכולים לעשות חשבון משלהם."

#, machine, plain1
msgid "They are already in this circle."
msgstr "הם כבר במעגל הזה."

#, machine, plain1
msgid "They are not told. Anyone you block leaves your circles."
msgstr "הם לא אמרו. כל מי שאתה חוסם משאיר את המעגלים שלך."

#, machine, plain2
msgid "They are signed out everywhere, chat apps included. If they use chat, they may need their recovery code, or a browser where they've used chat, to read their old messages."
msgstr "הם מנותקים בכל מקום, יישומי צ'אט הכלולים. אם הם משתמשים בצ'אט, הם עשויים לדרוש את קוד ההתאוששות שלהם, או דפדפן שבו הם השתמשו בצ'אט, כדי לקרוא את המסרים הישנים שלהם."

#, machine, plain1, python-format
msgid "They aren't in %(circle)s."
msgstr "הם לא בפנים %(circle)s."

#, machine, plain1
msgid "They aren't in this group."
msgstr "הם לא בקבוצה הזאת."

#, machine, plain1
msgid "They aren't muted here."
msgstr "הם לא מומסים כאן."

#, machine, plain1
msgid "They can buy and spend coins, tip, buy Premium and join or run paid circles."
msgstr "הם יכולים לקנות ולבזבז מטבעות, טיפ, לקנות Premium להצטרף או לרוץ מעגלים בתשלום."

#, machine, plain2
msgid "They can join and listen to Spaces. They can't host one or post in one: a child account only reads. Voice calls in a Space also need Chat to be on."
msgstr "הם יכולים להצטרף ולהאזין לחללים. הם לא יכולים לארח אחד או לפרסם אחד: חשבון ילדים קורא רק. שיחות קוליות בחלל זקוקות גם לצ'אט."

#, machine, plain1
msgid "They can message people, join group chats and make calls. The site never shows you what a chat says: chats are end-to-end encrypted. Whoever knows their password can still sign in and read them."
msgstr "הם יכולים לשלוח אנשים, להצטרף צ'אטים קבוצתיים ולעשות שיחות. האתר אף פעם לא מראה לך מה צ'אט אומר: צ'אטים הם מוצפנים מקצה לקצה. מי שמכיר את הסיסמה שלו עדיין יכול להיכנס ולקרוא אותם."

#, machine, plain1
msgid "They can see what you do on the site: your posts, comments, votes, bookmarks, follows, guilds, who you chat with, that your account was reported, and your recent sign-ins. The site never shows them what your chats say, because chats are end-to-end encrypted. But anyone who knows your password, a parent who chose it included, can sign in as you: change it in Security so that only you know it. They choose which of these are on for your account:"
msgstr "הם יכולים לראות מה אתה עושה באתר: הפוסטים שלך, התגובות, הקולות, סימניות, להלן, גילידים, מי אתה משוחח עם, כי החשבון שלך דווח, ואת הסימנים האחרונים שלך. האתר אף פעם לא מראה להם מה אומרים הצ'אטים שלך, כי צ'אטים הם מוצפנים מקצה לקצה. אבל כל מי שמכיר את הסיסמה שלך, הורה שבחר בה, יכול להיכנס כפי שאתה: לשנות אותה בביטחון, כך שרק אתה מכיר אותה. הם בוחרים מי מהם על החשבון שלך:"

#, machine, plain2
msgid "They can start a guild. They still can't post or comment: a child account only reads."
msgstr "הם יכולים להתחיל גורד. הם עדיין לא יכולים לכתוב או להגיב: חשבון ילדים קורא רק."

#, machine, plain1
msgid "They can't comment on your posts or comments, chat with you or notify you by mentioning you. They are not told, but they may work it out if they try to comment on something of yours."
msgstr "הם לא יכולים להגיב על הפוסטים או הערות שלך, לשוחח איתך או להודיע לך על ידי אזכור אותך. הם לא אומרים, אבל הם עשויים לעבוד אם הם מנסים להגיב על משהו שלך."

#, machine, plain1
msgid "They don't have this role."
msgstr "אין להם את התפקיד הזה."

#, machine, plain1
msgid "They go straight to your coin balance."
msgstr "הם הולכים ישר לאיזון המטבע שלך."

#, machine, plain1
msgid "They haven't asked for that."
msgstr "הם לא ביקשו את זה."

#, machine, plain2
msgid "They leave the site. What they said stays in the Log as Anonymous, except for anything made in the last five minutes that nobody has commented on, which is erased. This can't be undone."
msgstr "הם עוזבים את האתר. מה שהם אמרו נשאר ב- Log as Anonymous, למעט כל דבר שנעשה בחמש הדקות האחרונות שאיש לא אמר עליו, שנמחק. זה לא יכול להיות בלתי בודד."

#, machine, plain1
msgid "They need to be in the guild, and not exiled from it."
msgstr "הם צריכים להיות בגור, ולא להיגלה ממנו."

#, machine, plain1
msgid "They need to join the channel first."
msgstr "קודם כל צריך להצטרף לערוץ."

#, machine, plain1
msgid "They say they are 18 or over and asked you to release their account. If you do, it becomes their own and you can no longer see it."
msgstr "הם אומרים שהם 18 ומעלה וביקשו ממך לשחרר את החשבון שלהם. אם אתה עושה זאת, זה הופך להיות שלהם ואתה כבר לא יכול לראות את זה."

#, machine, plain2
msgid "They stay where they are, with your name taken off them. This can't be undone. Posts that need your name (for a Circle, or with tips) are listed afterwards as not changed."
msgstr "הם נשארים איפה שהם, עם השם שלך מוריד אותם. זה לא יכול להיות בלתי בודד. פוסטים שצריכים את שמך (עבור מעגל, או עם טיפים) מפורטים לאחר מכן כפי שלא השתנה."

#, machine, plain2, python-format
msgid "They wrote: %(note)s"
msgstr "הם כתבו: %(note)s"

#, machine, plain1
msgid "They're already a helper."
msgstr "הם כבר עוזר."

#, machine, plain1
msgid "They're already on stage."
msgstr "הם כבר על הבמה."

#, machine, plain1
msgid "They've already been invited to speak."
msgstr "הם כבר הזמינו לדבר."

#, machine, plain1
msgid "This Circle guild is by invitation only."
msgstr "מעגל זה הוא על ידי הזמנה בלבד."

#, machine, plain1
msgid "This Google account has no YouTube channel yet. Create one at youtube.com, then try again."
msgstr "זה Google לחשבון אין YouTube ערוץ עדיין. צור אחד ב- YouTube.com, נסה שוב."

#, machine, plain1
msgid "This Space"
msgstr "החלל הזה"

#, machine, plain1
msgid "This Space can't take a replay now."
msgstr "החלל הזה לא יכול לקחת משחק מחדש עכשיו."

#, machine, plain1
msgid "This Space has already started."
msgstr "החלל הזה כבר התחיל."

#, machine, plain1
msgid "This Space has ended."
msgstr "החלל הזה הסתיים."

#, machine, plain1
msgid "This Space has ended. Its board is still here to read."
msgstr "החלל הזה הסתיים. הוועדה עדיין כאן כדי לקרוא."

#, machine, plain1
msgid "This Space has ended. Its chat is still here to read."
msgstr "החלל הזה הסתיים. הצ'אט עדיין כאן כדי לקרוא."

#, machine, plain1
msgid "This Space hasn't started yet."
msgstr "החלל הזה עדיין לא התחיל."

#, machine, plain1, python-format
msgid "This Space is full (%(num)s listener)."
msgid_plural "This Space is full (%(num)s listeners)."
msgstr[0] "החלל הזה מלא (%(num)s מאזינים)."
msgstr[1] "החלל הזה מלא (%(num)s מאזינים)."

#, machine, plain1, python-format
msgid "This Space is live until %(time)s."
msgstr "החלל הזה חי עד %(time)s."

#, machine, plain1
msgid "This Space is live."
msgstr "החלל הזה חי."

#, machine, plain1
msgid "This Space is not recorded: when it ends, it is gone, with everything in it."
msgstr "החלל הזה לא נרשם: כאשר הוא נגמר, הוא נעלם, עם הכל."

#, machine, plain1
msgid "This Space is recorded"
msgstr "החלל הזה נרשם"

#, machine, plain1
msgid "This Space is recorded: its board stays to read when it ends."
msgstr "החלל הזה נרשם: הלוח שלו נשאר לקרוא כשהוא מסתיים."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay with the video."
msgstr "החלל הזה נרשם: המארח ממשיך לשחק מחדש עם הסרטון."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay."
msgstr "החלל הזה נרשם: המארח ממשיך לשחק מחדש."

#, machine, plain1
msgid "This Space isn't available."
msgstr "החלל הזה אינו זמין."

#, machine, plain1
msgid "This Space isn't waiting to start."
msgstr "החלל הזה לא מחכה להתחיל."

#, machine, plain1
msgid "This Space keeps its sound only."
msgstr "החלל הזה שומר רק את הצליל שלו."

#, machine, plain1
msgid "This access will expire in one hour, or earlier if you revoke it."
msgstr "גישה זו תפוג בשעה אחת, או מוקדם יותר אם תבטל אותה."

#, machine, plain1
msgid "This account can't use chat apps."
msgstr "חשבון זה לא יכול להשתמש באפליקציות צ'אט."

#, machine, plain1, python-format
msgid "This account has been marked 18 or over since %(date)s."
msgstr "חשבון זה מונה 18 או יותר מאז %(date)s."

#, machine, plain1, python-format
msgid "This account has been permanently suspended from %(site)s."
msgstr "חשבון זה הושעה לצמיתות מ- %(site)s."

#, machine, plain1, python-format
msgid "This account has been temporarily suspended from %(site)s. Check back later."
msgstr "חשבון זה הושעה באופן זמני מ- %(site)s בדוק שוב מאוחר יותר."

#, machine, plain1
msgid "This account is private"
msgstr "חשבון זה פרטי"

#, machine, plain1
msgid "This account is suspended."
msgstr "החשבון הזה מושעה."

#, machine, plain1
msgid "This account owes money, so it can't be deleted yet."
msgstr "חשבון זה חייב כסף, אז עדיין לא ניתן למחוק אותו."

#, machine, plain1
msgid "This account posts about sensitive topics"
msgstr "מאמר זה עוסק בנושאים רגישים"

#, machine, plain2
msgid "This also signs out chat everywhere else, chat apps included, except the chat this browser has used since you signed in here."
msgstr "זה גם ניתוק צ'אט בכל מקום אחר, יישומי צ'אט הכלולים, למעט צ'אט דפדפן זה שימש מאז שחתמת כאן."

#. %(time)s is a length of time, such as "6 months"
#, machine, plain1, python-format
msgid "This author hasn't been active for %(time)s, so isn't counted."
msgstr "הכותב הזה לא היה פעיל %(time)sכך לא נספר."

#, machine, plain2
msgid "This ban relies on:"
msgstr "איסור זה מתבסס על:"

#, machine, plain1
msgid "This bot can't take tips right now."
msgstr "בוט זה לא יכול לקחת טיפים כרגע."

#, machine, plain1
msgid "This bot has not been approved."
msgstr "בוט זה לא אושר."

#, machine, plain1
msgid "This bot is not running."
msgstr "הבוט הזה לא רץ."

#, machine, plain1
msgid "This bot's owner can't run it right now."
msgstr "הבעלים של הרובוט הזה לא יכול לרוץ עכשיו."

#, machine, plain2
msgid "This bot's owner can't run it while their account is on hold."
msgstr "הבעלים של בוט זה לא יכול להפעיל את זה בעוד החשבון שלהם הוא על להחזיק."

#, machine, plain2
msgid "This browser was signed out. Sign in again to carry on."
msgstr "הדפדפן הזה היה מנותק. היכנס שוב כדי להמשיך."

#, machine, plain2
msgid "This browser's notifications couldn't be turned on. Try again."
msgstr "הודעות הדפדפן הזה לא יכולות להיות מופעלות. נסה שוב."

#, machine, plain1, python-format
msgid "This call is full (%(num)s person)."
msgid_plural "This call is full (%(num)s people)."
msgstr[0] "קריאה זו מלאה (%(num)s אנשים)."
msgstr[1] "קריאה זו מלאה (%(num)s אנשים)."

#, machine, plain1
msgid "This can't be translated right now."
msgstr "אי אפשר לתרגם את זה עכשיו."

#, machine, plain2
msgid "This can't be undone. The site's admins can always see who wrote something, and if an admin bans or suspends the account for it, the Log may name the account for it."
msgstr "זה לא יכול להיות בלתי בודד. מנהלי האתר יכולים תמיד לראות מי כתב משהו, ואם מנהל מערכת אוסר או מעכב את החשבון עבור זה, ה- Log עשוי לקרוא לו את החשבון."

#, machine, plain1
msgid "This channel doesn't ask for its rules to be accepted."
msgstr "ערוץ זה אינו מבקש לקבל את הכללים שלו."

#, machine, plain1
msgid "This channel has no messages."
msgstr "לערוץ הזה אין הודעות."

#, machine, plain1
msgid "This channel is end-to-end encrypted: it is read and written in Chat, where your messages are unlocked."
msgstr "ערוץ זה מוצפן מקצה לקצה: הוא קורא ונכתב בצ'אט, שבו ההודעות שלך נעולות."

#, machine, plain1
msgid "This channel is end-to-end encrypted: the site can't read it, so it has no word filter, slow mode, pins, search or reports."
msgstr "ערוץ זה מוצפן מקצה לקצה: האתר לא יכול לקרוא אותו, כך שאין לו מסנן מילים, מצב איטי, סיכות, חיפוש או דוחות."

#, machine, plain1
msgid "This channel is full."
msgstr "הערוץ הזה מלא."

#, machine, plain1
msgid "This channel is written from the chat itself."
msgstr "ערוץ זה נכתב מהצ'אט עצמו."

#, machine, plain1
msgid "This channel isn't available."
msgstr "ערוץ זה אינו זמין."

#, machine, plain1
msgid "This circle isn't taking subscribers."
msgstr "מעגל זה לא לוקח מנויים."

#, machine, plain1
msgid "This code can't be used. Get a new one on the computer, or sign in there with your password."
msgstr "לא ניתן להשתמש בקוד הזה. קבל חדש במחשב, או היכנס לשם עם הסיסמה שלך."

#, machine, plain1
msgid "This code has run out."
msgstr "הקוד הזה נגמר."

#, machine, plain1
msgid "This comment and the comments under it"
msgstr "תגובה זו וההערות שמתחתיו"

#, machine, plain1, python-format
msgid "This comment breaks %(site)s policy"
msgstr "תגובה זו שוברת %(site)s מדיניות מדיניות"

#, machine, plain1
msgid "This comment can't be forwarded."
msgstr "תגובה זו לא ניתן לקדם."

#, machine, plain1
msgid "This comment can't be reposted."
msgstr "תגובה זו לא ניתן לשחזר."

#, machine, plain1
msgid "This comment is on a copy forwarded to a guild - ask that guild's guildmasters to remove it instead."
msgstr "תגובה זו היא על עותק שהועבר לגלם - שאל את המכשול של גיליד להסיר אותו במקום זאת."

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a>"
msgstr "סעיף זה הוא עיר רפאים. <a href=\"%(url)s\">היכנס</a>"

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a> to comment!"
msgstr "סעיף זה הוא עיר רפאים. <a href=\"%(url)s\">היכנס</a> להגיב!"

#, machine, plain1
msgid "This comment section is a ghost town. Be the first to comment!"
msgstr "סעיף זה הוא עיר רפאים. להיות הראשון להגיב!"

#, machine, plain1
msgid "This comment section is a ghost town..."
msgstr "סעיף זה הוא עיר רפאים..."

#, machine, plain1
msgid "This content has already been posted"
msgstr "תוכן זה כבר פורסם"

#, machine, plain1
msgid "This copy is no longer kept."
msgstr "עותק זה כבר לא נשמר."

#, machine, plain2
msgid "This couldn't be changed right now."
msgstr "זה לא יכול להשתנות כרגע."

#, machine, plain1
msgid "This creates a new, independent post in that guild with its own votes and comments. The title is generated from the comment's text. A link back to the original comment will be shown on the new post."
msgstr "זה יוצר פוסט חדש, עצמאי באותו גיל עם קולות והערות משלו. הכותרת נוצרה מהטקסט של ההערה. קישור חזרה להערה המקורית יופיע בפוסט החדש."

#, machine, plain1
msgid "This creates an independent copy of the post with its own votes and comments in that guild. You can forward to any guild that accepts forwards from you."
msgstr "זה יוצר עותק עצמאי של הפוסט עם קולות והערות משלו באותו גיל. אתה יכול להתקדם לכל גיל מקבל קדימה ממך."

#, machine, plain1
msgid "This curation's feed server has been asked too often. Try again in a minute."
msgstr "שרת הזנה של מזון מחוספסת זו נשאלה לעתים קרובות מדי. נסה שוב תוך דקה."

#, machine, plain1
msgid "This curation's feed server has not been answering."
msgstr "שרת ההזנה המחוספסת לא עונה."

#, machine, plain1
msgid "This curation's feed server has not been answering. Showing its last answer."
msgstr "שרת ההזנה המחוספסת לא עונה. מציג את התשובה האחרונה שלו."

#, machine, plain1
msgid "This curation's guilds and accounts"
msgstr "זה מחוספס וחשבונות של מזון"

#, machine, plain1
msgid "This curation's rules took too long to run. Its owner can make them narrower."
msgstr "הכללים של מזון מחוספס זה לקח זמן רב מדי כדי לרוץ. הבעלים יכולים להפוך אותם צרים יותר."

#, machine, plain2
msgid "This decision can't be appealed."
msgstr "החלטה זו לא ניתן לערער."

#, machine, plain2
msgid "This decision has already been lifted."
msgstr "ההחלטה כבר הוסרה."

#, machine, plain2
msgid "This decision is about you. If you think it was wrong, you can appeal it."
msgstr "ההחלטה הזו היא עליך. אם אתה חושב שזה לא בסדר, אתה יכול לערער את זה."

#, python-format
msgid "This decision is in the Log, and you can appeal it: [See it in the Log](%(log)s) · [Appeal this decision](%(appeal)s)"
msgstr ""

#, machine, plain1
msgid "This deletes their account and everything on it. It can't be undone. You can download their data first."
msgstr "זה מחק את החשבון והכל על זה. זה לא יכול להיות בלתי בודד. אתה יכול להוריד את הנתונים קודם."

#, machine, plain2
msgid "This device will be signed out shortly."
msgstr "המכשיר הזה יתנתק בקרוב."

#, machine, plain1
msgid "This draft hasn't been published."
msgstr "טיוטה זו לא פורסמה."

#, machine, plain1
msgid "This event is over."
msgstr "האירוע הזה נגמר."

#, machine, plain1
msgid "This event was cancelled."
msgstr "האירוע הזה בוטל."

#, machine, plain1
msgid "This exact phrase"
msgstr "הביטוי המדויק הזה"

#, machine, plain1
msgid "This guild discusses sensitive topics"
msgstr "גור זה מדבר על נושאים רגישים"

#, machine, plain1
msgid "This guild discusses sensitive topics (every post here will be blurred by default)."
msgstr "גור זה מדבר על נושאים רגישים (כל פוסט כאן ייטשטש כברירת מחדל)."

#, machine, plain2
msgid "This guild is already banned."
msgstr "גור זה כבר אסור."

#, machine, plain1
msgid "This guild is banned."
msgstr "גור זה אסור."

#, machine, plain1
msgid "This guild is private. Content posted prior to the guild being set to private is visible to everyone."
msgstr "הגור הזה הוא פרטי. תוכן שפורסם לפני גיל המעבר לפרטי נראה לכולם."

#, machine, plain1
msgid "This guild's channels are closed."
msgstr "הערוצים של הגורל סגורים."

#, machine, plain2
msgid "This has a legal-level record, which can't be cited."
msgstr "יש לזה שיא ברמה המשפטית, אשר לא ניתן לציין."

#, machine, plain2
msgid "This has been deleted."
msgstr "זה נמחק."

#, machine, plain1
msgid "This invitation was already answered."
msgstr "ההזמנה כבר התקבלה."

#, machine, plain1
msgid "This is a Space: its discussion is in the Space."
msgstr "זהו חלל: הדיון שלו נמצא בחלל."

#, machine, plain1, python-format
msgid "This is a Space: its discussion is in the Space. <a href=\"%(url)s\">Open the Space</a>"
msgstr "זהו חלל: הדיון שלו נמצא בחלל. <a href=\"%(url)s\">פתח את החלל</a>"

#, machine, plain1
msgid "This is a Space: its host and co-hosts post its updates from the Space."
msgstr "זהו חלל: המארח והשותף שלו מפרסמים את העדכונים שלו מהחלל."

#, machine, plain1, python-format
msgid "This is a log of moderator actions performed in +%(guild)s. The ones everyone may read are also in the site-wide <a href=\"%(url)s\">Log</a>. What members delete themselves is not published."
msgstr "זהו יומן של פעולות מודולריות שבוצעו ב +%(guild)sאלה שכולם יכולים לקרוא הם גם באתר <a href=\"%(url)s\">Log Log</a>מה שהחברים מחקים את עצמם לא פורסם."

#, machine, plain2
msgid "This is already anonymous."
msgstr "זה כבר אנונימי."

#, machine, plain1
msgid "This is already in your language."
msgstr "זה כבר בשפה שלך."

#, machine, plain2
msgid "This is for chat on this site. A chat app you use outside it follows its own setting."
msgstr "זה עבור צ'אט באתר זה. אפליקציית צ'אט שבה אתה משתמש בחוץ היא עוקבת אחר ההגדרה שלו."

#, machine, plain1
msgid "This is for the members of a Circle guild."
msgstr "זה עבור החברים של עיגול."

#. %(name)s is the username of the person who made the post
#, machine, plain1, python-format
msgid "This is for the people in one of <a href=\"%(url)s\">@%(name)s</a>'s circles."
msgstr "זה עבור האנשים באחד <a href=\"%(url)s\">@%(name)s</a>\"עיגולים."

#, machine, plain2
msgid "This is in a private place, and a private item can't be cited in the public Log."
msgstr "זה במקום פרטי, פריט פרטי לא ניתן לצטט בציבור Log."

#, machine, plain1
msgid "This is the guild's custom CSS file."
msgstr "זהו מנהגו של גורד CSS קובץ."

#, machine, plain1
msgid "This is too much like what was posted automatically today."
msgstr "זה יותר מדי כמו מה שפורסם היום באופן אוטומטי."

#, machine, plain1
msgid "This isn't available while your account is age-restricted. You can confirm your age in Settings > Content."
msgstr "זה לא זמין בזמן שהחשבון שלך מוגבל לגיל. אתה יכול לאשר את הגיל שלך בהגדרות > תוכן."

#, machine, plain2
msgid "This isn't one of the account's own posts or comments."
msgstr "זה לא אחד מהפוסטים או התגובות של החשבון."

#, machine, plain1
msgid "This isn't shown at your current word filter level. You can review your word filter in your content settings."
msgstr "זה לא מופיע ברמת המסנן הנוכחית שלך. אתה יכול לבדוק את המילה מסנן בהגדרות התוכן שלך."

#, machine, plain1
msgid "This isn't shown where you are until your age has been confirmed. Sign in to do that in your content settings."
msgstr "זה לא נראה איפה אתה עד שהגיל שלך אושר. היכנסו לעשות זאת בהגדרות התוכן שלכם."

#, machine, plain1
msgid "This isn't shown while your account is age-restricted."
msgstr "זה לא נראה בזמן שהחשבון שלך מוגבל לגיל."

#, machine, plain2
msgid "This isn't yours to change, or it is already gone."
msgstr "זה לא שלך להשתנות, או שזה כבר נעלם."

#, machine, plain1, python-format
msgid "This live thread ended a moment ago. It can go live again in %(num)s min."
msgid_plural "This live thread ended a moment ago. It can go live again in %(num)s min."
msgstr[0] "חוט חי הסתיים לפני רגע. זה יכול לחיות שוב תוך %(num)s דקות."
msgstr[1] "חוט חי הסתיים לפני רגע. הוא יכול לחיות שוב תוך %(num)s דקות."

#, machine, plain1
msgid "This live thread has ended"
msgstr "חוט חי זה הסתיים"

#, machine, plain1
msgid "This may be misleading or needs context (request a community note)"
msgstr "זה יכול להיות מטעה או צורך בהקשר (לבקש הערה קהילתית)"

#, machine, plain1
msgid "This month"
msgstr "החודש הזה"

#, machine, plain1
msgid "This needs a verified email address."
msgstr "זה צריך כתובת דואר אלקטרוני מאומתת."

#, machine, plain1
msgid "This page is empty."
msgstr "דף זה ריק."

#, machine, plain1, python-format
msgid "This page is generated by the %(site)s application introspecting its own routing functions. Nifty."
msgstr "דף זה נוצר על ידי יישום %(site)s המציין את פונקציות ההמראה שלו. גבוה."

#, machine, plain1
msgid "This page lists offensive words"
msgstr "דף זה מציג מילים פוגעניות"

#, machine, plain1
msgid "This page may not be embedded in other webpages."
msgstr "דף זה לא יכול להיות מוטבע באתרי אינטרנט אחרים."

#, machine, plain1
msgid "This page was opened from a link, not by your camera."
msgstr "דף זה נפתח מתוך קישור, לא באמצעות המצלמה."

#, machine, plain1
msgid "This permanently erases the comment text. It cannot be undone, even by an admin."
msgstr "זה לצמיתות מחק את טקסט התגובה. זה לא יכול להיות פגום, אפילו על ידי מנהל."

#, machine, plain1
msgid "This permanently erases the post title, text and link. It cannot be undone, even by an admin."
msgstr "זה לצמיתות מחק את כותרת הפוסט, הטקסט והקישור. זה לא יכול להיות פגום, אפילו על ידי מנהל."

#, machine, plain1
msgid "This person is blocking you."
msgstr "האדם הזה חוסם אותך."

#, machine, plain1
msgid "This phone signed in with a QR code, so it can't approve another one. Enter your password here, then scan a new code."
msgstr "הטלפון חתום ב- QR קוד, אז זה לא יכול לאשר עוד אחד. הזן את הסיסמה שלך כאן, ולאחר מכן לסרוק קוד חדש."

#, machine, plain1
msgid "This poll has ended."
msgstr "הסקר הזה הסתיים."

#, machine, plain1
msgid "This poll is no longer available."
msgstr "הסקר הזה כבר לא זמין."

#, machine, plain1
msgid "This post and its comments are archived and can no longer be voted on."
msgstr "הפוסט הזה וההערות שלו מאוחסנים ולא ניתן עוד להצביע עליהם."

#, machine, plain1, python-format
msgid "This post breaks %(site)s policy"
msgstr "הפוסט הזה שובר %(site)s מדיניות מדיניות"

#, machine, plain1
msgid "This post can't be forwarded."
msgstr "הפוסט הזה לא יכול להיות מועבר."

#, machine, plain1
msgid "This post can't be reposted."
msgstr "הפוסט הזה לא ניתן לשחזר."

#, machine, plain1
msgid "This post can't go live."
msgstr "הפוסט הזה לא יכול לחיות."

#, machine, plain1
msgid "This post does not exist."
msgstr "הפוסט הזה לא קיים."

#, machine, plain1
msgid "This post has no comments on the profile. Choose a guild's."
msgstr "לפוסט הזה אין הערות על הפרופיל. בחר גורד."

#, machine, plain1
msgid "This post has no comments on the profile. Its comments are in the guilds it was posted to."
msgstr "לפוסט הזה אין הערות על הפרופיל. הערותיו הן בגלידות שהוא פורסם."

#, machine, plain1
msgid "This post has no comments on your profile now. Its comments are in the guilds."
msgstr "לפוסט הזה אין הערות על הפרופיל שלך עכשיו. הערותיו הן בגורים."

#, machine, plain1
msgid "This post has no live thread."
