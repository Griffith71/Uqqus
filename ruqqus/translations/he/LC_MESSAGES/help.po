msgid "\"%(site)s\" is pronounced identically to the standard English word \"ruckus\""
msgstr "\"\"%(site)sזהה למילה האנגלית הסטנדרטית \"ruckus\""

#, machine, plain1
msgid "\"Ruqqie\" is pronounced \"RUCK-ee\""
msgstr "\"RuqChi\" הוא \"Ruck-ee\""

#. a cryptocurrency's name, then the word for the address to send it to.
#, machine, plain1, python-format
msgid "%(coin)s Address"
msgstr "%(coin)s כתובת"

#, machine, plain1, python-format
msgid "%(coin)s receiving address QR code"
msgstr "%(coin)s קבלת כתובת QR קודקוד"

#, machine, plain1, python-format
msgid "%(company)s is outside your jurisdiction. Sucks to be you."
msgstr "%(company)s מחוץ לתחום השיפוט שלך. מבאס להיות אתה."

#, python-format
msgid "%(company)s is, always has been, and always will be 100%% outside your jurisdiction. You must obtain legal process that is valid in the state of New Hampshire. Then, submit your United States legal process document to our [legal requests portal](/legal)."
msgstr ""

#, machine, plain1, python-format
msgid "%(company)s may revoke your License at any time and for any reason."
msgstr "%(company)s יכול לבטל את הרישיון שלך בכל עת ובכל סיבה שהיא."

#, machine, plain1, python-format
msgid "%(curation)s: a public curation, by its name or the short name under it. Search %(curation)s to find them; <code>%(in_curation)s</code> narrows a post search to that curation's guilds and accounts. Private curations are never found."
msgstr "%(curation)sאכילה ציבורית, בשמו או בשמו הקצר. חיפוש חיפוש %(curation)s למצוא אותם; <code>%(in_curation)s</code> מצמצמים חיפוש פוסט לזה שחוספסים וחשבונות של מזון. מזונות פרטיים לא נמצאו מעולם."

