#, machine, python-format
msgid "\"%(site)s\" is pronounced identically to the standard English word \"ruckus\""
msgstr "\"%(site)s\" is identiek aan het standaard Engelse woord \"ruckus\""

#, machine
msgid "\"Ruqqie\" is pronounced \"RUCK-ee\""
msgstr "\"Ruqqie\" wordt uitgesproken als \"RUCK-ee\""

#. a cryptocurrency's name, then the word for the address to send it to.
#, machine, python-format
msgid "%(coin)s Address"
msgstr "%(coin)s Adres"

#, machine, plain1, python-format
msgid "%(coin)s receiving address QR code"
msgstr "%(coin)s adres ontvangen QR code"

#, machine, python-format
msgid "%(company)s is outside your jurisdiction. Sucks to be you."
msgstr "%(company)s is buiten uw jurisdictie. Het is klote om jou te zijn."

#, machine, python-format
msgid "%(company)s is, always has been, and always will be 100%% outside your jurisdiction. You must obtain legal process that is valid in the state of New Hampshire. Then, submit your United States legal process document to our [legal requests portal](/legal)."
msgstr "%(company)s is, altijd al geweest, en zal altijd 100%% buiten uw jurisdictie blijven. U moet juridische procedures verkrijgen die geldig zijn in de staat New Hampshire. Stuur dan uw juridisch procesdocument van de Verenigde Staten naar onze [juridische verzoeken portal](/legal)."

#, machine, python-format
msgid "%(company)s may revoke your License at any time and for any reason."
msgstr "%(company)s kan uw licentie te allen tijde en om welke reden dan ook intrekken."

#, machine, plain1, python-format
msgid "%(curation)s: a public curation, by its name or the short name under it. Search %(curation)s to find them; <code>%(in_curation)s</code> narrows a post search to that curation's guilds and accounts. Private curations are never found."
msgstr "%(curation)s: een publiek samengesteld voer, met de naam of de korte naam eronder. Zoeken %(curation)s om ze te vinden; <code>%(in_curation)s</code> vernauwt een post zoektocht naar de gilden en rekeningen van dat gecureerde voer. Privé gecureerde feeds worden nooit gevonden."

