msgstr[1] "Търсенето може да бъде най-много %(num)s знака."

#, machine, plain1, python-format
msgid "A search can hold at most %(num)s word and operator."
msgid_plural "A search can hold at most %(num)s words and operators."
msgstr[0] "Търсенето може да съдържа най-много една дума и оператор."
msgstr[1] "Търсенето може да съдържа най-много %(num)s думи и оператори."

#, machine, plain1
msgid "A sensitive guild's posts are left out of All and For You for anyone who hasn't chosen to see sensitive content. Enable if your guild allows content that a film or game would rate 15, R or 16+, such as strong sexual content, graphic violence or self-harm - not a rule violation, just a heads-up. Every post in this guild will be blurred by default."
msgstr "За всеки, който не е избрал да види чувствително съдържание. Включване, ако вашата гилдия позволява съдържание, че филм или игра ще оцени 15, R или 16+, като силно сексуално съдържание, графично насилие или самонараняване - не нарушение на правилата, а само предупреждение. Всеки пост в тази гилдия ще бъде замъглен по подразбиране."

#, machine, plain1, python-format
