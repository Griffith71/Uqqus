msgid "A bot can post at most %(num)s time a day."
msgid_plural "A bot can post at most %(num)s times a day."
msgstr[0] "Един бот може да публикува най-много един път на ден."
msgstr[1] "Един бот може да публикува най-много %(num)s пъти на ден."

