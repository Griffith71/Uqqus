#, machine, plain1
msgid "Video is off in this call: you're on audio."
msgstr "Видеото е изключено в този разговор: Вие сте на аудио."

#, glossary, machine, plain1
msgid "View original"
msgstr "Виж оригинала"

#, machine, plain1
msgid "Voice call"
msgstr "Гласово обаждане"

#, machine, plain1, python-format
msgid "Voice call going on · %(num)s person"
msgid_plural "Voice call going on · %(num)s people"
msgstr[0] "Гласово обаждане става · %(num)s човек"
msgstr[1] "Гласово обаждане на %(num)s човека"

#, machine, plain1, python-format
msgid "Voice call · %(hours)s h %(minutes)s min"
msgstr "Гласово обаждане %(hours)s h %(minutes)s минути"

#, machine, plain1, python-format
msgid "Voice call · %(num)s min"
msgid_plural "Voice call · %(num)s min"
msgstr[0] "Гласово обаждане · %(num)s минути"
msgstr[1] "Гласово обаждане · %(num)s минути"

#, machine, plain1, python-format
msgid "Voice call · %(num)s s"
msgid_plural "Voice call · %(num)s s"
msgstr[0] "Гласово обаждане · %(num)s s"
msgstr[1] "Гласово обаждане · %(num)s s"

#. under a voice channel's name: its kind and its guild ("Voice channel ·
#. +pets")
#, machine, plain1, python-format
msgid "Voice channel · +%(guild)s"
msgstr "Гласов канал%(guild)s"

#, machine, plain1, python-format
msgid "Voice goes browser to browser through the site's relay, so nobody sees anyone's address. Up to %(num)s person."
msgid_plural "Voice goes browser to browser through the site's relay, so nobody sees anyone's address. Up to %(num)s people."
msgstr[0] "Гласът отива в браузъра през релето на сайта, така че никой не вижда ничий адрес. До един човек."
msgstr[1] "Гласът отива в браузъра през релето на сайта, така че никой не вижда ничий адрес. До %(num)s човека."

#, machine, plain1
msgid "Wait a moment: your last changes are still being saved."
msgstr "Чакай малко: последните ти промени все още са спасени."

#, machine, plain1
msgid "Waiting for the app"
msgstr "В очакване на приложението"

#, machine, plain1
msgid "We'll show fewer posts like this."
msgstr "Ще покажем по-малко такива постове."

#, machine, plain1
msgid "We'll take it from here."
msgstr "Ние поемаме от тук."

#, machine, plain1
msgid "What it would do (not saved yet)"
msgstr "Какво би направил (не е спасен още)"

#, machine, plain1
msgid "What's wrong with this Space? (optional)"
msgstr "Какво му е на това пространство? (по избор)"

#, machine, plain1
msgid "What's wrong with this message? (optional)"
msgstr "Какво не е наред с това съобщение? (по избор)"

#, machine, plain1
msgid "Where should your audio go?"
msgstr "Къде трябва да отиде звука?"

#, machine, plain1
msgid "Where should your pictures go?"
msgstr "Къде трябва да отидат снимките ти?"

#, machine, plain1
msgid "Where should your videos go?"
msgstr "Къде трябва да отидат клиповете ти?"

#. %(service)s is the video site (YouTube)
#, machine, plain1, python-format
msgid "Who can find the video on %(service)s"
msgstr "Кой може да намери видеото на %(service)s"

#, machine, plain1
msgid "Who said it"
msgstr "Кой го каза"

#, machine, plain1
msgid "Who upvoted"
msgstr "Кой гласува"

#, glossary, machine, plain1
msgid "Why"
msgstr "Защо"

#, machine, plain1
msgid "Why are you reporting this story? (optional)"
msgstr "Защо докладваш тази история? (по избор)"

#, machine, plain1
msgid "Why does this break your guild's rules? This will be shown to anyone who looks up this comment's history."
msgstr "Защо това нарушава правилата на гилдията ти? Това ще бъде показано на всеки, който погледне историята на този коментар."

#, machine, plain1
msgid "Why does this break your guild's rules? This will be shown to anyone who looks up this post/comment's history."
msgstr "Защо това нарушава правилата на гилдията ти? Това ще бъде показано на всеки, който разгледа историята на този пост / коментар."

#, machine, plain1
msgid "Working it out…"
msgstr "Да се разберем…"

#. a tab: write the post's text (beside Preview)
#, machine, plain1
msgid "Write"
msgstr "Запис"

#, machine, plain1
msgid "Write something first."
msgstr "Първо напиши нещо."

#, machine, plain1
msgid "Write what you want to tell us."
msgstr "Напиши каквото искаш да ни кажеш."

#, glossary, machine, plain1
msgid "Yes"
msgstr "Да"

#, machine, plain1
msgid "Yes, cancel it"
msgstr "Да, отмени го"

#. the name under your own picture in a call; "Someone" stands for a person
#. whose name is unknown
#. beside your own name in a group chat's list of people
#. in place of your own name among the people in a Space
#. the label on your own camera's picture in a Space's call
#. in place of your own name over your messages on a Space's board
#, machine, plain1
msgid "You"
msgstr "Ти."

#, glossary, machine, plain1
msgid "You already did that"
msgstr "Вече сте направили това"

#, machine, plain1
msgid "You already reported this comment."
msgstr "Вече докладвахте този коментар."

#, machine, plain1
msgid "You already reported this post."
msgstr "Вече докладвахте този пост."

#, machine, plain1
msgid "You already voted on this post."
msgstr "Вече гласувахте за този пост."

#, glossary, machine, plain1, python-format
msgid "You are blocking @%(name)s"
msgstr "Блокирали сте @%(name)s"

#, machine, plain1, python-format
msgid "You are following @%(name)s."
msgstr "Вие следвате @ %(name)s."

#, machine, plain1, python-format
msgid "You called · video · %(when)s · %(length)s"
msgstr "Вие се обадихте · видео · %(when)s · %(length)s"

#, machine, plain1, python-format
msgid "You called · voice · %(when)s · %(length)s"
msgstr "Обади се на глас · %(when)s · %(length)s"

#, machine, plain1
msgid "You can ask for a community note once for each comment, and not on your own comment."
msgstr "Можете да поискате обща бележка веднъж за всеки коментар, а не на собствения си коментар."

#, machine, plain1
msgid "You can ask for a community note once for each post, and not on your own post."
msgstr "Можете да поискате обща бележка веднъж за всеки пост, а не на собствения си пост."

#, machine, plain1, python-format
msgid "You can have %(num)s folder at most."
msgid_plural "You can have %(num)s folders at most."
msgstr[0] "Можете да имате една папка най-много."
msgstr[1] "Можете да имате най-много %(num)s папки."

#, machine, plain1
msgid "You can read this channel but not write in it."
msgstr "Можете да прочетете този канал, но не и да пишете в него."

#, machine, plain1
msgid "You can see who is here, but you can't speak in this channel."
msgstr "Виждаш кой е тук, но не можеш да говориш в този канал."

#, glossary, machine, plain1
msgid "You can't do that."
msgstr "Не можете да направите това."

#, machine, plain1
msgid "You can't message that person."
msgstr "Не можеш да му пишеш."

#, machine, plain1
msgid "You can't send to that chat."
msgstr "Не можеш да го изпратиш."

#, machine, plain1
msgid "You can't start a chat with them."
msgstr "Не можеш да започнеш разговор с тях."

#, machine, plain1
msgid "You can’t edit this draft any more (you may have left it or been removed)."
msgstr "Може да редактирате този проект повече (може да сте го оставили или премахнали)."

#, machine, plain1
msgid "You ended the Space."
msgstr "Ти сложи край на Космоса."

#, machine, plain1
msgid "You have no curations yet."
msgstr "Все още нямаш излекувани източници."

#, machine, plain1
msgid "You have no stories yet. Share one first."
msgstr "Все още нямаш истории. Сподели едно първо."

#, machine, plain1
msgid "You haven't made a circle of your own yet. Your Friends circle is automatic: it is everyone you follow who follows you back."
msgstr "Още не си направил собствен кръг. Кръгът на приятелите ти е автоматичен: всеки, който те следва, те следва."

#, machine, plain1
msgid "You left the Space."
msgstr "Напусна Космоса."

#, machine, plain1
msgid "You left the call."
msgstr "Оставил си обаждането."

#, machine, plain1, python-format
msgid "You unfollowed @%(name)s."
msgstr "Ти не ме последва.%(name)s."

#, machine, plain1
msgid "You were removed from this Space."
msgstr "Беше отстранен от това пространство."

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "Правиш го прекалено много. Опитай пак по-късно."

#, machine, plain1
msgid "You're no longer in this Space."
msgstr "Вече не си в това пространство."

#, machine, plain1
msgid "You're the only one here."
msgstr "Само ти си тук."

#, machine, plain1
msgid "Your app is verified"
msgstr "Приложението ви е проверено"

#, machine, plain1
msgid "Your browser blocked the window for connecting. Allow pop-ups for this site, or connect in the settings."
msgstr "Вашият браузър блокира прозореца за свързване. Позволете изскачащи прозорци за този сайт, или се свържете в настройките."

#, machine, plain1
msgid "Your chat devices can't be listed right now."
msgstr "Вашите устройства за чат не могат да бъдат записани точно сега."

#, machine, plain1
msgid "Your chats"
msgstr "Твоите разговори"

#, machine, plain1
msgid "Your chats will work again on this device, but messages from before can't be read here (or anywhere without your old key)."
msgstr "Вашите чатове ще работят отново на това устройство, но съобщения от преди не могат да се четат тук (или навсякъде без стария ключ)."

#, machine, plain1
msgid "Your comment could not be posted. Try again."
msgstr "Вашият коментар не може да бъде публикуван. Опитай пак."

#, machine, plain1
msgid "Your edit couldn't be saved. Please check your connection and try again."
msgstr "Редакцията ви не може да бъде спасена. Моля, проверете връзката си и опитайте отново."

#, machine, plain1
msgid "Your edit couldn't be saved. Please try again."
msgstr "Редакцията ви не може да бъде спасена. Моля, опитайте отново."

#, machine, plain1
msgid "Your files stay in your own account there, using its free space. This site only shows them in your posts."
msgstr "Файловете ви остават в акаунта ви, използвайки свободното си пространство. Този сайт ги показва само на вашите постове."

#, machine, plain1
msgid "Your guilds' chats"
msgstr "Гилдите ти си говорят"

#. placeholder text a member replaces: the headline of a "Call to action"
#. block, and its button's label
#, machine, plain1
msgid "Your headline"
msgstr "Заглавието ти"

#, machine, plain1
msgid "Your key can't be shown right now."
msgstr "Ключът ти не може да бъде показан точно сега."

#, machine, plain1
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "Ключът ти беше заключен с по-стара парола. Отворете чата на този сайт и въведете кода си за възстановяване веднъж; след това той се отваря тук."

#, machine, plain1
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "Паролата ти се промени, откакто този чат ключ беше заключен с него. Кодът за възстановяване, който си запазил, когато чата е бил създаден, го отваря."

#, machine, plain1
msgid "Your recovery code"
msgstr "Вашият код за възстановяване"

#, machine, plain1
msgid "Your saved templates show up here."
msgstr "Спасените ти шаблони се появяват тук."

#, machine, plain1
msgid "Your settings have been updated."
msgstr "Настройките ви са актуализирани."

#, machine, plain1
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "Складът ти трябва да се свърже отново. Изпращане на аудио на:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your pictures to:"
msgstr "Складът ти трябва да се свърже отново. Изпратете снимките си на:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your videos to:"
msgstr "Складът ти трябва да се свърже отново. Изпратете видеоклиповете си на:"

