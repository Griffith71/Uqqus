#, machine, python-format
msgid "\"%(site)s\" is pronounced identically to the standard English word \"ruckus\""
msgstr "\"%(site)s\" é pronunciado de forma idêntica à palavra padrão em inglês \"ruckus\""

#, machine
msgid "\"Ruqqie\" is pronounced \"RUCK-ee\""
msgstr "Ruqqie é pronunciado \"RUCK-ee\""

#. a cryptocurrency's name, then the word for the address to send it to.
#, machine, python-format
msgid "%(coin)s Address"
msgstr "Endereço %(coin)s"

#, machine, plain1, python-format
msgid "%(coin)s receiving address QR code"
msgstr "%(coin)s endereço de recepção QR código"

#, machine, python-format
msgid "%(company)s is outside your jurisdiction. Sucks to be you."
msgstr "%(company)s está fora da sua jurisdição. É uma pena seres tu."

#, machine, python-format
msgid "%(company)s is, always has been, and always will be 100%% outside your jurisdiction. You must obtain legal process that is valid in the state of New Hampshire. Then, submit your United States legal process document to our [legal requests portal](/legal)."
msgstr "%(company)s é, sempre foi, e sempre será 100 %% fora da sua jurisdição. Você deve obter um processo legal que é válido no estado de New Hampshire. Em seguida, envie seu documento de processo legal dos Estados Unidos ao nosso [portal de solicitações legais](/legal)."

#, machine, python-format
msgid "%(company)s may revoke your License at any time and for any reason."
msgstr "%(company)s pode revogar sua licença a qualquer momento e por qualquer motivo."

#, machine, plain1, python-format
msgid "%(curation)s: a public curation, by its name or the short name under it. Search %(curation)s to find them; <code>%(in_curation)s</code> narrows a post search to that curation's guilds and accounts. Private curations are never found."
msgstr "%(curation)s: um feed público curado, pelo seu nome ou pelo nome curto sob ele. Procurar %(curation)s Para os encontrar; <code>%(in_curation)s</code> Reduz uma pesquisa de posts para as guildas e contas daquela fonte. Feeds privados de curadoria nunca são encontrados."

#, machine, python-format
msgid "%(site)s - Contact"
msgstr "%(site)s - Contacto"

#, machine, plain1, python-format
msgid "%(site)s - FAQ"
msgstr "%(site)s - FAQ"

#, machine, python-format
msgid "%(site)s - Formatting"
msgstr "%(site)s - Formatação"

