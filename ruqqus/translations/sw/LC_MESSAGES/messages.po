#. url: is a search operator and stays as it is
#, machine, plain1, python-format
msgid "url: can be at most %(num)s character."
msgid_plural "url: can be at most %(num)s characters."
msgstr[0] "url: inaweza kuwa zaidi ya tabia moja."
msgstr[1] "url: inaweza kuwa katika wahusika zaidi ya %(num)s."

#, machine, plain1
msgid "username"
msgstr "jina la mtumiaji"

#. "v." is short for version; the name is the company that runs the site
#, machine, plain1, python-format
msgid "v. %(version)s, © 2021 %(company)s"
msgstr "v. %(version)s, © 2021 %(company)s"

#, machine, plain1
msgid "video"
msgstr "video ya video"

#, glossary, machine, plain2
msgid "video preview"
msgstr "onyesho la awali la video"

#, machine, plain1
msgid "voice, up to 8 people"
msgstr "sauti, hadi watu 8"

#, machine, plain1
msgid "waiting for them to accept"
msgstr "kusubiri kwa ajili ya kukubali"

#. follows the app's name, shown just above as a heading
#, machine, plain1, python-format
msgid "wants to access your @%(name)s account."
msgstr "Unahitaji kuingia kwenye akaunti yako%(name)s Akaunti ya."

#, machine, plain1
msgctxt "time filter"
msgid "week"
msgstr "wiki ya wiki"

#, machine, plain1
msgid "when it ends it disappears, with everything in it"
msgstr "baada ya kumaliza, kila kitu kiko ndani yake"

#, machine, plain1
msgid "who wrote what"
msgstr "ambaye aliandika kile ambacho"

#. beside a post's author, its co-authors: names is their names, linked
#, machine, plain1, python-format
msgid "with %(names)s"
msgstr "Pamoja na %(names)s"

#. beside a post's author, its co-authors: names is the first five, linked; num
#. is how many more there are
#, machine, plain1, python-format
msgid "with %(names)s and <a href=\"%(url)s\">%(num)s other</a>"
msgid_plural "with %(names)s and <a href=\"%(url)s\">%(num)s others</a>"
msgstr[0] "Pamoja na %(names)s Aidha, na <a href=\"%(url)s\">%(num)s nyingine</a>"
msgstr[1] "Pamoja na %(names)s Aidha, na <a href=\"%(url)s\">%(num)s wengine</a>"

#, machine, plain1, python-format
msgid "with promo code <code>%(code)s</code>"
msgstr "Kanuni ya promo <code>%(code)s</code>"

#, machine, plain1
msgid "words or phrases, separated by commas"
msgstr "maneno au maneno, yaliyotengwa na commas"

#. follows the moderator's name in a guild's moderation log; %(target)s is a
#. link
#, machine, plain1, python-format
msgid "yanked post %(target)s"
msgstr "barua ya wazi %(target)s"

