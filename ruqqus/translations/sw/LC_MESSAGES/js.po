#. block, and its button's label
#, machine, plain1
msgid "Your headline"
msgstr "Kichwa chako cha kichwa"

#, machine, plain1
msgid "Your key can't be shown right now."
msgstr "Maelezo yako hayawezi kuonyeshwa kwa sasa."

#, machine, plain1
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "Akaunti yako imefungwa na nenosiri la zamani. Fungua Chat kwenye tovuti hii na kuingia msimbo wako wa kufufua mara moja; kisha inafungua hapa."

#, machine, plain1, python-format
msgid "Your message will be sent once chat is unlocked on this device."
msgid_plural "Your %(num)s messages will be sent once chat is unlocked on this device."
msgstr[0] "Ujumbe wako utatumwa mara moja chat ni kufunguliwa kwenye kifaa hiki."
msgstr[1] "Ujumbe wako wa %(num)s utatumwa mara moja chat imefunguliwa kwenye kifaa hiki."

#, machine, plain2
msgid "Your name will show on this comment. Your own words can still give away that you wrote the post, and a comment under your name is not linked to the post by anything we show."
msgstr "Jina lako litaonekana kwenye maoni haya. Maneno yako mwenyewe yanaweza kuacha kwamba uliandika chapisho, na maoni chini ya jina lako hayahusiani na chapisho kwa chochote tunachoonyesha."

#, machine, plain2
msgid "Your old recovery code no longer works."
msgstr "Mfumo wako wa zamani haufanyi kazi tena."

#, machine, plain1
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "Nenosiri yako iliyopita tangu ufunguo huu chat imefungwa na hiyo. Msimbo wa kufufua uliohifadhiwa wakati chat ilianzishwa inafungua."

#, machine, plain1
msgid "Your password was changed for you, so chat is starting again here."
msgstr "Nenosiri yako ilibadilishwa kwako, kwa hivyo mazungumzo huanza tena hapa."

#, machine, plain1
msgid "Your password was changed, so chat is starting again here."
msgstr "Nenosiri yako ilibadilika, hivyo mazungumzo huanza tena hapa."

#, machine, plain1
msgid "Your password was reset, so chat is starting again here."
msgstr "Password yako ilikuwa upya, hivyo chat ni kuanza tena hapa."

#, machine, plain1
msgid "Your recovery code"
msgstr "Msimbo wa usajili"

#, machine, plain1
msgid "Your saved templates show up here."
msgstr "Violezo vyako vilivyohifadhiwa vinaonyeshwa hapa."

#, machine, plain2
msgid "Your screen can be shared only while you're on video in this call."
msgstr "Screen yako inaweza kushirikiwa tu wakati uko kwenye video kwenye simu hii."

#, machine, plain2
msgid "Your screen couldn't be shared."
msgstr "Kamera yako haiwezi kuunganishwa."

#, machine, plain1
msgid "Your settings have been updated."
msgstr "Mipangilio yako imesasishwa."

#, machine, plain1
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "Hifadhi yako inahitaji kuunganisha tena. Tuma sauti yako kwa:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your pictures to:"
msgstr "Hifadhi yako inahitaji kuunganisha tena. Tuma picha zako kwa:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your videos to:"
msgstr "Hifadhi yako inahitaji kuunganisha tena. Tuma video zako kwa:"

#. %(zone)s is a time zone name such as Europe/London
#, machine, plain1, python-format
msgid "Your time zone: %(zone)s"
msgstr "Eneo la muda wako: %(zone)s"

#, machine, plain1
msgid "Your vote is on another copy of this Space, or it can't change any more."
msgstr "Kura yako iko kwenye nakala nyingine ya nafasi hii, au haiwezi kubadilika tena."

#, machine, plain1
msgid "You’re all caught up"
msgstr "Wote mmekombolewa"

#, machine, plain1
msgid "You’re all caught up."
msgstr "Nyote mnaalikwa."

