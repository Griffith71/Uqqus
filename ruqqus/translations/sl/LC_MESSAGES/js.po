#, machine, plain1
msgid "Why does this break your guild's rules? This will be shown to anyone who looks up this post/comment's history."
msgstr "Zakaj to krši pravila tvojega ceha? To se bo pokazalo vsakomur, ki bo pogledal v zgodovino tega posta/kommenta."

#, machine, plain1
msgid "Working it out…"
msgstr "Razrešujem…"

#. a tab: write the post's text (beside Preview)
#, machine, plain1
msgid "Write"
msgstr "Piši"

#, machine, plain1
msgid "Write something first."
msgstr "Najprej nekaj napiši."

#, machine, plain1
msgid "Write what you want to tell us."
msgstr "Napiši, kar nam hočeš povedati."

#, glossary, machine, plain1
msgid "Yes"
msgstr "Da"

#, machine, plain1
msgid "Yes, cancel it"
msgstr "Ja, odpovej"

#. the name under your own picture in a call; "Someone" stands for a person
#. whose name is unknown
#. beside your own name in a group chat's list of people
#. in place of your own name among the people in a Space
#. the label on your own camera's picture in a Space's call
#. in place of your own name over your messages on a Space's board
#, machine, plain1
msgid "You"
msgstr "Ti"

#, glossary, machine, plain1
msgid "You already did that"
msgstr "To je že narejeno"

#, machine, plain1
msgid "You already reported this comment."
msgstr "To pripombo ste že prijavili."

#, machine, plain1
msgid "You already reported this post."
msgstr "To si že prijavil."

#, machine, plain1
msgid "You already voted on this post."
msgstr "Na tem mestu ste že glasovali."

#, machine, plain1, python-format
msgid "You are following @%(name)s."
msgstr "Sledite @ %(name)s."

#, machine, plain1, python-format
msgid "You called · video · %(when)s · %(length)s"
msgstr "Klicali ste · video · %(when)s · %(length)s"

#, machine, plain1, python-format
msgid "You called · voice · %(when)s · %(length)s"
msgstr "Klicali ste · glas · %(when)s · %(length)s"

#, machine, plain1
msgid "You can ask for a community note once for each comment, and not on your own comment."
msgstr "Za vsak komentar lahko zaprosite za sporočilo o skupnosti in ne za svoj komentar."

#, machine, plain1
msgid "You can ask for a community note once for each post, and not on your own post."
msgstr "Lahko prosite za obvestilo skupnosti enkrat za vsako delovno mesto, in ne na svojem delovnem mestu."

#, machine, plain1, python-format
msgid "You can have %(num)s folder at most."
msgid_plural "You can have %(num)s folders at most."
msgstr[0] "Lahko imate največ %(num)s mapo."
msgstr[1] "Lahko imate največ dve mapi."
msgstr[2] "Lahko imate največ %(num)s mape."
msgstr[3] "Lahko imate največ %(num)s map."

#, machine, plain1
msgid "You can read this channel but not write in it."
msgstr "Lahko preberete ta kanal, vendar ne pišete v njem."

#, machine, plain1
msgid "You can see who is here, but you can't speak in this channel."
msgstr "Lahko vidite, kdo je tukaj, vendar ne morete govoriti v tem kanalu."

#, glossary, machine, plain1
msgid "You can't do that."
msgstr "Tega ne moreš narediti."

#, machine, plain1
msgid "You can't message that person."
msgstr "Ne moreš mu sporočiti."

#, machine, plain1
msgid "You can't send to that chat."
msgstr "Ne moreš poslati tega pogovora."

#, machine, plain1
msgid "You can't start a chat with them."
msgstr "Ne moreš začeti pogovora z njimi."

#, machine, plain1
msgid "You can’t edit this draft any more (you may have left it or been removed)."
msgstr "Tega osnutka ne morete več urejati (lahko ste ga pustili ali odstranili)."

#, machine, plain1
msgid "You ended the Space."
msgstr "Končal si vesolje."

#, machine, plain1
msgid "You have no curations yet."
msgstr "Nimate še kurirane hrane."

#, machine, plain1
msgid "You have no stories yet. Share one first."
msgstr "Nimaš še nobene zgodbe. Najprej deli enega."

#, machine, plain1
msgid "You haven't made a circle of your own yet. Your Friends circle is automatic: it is everyone you follow who follows you back."
msgstr "Nisi še naredil svojega kroga. Krog tvojih prijateljev je samodejen: vsi, ki jim slediš, ti sledijo nazaj."

#, machine, plain1
msgid "You left the Space."
msgstr "Zapustil si vesolje."

#, machine, plain1
msgid "You left the call."
msgstr "Pustil si klic."

#, machine, plain1, python-format
msgid "You unfollowed @%(name)s."
msgstr "Niste sledili.%(name)s."

#, machine, plain1
msgid "You were removed from this Space."
msgstr "Odstranili so te iz tega prostora."

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "To počneš preveč. Poskusi kasneje."

#, machine, plain1
msgid "You're no longer in this Space."
msgstr "Nisi več v tem vesolju."

#, machine, plain1
msgid "You're the only one here."
msgstr "Ti si edini tukaj."

#, machine, plain1
msgid "Your app is verified"
msgstr "Vaša aplikacija je preverjena"

#, machine, plain1
msgid "Your browser blocked the window for connecting. Allow pop-ups for this site, or connect in the settings."
msgstr "Vaš brskalnik je blokiral okno za povezovanje. Dovoli pojavna okna za to stran ali pa se poveži v nastavitvah."

#, machine, plain1
msgid "Your chat devices can't be listed right now."
msgstr "Vaših naprav za klepet trenutno ni mogoče navesti."

#, machine, plain1
msgid "Your chats"
msgstr "Vaši pogovori"

#, machine, plain1
msgid "Your chats will work again on this device, but messages from before can't be read here (or anywhere without your old key)."
msgstr "Vaši klepeti bodo spet delovali na tej napravi, vendar sporočil od prej ni mogoče brati tukaj (ali kjerkoli brez vašega starega ključa)."

#, machine, plain1
msgid "Your comment could not be posted. Try again."
msgstr "Vaš komentar ni bil objavljen. Poskusi še enkrat."

#, machine, plain1
msgid "Your edit couldn't be saved. Please check your connection and try again."
msgstr "Vašega urejanja ni bilo mogoče shraniti. Preverite povezavo in poskusite znova."

#, machine, plain1
msgid "Your edit couldn't be saved. Please try again."
msgstr "Vašega urejanja ni bilo mogoče shraniti. Prosim, poskusite znova."

#, machine, plain1
msgid "Your files stay in your own account there, using its free space. This site only shows them in your posts."
msgstr "Vaše datoteke ostanejo tam na svojem računu z uporabo prostega prostora. Ta spletna stran jih prikazuje samo na vaših delovnih mestih."

#, machine, plain1
msgid "Your guilds' chats"
msgstr "Klepetanje tvojih guldnov"

#. placeholder text a member replaces: the headline of a "Call to action"
#. block, and its button's label
#, machine, plain1
msgid "Your headline"
msgstr "Vaš naslov"

#, machine, plain1
msgid "Your key can't be shown right now."
msgstr "Vaš ključ se trenutno ne more pokazati."

#, machine, plain1
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "Tvoj ključ je bil zaklenjen s starejšim geslom. Odprite klepet na tej strani in vnesite svojo kodo za okrevanje enkrat; nato se odpre tukaj."

#, machine, plain1
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "Tvoje geslo se je spremenilo, ker je bil ključ za klepet zaklenjen z njim. Koda, ki si jo shranil, ko je bil pogovor nastavljen, jo odpre."

#, machine, plain1
msgid "Your recovery code"
msgstr "Koda za obnovitev"

#, machine, plain1
msgid "Your saved templates show up here."
msgstr "Tukaj se prikažejo vaše shranjene predloge."

#, machine, plain1
msgid "Your settings have been updated."
msgstr "Vaše nastavitve so bile posodobljene."

#, machine, plain1
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "Tvoje skladišče se mora spet povezati. Pošljite zvok na:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your pictures to:"
msgstr "Tvoje skladišče se mora spet povezati. Pošljite slike na:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your videos to:"
msgstr "Tvoje skladišče se mora spet povezati. Pošljite video posnetke na:"

