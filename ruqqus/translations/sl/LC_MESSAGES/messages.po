msgstr "Besedilo ni prikazano: to so odstranili administratorji strani."

#, machine, plain1
msgid "The text of this version was hidden by a site administrator."
msgstr "Besedilo te različice je skril skrbnik strani."

#, machine, plain1, python-format
msgid "The time before links must be a whole number of days, 0 to %(max)s."
msgstr "Čas pred povezavami mora biti celo število dni, od 0 do %(max)s."

#, machine, plain1, python-format
msgid "The time in the guild must be a whole number of days, 0 to %(max)s."
msgstr "Čas v cehu mora biti celo število dni, od 0 do %(max)s."

#, machine, plain1, python-format
msgid "The title can be at most %(num)s character."
msgid_plural "The title can be at most %(num)s characters."
msgstr[0] "Naslov je lahko največ %(num)s lik."
msgstr[1] "Naslov je lahko največ %(num)s lika."
msgstr[2] "Naslov je lahko največ %(num)s liki."
msgstr[3] "Naslov je lahko največ %(num)s znakov."

#, machine, plain1
msgid "The two revisions have the same text."
msgstr "Obe reviziji imata enako besedilo."

#, machine, plain1
msgid "The upload did not arrive in your Google Drive. Try again."
msgstr "Nalaganje ni prispelo v vašem Google Drive. Poskusi še enkrat."

#, machine, plain1
msgid "The upload did not arrive in your OneDrive. Try again."
msgstr "Nalaganje ni prispelo v vašem OneDrive. Poskusi še enkrat."

#, machine, plain1
msgid "The upload did not arrive. Try again."
msgstr "Nalaganje ni prispelo. Poskusi še enkrat."

#, machine, plain1, python-format
msgid "The username @%(name)s has been pre-emptively reserved for: %(who)s"
msgstr "Uporabniško ime @ %(name)s je bilo vnaprej rezervirano za: %(who)s"

#, machine, plain1
msgid "The usual order - everything from the guilds and accounts you add"
msgstr "Običajni vrstni red - vse iz cehov in računov, ki jih dodate"

#, machine, plain1
msgid "The video did not finish uploading to Dailymotion. Add it again."
msgstr "Video ni končal nalaganje na Dailymotion. Dodaj še enkrat."

#, machine, plain1
msgid "The video did not finish uploading. Add it again."
msgstr "Posnetek ni končal pošiljanja. Dodaj še enkrat."

#, machine, plain1, python-format
msgid "The website can be at most %(num)s character."
msgid_plural "The website can be at most %(num)s characters."
msgstr[0] "Spletna stran je lahko največ %(num)s lik."
msgstr[1] "Spletna stran je lahko na največ %(num)s znakov."
msgstr[2] "Spletna stran je lahko največ %(num)s liki."
msgstr[3] "Spletna stran je lahko največ %(num)s znakov."

#, machine, plain1
msgid "The website can't contain a user name or password."
msgstr "Spletna stran ne more vsebovati uporabniškega imena ali gesla."

#, machine, plain1
msgid "The website can't contain spaces."
msgstr "Na spletni strani ni prostora."

#, machine, plain1
msgid "The website must start with https:// or http://."
msgstr "Spletno mesto se mora začeti s https:// ali http://."

#, machine, plain1
msgid "The website needs a full address, such as example.com."
msgstr "Spletna stran potrebuje popoln naslov, kot je primer.com."

#, machine, plain1
msgid "The whole site <span class=\"text-muted\">(needs an age limit of a month or less)</span>"
msgstr "Celotna lokacija <span class=\"text-muted\">(potrebuje starostno mejo enega meseca ali manj)</span>"

#, machine, plain1
msgid "The wiki is off: only guildmasters see it."
msgstr "Wiki je izključen: to vidijo samo guldni moderatorji."

#, machine, plain1
msgid "The wiki's first page can be emptied but not deleted."
msgstr "Wikijeva prva stran se lahko izprazni, vendar ne izbriše."

#, machine, plain1
msgid "The word filter has no words at the moment."
msgstr "Beseda filter trenutno nima besed."

#, machine, plain1, python-format
msgid "The words for other languages are adapted from %(source)s (%(licence)s): words that are also ordinary, innocent words were left out."
msgstr "Besede za druge jezike so prilagojene iz %(source)s (%(licence)s): besede, ki so tudi navadne, nedolžne besede, so bile izpuščene."

#, machine, plain1
msgid "The working copy as it is now. Only its authors can see this until it's published."
msgstr "Delovna kopija, kakršna je zdaj. To lahko vidijo le njegovi avtorji, dokler ni objavljeno."

#, machine, plain1
msgid "Theater"
msgstr "Gledališče"

#, machine, plain1
msgid "Their commenting history will show here."
msgstr "Njihova zgodovina komentiranja bo pokazala tukaj."

#, machine, plain1
msgid "Their forwarding activity will show here."
msgstr "Njihovo posredovanje se bo pokazalo tukaj."

#, machine, plain1
msgid "Their posting history will show here."
msgstr "Njihova objava zgodovina bo pokazala tukaj."

#, machine, plain1
msgid "Their posts and comments are left out of your feeds and threads and they cannot notify you. They are not told, and they can still follow you, comment on your posts and message you. Their anonymous posts and comments are not hidden, as hiding only those would tell you who wrote them. Mute someone from the menu on any of their posts or comments, or from their profile."
msgstr "Njihove objave in komentarji so izpuščeni iz vaših virov in niti in vas ne morejo obvestiti. Niso povedali, in še vedno lahko sledite, komentar na vaše objave in sporočilo vas. Njihove anonimne objave in komentarji niso skriti, saj bi se skrivali samo tisti, ki bi vam povedali, kdo jih je napisal. Utišaj nekoga iz menija na kateri koli od njihovih objav ali komentarjev ali iz njihovega profila."

#, machine, plain1
msgid "There are no approved users"
msgstr "Ni odobrenih uporabnikov"

#, machine, plain1
msgid "There are no exiled users"
msgstr "Ni izgnanih uporabnikov"

#, machine, plain1
msgid "There are no guildmaster invitations."
msgstr "Ni vabil za moderatorje."

#, machine, plain1
msgid "There are no guildmasters."
msgstr "Ni moderatorjev."

#, machine, plain1
msgid "There are no posts here."
msgstr "Tukaj ni objav."

#, machine, plain1, python-format
msgid "There is no account named @%(name)s."
msgstr "Ni računa z imenom @ %(name)s."

#, machine, plain2
msgid "There is nothing here to appeal."
msgstr "Tukaj ni ničesar za pritoževati."

#, machine, plain1
msgid "There is nothing to save yet."
msgstr "Ničesar še ni za rešiti."

#, machine, plain2
msgid "There is nothing waiting for this ban."
msgstr "Nič ne čaka na to prepoved."

#, machine, plain1
msgid "There was a problem. Please try again."
msgstr "Prišlo je do težave. Prosim, poskusite znova."

#, machine, plain1
msgid "There were no names in that file."
msgstr "V kartoteki ni bilo imen."

#, machine, plain1
msgid "There were no survivors."
msgstr "Preživelih ni bilo."

#, machine, plain1
msgid "There's a shortage of perfect request entities in this world. Would be a pity to damage yours."
msgstr "Na tem svetu primanjkuje popolnih subjektov. Škoda bi bilo poškodovati tvojega."

#, machine, plain1
msgid "There's already an open proposal like this one."
msgstr "Tak predlog je že odprt."

#, machine, plain1
msgid "There's no account with that name."
msgstr "S tem imenom ni računa."

#, machine, plain1
msgid "There's no invitation to speak."
msgstr "Ni vabila za pogovor."

#, machine, plain2
msgid "There's no recovery code to keep yet."
msgstr "Ni še nobene kode za okrevanje."

#, machine, plain1
msgid "There's nothing here right now."
msgstr "Ničesar ni tukaj."

#, machine, plain1
msgid "There's nothing left here but a giant smouldering crater."
msgstr "Tu ni ostalo nič drugega kot velikanski krater."

#, machine, plain1
msgid "These are the users you are subscribed to."
msgstr "To so uporabniki, na katere ste naročeni."

#, machine, plain1
msgid "These counts start from the day guild insights were switched on: before that the site did not record when people left a guild or how often its page was opened."
msgstr "Ta števila se začnejo od dneva, ko so bili vklopljeni napačni vpogledi: pred tem na mestu ni bilo zabeleženo, kdaj so ljudje zapustili ceglo ali kako pogosto je bila odprta njegova stran."

#, machine, plain1
msgid "These filters are saved as your default"
msgstr "Ti filtri so shranjeni kot privzeti"

#, machine, plain1
msgid "These topics"
msgstr "Te teme"

#, machine, plain1, python-format
msgid "These users have been invited to moderate +%(guild)s."
msgstr "Te uporabnike so povabili na zmerno + %(guild)s."

#, machine, plain1
msgid "They already have this role."
msgstr "To vlogo že imajo."

#, machine, plain1
msgid "They are 18 or over, so they can make their own account."
msgstr "Stara sta 18 let ali več, zato si lahko ustvarijo svoj račun."

#, machine, plain1
msgid "They are already in this circle."
msgstr "So že v tem krogu."

#, machine, plain1
msgid "They are not told. Anyone you block leaves your circles."
msgstr "Ne povedo jim. Vsak, ki ga blokiraš, ostane v tvojih krogih."

#, machine, plain2
msgid "They are signed out everywhere, chat apps included. If they use chat, they may need their recovery code, or a browser where they've used chat, to read their old messages."
msgstr "Povsod so izključeni, vključene so tudi aplikacije za klepet. Če uporabljajo klepet, morda potrebujejo svojo kodo za okrevanje, ali brskalnik, kjer so uporabljali klepet, za branje svojih starih sporočil."

#, machine, plain1, python-format
msgid "They aren't in %(circle)s."
msgstr "Ni jih notri. %(circle)s."

#, machine, plain1
msgid "They aren't in this group."
msgstr "Niso v tej skupini."

#, machine, plain1
msgid "They aren't muted here."
msgstr "Tu niso utišani."

#, machine, plain1
msgid "They can buy and spend coins, tip, buy Premium and join or run paid circles."
msgstr "Lahko kupijo in porabijo kovance, napitnino, kupijo Premium in se pridružijo ali vodijo plačane kroge."

#, machine, plain2
msgid "They can join and listen to Spaces. They can't host one or post in one: a child account only reads. Voice calls in a Space also need Chat to be on."
msgstr "Lahko se pridružijo in poslušajo Spaces. Ne morejo gostiti enega ali post v enem: otroški račun se bere samo. Glasovi v vesolju potrebujejo tudi klepet."

#, machine, plain1
msgid "They can message people, join group chats and make calls. The site never shows you what a chat says: chats are end-to-end encrypted. Whoever knows their password can still sign in and read them."
msgstr "Lahko sporočajo ljudem, se pridružijo skupinskim klepetom in kličejo. Spletna stran vam nikoli ne pokaže, kaj pravi klepet: klepeti so končni šifrirani. Kdor pozna njihovo geslo, se še lahko vpiše in prebere."

#, machine, plain1
msgid "They can see what you do on the site: your posts, comments, votes, bookmarks, follows, guilds, who you chat with, that your account was reported, and your recent sign-ins. The site never shows them what your chats say, because chats are end-to-end encrypted. But anyone who knows your password, a parent who chose it included, can sign in as you: change it in Security so that only you know it. They choose which of these are on for your account:"
msgstr "Vidijo lahko, kaj počnete na spletni strani: vaše objave, komentarji, glasovi, zaznamki, sledi, Guilds, s kom klepetate, da je bil vaš račun prijavljen, in vaše nedavne prijave. Spletna stran jim nikoli ne pokaže, kaj pravijo vaši klepeti, ker so klepeti končni šifrirani. Kdor pa pozna vaše geslo, ki ga je izbral, se lahko vpiše kot vi: spremenite ga v Varnost, tako da ga poznate samo vi. Izberejo, kateri od teh so na vašem računu:"

#, machine, plain2
msgid "They can start a guild. They still can't post or comment: a child account only reads."
msgstr "Lahko začnejo z guldnom. Še vedno ne morejo objaviti ali komentirati: otroški račun se bere samo."

#, machine, plain1
msgid "They can't comment on your posts or comments, chat with you or notify you by mentioning you. They are not told, but they may work it out if they try to comment on something of yours."
msgstr "Ne morejo komentirati vaših objav ali komentarjev, klepetati z vami ali vas obvestiti z omembo. Ne povejo jim, lahko pa se dogovorijo, če skušajo komentirati kaj vašega."

#, machine, plain1
msgid "They don't have this role."
msgstr "Nimajo te vloge."

#, machine, plain1
msgid "They go straight to your coin balance."
msgstr "Gredo naravnost na vašo bilanco kovancev."

#, machine, plain1
msgid "They haven't asked for that."
msgstr "Tega niso zahtevali."

#, machine, plain2
msgid "They leave the site. What they said stays in the Log as Anonymous, except for anything made in the last five minutes that nobody has commented on, which is erased. This can't be undone."
msgstr "Odšli so. Kar so rekli, ostane v dnevniku kot anonimno, razen česarkoli, kar je bilo narejeno v zadnjih petih minutah, kar ni nihče komentiral, kar je izbrisano. Tega ni mogoče popraviti."

#, machine, plain1
msgid "They need to be in the guild, and not exiled from it."
msgstr "Morajo biti v guldni in ne izgnani iz nje."

#, machine, plain1
msgid "They need to join the channel first."
msgstr "Najprej se morajo pridružiti kanalu."

#, machine, plain1
msgid "They say they are 18 or over and asked you to release their account. If you do, it becomes their own and you can no longer see it."
msgstr "Pravijo, da so stari 18 let ali več in da te prosijo, da izdaš njihov račun. Če jo boš, bo postala njihova in je ne boš več videl."

#, machine, plain2
msgid "They stay where they are, with your name taken off them. This can't be undone. Posts that need your name (for a Circle, or with tips) are listed afterwards as not changed."
msgstr "Ostanejo, kjer so, s tvojim imenom. Tega ni mogoče popraviti. Delovna mesta, ki potrebujejo vaše ime (za krog, ali z nasveti) so navedene kasneje, kot ni spremenjena."

#, machine, plain2, python-format
msgid "They wrote: %(note)s"
msgstr "Napisali so: %(note)s"

#, machine, plain1
msgid "They're already a helper."
msgstr "So že pomočniki."

#, machine, plain1
msgid "They're already on stage."
msgstr "So že na odru."

#, machine, plain1
msgid "They've already been invited to speak."
msgstr "Povabljeni so bili že na pogovor."

#, machine, plain1
msgid "This Circle guild is by invitation only."
msgstr "To je samo vabilo."

#, machine, plain1
msgid "This Google account has no YouTube channel yet. Create one at youtube.com, then try again."
msgstr "Ta račun Google nima YouTube Kanal še. Ustvarite eno na youtube.com, nato poskusite znova."

#, machine, plain1
msgid "This Space"
msgstr "Ta prostor"

#, machine, plain1
msgid "This Space can't take a replay now."
msgstr "Vesolje ne more več igrati."

#, machine, plain1
msgid "This Space has already started."
msgstr "Vesolje se je že začelo."

#, machine, plain1
msgid "This Space has ended."
msgstr "Vesolje se je končalo."

#, machine, plain1
msgid "This Space has ended. Its board is still here to read."
msgstr "Vesolje se je končalo. Njegova tabla je še vedno tukaj za branje."

#, machine, plain1
msgid "This Space has ended. Its chat is still here to read."
msgstr "Vesolje se je končalo. Njegov klepet je še vedno tukaj za branje."

#, machine, plain1
msgid "This Space hasn't started yet."
msgstr "Vesolje se še ni začelo."

#, machine, plain1, python-format
msgid "This Space is full (%(num)s listener)."
msgid_plural "This Space is full (%(num)s listeners)."
msgstr[0] "Ta prostor je poln (%(num)s poslušalec)."
msgstr[1] "Ta prostor je poln (%(num)s poslušalca)."
msgstr[2] "Ta prostor je poln (%(num)s poslušalci)."
msgstr[3] "Ta prostor je poln (%(num)s poslušalcev)."

#, machine, plain1, python-format
msgid "This Space is live until %(time)s."
msgstr "Ta prostor je v živo do %(time)s."

#, machine, plain1
msgid "This Space is live."
msgstr "Ta prostor je v živo."

#, machine, plain1
msgid "This Space is not recorded: when it ends, it is gone, with everything in it."
msgstr "Ta prostor ni posnet: ko se konča, izgine, z vsem v njem."

#, machine, plain1
msgid "This Space is recorded"
msgstr "Ta prostor je zapisan"

#, machine, plain1
msgid "This Space is recorded: its board stays to read when it ends."
msgstr "Ta prostor je zapisan: njegova tabla ostane za branje, ko se konča."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay with the video."
msgstr "Ta prostor je posnet: gostitelj vodi ponovitev z videom."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay."
msgstr "Ta prostor je posnet: gostitelj vodi ponovitev."

#, machine, plain1
msgid "This Space isn't available."
msgstr "Ta prostor ni na voljo."

#, machine, plain1
msgid "This Space isn't waiting to start."
msgstr "Ta prostor ne čaka na začetek."

#, machine, plain1
msgid "This Space keeps its sound only."
msgstr "Ta prostor ohranja samo svoj zvok."

#, machine, plain1
msgid "This access will expire in one hour, or earlier if you revoke it."
msgstr "Ta dostop bo potekel čez eno uro ali prej, če ga prekličete."

#, machine, plain1
msgid "This account can't use chat apps."
msgstr "Ta račun ne more uporabljati aplikacij za klepet."

#, machine, plain1, python-format
msgid "This account has been marked 18 or over since %(date)s."
msgstr "Ta račun je bil označen 18 ali več od %(date)s."

#, machine, plain1, python-format
msgid "This account has been permanently suspended from %(site)s."
msgstr "Ta račun je bil trajno ustavljen iz %(site)s."

#, machine, plain1, python-format
msgid "This account has been temporarily suspended from %(site)s. Check back later."
msgstr "Ta račun je bil začasno ustavljen iz %(site)s. Preveri kasneje."

#, machine, plain1
msgid "This account is private"
msgstr "Ta račun je zasebni"

#, machine, plain1
msgid "This account is suspended."
msgstr "Ta račun je suspendiran."

#, machine, plain1
msgid "This account owes money, so it can't be deleted yet."
msgstr "Ta račun je dolžan denar, zato ga še ni mogoče zbrisati."

#, machine, plain1
msgid "This account posts about sensitive topics"
msgstr "Ta račun objav o občutljivih temah"

#, machine, plain2
msgid "This also signs out chat everywhere else, chat apps included, except the chat this browser has used since you signed in here."
msgstr "To tudi prekine klepet povsod drugje, vključene so tudi aplikacije za klepet, razen klepeta, ki ga uporablja brskalnik, odkar ste se tukaj vpisali."

#. %(time)s is a length of time, such as "6 months"
#, machine, plain1, python-format
msgid "This author hasn't been active for %(time)s, so isn't counted."
msgstr "Avtor ni bil aktiven za %(time)s, zato se ne šteje."

#, machine, plain2
msgid "This ban relies on:"
msgstr "Ta prepoved temelji na:"

#, machine, plain1
msgid "This bot can't take tips right now."
msgstr "Ta robot zdaj ne more sprejemati nasvetov."

#, machine, plain1
msgid "This bot has not been approved."
msgstr "Ta robot ni bil odobren."

#, machine, plain1
msgid "This bot is not running."
msgstr "Ta robot ne deluje."

#, machine, plain1
msgid "This bot's owner can't run it right now."
msgstr "Lastnik tega robota trenutno ne more voditi."

#, machine, plain2
msgid "This bot's owner can't run it while their account is on hold."
msgstr "Lastnik tega robota ga ne more voditi, dokler je njihov račun na čakanju."

#, machine, plain2
msgid "This browser was signed out. Sign in again to carry on."
msgstr "Ta brskalnik je bil prekinjen. Še enkrat se vpišite za nadaljevanje."

#, machine, plain2
msgid "This browser's notifications couldn't be turned on. Try again."
msgstr "Obvestila tega brskalnika ni bilo mogoče vklopiti. Poskusi še enkrat."

#, machine, plain1, python-format
msgid "This call is full (%(num)s person)."
msgid_plural "This call is full (%(num)s people)."
msgstr[0] "Ta klic je poln (%(num)s oseba)."
msgstr[1] "Ta klic je poln (%(num)s osebi)."
msgstr[2] "Ta klic je poln (%(num)s osebe)."
msgstr[3] "Ta klic je poln (%(num)s oseb)."

#, machine, plain1
msgid "This can't be translated right now."
msgstr "Tega trenutno ni mogoče prevesti."

#, machine, plain2
msgid "This can't be undone. The site's admins can always see who wrote something, and if an admin bans or suspends the account for it, the Log may name the account for it."
msgstr "Tega ni mogoče popraviti. Administratorji spletne strani lahko vedno vidijo, kdo je nekaj napisal, in če admin prepove ali začasno prekine račun za to, lahko dnevnik imenuje račun za to."

#, machine, plain1
msgid "This channel doesn't ask for its rules to be accepted."
msgstr "Ta kanal ne zahteva, da se njegova pravila sprejmejo."

#, machine, plain1
msgid "This channel has no messages."
msgstr "Ta kanal nima sporočil."

#, machine, plain1
msgid "This channel is end-to-end encrypted: it is read and written in Chat, where your messages are unlocked."
msgstr "Ta kanal je šifriran od konca do konca: bere se in piše v klepetu, kjer so vaša sporočila odklenjena."

#, machine, plain1
msgid "This channel is end-to-end encrypted: the site can't read it, so it has no word filter, slow mode, pins, search or reports."
msgstr "Ta kanal je šifriran od konca do konca: stran ga ne more prebrati, zato nima besednega filtra, počasnega načina, zatičev, iskanja ali poročil."

#, machine, plain1
