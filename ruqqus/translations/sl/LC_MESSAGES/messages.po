#, machine, plain1, python-format
msgid "with %(names)s and <a href=\"%(url)s\">%(num)s other</a>"
msgid_plural "with %(names)s and <a href=\"%(url)s\">%(num)s others</a>"
msgstr[0] "z %(names)s ter <a href=\"%(url)s\">%(num)s drugo</a>"
msgstr[1] "z %(names)s ter <a href=\"%(url)s\">%(num)s drugi</a>"
msgstr[2] "z %(names)s ter <a href=\"%(url)s\">%(num)s drugi</a>"
msgstr[3] "z %(names)s ter <a href=\"%(url)s\">%(num)s drugih</a>"

#, machine, plain1, python-format
msgid "with promo code <code>%(code)s</code>"
msgstr "s promo kodo <code>%(code)s</code>"

#, machine, plain1
msgid "words or phrases, separated by commas"
msgstr "besede ali stavki, ločeni z vejicami"

#. follows the moderator's name in a guild's moderation log; %(target)s is a
#. link
#, machine, plain1, python-format
msgid "yanked post %(target)s"
msgstr "yanked post %(target)s"

#, machine, plain1
msgctxt "time filter"
msgid "year"
msgstr "leto"

#, machine, plain1
msgctxt "badge beside your own name"
msgid "you"
msgstr "ti"

#, machine, plain1
msgid "you voted no"
msgstr "vi ste glasovali proti"

#, machine, plain1
msgid "you voted yes"
msgstr "vi ste glasovali za"

#, machine, plain1
msgid "you were posting too fast, and it couldn't wait any longer."
msgstr "prehitro si objavljal in ni moglo več čakati."

#, machine, plain2
msgid "you were signed out."
msgstr "izključen si bil."

#, machine, plain1
msgid "you're invited to write it"
msgstr "povabljeni ste, da ga napišete"

#, machine, plain2
msgid "your account couldn't post it at that moment (it is on hold or suspended, or the rules of a guild it was forwarded to). Open it and press Post to see what."
msgstr "vaš račun ga v tistem trenutku ni mogel objaviti (je na čakanju ali začasno preklican ali pravila ceha, kateremu je bil posredovan). Odprite in pritisnite Post, da vidite, kaj."

#. "~" means about; an action is a post or comment counted towards the posting
#. cooldown
#, machine, plain1, python-format
msgid "~%(num)s action left before a cooldown"
msgid_plural "~%(num)s actions left before a cooldown"
msgstr[0] "~%(num)s dejanje levo pred ohladitvijo"
msgstr[1] "~%(num)s dejanja levo pred ohladitvijo"
msgstr[2] "~%(num)s dejanja levo pred ohladitvijo"
msgstr[3] "~%(num)s dejanja levo pred ohladitvijo"

#, machine, plain1, python-format
msgid "“%(name)s” is already used for a view of your bookmarks. Pick another name."
msgstr "“%(name)s” se že uporablja za pogled na vaše zaznamke. Izberi drugo ime."

#, machine, plain1, python-format
msgid "“%(name)s” isn't a guild name."
msgstr "\"%(name)s\" ni gildno ime."

#, machine, plain1, python-format
msgid "“%(option)s” is in the poll twice."
msgstr "\"%(option)s\" je v anketi dvakrat."

