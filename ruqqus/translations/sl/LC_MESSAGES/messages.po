msgstr "Tvoja kurirana hrana"

#, machine, plain1
msgid "Your custom filters have been updated"
msgstr "Vaši filtri po meri so bili posodobljeni"

#, machine, plain1
msgid "Your custom filters have been updated."
msgstr "Vaši filtri po meri so bili posodobljeni."

#, machine, plain1
msgid "Your database gnome took too long looking up your question. He's been.... dealt with."
msgstr "Vaš gnome baze podatkov je predolgo iskal vaše vprašanje. Z njim so opravili."

#, machine, plain1
msgid "Your display name has been removed."
msgstr "Ime zaslona je bilo odstranjeno."

#, machine, plain1
