msgstr[1] "Prvič, ko se prebere krmo, so objavljeni le njegovi najnovejši %(num)s postavke: bot nikoli ne poplavi stran z zaostankom krme."
msgstr[2] "Prvič, ko se prebere vir, so objavljeni le njegovi najnovejši %(num)s predmeti: bot nikoli ne poplavi stran z zaostankom krme."
msgstr[3] "Prvič, ko se prebere krmo, so objavljeni le njegovi najnovejši %(num)s predmetov: bot nikoli ne poplavi stran z zaostankom krme."

