#, machine, plain1, python-format
msgid "`cursor`: any text up to %(num)s characters that lets you continue. Leave it out when there is nothing more."
msgid_plural "`cursor`: any text up to %(num)s characters that lets you continue. Leave it out when there is nothing more."
msgstr[0] "`cursor`: Çdo tekst deri në %(num)s shkronja që të lejojnë të vazhdosh. Lëre kur nuk ka më asgjë."
msgstr[1] "`cursor`: Çdo tekst deri në %(num)s shkronja që ju lejojnë të vazhdoni. Lëre kur nuk ka më asgjë."

