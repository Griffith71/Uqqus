msgstr[0] "Mund të keni %(num)s kartelë më së shumti."
msgstr[1] "Mund të keni më së shumti %(num)s kartelë."

#, machine, plain1
msgid "You can read this channel but not write in it."
msgstr "Ju mund të lexoni këtë kanal por nuk shkruani në të."

#, machine, plain1
msgid "You can see who is here, but you can't speak in this channel."
msgstr "Mund të shihni kush është këtu, por nuk mund të flisni në këtë kanal."

#, glossary, machine, plain1
msgid "You can't do that."
msgstr "Nuk mund ta bësh këtë."

#, machine, plain1
msgid "You can't message that person."
msgstr "S'mund ta dërgosh mesazhin."

#, machine, plain1
msgid "You can't send to that chat."
msgstr "Ju nuk mund të dërgoni në atë bisedë."

#, machine, plain1
msgid "You can't start a chat with them."
msgstr "Nuk mund të fillosh një bisedë me ta."

#, machine, plain1
msgid "You can’t edit this draft any more (you may have left it or been removed)."
msgstr "Nuk mund ta ndryshoni më këtë projekt (mund të jenë lënë ose janë hequr)."

#, machine, plain1
msgid "You ended the Space."
msgstr "Ti i dhe fund hapësirës."

#, machine, plain1
msgid "You have no curations yet."
msgstr "Ju nuk keni dhënë ende ushqim."

#, machine, plain1
msgid "You have no stories yet. Share one first."
msgstr "Nuk ke akoma histori. Ndani një të parë."

#, machine, plain1
msgid "You haven't made a circle of your own yet. Your Friends circle is automatic: it is everyone you follow who follows you back."
msgstr "Nuk ke bërë ende një rreth tëndin. Rrethi i miqve tuaj është automatik: janë të gjithë ata që ju ndjekin prapa."

#, machine, plain1
msgid "You left the Space."
msgstr "Ti u largove nga hapësira."

#, machine, plain1
msgid "You left the call."
msgstr "Ti e le telefonatën."

#, machine, plain1, python-format
msgid "You unfollowed @%(name)s."
msgstr "Nuk ke ndjekur @%(name)s."

#, machine, plain1
msgid "You were removed from this Space."
msgstr "Je larguar nga kjo hapësirë."

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "Po e bën shumë. Provoje përsëri më vonë."

#, machine, plain1
msgid "You're no longer in this Space."
msgstr "Nuk je më në këtë hapësirë."

#, machine, plain1
msgid "You're the only one here."
msgstr "Ti je i vetmi këtu."

#, machine, plain1
msgid "Your app is verified"
msgstr "App juaj është verifikuar"

#, machine, plain1
msgid "Your browser blocked the window for connecting. Allow pop-ups for this site, or connect in the settings."
msgstr "Shfletuesi juaj bllokoi dritaren për t'u lidhur. Lejoni pop-ups për këtë sit, ose lidheni në rregullimet."

#, machine, plain1
msgid "Your chat devices can't be listed right now."
msgstr "Pajisjet tuaja të bisedës nuk mund të listohen tani."

#, machine, plain1
msgid "Your chats"
msgstr "Bisedat e tua"

#, machine, plain1
msgid "Your chats will work again on this device, but messages from before can't be read here (or anywhere without your old key)."
msgstr "Bisedat tuaja do të funksionojnë përsëri në këtë dispozitiv, por mesazhet nga para nuk mund të lexohen këtu (ose askund pa kyçin tuaj të vjetër)."

#, machine, plain1
msgid "Your comment could not be posted. Try again."
msgstr "Komenti yt nuk mund të postohej. Provoje përsëri."

#, machine, plain1
msgid "Your edit couldn't be saved. Please check your connection and try again."
msgstr "Ndryshimi yt nuk mund të shpëtohet. Kontrolloni lidhjen dhe provoni përsëri."

#, machine, plain1
msgid "Your edit couldn't be saved. Please try again."
msgstr "Ndryshimi yt nuk mund të shpëtohet. Të lutem provoje përsëri."

#, machine, plain1
msgid "Your files stay in your own account there, using its free space. This site only shows them in your posts."
msgstr "Dosjet tuaja qëndrojnë në llogarinë tuaj atje, duke përdorur hapësirën e saj të lirë. Ky faqe i tregon vetëm në vendet tuaja."

#, machine, plain1
msgid "Your guilds' chats"
msgstr "Bisedat e tua"

#. placeholder text a member replaces: the headline of a "Call to action"
#. block, and its button's label
#, machine, plain1
msgid "Your headline"
msgstr "Titulli yt"

#, machine, plain1
msgid "Your key can't be shown right now."
msgstr "Çelësi yt nuk mund të shfaqet tani."

#, machine, plain1
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "Çelësi juaj është bllokuar me një fjalëkalim të vjetër. Hap bisedat në këtë faqe dhe shkruaj kodin tënd të shërimit një herë; pastaj hapet këtu."

#, machine, plain1
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "Fjalëkalimi juaj u ndryshua pasi ky kyç bisede u mbyll me të. Kodi i rikuperimit që keni ruajtur kur është përcaktuar biseda."

#, machine, plain1
msgid "Your recovery code"
msgstr "Kodi juaj i shërimit"

#, machine, plain1
msgid "Your saved templates show up here."
msgstr "Modelet e tua të ruajtura shfaqen këtu."

#, machine, plain1
msgid "Your settings have been updated."
msgstr "Rregullimet tuaja janë përditësuar."

#, machine, plain1
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "Duhet të lidheni përsëri. Dërgo videon tënde tek:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your pictures to:"
msgstr "Duhet të lidheni përsëri. Dërgoi fotografitë:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your videos to:"
msgstr "Duhet të lidheni përsëri. Dërgo videot e tua tek:"

#. %(zone)s is a time zone name such as Europe/London
#, machine, plain1, python-format
msgid "Your time zone: %(zone)s"
msgstr "Zona juaj e kohës: %(zone)s"

#, machine, plain1
msgid "Your vote is on another copy of this Space, or it can't change any more."
msgstr "Votimi juaj është në një kopje tjetër të kësaj hapësire, ose nuk mund të ndryshojë më."

#, machine, plain1
msgid "You’re all caught up"
msgstr "Ju jeni të gjithë të kapur"

#, machine, plain1
msgid "You’re all caught up."
msgstr "Jeni të gjithë të zënë."

