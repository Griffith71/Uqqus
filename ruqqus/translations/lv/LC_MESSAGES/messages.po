msgstr "Jūsu atgriezeniskā saite tika fiksēta: \"%(excerpt)s\""

#, machine, plain1, python-format
msgid "Your feedback was marked fixed: \"%(excerpt)s\". Our response: %(response)s"
msgstr "Jūsu atsauksmes tika fiksētas: \"%(excerpt)s\". Mūsu atbilde: %(response)s"

#, machine, plain1
