msgstr[0] "Šī telpa ir pilna (%(num)s klausītājs)."
msgstr[1] "Šī telpa ir pilna (%(num)s klausītāji)."
msgstr[2] "Šī telpa ir pilna (%(num)s klausītāji)."

#, machine, plain1, python-format
msgid "This Space is live until %(time)s."
msgstr "Šī telpa ir dzīvot līdz %(time)s."

#, machine, plain1
msgid "This Space is live."
msgstr "Šī telpa ir dzīva."

#, machine, plain1
msgid "This Space is not recorded: when it ends, it is gone, with everything in it."
msgstr "Šī telpa nav ierakstīta: kad tā beidzas, tā ir aizgājusi, ar visu tajā."

#, machine, plain1
msgid "This Space is recorded"
msgstr "Šī telpa ir ierakstīta"

#, machine, plain1
msgid "This Space is recorded: its board stays to read when it ends."
msgstr "Šī telpa tiek ierakstīta: tās dēlis paliek lasīt, kad tas beidzas."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay with the video."
msgstr "Šī telpa ir ierakstīta: resursdators uztur atkārtošanos ar video."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay."
msgstr "Šī telpa ir ierakstīta: resursdators uztur atkārtojumu."

#, machine, plain1
