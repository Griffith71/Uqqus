msgid "When referring to the owners, staff, or other elements of %(company)s, use \"%(site)s staff\", \"%(site)s owners\", or similar phrasing."
msgstr "Attiecībā uz īpašniekiem, darbiniekiem vai citiem elementiem %(company)s, izmantojiet \"%(site)s darbinieki\", \"%(site)s īpašnieki\", vai līdzīgu frāžu."

#, machine, plain1
