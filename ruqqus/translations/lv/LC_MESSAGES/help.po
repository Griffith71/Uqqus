msgid "Title"
msgstr "Tituls"

#. keep the code between backticks exactly as it is
#, machine, plain1, python-format
msgid "To create a \"share to %(site)s\" button, create an element which has `onclick=\"window.location.href='https://ruqqus.com/submit?url='+window.location.href\"`"
msgstr "Lai izveidotu \"share uz %(site)s\" pogu, izveidojiet elementu, kam ir `onclick=\"window.location.href='https://ruqqus.com/submit?url='+window.location.href\"`"

#, machine, plain1, python-format
msgid "To help protect user privacy and safety, %(site)s forces HTTPS on all assets uploaded and submitted to %(site)s. This includes automatic conversion of all \"http://\" schemas into \"https://\"."
msgstr "Lai palīdzētu aizsargāt lietotāja privātumu un drošību, %(site)s spēki HTTPS uz visiem aktīviem augšupielādēt un nodot %(site)s. Tas ietver automātisku visu \"http://\" shēmu pārveidošanu par \"https://\"."

#, machine, plain1, python-format
msgid "To indicate the presence of a %(site)s-powered embed of content from %(site)s."
msgstr "Lai norādītu, ka %(site)s- ar dzinēju iebūvēts saturu no %(site)s."

#, machine, plain1, python-format
msgid "To link to %(site)s, enable sharing to %(site)s, or refer to your presence on %(site)s."
msgstr "Saite uz %(site)s, iespēja kopīgot %(site)s vai atsaukties uz jūsu klātbūtni %(site)s."

#, machine, plain1
msgid "To request ruqqus API keys, visit [this page](/help/apps)"
msgstr "Lai pieprasītu ruqqus API atslēgas, apmeklējiet [šī lapa](/help/apps)"

#, machine, plain1
msgid "To search for the words themselves, put them in quotes: <code>\"#gaming\"</code>."
msgstr "Lai meklētu vārdus paši, ielieciet tos citātos: <code>\"#gaming\"</code>."

#, machine, plain1, python-format
msgid "To use the access token, include the following header in subsequent API requests to %(site)s: `Authorization: Bearer access_token_goes_here`"
msgstr "Lai izmantotu piekļuvi marķierierīcei, turpmākajos API pieprasījumos %(site)s iekļauj šādu galveni: `Authorization: Bearer access_token_goes_here`"

#, glossary, machine, plain1
msgid "Toggle navigation"
msgstr "Pārslēgt navigāciju"

#, machine, plain1
msgid "Topic Mention"
msgstr "Temats"

#, machine, plain1
msgid "Trade the key for an access token, which lasts an hour:"
msgstr "Tirdzniecība atslēga piekļuves marķierierīci, kas ilgst stundu:"

