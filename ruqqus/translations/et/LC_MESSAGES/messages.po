msgstr[0] "Postituse tekst võib olla %(count)s märk (hiina, jaapani ja korea tähemärgid ning emotikonide arv 2)."
msgstr[1] "Postituse tekst võib olla %(count)s tähemärgid (hiina, jaapani ja korea tähemärgid ning emotikonide arv 2)."

#, machine, plain1
