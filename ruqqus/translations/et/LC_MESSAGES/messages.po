msgstr "Server vajab avalikku serveri nime, näiteks feeds.example.org"

#, machine, plain1
msgid "A feed's address can't hold a user name or password."
msgstr "Sööda aadress ei saa sisaldada kasutajanime ega parooli."

#, machine, plain1
msgid "A feed's address must start with https://"
msgstr "Sööda aadress peab algama https://"

#, machine, plain1
msgid "A few words (optional)"
msgstr "Mõned sõnad (valikuline)"

#, machine, plain1, python-format
msgid "A flair can be at most %(num)s character."
msgid_plural "A flair can be at most %(num)s characters."
msgstr[0] "Silt võib olla maksimaalselt %(num)s tähemärk."
msgstr[1] "Silt võib olla maksimaalselt %(num)s tähemärki."

#, machine, plain1, python-brace-format
msgid "A flair is plain text: no < > { } [ ] ` or \\."
msgstr "Silt on lihtne tekst: ei <> { } [ ] ` või \\."

#, machine, plain1, python-format
msgid "A folder name can be %(num)s character at most."
msgid_plural "A folder name can be %(num)s characters at most."
msgstr[0] "Kataloogi nimi võib olla maksimaalselt %(num)s märk."
msgstr[1] "Kataloogi nimi võib olla maksimaalselt %(num)s tähemärki."

