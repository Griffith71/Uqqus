msgid ""
"Your appeal of [this decision](%(log)s) was looked at, and the decision stands.\n"
"\n"
"```\n"
"%(note)s\n"
"```"
msgstr ""
"Teie kaebus [sellele otsusele](%(log)s vaadati läbi ja otsus kehtib.\n"
"\n"
"\"\"\n"
"%(note)s\n"
"\"\""

#, machine, plain2, python-format
msgid ""
"Your appeal of [this decision](%(log)s) was not taken further.\n"
"\n"
"```\n"
"%(note)s\n"
"```"
msgstr ""
"Teie kaebust [käesoleva otsuse](%(log)s peale ei võetud.\n"
"\n"
"\"\"\n"
"%(note)s\n"
"\"\""

#, machine, plain2
msgid "Your appeal was accepted, and the decision was reversed."
msgstr "Teie kaebus rahuldati ja otsus tühistati."

#, machine, plain2
msgid "Your appeal was looked at, and the decision stands."
msgstr "Teie kaebus vaadati läbi ja otsus kehtib."

#, machine, plain2
