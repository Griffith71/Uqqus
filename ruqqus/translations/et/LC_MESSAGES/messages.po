msgstr "@%(name)s uuesti postitatud [a comment](%(link)s."

#, machine, plain1, python-format
msgid "@%(name)s reposted [a post](%(link)s)."
msgstr "@%(name)s uuesti postitatud [a post](%(link)s."

#, machine, plain1, python-format
msgid "@%(name)s says they are 18 or over and asked you to release their account. You can answer in [Settings > Children](/settings/children)."
msgstr "@%(name)s ütleb, et nad on 18-aastased või vanemad ja palusid teil oma konto vabastada. Saate vastata [Seaded > Lapsed](/settings/children)."

#, machine, plain1, python-format
msgid "@%(name)s shared [a story](%(link)s)."
msgstr "@%(name)s jagatud [lugu](%(link)s."

#, machine, plain1, python-format
msgid "@%(name)s stepped off as co-author of [your post](%(link)s)."
msgstr "@%(name)s astus välja kaasautorina [teie postitus](%(link)s."

#, machine, plain2, python-format
msgid ""
"@%(name)s told everyone in #%(channel)s of +%(guild)s.\n"
"\n"
"[Open the channel](%(link)s)"
msgstr ""
"@%(name)s ütles kõigile #%(channel)s +%(guild)s.\n"
"\n"
"[Ava kanal](%(link)s"

#, machine, plain1, python-format
msgid "@%(name)s unblocked."
msgstr "@%(name)s blokeerimata."

#, machine, plain1, python-format
msgid "@%(name)s unmuted."
msgstr "@%(name)s muteerumata."

#, machine, plain1, python-format
msgid "@%(name)s user banner"
msgstr "@ %(name)s kasutaja bänner"

#, machine, plain1, python-format
msgid "@%(name)s was already invited."
msgstr "@%(name)s oli juba kutsutud."

#, machine, plain1, python-format
msgid "@%(name)s was exiled from +%(guild)s"
msgstr "@%(name)s oli pagendatud alates +%(guild)s"

#, machine, plain1, python-format
msgid "@%(name)s was muted in +%(guild)s's channels."
msgstr "@%(name)s vaigistati +%(guild)s kanalites."

#, machine, plain1, python-format
msgid "@%(name)s's age was confirmed as 18 or over, so their account is their own now and you can no longer see it."
msgstr "@%(name)s vanus kinnitati 18-aastaseks või vanemaks, nii et nende konto on nüüd nende enda ja te ei näe seda enam."

#, machine, plain1, python-format
msgid "@%(name)s's new posts will go into #%(channel)s."
msgstr "@%(name)s uued postitused lähevad #%(channel)s."

#. an account's @handle, then why it can't be given the role (a whole sentence
#. of its own)
#, machine, plain1, python-format
msgid "@%(name)s: %(refusal)s"
msgstr "@%(name)s: %(refusal)s"

#, machine, plain1
msgid "@bot"
msgstr "@bot"

#, machine, plain1
msgid "@name"
msgstr "@name"

#. example account names as they are typed, each starting with @
#, machine, plain1
msgid "@name, @other"
msgstr "@name, @other"

#, machine, plain1
msgid "@username"
msgstr "@username"

#, machine, plain1
msgid "@username, @username"
msgstr "@username, @username"

#, machine, plain1
msgid "A <strong>member bot</strong> needs its member to run it, with a key for their own script (for example for X) or a paid source: it stays theirs and says who runs it."
msgstr "A <strong>liikmerobot</strong> vajab oma liikme käivitada see, koos võti oma skripti (näiteks X) või tasuline allikas: see jääb nende ja ütleb, kes töötab seda."

#, machine, plain1
msgid "A <strong>site bot</strong> runs on free feeds (RSS, Atom or JSON feeds from news sites, YouTube channels, Bluesky, Mastodon, Reddit, Substack and many more): anyone can propose one, and once approved it is the site's, run by the admins and linked to nobody."
msgstr "A <strong>robot</strong> töötab tasuta kanalitel ()RSSAtom või JSON uudistekanalitest, YouTube kanalid, Bluesky, Mastodon, Reddit, Substack ja palju muud : igaüks võib ühe ettepaneku teha ja kui see on heaks kiidetud, on see sait, mida juhivad administraatorid ja mis on seotud mitte kellegagi."

#, machine, plain1
msgid "A Circle guild is always private."
msgstr "Ringi gild on alati privaatne."

#, machine, plain1
msgid "A Circle guild is private for good: only its members see it, and they post straight into it, so what they write does not appear on their own profiles. You invite members free, or set a price in coins to join, and the coins go to you. This can't be changed later."
msgstr "Circle gild on hea jaoks privaatne: ainult selle liikmed näevad seda ja nad postitavad otse sellesse, nii et see, mida nad kirjutavad, ei ilmu oma profiilidele. Sa kutsud liikmed tasuta või määrata hind mündid liituda, ja mündid lähevad teile. Seda ei saa hiljem muuta."

#, machine, plain1
msgid "A Curation is your own named collection of guilds and accounts - like a custom feed, with an algorithm you choose. Keep it private just for yourself, or make it public so others can follow or fork it."
msgstr "Kureeritud sööt on teie enda nimeline gildide ja kontode kogum - nagu kohandatud sööt, mille valite algoritmiga. Hoidke seda privaatselt ainult enda jaoks või tehke see avalikuks, et teised saaksid seda jälgida või kahvlit."

#, machine, plain1
msgid "A QR code to sign in with. Scan it with your phone, where you are signed in."
msgstr "A QR kood sisselogimiseks. Skaneerige seda oma telefoniga, kus olete sisse loginud."

#, machine, plain1
msgid "A Space"
msgstr "Kosmose"

#, machine, plain1, python-format
msgid "A Space can be scheduled at most %(num)s day ahead."
msgid_plural "A Space can be scheduled at most %(num)s days ahead."
msgstr[0] "Ruumi saab planeerida maksimaalselt %(num)s päev ette."
msgstr[1] "Ruumi saab planeerida maksimaalselt %(num)s päeva ette."

#, machine, plain1, python-format
msgid "A Space can have at most %(num)s co-host."
msgid_plural "A Space can have at most %(num)s co-hosts."
msgstr[0] "Ruumil võib olla maksimaalselt %(num)s kaassaatejuht."
msgstr[1] "Ruumis võib olla maksimaalselt %(num)s kaas-saatejuhti."

#, machine, plain1, python-format
msgid "A Space can have at most %(num)s update a day."
msgid_plural "A Space can have at most %(num)s updates a day."
msgstr[0] "Ruumil võib olla maksimaalselt %(num)s värskendus päevas."
msgstr[1] "Ruumis võib olla maksimaalselt %(num)s värskendust päevas."

#, machine, plain1
msgid "A Space can't be anonymous."
msgstr "Ruum ei saa olla anonüümne."

#, machine, plain1
msgid "A Space can't be hosted in a Circle guild."
msgstr "Ruumi ei saa majutada ringi gildis."

#, machine, plain2
msgid "A Space can't have its name removed."
msgstr "Ruumi ei saa eemaldada oma nime."

#, machine, plain1
msgid "A Space can't start in the past."
msgstr "Ruum ei saa alata minevikus."

#, machine, plain1
msgid "A Space for it <span class=\"text-muted font-weight-normal\">(optional: the Space's post link)</span>"
msgstr "Ruum selle jaoks <span class=\"text-muted font-weight-normal\">(vabatahtlik: ruumi postilink)</span>"

#, machine, plain1
msgid "A Space is live for a while: a board, a live thread or a call. It is kept for replay, or it is gone when it ends."
msgstr "Ruum on mõnda aega elav: laud, elav niit või kõne. Seda hoitakse korduseks või see on kadunud, kui see lõpeb."

#, machine, plain1, python-format
msgid "A Space you asked to be reminded of is live: [join it](/space/%(space)s)"
msgstr "Ruum, mida soovisite meelde tuletada, on live: [liituge sellega](/space/%(space)s"

#, machine, plain1, python-format
msgid "A Space you follow is live: [join it](/space/%(space)s)"
msgstr "Ruum, mida jälgite, on otse: [liituge sellega](/space/%(space)s"

#, machine, plain1, python-format
msgid "A Subscriber badge next to your name on @%(name)s's profile and posts, shown to whoever your <a href=\"/settings/profile#lists\">\"Circles you subscribe to\"</a> setting allows"
msgstr "Abonendimärk teie nime kõrval @%(name)sprofiil ja postitused, mida näidatakse ükskõik kellele <a href=\"/settings/profile#lists\">\"Ringid, mida tellite\"</a> seadistus"

#, machine, plain1
msgid "A Translate button shows under posts and comments in none of your languages. Nothing is translated unless you press it."
msgstr "Nupp Tõlkimine näitab postituste ja kommentaaride all mitte üheski teie keeles. Mitte midagi ei tõlgita, kui te seda ei vajuta."

#, machine, plain2, python-format
msgid "A ban can cite up to %(max)s items."
msgstr "Keeld võib viidata kuni %(max)s esemetele."

#, machine, plain1, python-format
msgid "A bio can be %(count)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A bio can be %(count)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Bio võib olla %(count)s märk (hiina, jaapani ja korea tähemärgid ning emotikonide arv 2)."
msgstr[1] "Bio võib olla %(count)s tähemärgid (hiina, jaapani ja korea tähemärgid ning emotikonide arv 2)."

#, machine, plain1, python-format
msgid "A bot can forward to at most %(num)s guild."
msgid_plural "A bot can forward to at most %(num)s guilds."
msgstr[0] "Robot võib edasi liikuda maksimaalselt %(num)s gildile."
msgstr[1] "Robot võib edasi liikuda maksimaalselt %(num)s gildini."

#, machine, plain1, python-format
msgid "A bot can have at most %(num)s key. Revoke it first."
msgid_plural "A bot can have at most %(num)s keys. Revoke one first."
msgstr[0] "Robotil võib olla maksimaalselt %(num)s võti. Võta see enne ära."
msgstr[1] "Robotil võib olla maksimaalselt %(num)s võtit. Tühista üks enne."

#, machine, plain1, python-format
msgid "A bot can post at most %(num)s time a day."
msgid_plural "A bot can post at most %(num)s times a day."
msgstr[0] "Robot võib postitada kõige rohkem %(num)s kord päevas."
msgstr[1] "Robot võib postitada kõige rohkem %(num)s korda päevas."

#, machine, plain1, python-format
msgid "A bot can read at most %(num)s feed."
msgid_plural "A bot can read at most %(num)s feeds."
msgstr[0] "Robot suudab lugeda maksimaalselt %(num)s kanalit."
msgstr[1] "Robot suudab lugeda maksimaalselt %(num)s kanalit."

#, machine, plain1
msgid "A bot can't post anonymously."
msgstr "Robot ei saa anonüümselt postitada."

#, machine, plain1
msgid "A bot can't read this site itself."
msgstr "Robot ei suuda seda saiti ise lugeda."

#, machine, plain1
msgid "A bot can't run bots."
msgstr "Robot ei saa roboteid juhtida."

#, machine, plain1
msgid "A bot gets keys once an admin has approved it."
msgstr "Robot saab võtmed, kui administraator on selle heaks kiitnud."

#, machine, plain1
msgid "A bot is an account that posts by itself, approved by the site's admins."
msgstr "Bot on konto, mis postitusi ise, heaks kiidetud saidi administraatorid."

#, machine, plain1
msgid "A bot's name is 3 to 25 letters, numbers or underscores."
msgstr "Boti nimi on 3 kuni 25 tähte, numbrit või alakriipsu."

#, machine, plain1
msgid "A bot's posts are public."
msgstr "Boti postitused on avalikud."

#, machine, plain1
msgid "A bot's posts can't have co-authors."
msgstr "Boti postitustel ei saa olla kaasautoreid."

#. %(listeners)s is the largest number of people listening
#, machine, plain1, python-format
msgid "A call has up to %(num)s person on stage and %(listeners)s listening, for at most 4 hours."
msgid_plural "A call has up to %(num)s people on stage and %(listeners)s listening, for at most 4 hours."
msgstr[0] "Kõnes on laval kuni %(num)s inimene ja %(listeners)s kuulamine, maksimaalselt 4 tundi."
msgstr[1] "Kõnes on kuni %(num)s inimest laval ja %(listeners)s kuulamine, maksimaalselt 4 tundi."

#, machine, plain1
msgid "A cancelled event can't be changed."
msgstr "Tühistatud sündmust ei saa muuta."

#, machine, plain1
msgid "A category"
msgstr "Kategooria"

#, machine, plain1, python-format
msgid "A category name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A category name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Kategooria nimi võib olla %(num)s märk (hiina, jaapani ja korea tähemärgid ning emotikonide arv 2)."
msgstr[1] "Kategooria nimi võib olla %(num)s märki (hiina, jaapani ja korea tähemärgid ning emotikonide arv 2)."

#, machine, plain1, python-format
msgid "A category name can be at most %(num)s character."
msgid_plural "A category name can be at most %(num)s characters."
msgstr[0] "Kategooria nimi võib olla maksimaalselt %(num)s märk."
msgstr[1] "Kategooria nimi võib olla maksimaalselt %(num)s tähemärki."

#, machine, plain1
msgid "A category name can't contain < or >."
msgstr "Kategooria nimi ei tohi sisaldada < või >."

#, machine, plain1
msgid "A category name can't contain @: it would read as a handle."
msgstr "Kategooria nimi ei saa sisaldada @: see loeks käepidemena."

#, machine, plain1
msgid "A category name can't contain control or invisible characters."
msgstr "Kategooria nimi ei saa sisaldada kontrolli ega nähtamatuid märke."

#, machine, plain1
msgid "A channel"
msgstr "Kanal"

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s bot feeding it."
msgid_plural "A channel can have at most %(num)s bots feeding it."
msgstr[0] "Kanal võib seda toita maksimaalselt %(num)s bot."
msgstr[1] "Kanal võib seda toita maksimaalselt %(num)s robotit."

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s helper."
msgid_plural "A channel can have at most %(num)s helpers."
msgstr[0] "Kanalil võib olla maksimaalselt %(num)s abimees."
msgstr[1] "Kanalil võib olla maksimaalselt %(num)s abimeest."

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s message a day."
msgid_plural "A channel can have at most %(num)s messages a day."
msgstr[0] "Kanalil võib olla maksimaalselt %(num)s sõnum päevas."
msgstr[1] "Kanal võib päevas saada maksimaalselt %(num)s sõnumit."

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s pinned message."
msgid_plural "A channel can have at most %(num)s pinned messages."
msgstr[0] "Kanalil võib olla maksimaalselt %(num)s pinned sõnum."
msgstr[1] "Kanal võib sisaldada maksimaalselt %(num)s pinned sõnumit."

#, machine, plain1
msgid "A channel is one-to-many: its owner and helpers write, members read and react. A public channel is open to everyone and can be moderated; a channel for circles is end-to-end encrypted and only for the people in them."
msgstr "Kanal on üks-paljudele: selle omanik ja abilised kirjutavad, liikmed loevad ja reageerivad. Avalik kanal on avatud kõigile ja seda saab modereerida; ringide kanal on otsast otsani krüpteeritud ja ainult nende inimeste jaoks."

#, machine, plain1, python-format
msgid "A channel name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A channel name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Kanali nimi võib olla %(num)s märk (hiina, jaapani ja korea tähemärgid ning emotikonide arv 2)."
msgstr[1] "Kanali nimi võib olla %(num)s tähemärki (hiina, jaapani ja korea tähemärki ning emotikonide arv 2)."

#, machine, plain1, python-format
msgid "A channel name can be at most %(num)s character."
msgid_plural "A channel name can be at most %(num)s characters."
msgstr[0] "Kanali nimi võib olla maksimaalselt %(num)s tähemärk."
msgstr[1] "Kanali nimi võib olla maksimaalselt %(num)s tähemärki."

#, machine, plain1
msgid "A channel name can't contain < or >."
msgstr "Kanali nimi ei saa sisaldada < või >."

#, machine, plain1
msgid "A channel name can't contain @: it would read as a handle."
msgstr "Kanali nimi ei saa sisaldada @: see loeks käepidemena."

#, machine, plain1
msgid "A channel name can't contain control or invisible characters."
msgstr "Kanali nimi ei saa sisaldada kontrolli ega nähtamatuid märke."

#, machine, plain1, python-format
msgid "A chat app wants to sign in to your chats as <strong>@%(name)s</strong>."
msgstr "Vestlusrakendus tahab teie vestlustesse sisse logida <strong>@%(name)s</strong>."

#, machine, plain1, python-format
msgid "A chat app was signed in to your %(site)s account. If that wasn't you, sign it out in [Settings > Chat apps](/settings/chat_apps) and change your password."
msgstr "Teie %(site)s kontole on sisse logitud vestlusrakendus. Kui see ei olnud sina, logige see välja [Seaded > Vestlusrakendused] (/settings/chat_apps) ja muutke oma parooli."

#, machine, plain2, python-format
msgid "A chat can have at most %(num)s pinned messages. Unpin one first."
msgstr "Vestlus võib sisaldada maksimaalselt %(num)s pinned sõnumeid. Võta üks enne lahti."

#, machine, plain1, python-format
msgid "A circle can have %(num)s person at most."
msgid_plural "A circle can have %(num)s people at most."
msgstr[0] "Ringis võib olla maksimaalselt %(num)s inimene."
msgstr[1] "Ringis võib olla maksimaalselt %(num)s inimest."

#. %(label)s is the label people see on such a post, "Shared with a circle"
#, machine, plain1, python-format
msgid "A circle of your own. The people in it are not told, and nothing they see names it: your posts for it show as \"%(label)s\"."
msgstr "Sinu enda ring. Selles olevatele inimestele ei öelda ja midagi, mida nad näevad, ei nimeta seda: teie postitused näitavad \"%(label)s\"."

#, machine, plain1, python-format
msgid "A circle's name can be %(num)s character at most."
msgid_plural "A circle's name can be %(num)s characters at most."
msgstr[0] "Ringi nimi võib olla maksimaalselt %(num)s märk."
msgstr[1] "Ringi nimi võib olla maksimaalselt %(num)s tähemärki."

#, machine, plain2
msgid "A comment"
msgstr "Kommentaar"

#, machine, plain2
msgid "A comment by an account you blocked or that blocked you."
msgstr "Kommentaar kontolt, mille olete blokeerinud või mis blokeeris teid."

#, machine, plain2
msgid "A comment hidden by a guildmaster."
msgstr "Kommentaar, mida varjab gildi moderaator."

#, machine, plain2
msgid "A comment hidden by your word filter."
msgstr "Sõnafiltriga peidetud kommentaar."

#, machine, plain2
msgid "A comment its author deleted. What it said isn't shown here."
msgstr "Kommentaar selle autor kustutatud. Seda, mida siin öeldi, siin ei näidata."

#, machine, plain1
msgid "A comment on a post for a Circle can't be forwarded to a guild."
msgstr "Kommentaari Circle'i postituse kohta ei saa gildile edastada."

#, machine, plain1
msgid "A comment on a post for a Circle can't be reposted."
msgstr "Kommentaari Circle'i postituse kohta ei saa uuesti postitada."

#, machine, plain2
msgid "A comment removed by the site's admins."
msgstr "Kommentaar eemaldatud saidi administraatorid."

#, machine, plain1, python-format
msgid "A community note was added to a comment you asked about: [view it](%(link)s)"
msgstr "Kommentaarile, mille kohta küsisite, lisati kogukonna märkus: [vaata seda](%(link)s"

#, machine, plain1, python-format
msgid "A community note was added to a post you asked about: [view it](%(link)s)"
msgstr "Postitusele, mille kohta küsisite: [vaata seda](%(link)s"

#, machine, plain1
msgid "A curation of the whole site needs an age limit of a month or less."
msgstr "Kogu saidi kureeritud sööt vajab vanusepiirangut kuu või vähem."

#, machine, plain1
msgid "A day"
msgstr "Päev"

#, machine, plain2
msgid "A decision in the Log"
msgstr "Otsus logis"

#, machine, plain2
msgid "A deleted post and what was said under it"
msgstr "Kustutatud postitus ja mida selle all öeldi"

#, machine, plain1, python-format
msgid "A description can be %(num)s character at most."
msgid_plural "A description can be %(num)s characters at most."
msgstr[0] "Kirjeldus võib olla maksimaalselt %(num)s märk."
msgstr[1] "Kirjeldus võib olla maksimaalselt %(num)s tähemärki."

#, machine, plain1, python-format
msgid "A description is at most %(num)s character."
msgid_plural "A description is at most %(num)s characters."
msgstr[0] "Kirjeldus on maksimaalselt %(num)s märk."
msgstr[1] "Kirjeldus on maksimaalselt %(num)s tähemärki."

#, machine, plain2
msgid "A different admin has to confirm a reveal."
msgstr "Teine administraator peab paljastamist kinnitama."

#, machine, plain1, python-format
msgid "A display name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A display name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Ekraani nimi võib olla %(num)s märk (hiina, jaapani ja korea tähemärgid ning emoji arv 2)."
msgstr[1] "Ekraani nimi võib olla %(num)s märki (hiina, jaapani ja korea tähemärgid ning emoji arv 2)."

#, machine, plain1
msgid "A display name can't contain < or >."
msgstr "Kuva nimi ei tohi sisaldada < või >."

#, machine, plain1
msgid "A display name can't contain @: it would read as a handle."
msgstr "Kuva nimi ei saa sisaldada @: see oleks loetav käepidemena."

#, machine, plain1
msgid "A display name can't contain control or invisible characters."
msgstr "Ekraani nimi ei saa sisaldada juht- ega nähtamatuid märke."

#, machine, plain1
msgid "A feed added now waits for an admin before it is read."
msgstr "Lisatud kanal ootab nüüd administraatorit, enne kui seda loetakse."

#, machine, plain1
msgid "A feed an admin adds is approved at once."
msgstr "Sööt, mille admin lisab, kiidetakse heaks korraga."

#, machine, plain1
msgid "A feed server address cannot hold a user name or password."
msgstr "Söödaserveri aadress ei saa sisaldada kasutajanime ega parooli."

#, machine, plain1
msgid "A feed server address must start with https://"
msgstr "Söödaserveri aadress peab algama https://"

#, machine, plain1
