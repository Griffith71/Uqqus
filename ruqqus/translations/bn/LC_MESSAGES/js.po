msgid "This sign-in"
msgstr "এই সাইন-ইন"

#, machine, plain2
msgid "This signs out chat in this browser too, if it is this browser's. It will start again as a new device."
msgstr "এই ব্রাউজারের সাথে সংযোগ স্থাপন করা হলে, এই ব্রাউজারের সাথে সংযোগ স্থাপন করা হবে। এটা নতুন ডিভাইস হিসাবে আবার শুরু হবে।"

#, machine, plain1, python-format
msgid "This voice channel is full (%(num)s person)."
msgid_plural "This voice channel is full (%(num)s people)."
msgstr[0] "এই ভয়েস চ্যানেলটি পূর্ণ (%(num)s জন)."
msgstr[1] "এই ভয়েস চ্যানেলটি পূর্ণ (%(num)s জন)।"

#, machine, plain2
msgid "Those keys are no longer your account's. Use your recovery code, or start over."
msgstr "এই কিগুলো আর আপনার অ্যাকাউন্ট নয়। আপনার পুনরুদ্ধার কোড ব্যবহার করুন, অথবা ওভার।"

#, machine, plain1
msgid "Thou've reached the end of the list!"
msgstr "তুমি তালিকার শেষ প্রান্তে পৌঁছে গেছ!"

