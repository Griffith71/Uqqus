msgstr "একটি guigud নিষিদ্ধ করার জন্য একটি উন্মুক্ত কারণ প্রয়োজন, তাই guid এর পাতা এবং লগ কেন তা বলতে পারে।"

#, machine, plain1, python-format
msgid "A guild can have at most %(num)s category."
msgid_plural "A guild can have at most %(num)s categories."
msgstr[0] "Guidd প্রায় %(num)s বিভাগে থাকতে পারে."
msgstr[1] "একটি guidd সর্বাধিক %(num)sc হতে পারে।"

#, machine, plain1, python-format
msgid "A guild can have at most %(num)s channel."
msgid_plural "A guild can have at most %(num)s channels."
msgstr[0] "একটি guidd সর্বাধিক %(num)s চ্যানেলে থাকতে পারে."
msgstr[1] "একটি guidd সর্বাধিক %(num)s চ্যানেলে হতে পারে।"

#, python-format
msgid "A guild can have at most %(num)s flair."
msgid_plural "A guild can have at most %(num)s flairs."
msgstr[0] ""
msgstr[1] ""

#, machine, plain1, python-format
msgid "A guild can have at most %(num)s resource."
msgid_plural "A guild can have at most %(num)s resources."
msgstr[0] "একটি guiguid সবচেয়ে রিসোর্স থাকতে পারে."
msgstr[1] "একটি guidd সর্বাধিক %(num)s রিসোর্স থাকতে পারে."

#, machine, plain1, python-format
msgid "A guild can have at most %(num)s role."
msgid_plural "A guild can have at most %(num)s roles."
msgstr[0] "একটি guiguid সবচেয়ে গুরুত্বপূর্ণ হতে পারে."
msgstr[1] "একটি guidd সর্বাধিক %(num)s ভূমিকা রাখতে পারে।"

#, machine, plain1, python-format
msgid "A guild can have at most %(num)s wiki page."
msgid_plural "A guild can have at most %(num)s wiki pages."
msgstr[0] "একটি গ্রিল্ড উইকি পাতা থেকে %(num)s নম্বর পাতায় আসতে পারে।"
msgstr[1] "একটি guiddd সর্বাধিক %(num)s পাতা হতে পারে।"

#, machine, plain1, python-format
msgid "A guild can make %(num)s event in 30 days. Try again later."
msgid_plural "A guild can make %(num)s events in 30 days. Try again later."
msgstr[0] "একটি guidd 30 দিনের মধ্যে %(num)s অনুষ্ঠান হতে পারে. পরে চেষ্টা করো।"
msgstr[1] "একটি guidd 30 দিনের মধ্যে %(num)s অনুষ্ঠান তৈরি করতে পারে। পরে চেষ্টা করো।"

#, machine, plain1
msgid "A guildmaster has muted you in this guild's channels."
msgstr "Guiguidd Mild এর চ্যানেলে আপনি নিরেট."

#, machine, plain1, python-format
msgid "A highlight's name can be %(num)s character at most."
msgid_plural "A highlight's name can be %(num)s characters at most."
msgstr[0] "উজ্জ্বল করা নাম %(num)s অক্ষরের সর্বাধিক সংখ্যা।"
msgstr[1] "উজ্জ্বল করে দর্শানোর নাম %(num)s অক্ষর ।"

#. "Settings > Apps" names the Apps tab of the settings pages
#, machine, plain1, python-format
msgid "A key works through one of your apps (<a href=\"%(url)s\">Settings &gt; Apps</a>) and may post, edit and delete the bot's posts, never vote or comment."
msgstr "আপনার অ্যাপ্লিকেশনের একটিতে (ই.ডি.ই.এম.)<a href=\"%(url)s\">বৈশিষ্ট্য &gt; এপিপি</a>এবং হয়ত পোস্ট, সম্পাদনা এবং সম্পাদনা এবং মুছে ফেলা, কোন ভোট বা মন্তব্য নয়।"

#, machine, plain1, python-format
msgid "A label can be at most %(num)s character."
msgid_plural "A label can be at most %(num)s characters."
msgstr[0] "একটি লেবেল %(num)s অক্ষরের মধ্যে হতে পারে।"
msgstr[1] "একটি লেবেল সর্বোচ্চ %(num)s অক্ষর বিশিষ্ট হতে পারে ।"

#, machine, plain1
msgid "A label is plain text."
msgstr "একটি লেবেল সাধারণ টেক্সট।"

#, machine, plain1
msgid "A link starts with http:// or https://."
msgstr "একটি লিঙ্ক এর শুরু হয়েছে http:/// অথবা https://."

#, machine, plain1
msgid "A live audio stage (video too, if you allow it), with a live chat beside it."
msgstr "একটি লাইভ অডিও মঞ্চ (ভিডিওও যদি আপনি তা অনুমতি দেন, তবে এটি তার পাশে একটি লাইভ চ্যাট।)."

#, machine, plain1
msgid "A live thread takes comments, not board messages."
msgstr "একটি লাইভ থ্রেড মন্তব্য করে, বোর্ড মেসেজ নয়।"

#, machine, plain1
msgid "A member"
msgstr "একজন সদস্য"

#, machine, plain1
msgid "A member reported this account."
msgstr "একজন সদস্য এই অ্যাকাউন্ট সম্পর্কে রিপোর্ট করেছেন।"

#, machine, plain1, python-format
msgid "A message can be at most %(count)s character."
msgid_plural "A message can be at most %(count)s characters."
msgstr[0] "বার্তার মধ্যে বেশিরভাগের মধ্যেই বার্তা প্রেরণ করা যাবে %(count)s অক্ষর"
msgstr[1] "বার্তার মধ্যে বেশিরভাগের মধ্যেই বার্তা প্রেরণ করা যাবে %(count)s অক্ষর।"

#, machine, plain1, python-format
msgid "A message can be at most %(num)s character."
msgid_plural "A message can be at most %(num)s characters."
msgstr[0] "বার্তার মূল অংশ হচ্ছে %(num)s অক্ষর ।"
msgstr[1] "একটি বার্তাকে সর্বোচ্চ %(num)s-টি অক্ষর দিয়ে চালানো যাবে ।"

#, machine, plain1
msgid "A message in a thread can't have a thread of its own."
msgstr "একটি থ্রেড দিয়ে বার্তা পাঠানো যাবে না।"

#, machine, plain1
msgid "A month"
msgstr "মাস"

#, machine, plain1
msgid "A month is paid after it ends, in coins added to your balance. You get a notification."
msgstr "এটা শেষ হওয়ার এক মাস পরে টাকা দেয়া হয়, আপনার ভারসাম্যের সাথে টাকা যোগ করে। আপনি একটি ঘোষণা পেতে."

#, machine, plain1
msgid "A monthly budget shared among the members whose posts and comments people valued most. Join from here."
msgstr "এক মাসিক বাজেট সেই সব সদস্যদের মধ্যে ভাগাভাগি করা হয়েছে যাদের পোস্ট এবং মন্তব্য করা হয়েছে, যারা সব থেকে বেশী মূল্যবান। এখানে যোগ দিন."

#, machine, plain1, python-format
msgid "A muted person can still read, but can't write in any of +%(guild)s's channels. They are told when they try."
msgstr "একটি নিঃশব্দ মানুষ এখনও পড়তে পারে, কিন্তু যে কোন +তেই লিখতে পারে না%(guild)sচ্যানেলগুলো তারা চেষ্টা করার সময় তাদের বলা হয়."

#, machine, plain2
msgid "A note to the person"
msgstr "ব্যক্তির কাছে নোট"

#, machine, plain1, python-format
msgid "A page can be at most %(num)s character."
msgid_plural "A page can be at most %(num)s characters."
msgstr[0] "একটি পৃষ্ঠা যা %(num)s অক্ষরের সবচেয়ে বেশি।"
msgstr[1] "একটি পৃষ্ঠা যা সর্বোচ্চ %(num)s অক্ষর ব্যবহার করে শেষ হতে পারে ।"

#, python-format
msgid "A page's address is 1 to %(num)s letter, digit or dash."
msgid_plural "A page's address is 1 to %(num)s letters, digits or dashes."
msgstr[0] ""
msgstr[1] ""

#. %(price)s is a price such as "5 coins every 30 days"
#, machine, plain1, python-format
msgid "A paid circle: people pay %(price)s to be in it. They see its name."
msgstr "একটি মুদ্রা বৃত্ত: জনগণ টাকা %(price)s সেখানে থাকার জন্য. তারা এর নাম দেখে."

#, machine, plain1
msgid "A picture can be 8 MB at most."
msgstr "ছবি ৮ হতে পারে MB খুব বেশি."

msgid "A picture must be a PNG, JPEG, GIF or WebP file."
msgstr ""

#, machine, plain1, python-format
msgid "A place can be at most %(num)s character."
msgid_plural "A place can be at most %(num)s characters."
msgstr[0] "এমন একটা জায়গা যা %(num)s অক্ষরের মধ্যে হতে পারে।"
msgstr[1] "একটি স্থান যা সর্বোচ্চ %(num)s অক্ষর হতে পারে ।"

#, machine, plain1
msgid "A place is plain text."
msgstr "একটা জায়গা সহজ লেখা।"

#, machine, plain1, python-format
msgid "A point needs an account at least %(num)s day old that is not banned or deleted. Your own votes and comments never count."
msgid_plural "A point needs an account at least %(num)s days old that is not banned or deleted. Your own votes and comments never count."
msgstr[0] "একটি বিন্দুতে অন্তত %(num)s দিন পুরোনো একটি একাউন্ট দরকার যা নিষিদ্ধ বা মুছে ফেলা হয়নি। আপনার নিজের ভোট আর মন্তব্য কখনো গণনা করে না।"
msgstr[1] "একটি বিন্দু অন্তত %(num)s দিন পুরোনো একটি অ্যাকাউন্ট প্রয়োজন যা নিষিদ্ধ বা মুছে ফেলা হয়নি । আপনার নিজের ভোট আর মন্তব্য কখনো গণনা করে না।"

#, machine, plain1, python-format
msgid "A poll can have %(num)s option at most."
msgid_plural "A poll can have %(num)s options at most."
msgstr[0] "এর মধ্যে %(num)sটি ভোটের সুযোগ থাকতে পারে।"
msgstr[1] "বেশিরভাগ ক্ষেত্রে একটি ভোটের মান %(num)s হতে পারে।"

#, machine, plain1, python-format
msgid "A poll needs at least %(num)s option."
msgid_plural "A poll needs at least %(num)s options."
msgstr[0] "একটি জরিপের জন্য অন্তত %(num)s টা বিকল্প দরকার।"
msgstr[1] "পোলের ক্ষেত্রে অন্তত %(num)s অপশন প্রয়োজন।"

#, machine, plain1, python-format
msgid "A poll option can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A poll option can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "একটি পোলের উপায় হতে পারে %(num)s অক্ষর (চীনা, জাপানি আর কোরিয়ান অক্ষর) আর ইমোজি হিসাবে 2)।"
msgstr[1] "%(num)s অক্ষর (চীনা, জাপানি ও কোরিয়ান অক্ষর) এবং ইমোজি হিসেবে 2 হিসেবে ভোটের বিকল্প হতে পারে।"

#, machine, plain1
msgid "A poll option can't hold control characters."
msgstr "একটি পোল অপশন অক্ষর নিয়ন্ত্রণ করতে পারেনা."

#, machine, plain2
msgid "A post"
msgstr "একটি পোস্ট"

#, machine, plain1, python-format
msgid "A post can have %(num)s co-author at most."
msgid_plural "A post can have %(num)s co-authors at most."
msgstr[0] "একটা পোস্ট থেকে বেশীরভাগ ক্ষেত্রেই %(num)s জন সহ লেখক আসতে পারে।"
msgstr[1] "একটি পোস্ট হয়ত %(num)s সহ-authorী হতে পারে।"

#, machine, plain1, python-format
msgid "A post can have at most %(num)s update a day."
msgid_plural "A post can have at most %(num)s updates a day."
msgstr[0] "একটি পোস্ট দিনে প্রায় %(num)sটি আপডেট করতে পারে।"
msgstr[1] "একটি পোস্ট দিনে প্রায় %(num)sটি আপডেট করতে পারে।"

#, machine, plain1
msgid "A post for a Circle can't be forwarded to a guild."
msgstr "একটি বৃত্তের জন্য পোস্ট করা যাবে না একটি guild উদ্দেশ্যে।"

#, machine, plain1
msgid "A post for a Circle can't be reposted."
msgstr "একটি বৃত্তের জন্য লেখা পোস্ট করা যাবে না।"

#, machine, plain1
msgid "A post for a Circle can't have co-authors."
msgstr "একটি বৃত্তের জন্য লেখা একটি পোস্ট সহ-কার্দের থাকতে পারে না।"

#, machine, plain2
msgid "A post for a Circle can't have its name removed."
msgstr "একটি বৃত্তের নাম মুছে ফেলা যাবে না।"

#, machine, plain1
msgid "A post for your circles can't be anonymous: the people in them already know who you are."
msgstr "আপনার বৃত্তের জন্য একটি পোস্ট পরিচয় গোপন রাখা যাবে নাঃ ইতোমধ্যে জানা যাচ্ছে যে আপনি কে।"

#, machine, plain1
msgid "A post for your circles can't be forwarded to a guild."
msgstr "তোমার বৃত্তের জন্য একটা পোস্ট দেয়া যাবে না, guild এর কাছে।"

#, machine, plain1
msgid "A post for your circles can't have co-authors."
msgstr "তোমার বৃত্তের জন্য একটা পোস্ট আছে যা কিনা সহ লেখকর কাছে নেই।"

#, machine, plain1
msgid "A post in a Circle guild can't be forwarded to another guild."
msgstr "একটি বৃত্ত guiguided একটি পোস্ট অন্য guild উদ্দেশ্যে করা যাবে না।"

#, machine, plain1
msgid "A post in a Circle guild keeps that guild's audience."
msgstr "বৃত্ত গ্রিল্ডের একটি পোস্টে বলা হয়েছে যে guid এর দর্শক আছে।"

#, machine, plain1
msgid "A post loses half its weight in"
msgstr "একটা পোস্ট তার অর্ধেক ওজন হারিয়েছে"

#, machine, plain1
msgid "A post needs a title."
msgstr "একটি পোস্টের একটি শিরোনাম প্রয়োজন।"

#, machine, plain2
msgid "A post that has been tipped can't have its name removed, because the coins went to you."
msgstr "এমন একটি পোস্ট যা বলা হয়েছে তার নাম মুছে ফেলা যাবে না, কারণ পয়সা তোমার কাছে গিয়েছিল।"

#, machine, plain1
msgid "A post that isn't public can't use this picture upload: its files can be opened by anyone with the address. Add the picture from your linked storage instead (Settings > Media)."
msgstr "এই ছবিটি আপলোড করা যাবে না: ঠিকানার মাধ্যমে এর ফাইল খোলা যাবে। কনফিগার করা বৈশিষ্ট্যের পরিবর্তে ( বলল > মিডিয়া) থেকে ছবিটি যোগ করুন।"

#, machine, plain2
msgid "A post with an anonymous credit can't be forked."
msgstr "বেনামী ক্রেডিটের নামে একটি পোস্ট দেয়া যায় না।"

#, machine, plain1
msgid "A post with co-authors can't be moved to circles. Moving a public post to circles takes down the copies you forwarded; copies other people forwarded stay in their guilds."
msgstr "সহ-authors সঙ্গে একটি পোস্ট প্রদর্শন করতে পারে না। আপনি যে কপিগুলো দিয়েছিলেন সেগুলোর কপি নীচে সরিয়ে নেওয়ার জন্য পাবলিক পোস্টগুলো নেওয়া হয়েছে; অন্য লোকেরা তাদের গিল্ডে চলে গিয়েছিল ।"

#, machine, plain2
msgid "A post written together is deleted only when its authors agree, in its shared draft."
msgstr "একটি লেখা একসাথে মুছে ফেলা হয় যখন এর লেখক একমত হন, এটি শেয়ার করা খসড়া।"

#, machine, plain2
msgid "A post written together is public and can't be shared with circles or have a poll. Its authors are its co-authors. These options are shared by every author and used each time you publish."
