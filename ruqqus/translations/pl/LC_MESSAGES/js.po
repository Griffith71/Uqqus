msgid_plural "You can have %(num)s folders at most."
msgstr[0] "Możesz mieć co najwyżej %(num)s folder."
msgstr[1] "Możesz mieć najwyżej %(num)s foldery."
msgstr[2] "Możesz mieć najwyżej %(num)s folderów."

#, machine
msgid "You can read this channel but not write in it."
msgstr "Można przeczytać ten kanał, ale nie pisać w nim."

#, machine
msgid "You can see who is here, but you can't speak in this channel."
msgstr "Widzisz, kto tu jest, ale nie możesz mówić tym kanałem."

#, glossary, machine, plain1
msgid "You can't do that."
msgstr "Nie możesz tego zrobić."

#, machine
msgid "You can't message that person."
msgstr "Nie możesz jej wysłać."

#, machine
msgid "You can't send to that chat."
msgstr "Nie możesz wysłać na tę pogawędkę."

#, machine
msgid "You can't start a chat with them."
msgstr "Nie możesz z nimi rozmawiać."

#, machine
msgid "You can’t edit this draft any more (you may have left it or been removed)."
msgstr "Nie możesz już edytować tego szkicu (możesz go zostawić lub zostać usunięty)."

#, machine
msgid "You ended the Space."
msgstr "Zakończyłeś przestrzeń."

#, machine, plain1
msgid "You have no curations yet."
msgstr "Nie masz jeszcze uleczonych kanałów."

#, machine
msgid "You have no stories yet. Share one first."
msgstr "Nie masz jeszcze historii. Najpierw podziel się jednym."

#, machine
msgid "You haven't made a circle of your own yet. Your Friends circle is automatic: it is everyone you follow who follows you back."
msgstr "Nie stworzyłeś jeszcze własnego kręgu. Krąg Przyjaciół jest automatyczny: to każdy, kogo śledzisz, podąża za tobą."

#, machine
msgid "You left the Space."
msgstr "Opuściłeś przestrzeń."

#, machine
msgid "You left the call."
msgstr "Zostawiłeś telefon."

#, machine, plain1, python-format
msgid "You unfollowed @%(name)s."
msgstr "Nie śledziłeś @ %(name)s."

#, machine
msgid "You were removed from this Space."
msgstr "Zostałeś usunięty z tej przestrzeni."

#, machine
msgid "You're doing that too much. Try again later."
msgstr "Za dużo robisz. Spróbuj później."

#, machine
msgid "You're no longer in this Space."
msgstr "Nie jesteś już w tej przestrzeni."

#, machine
msgid "You're the only one here."
msgstr "Tylko ty tu jesteś."

#, machine
msgid "Your app is verified"
msgstr "Twoja aplikacja jest zweryfikowana"

#, machine
msgid "Your browser blocked the window for connecting. Allow pop-ups for this site, or connect in the settings."
msgstr "Twoja przeglądarka zablokowała okno do podłączenia. Zezwalaj na wyskakiwanie dla tej strony lub podłączenie w ustawieniach."

#, machine
msgid "Your chat devices can't be listed right now."
msgstr "Twoje urządzenia czatu nie mogą być wymienione w tej chwili."

#, machine
msgid "Your chats"
msgstr "Twoje rozmowy"

#, machine
msgid "Your chats will work again on this device, but messages from before can't be read here (or anywhere without your old key)."
msgstr "Twoje rozmowy będą działać ponownie na tym urządzeniu, ale wiadomości z przeszłości nie można odczytać tutaj (lub gdziekolwiek bez starego klucza)."

#, machine
msgid "Your comment could not be posted. Try again."
msgstr "Twój komentarz nie mógł zostać opublikowany. Spróbuj jeszcze raz."

#, machine
msgid "Your edit couldn't be saved. Please check your connection and try again."
msgstr "Twoja edycja nie mogła zostać zachowana. Proszę sprawdzić połączenie i spróbować ponownie."

#, machine
msgid "Your edit couldn't be saved. Please try again."
msgstr "Twoja edycja nie mogła zostać zachowana. Proszę spróbować jeszcze raz."

#, machine
msgid "Your files stay in your own account there, using its free space. This site only shows them in your posts."
msgstr "Twoje pliki pozostają na swoim koncie, korzystając z wolnej przestrzeni. Ta strona pokazuje je tylko w swoich postów."

#, machine
msgid "Your guilds' chats"
msgstr "Twoje pogaduszki o gildii"

#. placeholder text a member replaces: the headline of a "Call to action"
#. block, and its button's label
#, machine
msgid "Your headline"
msgstr "Twój nagłówek"

#, machine
msgid "Your key can't be shown right now."
msgstr "Twój klucz nie może być pokazany."

#, machine
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "Twój klucz był zablokowany starszym hasłem. Otwórz czat na tej stronie i wprowadź kod odzysku raz; następnie otwiera się tutaj."

#, machine
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "Twoje hasło zmieniło się, ponieważ ten klucz do czatu został zablokowany. Kod odzyskiwania zapisany podczas czatu go otwiera."

#, machine
msgid "Your recovery code"
msgstr "Twój kod odzyskiwania"

#, machine
msgid "Your saved templates show up here."
msgstr "Twoje zapisane szablony pojawiają się tutaj."

#, machine
msgid "Your settings have been updated."
msgstr "Twoje ustawienia zostały zaktualizowane."

#, machine
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "Przechowalnia musi znów się połączyć. Wyślij swój dźwięk do:"

#, machine
msgid "Your storage needs connecting again. Send your pictures to:"
msgstr "Przechowalnia musi znów się połączyć. Wyślij zdjęcia do:"

#, machine
msgid "Your storage needs connecting again. Send your videos to:"
msgstr "Przechowalnia musi znów się połączyć. Wyślij swoje filmy do:"

#. %(zone)s is a time zone name such as Europe/London
#, machine, python-format
msgid "Your time zone: %(zone)s"
msgstr "Twoja strefa czasowa: %(zone)s"

#, machine
msgid "Your vote is on another copy of this Space, or it can't change any more."
msgstr "Twój głos jest na innej kopii tej przestrzeni, albo nie może się zmienić."

#, machine
msgid "You’re all caught up"
msgstr "Wszyscy jesteście złapani"

#, machine
msgid "You’re all caught up."
msgstr "Wszyscy jesteście złapani."

