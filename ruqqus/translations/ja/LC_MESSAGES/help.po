msgctxt "formatting"
msgid "Code"
msgstr "コードコード"

#, machine
msgid "Code Block"
msgstr "コードブロック"

#, machine
msgid "Coloring"
msgstr "カラーリング"

#, machine
msgid "Colour, highlight, alignment and buttons"
msgstr "カラー、ハイライト、アライメント、ボタン"

