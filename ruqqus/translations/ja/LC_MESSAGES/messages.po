#. beside a post's author, its co-authors: names is the first five, linked; num
#. is how many more there are
#, machine, python-format
msgid "with %(names)s and <a href=\"%(url)s\">%(num)s other</a>"
msgid_plural "with %(names)s and <a href=\"%(url)s\">%(num)s others</a>"
msgstr[0] "お問い合わせ %(names)s そして、 <a href=\"%(url)s\">%(num)s その他</a>"

#, machine, python-format
msgid "with promo code <code>%(code)s</code>"
msgstr "プロモーションコード <code>%(code)s</code>"

#, machine
msgid "words or phrases, separated by commas"
msgstr "単語やフレーズ、コンマで区切る"

#. follows the moderator's name in a guild's moderation log; %(target)s is a
#. link
#, machine, python-format
msgid "yanked post %(target)s"
msgstr "ヤンク投稿 %(target)s"

#, machine
msgctxt "time filter"
msgid "year"
msgstr "年間行事"

#, machine
msgctxt "badge beside your own name"
msgid "you"
msgstr "お問い合わせ"

#, machine
msgid "you voted no"
msgstr "投票する"

#, machine
msgid "you voted yes"
msgstr "投票する はい"

#, machine
msgid "you were posting too fast, and it couldn't wait any longer."
msgstr "あまりにも早く投稿していたので、もう待たせませんでした."

#, machine, plain2
msgid "you were signed out."
msgstr "切断された."

#, machine
msgid "you're invited to write it"
msgstr "お問い合わせ"

#, machine, plain2
msgid "your account couldn't post it at that moment (it is on hold or suspended, or the rules of a guild it was forwarded to). Open it and press Post to see what."
msgstr "あなたのアカウントは、その瞬間にそれを投稿できませんでした(それは、保持または中断された、またはそれが転送されたギルドのルールです)。 それを開いたり、ポストを押すと、何が表示されるかが表示されます."

#. "~" means about; an action is a post or comment counted towards the posting
#. cooldown
#, machine, python-format
msgid "~%(num)s action left before a cooldown"
msgid_plural "~%(num)s actions left before a cooldown"
msgstr[0] "~%(num)sクールダウン前のアクション"

#, machine, python-format
msgid "“%(name)s” is already used for a view of your bookmarks. Pick another name."
msgstr "「%(name)s」は、すでにブックマークのビューに使われています。 別の名前を選ぶ."

#, machine, python-format
msgid "“%(name)s” isn't a guild name."
msgstr "「%(name)s」はギルドの名前ではありません."

#, machine, python-format
msgid "“%(option)s” is in the poll twice."
msgstr "“%(option)s” は 2 回投票する."

