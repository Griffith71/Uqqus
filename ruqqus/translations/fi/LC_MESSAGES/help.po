msgid "%(coin)s Address"
msgstr "%(coin)s Osoite"

#, machine, plain1, python-format
msgid "%(coin)s receiving address QR code"
msgstr "%(coin)s vastaanottava osoite QR koodi"

#, machine, plain1, python-format
msgid "%(company)s is outside your jurisdiction. Sucks to be you."
msgstr "%(company)s ei kuulu toimivaltaanne. Kurjaa olla sinä."

#, machine, plain1, python-format
msgid "%(company)s is, always has been, and always will be 100%% outside your jurisdiction. You must obtain legal process that is valid in the state of New Hampshire. Then, submit your United States legal process document to our [legal requests portal](/legal)."
msgstr "%(company)s on aina ollut ja tulee aina olemaan 100%% toimivallan ulkopuolella. Sinun on hankittava New Hampshiren osavaltiossa voimassa oleva oikeudenkäynti. Sitten, lähetä Yhdysvaltain oikeudellinen prosessi asiakirja meidän [oikeudellisten pyyntöjen portaali] [/legal)."

#, machine, plain1, python-format
msgid "%(company)s may revoke your License at any time and for any reason."
msgstr "%(company)s voi peruuttaa lisenssisi milloin tahansa ja mistä tahansa syystä."

#, machine, plain1, python-format
msgid "%(curation)s: a public curation, by its name or the short name under it. Search %(curation)s to find them; <code>%(in_curation)s</code> narrows a post search to that curation's guilds and accounts. Private curations are never found."
msgstr "%(curation)s: julkinen kuratoitu rehu, sen nimi tai sen lyhyt nimi. Etsi %(curation)s löytää ne; <code>%(in_curation)s</code> Kaventaa postietsinnän kuratoidun syötteen kiltoihin ja tileihin. Yksityisiä kuraatteja ei koskaan löydy."

