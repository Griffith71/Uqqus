msgstr "Oma muotoilu"

#, machine, plain1
msgid "DO NOT reveal your Client Secret. Anyone with your Client Secret will be able to pretend to be you. You are responsible for keeping your Client Secret a secret!"
msgstr "ÄLÄ paljasta asiakassalaisuuttasi. Kuka tahansa asiakassalaisesi voi esittää sinua. Olet vastuussa asiakassalaisuutesi salaisuudesta!"

#, machine, plain1, python-format
msgid "Days are in UTC. <code>%(before)s</code> and <code>%(after)s</code> leave the day itself out; <code>%(since)s</code> and <code>%(until)s</code> include it."
msgstr "Päivät ovat ohi UTC. <code>%(before)s</code> sekä <code>%(after)s</code> jättää päivän itse; <code>%(since)s</code> sekä <code>%(until)s</code> Mukaan lukien."

#, machine, plain1
