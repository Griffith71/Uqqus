msgstr[0] "Paskutiniai %(num)s ženklai. Vieta yra tik šalis, dirbo iš ryšio. Neatpažįsti? Pakeiskite slaptažodį: kuris atjungia kiekvieną kitą įrenginį."
msgstr[1] "Paskutiniai %(num)s ženklai. Vieta yra tik šalis, dirbo iš ryšio. Neatpažįsti? Pakeiskite slaptažodį: kuris atjungia kiekvieną kitą įrenginį."
msgstr[2] "Tavo paskutiniai %(num)s ženklai. Vieta yra tik šalis, dirbo iš ryšio. Neatpažįsti? Pakeiskite slaptažodį: kuris atjungia kiekvieną kitą įrenginį."

