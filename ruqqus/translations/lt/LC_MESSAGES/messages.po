msgstr[0] "Ši erdvė pilna (%(num)s klausytojas)."
msgstr[1] "Ši erdvė pilna (%(num)s klausytojai)."
msgstr[2] "Ši erdvė pilna (%(num)s klausytojų)."

#, machine, plain1, python-format
msgid "This Space is live until %(time)s."
msgstr "Ši erdvė veiks iki %(time)s."

#, machine, plain1
msgid "This Space is live."
msgstr "Ši erdvė gyva."

#, machine, plain1
msgid "This Space is not recorded: when it ends, it is gone, with everything in it."
msgstr "Ši erdvė nėra įrašyta: kai ji baigiasi, ji dingo, su viskuo jame."

#, machine, plain1
msgid "This Space is recorded"
msgstr "Ši erdvė yra registruojama"

#, machine, plain1
msgid "This Space is recorded: its board stays to read when it ends."
msgstr "Ši erdvė yra įrašyta: jos lenta lieka skaityti, kai ji baigiasi."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay with the video."
msgstr "Ši erdvė yra įrašytas: šeimininkas išlaiko replay su vaizdo."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay."
msgstr "Ši erdvė yra įrašytas: šeimininkas išlaiko replay."

#, machine, plain1
msgid "This Space isn't available."
msgstr "Ši erdvė neprieinama."

#, machine, plain1
msgid "This Space isn't waiting to start."
msgstr "Kosmosas nelaukia pradžios."

#, machine, plain1
msgid "This Space keeps its sound only."
msgstr "Ši erdvė išlaiko tik savo garsą."

#, machine, plain1
msgid "This access will expire in one hour, or earlier if you revoke it."
msgstr "Ši prieiga nustos galioti po valandos arba anksčiau, jei ją panaikinsite."

#, machine, plain1
msgid "This account can't use chat apps."
msgstr "Ši paskyra negali naudoti pokalbių programėlių."

#, machine, plain1, python-format
msgid "This account has been marked 18 or over since %(date)s."
msgstr "Ši paskyra pažymėta 18 ar daugiau nuo %(date)s."

#, machine, plain1, python-format
msgid "This account has been permanently suspended from %(site)s."
msgstr "Ši paskyra buvo visam laikui sustabdyta nuo %(site)s."

#, machine, plain1, python-format
msgid "This account has been temporarily suspended from %(site)s. Check back later."
msgstr "Ši sąskaita laikinai sustabdyta nuo %(site)s. Atsiliepk vėliau."

#, machine, plain1
msgid "This account is private"
msgstr "Ši sąskaita yra privati"

#, machine, plain1
msgid "This account is suspended."
msgstr "Ši sąskaita sustabdyta."

#, machine, plain1
msgid "This account owes money, so it can't be deleted yet."
msgstr "Ši sąskaita skolinga pinigų, todėl jos dar negalima ištrinti."

#, machine, plain1
msgid "This account posts about sensitive topics"
msgstr "Ši sąskaita skirta jautrioms temoms"

#, machine, plain2
msgid "This also signs out chat everywhere else, chat apps included, except the chat this browser has used since you signed in here."
msgstr "Tai taip pat atjungia pokalbius visur kitur, pokalbių programėlės įtrauktos, išskyrus pokalbį, kurį ši naršyklė naudojo nuo tada, kai jūs čia pasirašėte."

#. %(time)s is a length of time, such as "6 months"
#, machine, plain1, python-format
msgid "This author hasn't been active for %(time)s, so isn't counted."
msgstr "Šis autorius nebuvo aktyvus %(time)s, todėl nėra skaičiuojamas."

#, machine, plain1
msgid "This bot can't take tips right now."
msgstr "Šis robotas dabar negali gauti patarimų."

#, machine, plain1
msgid "This bot has not been approved."
msgstr "Šis robotas nebuvo patvirtintas."

#, machine, plain1
msgid "This bot is not running."
msgstr "Šis robotas nebėga."

#, machine, plain1
msgid "This bot's owner can't run it right now."
msgstr "Šio roboto savininkas dabar negali jo paleisti."

#, machine, plain2
msgid "This browser was signed out. Sign in again to carry on."
msgstr "Ši naršyklė buvo atjungta. Vėl prisijunk, kad tęstum."

#, machine, plain2
msgid "This browser's notifications couldn't be turned on. Try again."
msgstr "Šios naršyklės pranešimų nepavyko įjungti. Pabandyk dar kartą."

#, machine, plain1, python-format
msgid "This call is full (%(num)s person)."
msgid_plural "This call is full (%(num)s people)."
msgstr[0] "Šis skambutis pilnas (%(num)s asmuo)."
msgstr[1] "Šis skambutis pilnas (%(num)s žmonės)."
msgstr[2] "Šis skambutis pilnas (%(num)s žmonių)."

#, machine, plain1
msgid "This can't be translated right now."
msgstr "To dabar negalima išversti."

#, machine, plain1
msgid "This channel doesn't ask for its rules to be accepted."
msgstr "Šis kanalas neprašo priimti jo taisyklių."

#, machine, plain1
msgid "This channel has no messages."
msgstr "Šis kanalas neturi žinučių."

#, machine, plain1
msgid "This channel is end-to-end encrypted: it is read and written in Chat, where your messages are unlocked."
msgstr "Šis kanalas yra užšifruotas: jis skaitomas ir rašomas Pokalbyje, kur atrakinti jūsų laiškai."

#, machine, plain1
msgid "This channel is end-to-end encrypted: the site can't read it, so it has no word filter, slow mode, pins, search or reports."
msgstr "Šis kanalas yra užšifruotas: svetainė negali jo perskaityti, todėl jame nėra žodžių filtro, lėtas režimas, smeigtukai, paieška ar ataskaitos."

#, machine, plain1
msgid "This channel is full."
msgstr "Šis kanalas pilnas."

#, machine, plain1
msgid "This channel is written from the chat itself."
msgstr "Šis kanalas yra parašytas iš paties pokalbio."

#, machine, plain1
msgid "This channel isn't available."
msgstr "Šis kanalas neprieinamas."

#, machine, plain1
msgid "This circle isn't taking subscribers."
msgstr "Šis ratas neturi abonentų."

#, machine, plain1
msgid "This code can't be used. Get a new one on the computer, or sign in there with your password."
msgstr "Šis kodas negali būti naudojamas. Gaukite naują kompiuteryje, arba pasirašyti ten su savo slaptažodžiu."

#, machine, plain1
msgid "This code has run out."
msgstr "Šis kodas baigėsi."

#, machine, plain1
msgid "This comment and the comments under it"
msgstr "Ši pastaba ir joje pateiktos pastabos"

#, machine, plain1, python-format
msgid "This comment breaks %(site)s policy"
msgstr "Šis komentaras pertrauka %(site)s politiką"

#, machine, plain1
msgid "This comment can't be forwarded."
msgstr "Šios pastabos siųsti negalima."

#, machine, plain1
msgid "This comment can't be reposted."
msgstr "Šio komentaro negalima persiųsti."

#, machine, plain1
msgid "This comment is on a copy forwarded to a guild - ask that guild's guildmasters to remove it instead."
msgstr "Šis komentaras yra ant kopijos, persiunčiamos į gildijos - paprašyti, kad gildijos gildijos moderatoriai pašalinti jį vietoj."

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a>"
msgstr "Šis komentaras yra vaiduoklis miestas. <a href=\"%(url)s\">Prisijungti</a>"

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a> to comment!"
msgstr "Šis komentaras yra vaiduoklis miestas. <a href=\"%(url)s\">Prisijungti</a> komentuoti!"

#, machine, plain1
msgid "This comment section is a ghost town. Be the first to comment!"
msgstr "Šis komentaras yra vaiduoklis miestas. Būkite pirmas komentaras!"

#, machine, plain1
msgid "This comment section is a ghost town..."
msgstr "Šis komentaras yra vaiduoklis miestas..."

#, machine, plain1
msgid "This content has already been posted"
msgstr "Šis turinys jau paskelbtas"

#, machine, plain1
msgid "This copy is no longer kept."
msgstr "Ši kopija nebesaugoma."

#, machine, plain1
msgid "This creates a new, independent post in that guild with its own votes and comments. The title is generated from the comment's text. A link back to the original comment will be shown on the new post."
msgstr "Tai sukuria naują, nepriklausomą postą, kad gild su savo balsais ir komentarais. Pavadinimas sukurtas iš komentaro teksto. Nuoroda į pradinį komentarą bus rodoma naujajame poste."

#, machine, plain1
msgid "This creates an independent copy of the post with its own votes and comments in that guild. You can forward to any guild that accepts forwards from you."
msgstr "Tai sukuria nepriklausomą kopiją posto su savo balsus ir komentarus, kad gildija. Galite persiųsti bet kokią gildiją, kuri priima į priekį iš jūsų."

#, machine, plain1
msgid "This curation's feed server has been asked too often. Try again in a minute."
msgstr "Šis kuruotas pašarų serveris buvo paprašytas per dažnai. Pabandyk po minutės."

#, machine, plain1
msgid "This curation's feed server has not been answering."
msgstr "Šis kuruotas pašarų serveris neatsiliepia."

#, machine, plain1
msgid "This curation's feed server has not been answering. Showing its last answer."
msgstr "Šis kuruotas pašarų serveris neatsiliepia. Rodomas paskutinis atsakymas."

#, machine, plain1
msgid "This curation's guilds and accounts"
msgstr "Tai varškės pašarų kaltės ir sąskaitos"

#, machine, plain1
msgid "This curation's rules took too long to run. Its owner can make them narrower."
msgstr "Šitos šėrimo taisyklės užtruko per ilgai. Jo savininkas gali padaryti juos siauresni."

#, machine, plain1
msgid "This deletes their account and everything on it. It can't be undone. You can download their data first."
msgstr "Tai ištrina jų sąskaitą ir viską apie ją. Tai negali būti atšaukta. Pirmiausia galite atsisiųsti duomenis."

#, machine, plain2
msgid "This device will be signed out shortly."
msgstr "Šis įrenginys netrukus bus atjungtas."

#, machine, plain1
msgid "This draft hasn't been published."
msgstr "Šis projektas nebuvo paskelbtas."

#, machine, plain1
msgid "This event is over."
msgstr "Šis įvykis baigtas."

#, machine, plain1
msgid "This event was cancelled."
msgstr "Šis įvykis buvo atšauktas."

#, machine, plain1
msgid "This exact phrase"
msgstr "Ši tiksli frazė"

#, machine, plain1
msgid "This guild discusses sensitive topics"
msgstr "Šiame dokumente aptariamos opios temos"

#, machine, plain1
msgid "This guild discusses sensitive topics (every post here will be blurred by default)."
msgstr "Šis vadovas aptaria jautrias temas (kiekvienas postas čia bus neryškus pagal nutylėjimą)."

#, machine, plain1
msgid "This guild is banned."
msgstr "Ši gildija uždrausta."

#, machine, plain1
msgid "This guild is private. Content posted prior to the guild being set to private is visible to everyone."
msgstr "Ši gildija privati. Turinys paskelbtas prieš gildijos nustatomas privačiai yra matomas visiems."

#, machine, plain1
msgid "This guild's channels are closed."
msgstr "Šios gildijos kanalai uždaryti."

#, machine, plain1
msgid "This invitation was already answered."
msgstr "Į šį kvietimą jau atsakyta."

#, machine, plain1
msgid "This is a Space: its discussion is in the Space."
msgstr "Tai erdvė: jos diskusija yra kosmose."

#, machine, plain1, python-format
msgid "This is a Space: its discussion is in the Space. <a href=\"%(url)s\">Open the Space</a>"
msgstr "Tai erdvė: jos diskusija yra kosmose. <a href=\"%(url)s\">Atverti erdvę</a>"

#, machine, plain1
msgid "This is a Space: its host and co-hosts post its updates from the Space."
msgstr "Tai erdvė: jos šeimininkas ir bendrašeimininkai rašyti savo atnaujinimus iš kosmoso."

#, machine, plain1, python-format
msgid "This is a log of moderator actions performed in +%(guild)s. The ones everyone may read are also in the site-wide <a href=\"%(url)s\">Log</a>. What members delete themselves is not published."
msgstr "Tai moderatoriaus veiksmų žurnalas, atliktas +%(guild)sTie, kurie visi gali skaityti, taip pat yra visoje svetainėje <a href=\"%(url)s\">Žurnalas</a>. Kas nariai ištrinti save nėra skelbiamas."

#, machine, plain1
msgid "This is already in your language."
msgstr "Tai jau jūsų kalba."

#, machine, plain2
msgid "This is for chat on this site. A chat app you use outside it follows its own setting."
msgstr "Tai skirta pokalbiams šioje svetainėje. Pokalbio programa, kurią naudojate už jos ribų, seka savo nustatymus."

#, machine, plain1
msgid "This is for the members of a Circle guild."
msgstr "Tai skirta rato gildijos nariams."

#. %(name)s is the username of the person who made the post
#, machine, plain1, python-format
msgid "This is for the people in one of <a href=\"%(url)s\">@%(name)s</a>'s circles."
msgstr "Tai skirta žmonėms <a href=\"%(url)s\">@%(name)s</a>- Tai apskritimai."

#, machine, plain1
msgid "This is the guild's custom CSS file."
msgstr "Tai gildijos naudotojo CSS failas."

#, machine, plain1
msgid "This is too much like what was posted automatically today."
msgstr "Tai per daug, kad tai buvo paskelbtas automatiškai šiandien."

#, machine, plain1
msgid "This isn't available while your account is age-restricted. You can confirm your age in Settings > Content."
msgstr "Tai nėra prieinama, kol jūsų paskyra yra yra riboto amžiaus. Jūs galite patvirtinti savo amžių Parametrai > Turinys."

#, machine, plain1
msgid "This isn't shown at your current word filter level. You can review your word filter in your content settings."
msgstr "Tai nėra rodoma jūsų dabartinio žodžio filtro lygyje. Galite peržiūrėti savo žodžių filtrą turinio nustatymuose."

#, machine, plain1
msgid "This isn't shown where you are until your age has been confirmed. Sign in to do that in your content settings."
msgstr "Tai nėra parodyta, kur esate, kol jūsų amžius nėra patvirtintas. Prisijunkite prie to turinio nustatymuose."

#, machine, plain1
msgid "This isn't shown while your account is age-restricted."
msgstr "Tai nerodoma, kol jūsų paskyra yra apribota."

#, machine, plain1, python-format
msgid "This live thread ended a moment ago. It can go live again in %(num)s min."
msgid_plural "This live thread ended a moment ago. It can go live again in %(num)s min."
msgstr[0] "Šis gyvasis siūlas baigėsi prieš akimirką. Jis gali vėl gyventi po %(num)s minučių."
msgstr[1] "Šis gyvasis siūlas baigėsi prieš akimirką. Jis gali vėl gyventi po %(num)s minučių."
msgstr[2] "Šis gyvasis siūlas baigėsi prieš akimirką. Jis gali vėl gyventi po %(num)s minučių."

#, machine, plain1
msgid "This live thread has ended"
msgstr "Šis gyvasis siūlas baigėsi"

#, machine, plain1
msgid "This may be misleading or needs context (request a community note)"
msgstr "Tai gali būti klaidinanti arba reikia kontekstą (prašyti Bendrijos pastaba)"

#, machine, plain1
msgid "This month"
msgstr "Šį mėnesį"

#, machine, plain1
msgid "This needs a verified email address."
msgstr "Tam reikia patvirtinto el. pašto adreso."

#, machine, plain1
msgid "This page is empty."
msgstr "Šis puslapis tuščias."

#, machine, plain1, python-format
msgid "This page is generated by the %(site)s application introspecting its own routing functions. Nifty."
msgstr "Šį puslapį sukuria programa %(site)s, turinti savo maršrutizavimo funkcijas. Nifty."

