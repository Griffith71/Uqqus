#. the last error, a sentence.
#, machine, plain1, python-format
msgid "Your bot @%(name)s stopped reading %(url)s after %(fails)s failed tries: %(reason)s Start it again from Settings > Bots once it works."
msgstr "Jūsų botas @ %(name)s nustojo skaityti %(url)s po %(fails)s nepavyko bandyti: %(reason)s Paleisti jį iš naujo iš Parametrai > Botai, kai tai veikia."

#, python-format
msgid "Your bot [@%(name)s](/@%(name)s) was approved. It starts posting within a few minutes. Manage it in [Settings > Bots](/settings/bots)."
msgstr ""

