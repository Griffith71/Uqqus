msgstr "Jūsų paskyros automatinis komandiravimas sustabdytas: %(reason)s"

#, machine, plain1
msgid "Your account's automated posting is running again."
msgstr "Jūsų paskyros automatinis komandiravimas vėl veikia."

#, machine, plain1, python-format
msgid "Your account's automated posting stopped reading %(url)s after %(fails)s failed tries: %(reason)s Start it again from Settings > Bots once it works."
msgstr "Jūsų paskyros automatinis siuntimas nutraukė skaitymą %(url)s po %(fails)s nepavykusių bandymų: %(reason)s Paleisti jį iš naujo iš Parametrai > Botai, kai tai veikia."

#, machine, plain1
msgid "Your account's automated posting was approved. Your feeds' new posts appear on your profile, marked as automated, within a few minutes. Manage it in [Settings > Bots](/settings/bots)."
msgstr "Jūsų sąskaitos automatinis komandiravimas buvo patvirtintas. Per kelias minutes savo profilyje pasirodo naujieji laiškai, pažymėti kaip automatiniai. Tvarkyti jį [Nustatymai > Batai] (/settings/bots)."

#, machine, plain1
msgid "Your age"
