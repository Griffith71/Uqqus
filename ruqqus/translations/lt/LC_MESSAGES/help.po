msgstr[1] "`cursor`: bet koks tekstas iki %(num)s simbolių, kurie leidžia tęsti. Palik tai, kai nieko daugiau nėra."
msgstr[2] "`cursor`: bet koks tekstas iki %(num)s simbolių, kurie leidžia tęsti. Palik tai, kai nieko daugiau nėra."

#. the word in quotes is a value the application sends as it is: keep it in
#. English.
#, machine, plain1
msgid "`grant_type` - Set to the word \"code\""
msgstr "`grant_type` - Nurodykite žodį \"kodas\""

#. the word in quotes is a value the application sends as it is: keep it in
#. English.
#, machine, plain1
msgid "`grant_type` - set to the word \"refresh\""
msgstr "`grant_type` - nustatyti žodį \"atnaujinti\""

#, machine, plain1
msgid "`permanent` - optional. Set to `true` if you are requesting indefinite access. Omit if not."
msgstr "`permanent` - neprivaloma. Nustatyti į `true`, jei pageidaujate neribotos prieigos. Jei ne, pamiršk."

#. keep the code between backticks exactly as it is
#, python-format
msgid "`posts`: up to %(num)s post ids. A post's id is the short code in its address: `/post/2k1/a-title` is `2k1`."
msgid_plural "`posts`: up to %(num)s post ids. A post's id is the short code in its address: `/post/2k1/a-title` is `2k1`."
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#, machine, plain1
msgid "`redirect_uri` - The redirect URI (or one of the URIs) specified in your application information. Must not use HTTP unless using localhost (use HTTPS instead)."
msgstr "`redirect_uri` - Nukreipimas URI (arba vienas iš URI), nurodytas jūsų paraiškos informacijoje. Negalima vartoti HTTP, išskyrus atvejus, kai naudojamas lokalhost (vietoje jo HTTPS)."

#, machine, plain1
msgid "`refresh_token` - the refresh token which you obtained during Step 3"
msgstr "`refresh_token` - atnaujinti žymą, kurį gavote 3 žingsnio metu"

#, machine, plain1
msgid "`scope` - A comma-separated list of permission scopes that you are requesting. Valid scopes are: `identity`, `create`, `read`, `update`, `delete`, `vote`, and `guildmaster`."
msgstr "`scope` - Jūsų prašomas bendras atskirtų leidimų sąrašas. Galioja: `identity`, `create`, `read`, `update`, `delete`, `vote` ir `guildmaster`."

#, machine, plain1
msgid "`state` - The state token from earlier."
msgstr "`state` - Valstybės ženklas nuo anksčiau."

#, machine, plain1
msgid "`state` - This is your own anti-cross-site-forgery token. We don't do anything with this, except give it to the user to pass back to you later. You are responsible for generating and validating the state token."
msgstr "`state` - Tai yra jūsų priešingybė. Mes nieko nedarome su šituo, išskyrus tai, kad suteiksime vartotojui, kad jis vėliau jums perduotų. Jūs esate atsakingi už valstybės rakto kūrimą ir patvirtinimą."

#, machine, plain1
msgid "a Redirect URI, or a comma-separated list of redirect URIs. May not use HTTP unless using localhost (use HTTPS instead)."
msgstr "a Redirect URI arba commased list of rediredirect URI. Negalima naudoti HTTP, išskyrus atvejus, kai naudojamas lokalhost (vietoj jo naudojamas HTTPS)."

#, machine, plain1
msgid "a brief description of what your application is intended to do"
msgstr "trumpas aprašymas, ką jūsų paraiška yra skirta daryti"

#, machine, plain1, python-format
msgid "a category or subcategory: %(examples)s (letters and numbers only)"
msgstr "kategorija arba pakategorė: %(examples)s (tik raidės ir skaičiai)"

#, machine, plain1
msgid "a name (3 to 25 letters, numbers or underscores), a profile picture, a banner and a bio, which say where its posts come from;"
msgstr "pavadinimas (nuo 3 iki 25 raidžių, skaičių ar pabraukimų), profilio vaizdas, vėliava ir biometanas, iš kurių galima spręsti, iš kur yra jų darbo vietos;"

