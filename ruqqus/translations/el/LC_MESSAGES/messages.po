msgid_plural "A word or phrase can be %(num)s characters at most: \"%(word)s...\""
msgstr[0] "Μια λέξη ή φράση μπορεί να είναι %(num)s χαρακτήρας το πολύ: \"%(word)s...\""
msgstr[1] "Μια λέξη ή φράση μπορεί να είναι %(num)s χαρακτήρες το πολύ: \"%(word)s...\""

