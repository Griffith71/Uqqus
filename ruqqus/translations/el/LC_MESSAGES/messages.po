msgid_plural "Tip (%(num)s coins tipped)"
msgstr[0] "Συμβουλή (%(num)s κέρμα φιλοδώρημα)"
msgstr[1] "Συμβουλή (%(num)s νομίσματα φιλοδώρημα)"

#, machine, plain1
msgid "Tip Successful!"
msgstr "Επιτυχής συμβουλή!"

#, machine, plain1, python-format
msgid "Tip, %(num)s coin tipped"
msgid_plural "Tip, %(num)s coins tipped"
msgstr[0] "Συμβουλή, %(num)s κέρμα φιλοδώρημα"
msgstr[1] "Συμβουλή, %(num)s νομίσματα"

#, glossary, machine, plain2
