msgstr "Ένα σήμα συνδρομητή δίπλα στο όνομά σας στο @%(name)sΤο προφίλ και οι δημοσιεύσεις, δείχνουν σε όποιον κι αν είσαι <a href=\"/settings/profile#lists\">\"Κύκλων που εγγραφείτε σε \"</a> Η ρύθμιση επιτρέπει"

#, machine, plain1
msgid "A Translate button shows under posts and comments in none of your languages. Nothing is translated unless you press it."
msgstr "Ένα κουμπί Translate εμφανίζει κάτω από τις δημοσιεύσεις και τα σχόλια σε καμία από τις γλώσσες σας. Τίποτα δεν μεταφράζεται αν δεν το πατήσετε."

#, machine, plain2, python-format
