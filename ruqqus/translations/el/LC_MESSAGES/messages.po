msgid "A reason is required."
msgstr "Απαιτείται ένας λόγος."

#, machine, plain1
msgid "A recorded call keeps the video too, on your own YouTube or Dailymotion; a call for circles keeps the sound only."
msgstr "Μια καταγεγραμμένη κλήση κρατά το βίντεο πάρα πολύ, για τη δική σας YouTube ή Dailymotion? μια κλήση για κύκλους κρατά μόνο τον ήχο."

#, machine, plain1, python-format
msgid "A role can have at most %(num)s person."
msgid_plural "A role can have at most %(num)s people."
msgstr[0] "Ένας ρόλος μπορεί να έχει το πολύ %(num)s άτομο."
msgstr[1] "Ένας ρόλος μπορεί να έχει το πολύ %(num)s άτομα."

#, machine, plain1, python-format
msgid "A role is a coloured name beside someone's messages in +%(guild)s's channels. It can let its people skip slow mode, remove or pin messages, and on each channel (under <a href=\"%(url)s\">Channels</a>) allow or deny reading and writing over the channel's own rules. Where one role allows and another denies, allowing wins. A role never lets someone into a channel of a guild they can't see, and never changes what a guildmaster can do. Up to %(max)s."
msgstr "Ένας ρόλος είναι ένα έγχρωμο όνομα δίπλα στα μηνύματα κάποιου σε +%(guild)sΤα κανάλια. Μπορεί να αφήσει τους ανθρώπους του να παραλείψουν αργή λειτουργία, να αφαιρέσουν ή να καρφιτσώσουν μηνύματα, και σε κάθε κανάλι (κάτω <a href=\"%(url)s\">Κανάλια</a>) επιτρέπουν ή αρνούνται την ανάγνωση και τη συγγραφή πάνω από τους κανόνες του καναλιού. Όπου ένας ρόλος επιτρέπει και ένας άλλος αρνείται, επιτρέποντας νίκες. Ένας ρόλος ποτέ δεν αφήνει κάποιον σε ένα κανάλι μιας συντεχνίας που δεν μπορούν να δουν, και ποτέ δεν αλλάζει τι μπορεί να κάνει ένας συντονιστής συντεχνίας. Μέχρι %(max)s."

#, machine, plain1, python-format
msgid "A role name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A role name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Ένα όνομα ρόλου μπορεί να είναι %(num)s χαρακτήρας (κινέζικα, ιαπωνικά και κορεατικά χαρακτήρες και emoji μετρούν ως 2)."
msgstr[1] "Ένα όνομα ρόλου μπορεί να είναι %(num)s χαρακτήρες (κινέζοι, Ιάπωνες και Κορεάτες χαρακτήρες και emoji μετρούν ως 2)."

#, machine, plain1, python-format
msgid "A role name can be at most %(num)s character."
msgid_plural "A role name can be at most %(num)s characters."
msgstr[0] "Ένα όνομα ρόλου μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Ένα όνομα ρόλου μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1
msgid "A role name can't contain < or >."
msgstr "Ένα όνομα ρόλου δεν μπορεί να περιέχει < ή >."

#, machine, plain1
