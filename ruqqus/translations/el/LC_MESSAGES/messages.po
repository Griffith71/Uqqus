#, machine, plain1, python-format
msgid "Your bot @%(name)s has been paused: %(reason)s"
msgstr "Το bot σας @ %(name)s έχει διακοπεί: %(reason)s"

#, machine, plain1, python-format
msgid "Your bot @%(name)s is running again."
msgstr "Το bot @%(name)s τρέχει πάλι."

#. %(fails)s is a number of failed tries in a row (at least 10); %(reason)s is
#. the last error, a sentence.
#, machine, plain1, python-format
msgid "Your bot @%(name)s stopped reading %(url)s after %(fails)s failed tries: %(reason)s Start it again from Settings > Bots once it works."
msgstr "Το bot σας @ %(name)s σταμάτησε να διαβάζει %(url)s μετά τις αποτυχημένες προσπάθειες %(fails)s: %(reason)s Εκκίνηση ξανά από τις Settings > Ο Μποτς μόλις δουλέψει."

#, machine, plain1, python-format
msgid "Your bot [@%(name)s](/@%(name)s) was approved. It starts posting within a few minutes. Manage it in [Settings > Bots](/settings/bots)."
msgstr "Το bot σας [@%(name)s](/@%(name)s) εγκρίθηκε. Αρχίζει να αναρτά μέσα σε λίγα λεπτά. Διαχείριση σε [Sυθμίσεις > Bots]( /settings/bots)."

#, machine, plain1
msgid "Your bots"
msgstr "Τα ρομπότ σου"

#, glossary, machine, plain2
msgid "Your channels"
msgstr "Τα κανάλια σας"

#, machine, plain1
msgid "Your chat apps"
msgstr "Οι εφαρμογές συνομιλίας σας"

#, machine, plain1
msgid "Your chat devices"
msgstr "Οι συσκευές συνομιλίας σας"

#, machine, plain1
msgid "Your chat devices can't be listed right now."
msgstr "Οι συσκευές συνομιλίας σας δεν μπορούν να καταχωρηθούν τώρα."

#, machine, plain2
msgid "Your chat encryption was started over. Messages from before can't be read on your devices unless a browser where you used chat brings them back. If this wasn't you, change your password in [Settings > Security](/settings/security)."
msgstr "Η κρυπτογράφηση συνομιλίας ξεκίνησε από την αρχή. Μηνύματα από πριν δεν μπορούν να διαβαστούν στις συσκευές σας εκτός εάν ένας περιηγητής όπου χρησιμοποιήσατε chat τους φέρει πίσω. Αν δεν ήσουν εσύ, άλλαξε τον κωδικό σου στο [Sυθμίσεις > Ασφάλεια](/settings/security)."

#, machine, plain1
msgid "Your chats and their keys have been removed from this browser."
msgstr "Οι συνομιλίες σας και τα κλειδιά τους έχουν αφαιρεθεί από αυτό το πρόγραμμα περιήγησης."

#, machine, plain1
msgid "Your chats are end-to-end encrypted, and the site can't read them. The key that opens them is kept locked: once with your password, and once with the recovery code you saved when chat was set up. If you forget your password, that code is the only way to read your old messages after a reset."
msgstr "Οι συζητήσεις σας είναι κρυπτογραφημένες και η ιστοσελίδα δεν μπορεί να τις διαβάσει. Το κλειδί που τα ανοίγει φυλάσσεται κλειδωμένο: μια φορά με τον κωδικό πρόσβασης σας, και μια φορά με τον κωδικό ανάκτησης που αποθηκεύσατε όταν δημιουργήθηκε η συνομιλία. Εάν ξεχάσετε τον κωδικό σας, αυτός ο κωδικός είναι ο μόνος τρόπος για να διαβάσετε τα παλιά σας μηνύματα μετά από μια επαναφορά."

#, machine, plain1, python-format
msgid "Your chats run on Matrix, an open standard, on %(site)s's own chat server. Besides Chat on this site, you can use them in a Matrix app such as Element (web, desktop and the classic phone apps), FluffyChat or Cinny. They stay end-to-end encrypted there too."
msgstr "Οι συνομιλίες σας τρέχουν στο Matrix, ένα ανοικτό πρότυπο, στο δικό του διακομιστή συνομιλίας %(site)s. Εκτός από Chat σε αυτό το site, μπορείτε να τα χρησιμοποιήσετε σε μια εφαρμογή Matrix όπως το Στοιχείο (web, desktop και οι κλασικές εφαρμογές τηλεφώνου), FluffyChat ή Cinny. Παραμένουν κρυπτογραφημένα εκεί."

#, machine, plain1
msgid "Your child accounts will be deleted with yours."
msgstr "Οι λογαριασμοί των παιδιών σας θα διαγραφούν με τους δικούς σας."

#, glossary, machine, plain2
msgid "Your circles"
msgstr "Οι κύκλοι σας"

#, machine, plain1, python-format
msgid "Your circles - %(site)s"
msgstr "Οι κύκλοι σας - %(site)s"

#, machine, plain1
msgid "Your commenting history will show here."
msgstr "Τα σχόλιά σας θα δείξουν εδώ."

#, machine, plain2
msgid "Your credit on this post is anonymous: other members see it as \"Anonymous #N\". Admins and the post's author can still see it is yours. This can't be undone."
msgstr "Η πίστωσή σας σε αυτή τη θέση είναι ανώνυμη: άλλα μέλη το βλέπουν ως \"Ανώνυμο #N\". Οι διοικητές και ο συγγραφέας της θέσης μπορούν ακόμα να δουν ότι είναι δικό σου. Αυτό δεν μπορεί να αναιρεθεί."

#, machine, plain1
msgid "Your curations"
msgstr "Η επιμέλεια σας feeds"

#, machine, plain1
msgid "Your custom filters have been updated"
msgstr "Τα προσαρμοσμένα φίλτρα σας έχουν ενημερωθεί"

#, machine, plain1
msgid "Your custom filters have been updated."
msgstr "Τα προσαρμοσμένα φίλτρα σας έχουν ενημερωθεί."

#, machine, plain1
msgid "Your database gnome took too long looking up your question. He's been.... dealt with."
msgstr "Ο νάνος της βάσης δεδομένων σου άργησε να ψάξει την ερώτησή σου. Έχει... κανονιστεί."

#, machine, plain1
msgid "Your display name has been removed."
msgstr "Το όνομα της οθόνης σας έχει αφαιρεθεί."

#, machine, plain1
msgid "Your display name has been updated."
msgstr "Το όνομα της οθόνης σας έχει ενημερωθεί."

#, machine, plain1
msgid "Your drafts and scheduled posts"
msgstr "Τα σχέδια και οι προγραμματισμένες θέσεις σας"

#, machine, plain1
msgid "Your email"
msgstr "Το email σας"

#, machine, plain1, python-format
msgid "Your email %(email)s has been verified. Thank you."
msgstr "Το email σας %(email)s έχει επαληθευτεί. Ευχαριστώ."

#, machine, plain1, python-format
msgid "Your feedback was marked fixed: \"%(excerpt)s\""
msgstr "Τα σχόλιά σας ήταν σταθερά: \"%(excerpt)s\""

#, machine, plain1, python-format
msgid "Your feedback was marked fixed: \"%(excerpt)s\". Our response: %(response)s"
msgstr "Τα σχόλιά σας ήταν σταθερά: \"%(excerpt)s\". Η απάντησή μας: %(response)s"

#, machine, plain1
msgid "Your followers"
msgstr "Οι ακόλουθοί σου"

#, machine, plain1
msgid "Your guilds"
msgstr "Οι συντεχνίες σας"

#, machine, plain1
msgid "Your inquiry has been saved."
msgstr "Η έρευνά σας έχει σωθεί."

#, machine, plain1
msgid "Your language"
msgstr "Η γλώσσα σου"

#. the English uses "sign-ins" for every number
#, machine, plain2, python-format
msgid "Your last %(num)s sign-ins. The place is only the country, worked out from the connection. Don't recognise one? Change your password: that signs out every other device."
msgid_plural "Your last %(num)s sign-ins. The place is only the country, worked out from the connection. Don't recognise one? Change your password: that signs out every other device."
msgstr[0] "Οι τελευταίες σας %(num)s εγγραφές. Το μέρος είναι μόνο η χώρα, επεξεργασμένο από τη σύνδεση. Δεν αναγνωρίζεις κανένα; Αλλάξτε τον κωδικό σας: που αποσυνδέει κάθε άλλη συσκευή."
msgstr[1] "Οι τελευταίες σας %(num)s εγγραφές. Το μέρος είναι μόνο η χώρα, επεξεργασμένο από τη σύνδεση. Δεν αναγνωρίζεις κανένα; Αλλάξτε τον κωδικό σας: που αποσυνδέει κάθε άλλη συσκευή."

#, machine, plain1
msgid "Your media storage is no longer connected."
msgstr "Η αποθήκευση των μέσων μαζικής ενημέρωσης δεν είναι πλέον συνδεδεμένη."

#, machine, plain1
msgid "Your media storage needs connecting again."
msgstr "Η αποθήκευσή σου στα ΜΜΕ χρειάζεται σύνδεση ξανά."

#, machine, plain1, python-format
msgid "Your membership of [+%(guild)s](/+%(guild)s) ended: you didn't have the %(coins)s coins it renews for. You can join again from its page."
msgstr "Η συμμετοχή σας στα [+ %(guild)s](/+%(guild)s έληξε: δεν είχατε τα κέρματα %(coins)s για τα οποία ανανεώνεται. Μπορείς να ξαναμπείς από τη σελίδα του."

#, machine, plain1
msgid "Your membership will renew again."
msgstr "Η συνδρομή σας θα ανανεωθεί ξανά."

#, machine, plain1
msgid "Your membership won't renew. You keep access until the day you paid to."
msgstr "Η συνδρομή σας δεν θα ανανεωθεί. Κρατάς πρόσβαση μέχρι την ημέρα που πλήρωσες."

#, machine, plain1
msgid "Your message includes a word this guild doesn't allow."
msgstr "Το μήνυμά σας περιλαμβάνει μια λέξη που αυτή η συντεχνία δεν επιτρέπει."

#, machine, plain1
msgid "Your new backup codes are below. The old ones no longer work."
msgstr "Οι νέοι εφεδρικοί κωδικοί είναι κάτω. Οι παλιοί δεν δουλεύουν πια."

#, machine, plain1
msgid "Your new custom RSS Feed Token has been generated."
msgstr "Το νέο σας έθιμο RSS Το Token έχει παραχθεί."

#, machine, plain1
msgid "Your new key. Copy it now: it is not shown again."
msgstr "Το νέο σου κλειδί. Αντιγραφή τώρα: δεν εμφανίζεται ξανά."

#, machine, plain1, python-format
msgid "Your original username will always stay reserved for you: <code>%(name)s</code>"
msgstr "Το αρχικό σας όνομα χρήστη θα παραμένει πάντα δεσμευμένο για εσάς: <code>%(name)s</code>"

#, machine, plain2
msgid "Your other devices have been signed out."
msgstr "Οι άλλες συσκευές σας έχουν αποσυνδεθεί."

#, machine, plain1
msgid "Your own circles"
msgstr "Οι κύκλοι σου"

#. %(who)s is the @handle of the account being added, filled in by the page
#, machine, plain1, python-format
msgid "Your own circles. %(who)s is not told."
msgstr "Τους δικούς σου κύκλους. %(who)s Δεν έχει ειπωθεί."

#, machine, plain1
msgid "Your own mix"
msgstr "Το δικό σου μείγμα"

#, python-format
msgid "Your own mix ranks the newest %(num)s matching post. 0 switches a part off, 10 makes it count the most."
msgid_plural "Your own mix ranks the newest %(num)s matching posts. 0 switches a part off, 10 makes it count the most."
msgstr[0] ""
msgstr[1] ""

#, machine, plain1
msgid "Your own password"
msgstr "Ο δικός σας κωδικός πρόσβασης"

#, machine, plain1
msgid "Your parent or guardian didn't agree to release your account."
msgstr "Ο γονιός σου ή ο κηδεμόνας σου δεν συμφώνησαν να αποδεσμεύσουν τον λογαριασμό σου."

#, machine, plain1
msgid "Your parent or guardian has been asked to release your account. Nothing changes until they answer."
msgstr "Ο γονιός ή κηδεμόνας σας έχει κληθεί να αποδεσμεύσει το λογαριασμό σας. Τίποτα δεν αλλάζει μέχρι να απαντήσουν."

#, machine, plain1
msgid "Your parent or guardian has turned this off for your account."
msgstr "Ο γονιός ή ο κηδεμόνας σου το έκλεισε για λογαριασμό σου."

#, machine, plain1
msgid "Your parent or guardian made this account for you. They can see what you do on the site (your posts, comments, votes, bookmarks, follows, guilds, who you chat with, that your account was reported and your recent sign-ins; the site never shows them what your chats say) and they choose which features are on. You can see which in [Settings > Content](/settings/content). They chose your password: change it in [Settings > Security](/settings/security) so that only you know it, because anyone who knows it can sign in as you and read your chats."
msgstr "Ο γονιός ή κηδεμόνας σου έκανε αυτό το λογαριασμό για σένα. Μπορούν να δουν τι κάνετε στο site (οι δημοσιεύσεις σας, τα σχόλια σας, οι ψήφοι, οι σελιδοδείκτες, ακολουθεί, οι συντεχνίες, με τους οποίους συνομιλείτε, ότι ο λογαριασμός σας αναφέρθηκε και οι πρόσφατες εγγραφές σας; η ιστοσελίδα δεν τους δείχνει ποτέ τι λένε οι συνομιλίες σας) και επιλέγουν ποια χαρακτηριστικά είναι on. Μπορείτε να δείτε ποια στο [Sυθμίσεις > Περιεχόμενο]( /settings/content). Επέλεξαν τον κωδικό σας: αλλάξτε τον σε [Sυθμίσεις > Ασφάλεια](/settings/security) έτσι ώστε μόνο εσείς τον ξέρετε, επειδή όποιος ξέρει μπορεί να υπογράψει ως εσάς και να διαβάσει τις συνομιλίες σας."

#, machine, plain2
msgid "Your parent or guardian set a new password for your account and you were signed out. Sign in with the new password, then change it in [Settings > Security](/settings/security) so that only you know it."
msgstr "Ο γονιός ή ο κηδεμόνας σου όρισε νέο κωδικό πρόσβασης για το λογαριασμό σου και αποσυνδέθηκες. Συνδεθείτε με το νέο κωδικό πρόσβασης, στη συνέχεια, αλλάξτε το σε [Sυθμίσεις > Ασφάλεια](/settings/security) έτσι ώστε μόνο εσείς το ξέρετε."

#, machine, plain1
msgid "Your parent or guardian stopped managing your account. It keeps the child lock until you confirm your age in Settings > Content. They chose your password: change it in [Settings > Security](/settings/security), or they can still sign in as you."
msgstr "Ο γονιός ή κηδεμόνας σου σταμάτησε να διαχειρίζεται το λογαριασμό σου. Κρατάει το παιδί κλειδωμένο μέχρι να επιβεβαιώσετε την ηλικία σας στις Settings > Περιεχόμενο. Επέλεξαν τον κωδικό σας: αλλάξτε τον σε [Sυθμίσεις > Ασφάλεια](/settings/security), ή μπορούν ακόμα να υπογράψουν ως εσάς."

#, machine, plain1
msgid "Your parent or guardian's account was suspended, so yours is suspended until theirs is back."
msgstr "Ο λογαριασμός του γονέα ή κηδεμόνα σας τέθηκε σε διαθεσιμότητα, οπότε ο δικός σας αναστέλλεται μέχρι να επιστρέψει ο δικός τους."

#, machine, plain1
msgid "Your password"
msgstr "Ο κωδικός πρόσβασης σας"

#, machine, plain2
msgid "Your password has been changed. Your other devices have been signed out."
msgstr "Ο κωδικός σου έχει αλλαχτεί. Οι άλλες συσκευές σας έχουν αποσυνδεθεί."

#, machine, plain1
msgid "Your password meets the requirements."
msgstr "Ο κωδικός σας πληροί τις απαιτήσεις."

#, machine, plain1
msgid "Your payouts"
msgstr "Οι πληρωμές σας"

#, machine, plain1
msgid "Your phone approved this. Only continue if this is your account."
msgstr "Το τηλέφωνό σου ενέκρινε αυτό. Συνεχίστε μόνο αν αυτός είναι ο λογαριασμός σας."

#, machine, plain1
msgid "Your phone said no, so nobody was signed in."
msgstr "Το τηλέφωνό σου είπε όχι, οπότε κανείς δεν υπέγραψε."

#, machine, plain1
msgid "Your post is listed on your profile either way. Choose My profile to have its comments there too, and add guilds to post it straight into them: each guild gets its own copy with its own votes and comments."
msgstr "Η θέση σας είναι καταχωρημένη στο προφίλ σας ούτως ή άλλως. Επιλογή Το προφίλ μου για να έχω εκεί τα σχόλιά του, και να προσθέσω συντεχνίες για να το αναρτήσω απευθείας σε αυτές: κάθε συντεχνία παίρνει το δικό της αντίγραφο με τις δικές της ψήφους και σχόλια."

#, machine, plain1
msgid "Your posting history will show here."
msgstr "Το ιστορικό σου θα δείξει εδώ."

#, machine, plain1
msgid "Your posts are kept out of All."
msgstr "Οι θέσεις σας κρατούνται έξω από όλους."

#, machine, plain1
msgid "Your posts can appear in All."
msgstr "Οι θέσεις σας μπορούν να εμφανιστούν σε όλα."

#, machine, plain1
msgid "Your posts from the last 28 days, with what each got (a post and its guild forwards added up). Only you can see this; these are counts, never names."
msgstr "Οι θέσεις σας από τις τελευταίες 28 ημέρες, με ό, τι πήρε ο καθένας (μια θέση και συντεχνία του προς τα εμπρός). Μόνο εσύ μπορείς να το δεις αυτό. Αυτά είναι αριθμοί, ποτέ ονόματα."

#, machine, plain1
msgid "Your posts stay on your profile and in the feeds of people who follow you, but All leaves them out. Copies you forward to a guild follow that guild's own setting, and anonymous posts always appear in All, so nobody can tell which ones are yours."
msgstr "Οι θέσεις σας παραμένουν στο προφίλ σας και στις ζωοτροφές των ανθρώπων που σας ακολουθούν, αλλά όλοι τους αφήνουν έξω. Αντίγραφα που προωθήσατε σε μια συντεχνία ακολουθούν αυτό το σκηνικό της συντεχνίας, και ανώνυμες θέσεις εμφανίζονται πάντα σε Όλα, έτσι κανείς δεν μπορεί να πει ποια είναι δικά σας."

#, machine, plain1
msgid "Your profile"
msgstr "Το προφίλ σας"

#, machine, plain1
msgid "Your profile details have been updated."
msgstr "Τα στοιχεία του προφίλ σας έχουν ενημερωθεί."

#, machine, plain1
msgid "Your purchase was successful. A receipt will be emailed to you from Paypal."
msgstr "Η αγορά σου ήταν επιτυχής. Μια απόδειξη θα σας αποσταλεί email από το Paypal."

#, machine, plain1
msgid "Your roles"
msgstr "Οι ρόλοι σας"

#. a notification. %(title)s is the post's title; %(reason)s says why, as a
#. sentence starting in lowercase.
#, machine, plain1, python-format
msgid ""
"Your scheduled post \"%(title)s\" could not be published: %(reason)s\n"
"\n"
"It is saved in your drafts, so you can fix it and post it or schedule it again."
msgstr ""
"Η προγραμματισμένη δημοσίευση σας \" %(title)s\" δεν μπόρεσε να δημοσιευθεί: %(reason)s\n"
"\n"
"Αποθηκεύεται στα προγράμματά σας, ώστε να μπορείτε να το διορθώσετε και να το δημοσιεύσετε ή να το προγραμματίσετε ξανά."

#. a notification about a post with no title. %(reason)s says why, as a
#. sentence starting in lowercase.
#, machine, plain1, python-format
msgid ""
"Your scheduled post \"Untitled\" could not be published: %(reason)s\n"
"\n"
"It is saved in your drafts, so you can fix it and post it or schedule it again."
msgstr ""
"Η προγραμματισμένη ανάρτηση \" Untitled\" δεν μπόρεσε να δημοσιευθεί: %(reason)s\n"
"\n"
"Αποθηκεύεται στα προγράμματά σας, ώστε να μπορείτε να το διορθώσετε και να το δημοσιεύσετε ή να το προγραμματίσετε ξανά."

#, machine, plain1
msgid "Your security key"
msgstr "Το κλειδί ασφαλείας σου"

#, machine, plain1
msgid "Your settings have been updated."
msgstr "Οι ρυθμίσεις σας έχουν ενημερωθεί."

#, python-format
msgid "Your shared draft couldn't be published: %(error)s [Open the draft](%(link)s)"
msgstr ""

#, machine, plain1
msgid "Your shared drafts"
msgstr "Τα κοινά σας σχέδια"

#, machine, plain1, python-format
msgid "Your siege failed. One of the guildmasters created or edited a comment in +%(guild)s within the last 60 days. You may try again in 7 days."
msgstr "Η αξίωση εξαγοράς σου απέτυχε. Ένας από τους συντονιστές συντεχνίας δημιούργησε ή επεξεργάστηκε ένα σχόλιο στο +%(guild)s μέσα στις τελευταίες 60 ημέρες. Μπορείτε να δοκιμάσετε ξανά σε 7 ημέρες."

#, machine, plain1, python-format
msgid "Your siege failed. One of the guildmasters had a post forwarded to +%(guild)s, or edited one there, within the last 60 days. You may try again in 7 days."
msgstr "Η αξίωση εξαγοράς σου απέτυχε. Ένας από τους συντονιστές συντεχνίας είχε μια θέση που διαβιβάστηκε στο + %(guild)s, ή επιμελήθηκε ένα εκεί, μέσα στις τελευταίες 60 ημέρες. Μπορείτε να δοκιμάσετε ξανά σε 7 ημέρες."

#, machine, plain1, python-format
msgid "Your siege failed. One of the guildmasters has performed a mod action in +%(guild)s within the last 60 days. You may try again in 7 days."
msgstr "Η αξίωση εξαγοράς σου απέτυχε. Ένας από τους συντονιστές συντεχνίας έχει εκτελέσει μια δράση συντονιστή σε + %(guild)s μέσα στις τελευταίες 60 ημέρες. Μπορείτε να δοκιμάσετε ξανά σε 7 ημέρες."

#, machine, plain1
msgid "Your story is up for 24 hours."
msgstr "Η ιστορία σου τελείωσε για 24 ώρες."

#. %(circle)s is the name of a paid circle someone subscribed to
#, machine, plain1, python-format
msgid "Your subscription to %(circle)s by [@%(name)s](/@%(name)s) ended: you didn't have the %(coins)s coins it renews for. You can subscribe again from their profile."
msgstr "Η συνδρομή σας στο %(circle)s κατά [@%(name)s](/@%(name)s έληξε: δεν είχατε τα κέρματα %(coins)s για τα οποία ανανεώνεται. Μπορείτε να εγγραφείτε ξανά από το προφίλ τους."

#, machine, plain1
msgid "Your subscription will renew again."
msgstr "Η συνδρομή σας θα ανανεωθεί ξανά."

#, machine, plain1
msgid "Your subscription won't renew. You keep access until the day you paid to."
msgstr "Η συνδρομή σου δεν θα ανανεωθεί. Κρατάς πρόσβαση μέχρι την ημέρα που πλήρωσες."

#, machine, plain1
msgid "Your subscriptions"
msgstr "Οι συνδρομές σας"

#, machine, plain2, python-format
msgid "Your suspension has ended. You can use %(site)s as you did before."
msgstr "Η αναστολή σου τελείωσε. Μπορείτε να χρησιμοποιήσετε το %(site)s όπως κάνατε πριν."

#, machine, plain1, python-format
msgid "Your title is the question. %(min)s to %(max)s options, one vote each. The poll can be voted from every forward and repost of this post."
msgstr "Ο τίτλος σου είναι το ερώτημα. %(min)s προς %(max)s επιλογές, μία ψήφος ο καθένας. Η δημοσκόπηση μπορεί να ψηφιστεί από κάθε προτροπή και αναδημοσίευση αυτής της θέσης."

#, machine, plain1, python-format
msgid "Your title is the question. Give %(min)s to %(max)s options. People can vote from every forward and repost of this post, once each."
msgstr "Ο τίτλος σου είναι το ερώτημα. Δώστε %(min)s στις επιλογές %(max)s. Οι άνθρωποι μπορούν να ψηφίσουν από κάθε πρόοδο και αναδημοσίευση αυτής της θέσης, μία φορά ο καθένας."

#, machine, plain2
msgid "Your two-factor code"
msgstr "Ο κωδικός σου για δύο συντελεστές"

#, machine, plain1
msgid "Your username is your unique <code>@handle</code>: the address of your profile, and what people mention and search for. Changing it costs 20 Coins and may be done once every 7 days. To change how your name reads without that, use your display name above."
msgstr "Το όνομα χρήστη είναι το μοναδικό σας <code>@handle</code>: η διεύθυνση του προφίλ σας, και τι οι άνθρωποι αναφέρουν και ψάχνουν. Η αλλαγή κοστίζει 20 νομίσματα και μπορεί να γίνει μία φορά κάθε 7 ημέρες. Για να αλλάξετε τον τρόπο με τον οποίο το όνομά σας διαβάζει χωρίς αυτό, χρησιμοποιήστε το όνομα εμφάνισης σας παραπάνω."

