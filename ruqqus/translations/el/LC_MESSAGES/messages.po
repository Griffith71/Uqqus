msgid "A bio can be %(count)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A bio can be %(count)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Ένα βιο μπορεί να είναι χαρακτήρας %(count)s (κινέζικα, ιαπωνικά και κορεατικά χαρακτήρες και emoji μετρούν ως 2)."
msgstr[1] "Ένα βιο μπορεί να είναι %(count)s χαρακτήρες (κινέζοι, Ιάπωνες και Κορεάτες χαρακτήρες και emoji μετρούν ως 2)."

#, machine, plain1, python-format
msgid "A bot can forward to at most %(num)s guild."
msgid_plural "A bot can forward to at most %(num)s guilds."
msgstr[0] "Ένα ρομπότ μπορεί να προωθήσει το πολύ %(num)s συντεχνία."
msgstr[1] "Ένα ρομπότ μπορεί να προωθήσει το πολύ %(num)s συντεχνίες."

#, machine, plain1, python-format
msgid "A bot can have at most %(num)s key. Revoke it first."
msgid_plural "A bot can have at most %(num)s keys. Revoke one first."
msgstr[0] "Ένα ρομπότ μπορεί να έχει το πολύ %(num)s κλειδί. Να το ξαναφτιάξουμε πρώτα."
msgstr[1] "Ένα ρομπότ μπορεί να έχει το πολύ %(num)s κλειδιά. Να ξαναφτιάξουμε ένα πρώτα."

#, machine, plain1, python-format
msgid "A bot can post at most %(num)s time a day."
msgid_plural "A bot can post at most %(num)s times a day."
msgstr[0] "Ένα ρομπότ μπορεί να δημοσιεύει το πολύ %(num)s φορά την ημέρα."
msgstr[1] "Ένα ρομπότ μπορεί να δημοσιεύει το πολύ %(num)s φορές την ημέρα."

#, machine, plain1, python-format
msgid "A bot can read at most %(num)s feed."
msgid_plural "A bot can read at most %(num)s feeds."
msgstr[0] "Ένα ρομπότ μπορεί να διαβάσει το πολύ %(num)s feed."
msgstr[1] "Ένα ρομπότ μπορεί να διαβάσει το πολύ %(num)s feeds."

#, machine, plain1
msgid "A bot can't post anonymously."
msgstr "Ένα ρομπότ δεν μπορεί να το δημοσιεύσει ανώνυμα."

#, machine, plain1
msgid "A bot can't read this site itself."
msgstr "Ένα ρομπότ δεν μπορεί να διαβάσει αυτό το site από μόνο του."

#, machine, plain1
msgid "A bot can't run bots."
msgstr "Ένα ρομπότ δεν μπορεί να διευθύνει ρομπότ."

#, machine, plain1
msgid "A bot gets keys once an admin has approved it."
msgstr "Ένα ρομπότ παίρνει κλειδιά μόλις το εγκρίνει ένας διαχειριστής."

#, machine, plain1
msgid "A bot is an account that posts by itself, approved by the site's admins."
msgstr "Ένα bot είναι ένας λογαριασμός που δημοσιεύει από μόνο του, εγκεκριμένος από τους διαχειριστές της ιστοσελίδας."

#, machine, plain1
msgid "A bot's name is 3 to 25 letters, numbers or underscores."
msgstr "Το όνομα ενός ρομπότ είναι 3 με 25 γράμματα, αριθμοί ή υποβρύχια."

#, machine, plain1
msgid "A bot's posts are public."
msgstr "Τα πόστα ενός ρομπότ είναι δημόσια."

#, machine, plain1
msgid "A bot's posts can't have co-authors."
msgstr "Οι αναρτήσεις ενός ρομπότ δεν μπορούν να έχουν συν-συγγραφείς."

#. %(listeners)s is the largest number of people listening
#, machine, plain1, python-format
msgid "A call has up to %(num)s person on stage and %(listeners)s listening, for at most 4 hours."
msgid_plural "A call has up to %(num)s people on stage and %(listeners)s listening, for at most 4 hours."
msgstr[0] "Μια κλήση έχει μέχρι %(num)s άτομο στη σκηνή και %(listeners)s Ακούω, το πολύ 4 ώρες."
msgstr[1] "Μια κλήση έχει μέχρι %(num)s άτομα στη σκηνή και %(listeners)s Ακούω, το πολύ 4 ώρες."

#, machine, plain1
msgid "A cancelled event can't be changed."
msgstr "Ένα ακυρωμένο γεγονός δεν μπορεί να αλλάξει."

#, machine, plain1
msgid "A category"
msgstr "Κατηγορία"

#, machine, plain1, python-format
msgid "A category name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A category name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Ένα όνομα κατηγορίας μπορεί να είναι %(num)s χαρακτήρας (κινεζικοί, ιαπωνικοί και κορεατικοί χαρακτήρες και emoji μετρούν ως 2)."
msgstr[1] "Ένα όνομα κατηγορίας μπορεί να είναι %(num)s χαρακτήρες (κινεζικοί, ιαπωνικοί και κορεατικοί χαρακτήρες και emoji μετρούν ως 2)."

#, machine, plain1, python-format
msgid "A category name can be at most %(num)s character."
msgid_plural "A category name can be at most %(num)s characters."
msgstr[0] "Ένα όνομα κατηγορίας μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Ένα όνομα κατηγορίας μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1
msgid "A category name can't contain < or >."
msgstr "Ένα όνομα κατηγορίας δεν μπορεί να περιέχει < ή >."

#, machine, plain1
msgid "A category name can't contain @: it would read as a handle."
msgstr "Ένα όνομα κατηγορίας δεν μπορεί να περιέχει @: θα μπορούσε να διαβαστεί ως λαβή."

#, machine, plain1
msgid "A category name can't contain control or invisible characters."
msgstr "Ένα όνομα κατηγορίας δεν μπορεί να περιέχει τον έλεγχο ή αόρατους χαρακτήρες."

#, machine, plain1
msgid "A channel"
msgstr "Κανάλι"

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s bot feeding it."
msgid_plural "A channel can have at most %(num)s bots feeding it."
msgstr[0] "Ένα κανάλι μπορεί να έχει το πολύ %(num)s bot τάισμα."
msgstr[1] "Ένα κανάλι μπορεί να έχει το πολύ %(num)s bots τροφοδοτώντας το."

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s helper."
msgid_plural "A channel can have at most %(num)s helpers."
msgstr[0] "Ένα κανάλι μπορεί να έχει το πολύ %(num)s βοηθό."
msgstr[1] "Ένα κανάλι μπορεί να έχει το πολύ %(num)s βοηθούς."

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s message a day."
msgid_plural "A channel can have at most %(num)s messages a day."
msgstr[0] "Ένα κανάλι μπορεί να έχει το πολύ %(num)s μήνυμα την ημέρα."
msgstr[1] "Ένα κανάλι μπορεί να έχει το πολύ %(num)s μηνύματα την ημέρα."

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s pinned message."
msgid_plural "A channel can have at most %(num)s pinned messages."
msgstr[0] "Ένα κανάλι μπορεί να έχει το πολύ %(num)s καρφωμένο μήνυμα."
msgstr[1] "Ένα κανάλι μπορεί να έχει το πολύ %(num)s καρφωμένα μηνύματα."

#, machine, plain1
msgid "A channel is one-to-many: its owner and helpers write, members read and react. A public channel is open to everyone and can be moderated; a channel for circles is end-to-end encrypted and only for the people in them."
msgstr "Ένα κανάλι είναι ένα προς ένα: ο ιδιοκτήτης και οι βοηθοί του γράφουν, τα μέλη διαβάζουν και αντιδρούν. Ένα δημόσιο κανάλι είναι ανοιχτό σε όλους και μπορεί να μετριαστεί· ένα κανάλι για κύκλους είναι κρυπτογραφημένο από άκρη σε άκρη και μόνο για τους ανθρώπους σε αυτούς."

#, machine, plain1, python-format
msgid "A channel name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A channel name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Ένα όνομα καναλιού μπορεί να είναι %(num)s χαρακτήρας (κινέζικα, ιαπωνικά και κορεατικά χαρακτήρες και emoji μετρούν ως 2)."
msgstr[1] "Ένα όνομα καναλιού μπορεί να είναι %(num)s χαρακτήρες (κινέζικα, ιαπωνικά και κορεατικά χαρακτήρες και emoji μετρούν ως 2)."

#, machine, plain1, python-format
msgid "A channel name can be at most %(num)s character."
msgid_plural "A channel name can be at most %(num)s characters."
msgstr[0] "Ένα όνομα καναλιού μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Ένα όνομα καναλιού μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1
msgid "A channel name can't contain < or >."
msgstr "Ένα όνομα καναλιού δεν μπορεί να περιέχει < ή >."

#, machine, plain1
msgid "A channel name can't contain @: it would read as a handle."
msgstr "Ένα όνομα καναλιού δεν μπορεί να περιέχει το @: θα μπορούσε να διαβαστεί ως λαβή."

#, machine, plain1
msgid "A channel name can't contain control or invisible characters."
msgstr "Ένα όνομα καναλιού δεν μπορεί να περιέχει έλεγχο ή αόρατους χαρακτήρες."

#, machine, plain1, python-format
msgid "A chat app wants to sign in to your chats as <strong>@%(name)s</strong>."
msgstr "Μια εφαρμογή συνομιλίας θέλει να υπογράψει στις συνομιλίες σας ως <strong>@%(name)s</strong>."

#, machine, plain1, python-format
msgid "A chat app was signed in to your %(site)s account. If that wasn't you, sign it out in [Settings > Chat apps](/settings/chat_apps) and change your password."
msgstr "Μια εφαρμογή συνομιλίας υπογράφηκε στο λογαριασμό σας %(site)s. Αν δεν ήσουν εσύ, υπέγραψε το στο [Sυθμίσεις > apps συνομιλίας](/settings/chat_apps) και άλλαξε τον κωδικό σου."

#, machine, plain2, python-format
msgid "A chat can have at most %(num)s pinned messages. Unpin one first."
msgstr "Μια συνομιλία μπορεί να έχει το πολύ %(num)s καρφωμένα μηνύματα. Ξεκούμπωσε πρώτα ένα."

#, machine, plain1, python-format
msgid "A circle can have %(num)s person at most."
msgid_plural "A circle can have %(num)s people at most."
msgstr[0] "Ένας κύκλος μπορεί να έχει %(num)s άτομο το πολύ."
msgstr[1] "Ένας κύκλος μπορεί να έχει %(num)s άτομα το πολύ."

#. %(label)s is the label people see on such a post, "Shared with a circle"
#, machine, plain1, python-format
msgid "A circle of your own. The people in it are not told, and nothing they see names it: your posts for it show as \"%(label)s\"."
msgstr "Ένας δικός σου κύκλος. Οι άνθρωποι σε αυτό δεν λέγεται, και τίποτα δεν βλέπουν το όνομα: οι θέσεις σας για αυτό δείχνουν ως \"%(label)s\"."

#, machine, plain1, python-format
msgid "A circle's name can be %(num)s character at most."
msgid_plural "A circle's name can be %(num)s characters at most."
msgstr[0] "Το όνομα ενός κύκλου μπορεί να είναι ένας χαρακτήρας το πολύ."
msgstr[1] "Το όνομα ενός κύκλου μπορεί να είναι %(num)s χαρακτήρες το πολύ."

#, machine, plain2
msgid "A comment"
msgstr "Ένα σχόλιο"

#, machine, plain2
msgid "A comment by an account you blocked or that blocked you."
msgstr "Ένα σχόλιο από ένα λογαριασμό που μπλοκάρισες ή που σε εμπόδισε."

#, machine, plain2
msgid "A comment hidden by a guildmaster."
msgstr "Ένα σχόλιο κρυμμένο από έναν συντονιστή συντεχνίας."

#, machine, plain2
msgid "A comment hidden by your word filter."
msgstr "Ένα σχόλιο κρυμμένο από το φίλτρο λέξης σας."

#, machine, plain2
msgid "A comment its author deleted. What it said isn't shown here."
msgstr "Ένα σχόλιο του συγγραφέα του διαγράφηκε. Αυτό που είπε δεν φαίνεται εδώ."

#, machine, plain1
msgid "A comment on a post for a Circle can't be forwarded to a guild."
msgstr "Ένα σχόλιο για μια θέση για έναν Κύκλο δεν μπορεί να διαβιβαστεί σε μια συντεχνία."

#, machine, plain1
msgid "A comment on a post for a Circle can't be reposted."
msgstr "Ένα σχόλιο για μια θέση για έναν Κύκλο δεν μπορεί να αναδημοσιευτεί."

#, machine, plain2
msgid "A comment removed by the site's admins."
msgstr "Ένα σχόλιο που αφαιρέθηκε από τους διαχειριστές του site."

#, machine, plain1, python-format
msgid "A community note was added to a comment you asked about: [view it](%(link)s)"
msgstr "Ένα σημείωμα της κοινότητας προστέθηκε σε ένα σχόλιο που ρωτήσατε: [δείτε]( %(link)s)"

#, machine, plain1, python-format
msgid "A community note was added to a post you asked about: [view it](%(link)s)"
msgstr "Ένα σημείωμα της κοινότητας προστέθηκε σε μια ανάρτηση που ρωτήσατε: [δείτε]( %(link)s)"

#, machine, plain2
msgid "A copy of this as it was when it was hidden, removed, deleted or relied on for a decision. Only its author, the guildmasters of the guild that decided and the site's administrators can open it here. Most copies are cleared after a while; the copy of something its author deleted stays in the public Log."
msgstr "Ένα αντίγραφο αυτού όπως ήταν όταν ήταν κρυμμένο, αφαιρέθηκε, διαγράφηκε ή στηρίχθηκε σε μια απόφαση. Μόνο ο συγγραφέας της, οι συντονιστές της συντεχνίας που αποφάσισαν και οι διαχειριστές της ιστοσελίδας μπορούν να την ανοίξουν εδώ. Τα περισσότερα αντίγραφα καθαρίζονται μετά από λίγο· το αντίγραφο κάτι που ο συγγραφέας του διέγραψε παραμένει στο δημόσιο ημερολόγιο."

#, machine, plain1
msgid "A curation of the whole site needs an age limit of a month or less."
msgstr "Μια επιμελημένη τροφοδοσία ολόκληρης της ιστοσελίδας χρειάζεται όριο ηλικίας ενός μήνα ή λιγότερο."

#, machine, plain1
msgid "A day"
msgstr "Μια μέρα"

#, machine, plain2
msgid "A decision in the Log"
msgstr "Απόφαση στο Ημερολόγιο"

#, machine, plain2
msgid "A deleted post and what was said under it"
msgstr "Μια διαγραμμένη θέση και ό,τι ειπώθηκε κάτω από αυτήν"

#, machine, plain1, python-format
msgid "A description can be %(num)s character at most."
msgid_plural "A description can be %(num)s characters at most."
msgstr[0] "Μια περιγραφή μπορεί να είναι %(num)s χαρακτήρας το πολύ."
msgstr[1] "Μια περιγραφή μπορεί να είναι %(num)s χαρακτήρες το πολύ."

#, machine, plain1, python-format
msgid "A description is at most %(num)s character."
msgid_plural "A description is at most %(num)s characters."
msgstr[0] "Μια περιγραφή είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Μια περιγραφή είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain2
msgid "A different admin has to confirm a reveal."
msgstr "Ένας άλλος διαχειριστής πρέπει να επιβεβαιώσει μια αποκάλυψη."

#, machine, plain1, python-format
msgid "A display name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A display name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Ένα όνομα εμφάνισης μπορεί να είναι %(num)s χαρακτήρας (κινέζικα, ιαπωνικά και κορεατικά χαρακτήρες και emoji μετρούν ως 2)."
msgstr[1] "Ένα όνομα οθόνης μπορεί να είναι %(num)s χαρακτήρες (κινεζικοί, ιαπωνικοί και κορεατικοί χαρακτήρες και emoji μετρούν ως 2)."

#, machine, plain1
msgid "A display name can't contain < or >."
msgstr "Ένα όνομα εμφάνισης δεν μπορεί να περιέχει < ή >."

#, machine, plain1
msgid "A display name can't contain @: it would read as a handle."
msgstr "Ένα όνομα εμφάνισης δεν μπορεί να περιέχει το @: θα μπορούσε να διαβαστεί ως λαβή."

#, machine, plain1
msgid "A display name can't contain control or invisible characters."
msgstr "Ένα όνομα εμφάνισης δεν μπορεί να περιέχει χαρακτήρες ελέγχου ή αόρατους."

#, machine, plain1
msgid "A feed added now waits for an admin before it is read."
msgstr "Μια τροφή που προστίθεται τώρα περιμένει έναν διαχειριστή πριν διαβαστεί."

#, machine, plain1
msgid "A feed an admin adds is approved at once."
msgstr "Μια τροφή που ένας διαχειριστής προσθέτει εγκρίνεται αμέσως."

#, machine, plain1
msgid "A feed server address cannot hold a user name or password."
msgstr "Μια διεύθυνση διακομιστή τροφοδοσίας δεν μπορεί να περιέχει όνομα χρήστη ή κωδικό πρόσβασης."

#, machine, plain1
msgid "A feed server address must start with https://"
msgstr "Μια διεύθυνση διακομιστή τροφοδοσίας πρέπει να ξεκινήσει με το https://"

#, machine, plain1
msgid "A feed server must use the usual https port."
msgstr "Ένας διακομιστής τροφοδοσίας πρέπει να χρησιμοποιεί τη συνήθη θύρα https."

#, machine, plain1
msgid "A feed server needs a public server name, like feeds.example.org"
msgstr "Ένας διακομιστής τροφοδοσίας χρειάζεται ένα όνομα δημόσιου εξυπηρετητή, όπως feeds.example.org"

#, machine, plain1
msgid "A feed's address can't hold a user name or password."
msgstr "Η διεύθυνση μιας τροφοδοσίας δεν μπορεί να περιέχει όνομα χρήστη ή κωδικό πρόσβασης."

#, machine, plain1
msgid "A feed's address must start with https://"
msgstr "Η διεύθυνση μιας τροφοδοσίας πρέπει να ξεκινά από το https://"

#, machine, plain1
msgid "A few words (optional)"
msgstr "Λίγα λόγια (προαιρετικά)"

#, machine, plain1, python-format
msgid "A flair can be at most %(num)s character."
msgid_plural "A flair can be at most %(num)s characters."
msgstr[0] "Μια ετικέτα μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Μια ετικέτα μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1, python-brace-format
msgid "A flair is plain text: no < > { } [ ] ` or \\."
msgstr "Μια ετικέτα είναι απλό κείμενο: όχι < > { {} [ ] ` ή \\."

#, machine, plain1, python-format
msgid "A folder name can be %(num)s character at most."
msgid_plural "A folder name can be %(num)s characters at most."
msgstr[0] "Ένα όνομα φακέλου μπορεί να είναι %(num)s χαρακτήρας το πολύ."
msgstr[1] "Ένα όνομα φακέλου μπορεί να είναι %(num)s χαρακτήρες το πολύ."

#, machine, plain1
msgid "A folder name can't hold control characters."
msgstr "Ένα όνομα φακέλου δεν μπορεί να κρατήσει χαρακτήρες ελέγχου."

#, machine, plain1, python-format
msgid "A group can have at most %(num)s person."
msgid_plural "A group can have at most %(num)s people."
msgstr[0] "Μια ομάδα μπορεί να έχει το πολύ %(num)s άτομο."
msgstr[1] "Μια ομάδα μπορεί να έχει το πολύ %(num)s άτομα."

#, machine, plain1, python-format
msgid "A group name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A group name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Ένα ομαδικό όνομα μπορεί να είναι %(num)s χαρακτήρας (κινέζικα, ιαπωνικά και κορεατικά χαρακτήρες και emoji μετρούν ως 2)."
msgstr[1] "Ένα ομαδικό όνομα μπορεί να είναι %(num)s χαρακτήρες (κινεζικοί, ιαπωνικοί και κορεατικοί χαρακτήρες και emoji μετρούν ως 2)."

#, machine, plain1, python-format
msgid "A group name can be at most %(num)s character."
msgid_plural "A group name can be at most %(num)s characters."
msgstr[0] "Ένα όνομα ομάδας μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Ένα όνομα ομάδας μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1
msgid "A group name can't contain < or >."
msgstr "Ένα όνομα ομάδας δεν μπορεί να περιέχει < ή >."

#, machine, plain1
msgid "A group name can't contain @: it would read as a handle."
msgstr "Ένα όνομα ομάδας δεν μπορεί να περιέχει @: θα μπορούσε να διαβαστεί ως λαβή."

#, machine, plain1
msgid "A group name can't contain control or invisible characters."
msgstr "Ένα όνομα ομάδας δεν μπορεί να περιέχει τον έλεγχο ή αόρατους χαρακτήρες."

#, machine, plain2
msgid "A guild ban needs a public reason, so the guild's page and the Log can say why."
msgstr "Μια απαγόρευση συντεχνίας χρειάζεται έναν δημόσιο λόγο, έτσι ώστε η σελίδα της συντεχνίας και το ημερολόγιο να μπορούν να πουν γιατί."

#, machine, plain1, python-format
msgid "A guild can have at most %(num)s category."
msgid_plural "A guild can have at most %(num)s categories."
msgstr[0] "Μια συντεχνία μπορεί να έχει το πολύ %(num)s κατηγορία."
msgstr[1] "Μια συντεχνία μπορεί να έχει το πολύ %(num)s κατηγορίες."

#, machine, plain1, python-format
msgid "A guild can have at most %(num)s channel."
msgid_plural "A guild can have at most %(num)s channels."
msgstr[0] "Μια συντεχνία μπορεί να έχει το πολύ %(num)s κανάλι."
msgstr[1] "Μια συντεχνία μπορεί να έχει το πολύ %(num)s κανάλια."

#, machine, plain1, python-format
msgid "A guild can have at most %(num)s flair."
