msgid_plural "Only links to: %(num)s sites at most."
msgstr[0] "Μόνο συνδέσεις με: %(num)s site το πολύ."
msgstr[1] "Μόνο συνδέσεις με: %(num)s τοποθεσίες το πολύ."

#, machine, plain1
msgid "Only me"
msgstr "Μόνο εγώ"

#, machine, plain1, python-format
msgid "Only members of +%(guild)s can post in it."
msgstr "Μόνο μέλη του + %(guild)s μπορούν να το δημοσιεύσουν."

#, machine, plain1
msgid "Only people on stage can turn their camera on."
msgstr "Μόνο οι άνθρωποι στη σκηνή μπορούν να ανοίξουν την κάμερα τους."

#, machine, plain1
msgid "Only people you follow who follow you back are listed. Downvotes are never shown."
msgstr "Μόνο οι άνθρωποι που ακολουθείς που σε ακολουθούν είναι καταχωρημένοι. Οι καταψηφίσεις δεν εμφανίζονται ποτέ."

#, machine, plain1, python-format
msgid "Only posts that mention %(words)s."
msgstr "Μόνο δημοσιεύσεις που αναφέρουν %(words)s."

#, machine, plain1, python-format
msgid "Only posts that mention all of %(words)s."
msgstr "Μόνο δημοσιεύσεις που αναφέρουν όλα τα %(words)s."

#, machine, plain1
msgid "Only public posts and comments count: not Circle posts or posts in private guilds, and not anything removed or deleted."
msgstr "Μόνο δημόσιες δημοσιεύσεις και σχόλια μετρούν: όχι Circle posts ή posts σε ιδιωτικές συντεχνίες, και δεν έχει αφαιρεθεί ή διαγραφεί τίποτα."

#, machine, plain1
msgid "Only someone in the call can be invited to speak."
msgstr "Μόνο κάποιος στο τηλεφώνημα μπορεί να προσκληθεί να μιλήσει."

#, machine, plain1
msgid "Only the author can see who upvoted."
msgstr "Μόνο ο συγγραφέας μπορεί να δει ποιος ψήφισε."

#, machine, plain1
msgid "Only the author can share this post"
msgstr "Μόνο ο συγγραφέας μπορεί να μοιραστεί αυτή τη δημοσίευση"

#, machine, plain1
msgid "Only the author can share this: it isn't public."
msgstr "Μόνο ο συγγραφέας μπορεί να μοιραστεί αυτό: δεν είναι δημόσιο."

#, machine, plain1
msgid "Only the automation and its feeds go. Your account and its posts stay."
msgstr "Μόνο ο αυτοματισμός και οι ζωοτροφές του φεύγουν. Ο λογαριασμός σας και οι θέσεις του παραμένουν."

#, machine, plain1
msgid "Only the channel's owner and helpers write in it."
msgstr "Μόνο ο ιδιοκτήτης και οι βοηθοί του καναλιού γράφουν σε αυτό."

#, machine, plain1
msgid "Only the channel's owner chooses its helpers."
msgstr "Μόνο ο ιδιοκτήτης του καναλιού επιλέγει τους βοηθούς του."

#, glossary, machine, plain2
msgid "Only the circles you pick"
msgstr "Μόνο οι κύκλοι που επιλέγετε"

#, machine, plain1
msgid "Only the founder sets the price."
msgstr "Μόνο ο ιδρυτής καθορίζει την τιμή."

#, machine, plain1
msgid "Only the group's owner and admins can add people."
msgstr "Μόνο ο ιδιοκτήτης και οι διαχειριστές της ομάδας μπορούν να προσθέσουν ανθρώπους."

#, machine, plain1
msgid "Only the group's owner and admins can remove people."
msgstr "Μόνο ο ιδιοκτήτης και οι διαχειριστές της ομάδας μπορούν να απομακρύνουν τους ανθρώπους."

#, machine, plain1
msgid "Only the group's owner and admins can rename it."
msgstr "Μόνο ο ιδιοκτήτης και οι διαχειριστές της ομάδας μπορούν να το μετονομάσουν."

#, machine, plain1
msgid "Only the guild name capitalization can be changed."
msgstr "Μόνο το όνομα της συντεχνίας μπορεί να αλλάξει."

#, machine, plain1
msgid "Only the guild's founder can set the price."
msgstr "Μόνο ο ιδρυτής της συντεχνίας μπορεί να ορίσει την τιμή."

#, machine, plain1
msgid "Only the guild's guildmasters and approved members can edit this page."
msgstr "Μόνο οι συντονιστές συντεχνίας και τα εγκεκριμένα μέλη μπορούν να επεξεργαστούν αυτή τη σελίδα."

#, machine, plain1
msgid "Only the guild's guildmasters can edit this page."
msgstr "Μόνο οι συντονιστές της συντεχνίας μπορούν να επεξεργαστούν αυτή τη σελίδα."

#, machine, plain1
msgid "Only the guild's guildmasters can make new pages."
msgstr "Μόνο οι συντονιστές της συντεχνίας μπορούν να φτιάξουν νέες σελίδες."

#, machine, plain1
msgid "Only the guild's guildmasters write in this channel."
msgstr "Μόνο οι συντονιστές της συντεχνίας γράφουν σε αυτό το κανάλι."

#, machine, plain1
msgid "Only the host and co-hosts can edit the summary."
msgstr "Μόνο ο οικοδεσπότης και οι συμπαρουσιαστές μπορούν να επεξεργαστούν την περίληψη."

#, machine, plain1
msgid "Only the host and co-hosts can invite people to speak."
msgstr "Μόνο ο οικοδεσπότης και οι συμπαρουσιαστές μπορούν να καλέσουν κόσμο να μιλήσει."

#, machine, plain1
msgid "Only the host and co-hosts can move people off the stage."
msgstr "Μόνο ο οικοδεσπότης και οι συμπαρουσιαστές μπορούν να διώξουν τους ανθρώπους από τη σκηνή."

#, machine, plain1
msgid "Only the host and co-hosts can mute speakers."
msgstr "Μόνο οι οικοδεσπότες και οι συμπαρουσιαστές μπορούν να μουγγούν τα ηχεία."

#, machine, plain1
msgid "Only the host and co-hosts can post updates."
msgstr "Μόνο ο οικοδεσπότης και οι συμπαρουσιαστές μπορούν να δημοσιεύσουν ενημερώσεις."

#, machine, plain1
msgid "Only the host and co-hosts can remove messages."
msgstr "Μόνο ο οικοδεσπότης και οι συμπαρουσιαστές μπορούν να αφαιρέσουν μηνύματα."

#, machine, plain1
msgid "Only the host and co-hosts can remove people."
msgstr "Μόνο ο οικοδεσπότης και οι συμπαρουσιαστές μπορούν να απομακρύνουν τους ανθρώπους."

#, machine, plain1
msgid "Only the host and co-hosts can set slow mode."
msgstr "Μόνο ο οικοδεσπότης και οι συμπαρουσιαστές μπορούν να ορίσουν αργή λειτουργία."

#, machine, plain1
msgid "Only the host can choose co-hosts."
msgstr "Μόνο ο οικοδεσπότης μπορεί να επιλέξει συμπαρουσιαστές."

#, machine, plain1
msgid "Only the host can end this Space."
msgstr "Μόνο ο ξενιστής μπορεί να τελειώσει αυτό το Διάστημα."

#, machine, plain1
msgid "Only the host can remove a co-host."
msgstr "Μόνο ο ξενιστής μπορεί να αφαιρέσει έναν συμπαρουσιαστή."

#, machine, plain1
msgid "Only the host can start this Space."
msgstr "Μόνο ο ξενιστής μπορεί να ξεκινήσει αυτό το Διάστημα."

#, machine, plain1
msgid "Only the numbers are shown: nobody sees who answered. You'll get a reminder an hour before."
msgstr "Μόνο οι αριθμοί εμφανίζονται: κανείς δεν βλέπει ποιος απάντησε. Θα πάρεις μια υπενθύμιση μια ώρα πριν."

#, machine, plain1
msgid "Only the owner can choose the admins."
msgstr "Μόνο ο ιδιοκτήτης μπορεί να επιλέξει τους διαχειριστές."

#, machine, plain1
msgid "Only the owner can remove an admin."
msgstr "Μόνο ο ιδιοκτήτης μπορεί να αφαιρέσει έναν διαχειριστή."

#, machine, plain1
msgid "Only the people in them see it, and nobody is told which of your circles they are in. It can't be anonymous, forwarded, reposted or co-authored, and it stays off All, search and trending."
msgstr "Μόνο οι άνθρωποι μέσα τους το βλέπουν, και κανείς δεν λέγεται σε ποιον από τους κύκλους σου βρίσκονται. Δεν μπορεί να είναι ανώνυμο, να προωθείται, να αναδημοσιεύεται ή να συν-συγγραφεί, και μένει μακριά από όλα, αναζήτηση και τάση."

#, machine, plain1
msgid "Only the post's author and co-authors can edit the summary."
msgstr "Μόνο ο συγγραφέας και οι συν-συγγραφείς της δημοσίευσης μπορούν να επεξεργαστούν την περίληψη."

#, machine, plain1
msgid "Only the post's author and co-authors can end its live updates."
msgstr "Μόνο ο συγγραφέας και οι συν-συγγραφείς της ανάρτησης μπορούν να τερματίσουν τις ζωντανές ενημερώσεις της."

#, machine, plain1
msgid "Only the post's author and co-authors can extend its live updates."
msgstr "Μόνο ο συγγραφέας και οι συν-συγγραφείς της ανάρτησης μπορούν να επεκτείνουν τις ζωντανές ενημερώσεις της."

#, machine, plain1
msgid "Only the post's author and co-authors can post updates."
msgstr "Μόνο ο συγγραφέας και οι συν-συγγραφείς της ανάρτησης μπορούν να δημοσιεύσουν ενημερώσεις."

#, machine, plain1
msgid "Only the post's author and co-authors can run its live updates."
msgstr "Μόνο ο συγγραφέας και οι συν-συγγραφείς της ανάρτησης μπορούν να εκτελέσουν τις ζωντανές ενημερώσεις της."

#, machine, plain1
msgid "Only used to check their age. It isn't kept."
msgstr "Έλεγχα μόνο την ηλικία τους. Δεν κρατιέται."

#, machine, plain1
msgid "Only when I turn them on"
msgstr "Μόνο όταν τα ανάψω"

#, machine, plain1
msgid "Only whoever forwarded this post and the guild's guildmasters can change its flair."
msgstr "Μόνο όποιος προώθησε αυτό το πόστο και οι συντονιστές της συντεχνίας μπορούν να αλλάξουν την ετικέτα του."

#, machine, plain1
msgid "Only you"
msgstr "Μόνο εσύ"

#, machine, plain1
msgid "Only you can see this. These are counts: nobody who looked, voted or answered a poll is named."
msgstr "Μόνο εσύ μπορείς να δεις αυτό. Αυτές είναι οι κατηγορίες: κανείς που κοίταξε, ψήφισε ή απάντησε σε μια δημοσκόπηση δεν ονομάζεται."

#, machine, plain2
msgid "Only your credit changes: the other authors stay named. Admins and the post's author can still see it is you."
msgstr "Μόνο οι πιστωτικές σας αλλαγές: οι άλλοι συγγραφείς παραμένουν όνομα. Οι διοικητές και ο συγγραφέας της θέσης μπορούν ακόμα να δουν ότι είσαι εσύ."

#, machine, plain1
