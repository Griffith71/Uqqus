msgid "A key works through one of your apps (<a href=\"%(url)s\">Settings &gt; Apps</a>) and may post, edit and delete the bot's posts, never vote or comment."
msgstr "Ένα κλειδί λειτουργεί μέσω μιας από τις εφαρμογές σας (<a href=\"%(url)s\">Settings &gt; Εφαρμογές</a>) και μπορεί να δημοσιεύσει, να επεξεργαστεί και να διαγράψει τις θέσεις του bot, ποτέ να ψηφίσει ή να σχολιάσει."

#, machine, plain1, python-format
msgid "A label can be at most %(num)s character."
