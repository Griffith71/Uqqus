msgid "The base URL is <code>%(url)s</code>"
msgstr "Η βάση URL λέ <code>%(url)s</code>"

#, machine, plain1
msgid "The board is open while the Space is live."
msgstr "Ο πίνακας είναι ανοιχτός όσο ο χώρος είναι ζωντανός."

#, machine, plain1, python-format
msgid "The body can be at most %(num)s character."
msgid_plural "The body can be at most %(num)s characters."
msgstr[0] "Το σώμα μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Το σώμα μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved."
msgstr "Το bot @%(name)s που πρότεινες δεν εγκρίθηκε."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved. The admins said: %(note)s"
msgstr "Το bot @%(name)s που πρότεινες δεν εγκρίθηκε. Οι διαχειριστές είπαν: %(note)s"

#, machine, plain1
msgid "The bot already reads that feed."
msgstr "Το ρομπότ το διαβάζει ήδη."

#, machine, plain1, python-format
msgid "The bot you proposed, [@%(name)s](/@%(name)s), was approved. It is run by the site from now on and starts posting from its feeds within a few minutes. Thank you!"
msgstr "Το bot που πρότεινες, [@%(name)s](/@%(name)s), εγκρίθηκε. Διοικείται από το site από εδώ και στο εξής και αρχίζει να δημοσιεύει από τις ζωοτροφές του μέσα σε λίγα λεπτά. Ευχαριστώ!"

#, machine, plain1
msgid "The bot's account no longer exists."
msgstr "Ο λογαριασμός του ρομπότ δεν υπάρχει πια."

#, machine, plain1
msgid "The bot's owner can't run it right now."
msgstr "Ο ιδιοκτήτης του ρομπότ δεν μπορεί να το ελέγξει τώρα."

#, machine, plain1, python-format
msgid "The category %(category)s was deleted; its channels stay."
msgstr "Η κατηγορία %(category)s διαγράφηκε· τα κανάλια της παραμένουν."

#, machine, plain1, python-format
msgid "The category %(category)s was made."
msgstr "Έγινε η κατηγορία %(category)s."

#, machine, plain1, python-format
msgid "The category was renamed %(category)s."
msgstr "Η κατηγορία μετονομάστηκε σε %(category)s."

#, machine, plain1, python-format
msgid "The coins go to the founder, <a href=\"%(url)s\">@%(name)s</a>."
msgstr "Τα νομίσματα πάνε στον ιδρυτή, <a href=\"%(url)s\">@%(name)s</a>."

#, machine, plain1
msgid "The coins you earn from tips, paid circles and the creator fund, for the last 30 days and all time."
msgstr "Τα νομίσματα που κερδίζετε από συμβουλές, πληρωμένους κύκλους και το ταμείο δημιουργών, για τις τελευταίες 30 ημέρες και όλη την ώρα."

#, machine, plain2
msgid "The comment stays where it is, with your name taken off it. Everyone who saw it with your name still knows it was you."
msgstr "Το σχόλιο μένει εκεί που είναι, με το όνομά σου να το βγάζει. Όλοι όσοι το είδαν με το όνομά σου ξέρουν ότι ήσουν εσύ."

#, machine, plain1, python-format
msgid "The copy other people forwarded to guilds will stay there."
msgid_plural "The %(num)s copies other people forwarded to guilds will stay there."
msgstr[0] "Το αντίγραφο που έστειλαν άλλοι άνθρωποι στις συντεχνίες θα μείνει εκεί."
msgstr[1] "Τα %(num)s αντίγραφα που προωθήθηκαν σε συντεχνίες θα μείνουν εκεί."

#. %(guilds)s is a list of guild names, such as "+a, +b and +c"
#, machine, plain1, python-format
msgid "The copy you forwarded to %(guilds)s will be taken down."
msgid_plural "The copies you forwarded to %(guilds)s will be taken down."
msgstr[0] "Το αντίγραφο που προωθήσατε στο %(guilds)s θα αφαιρεθεί."
msgstr[1] "Τα αντίγραφα που προωθήσατε στο %(guilds)s θα αφαιρεθούν."

#, machine, plain1
msgid "The dates leave no days."
msgstr "Οι ημερομηνίες δεν αφήνουν μέρες."

#, machine, plain2
msgid "The decision stands"
msgstr "Η απόφαση ισχύει"

#, machine, plain1
msgid "The decisions made about it, newest first: who, when, where, which rule and why. It never shows the title or the text of what was hidden or removed."
msgstr "Οι αποφάσεις που πάρθηκαν γι' αυτό, νεότερες πρώτα: ποιος, πότε, πού, που κυβερνούν και γιατί. Ποτέ δεν δείχνει τον τίτλο ή το κείμενο του τι ήταν κρυμμένο ή αφαιρέθηκε."

#, machine, plain1
msgid "The draft has changes the post doesn't show yet."
msgstr "Το προσχέδιο έχει αλλαγές που η θέση δεν φαίνεται ακόμα."

#, machine, plain1
msgid "The earlier versions aren't shown while this is hidden."
msgstr "Οι προηγούμενες εκδόσεις δεν εμφανίζονται ενώ αυτό είναι κρυμμένο."

#, machine, plain2
msgid "The earlier versions aren't shown: this was deleted and its text has been cleared."
msgstr "Οι προηγούμενες εκδόσεις δεν εμφανίζονται: αυτό διαγράφηκε και το κείμενό του έχει εκκαθαριστεί."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was approved: it is read from now on."
msgstr "Η τροφοδοσία %(url)s για την αυτοματοποιημένη απόσπαση του λογαριασμού σας εγκρίθηκε: από εδώ και πέρα διαβάζεται."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was not approved."
msgstr "Η τροφοδοσία %(url)s για την αυτοματοποιημένη απόσπαση του λογαριασμού σας δεν εγκρίθηκε."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was approved: it is read from now on."
msgstr "Η τροφοδοσία %(url)s για το bot @%(name)s εγκρίθηκε: διαβάζεται από τώρα και στο εξής."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was not approved."
msgstr "Η τροφοδοσία %(url)s για το bot σας @%(name)s δεν εγκρίθηκε."

#, machine, plain1, python-format
msgid "The feed answered with an error (%(status)s)."
msgstr "Η ροή απάντησε με σφάλμα (%(status)s)."

#, machine, plain1
msgid "The feed asked us to slow down."
msgstr "Η τροφοδοσία μας ζήτησε να επιβραδύνουμε."

#, machine, plain1
msgid "The feed did not answer in time."
msgstr "Η τροφή δεν απάντησε εγκαίρως."

#, machine, plain1
msgid "The feed is unavailable for now."
msgstr "Η τροφοδοσία δεν είναι διαθέσιμη προς το παρόν."

#, machine, plain1
msgid "The feed server answered with a redirect, which is not followed."
msgstr "Ο διακομιστής τροφοδοσίας απάντησε με ανακατεύθυνση, η οποία δεν ακολουθείται."

#. status is an HTTP status code, such as 404
#, machine, plain1, python-format
msgid "The feed server answered with an error (%(status)s)."
msgstr "Ο διακομιστής τροφοδοσίας απάντησε με σφάλμα (%(status)s)."

#, machine, plain1, python-format
msgid "The feed server answered with more than %(num)s post at once."
msgid_plural "The feed server answered with more than %(num)s posts at once."
msgstr[0] "Ο διακομιστής τροφοδοσίας απάντησε με περισσότερες από %(num)s θέσεις ταυτόχρονα."
msgstr[1] "Ο διακομιστής τροφοδοσίας απάντησε με περισσότερες από %(num)s δημοσιεύσεις ταυτόχρονα."

#, machine, plain1
msgid "The feed server did not answer in time."
msgstr "Ο διακομιστής τροφοδοσίας δεν απάντησε εγκαίρως."

#, machine, plain1
msgid "The feed server took too long to answer."
msgstr "Ο διακομιστής τροφοδοσίας άργησε να απαντήσει."

#, machine, plain1
msgid "The feed server's answer has no list of posts."
msgstr "Η απάντηση του διακομιστή τροφοδοσίας δεν έχει λίστα με δημοσιεύσεις."

#, machine, plain1
msgid "The feed server's answer holds something that is not a post id."
msgstr "Η απάντηση του διακομιστή τροφοδοσίας περιέχει κάτι που δεν είναι ταχυδρομική ταυτότητα."

#, machine, plain1
msgid "The feed server's answer is not JSON."
msgstr "Η απάντηση του εξυπηρετητή δεν είναι JSON."

#, machine, plain1
msgid "The feed server's answer is not a JSON object."
msgstr "Η απάντηση του διακομιστή τροφοδοσίας δεν είναι ένα αντικείμενο JSON."

#, machine, plain1
msgid "The feed server's answer is too large."
msgstr "Η απάντηση του διακομιστή τροφοδοσίας είναι πολύ μεγάλη."

#, machine, plain1
msgid "The feed server's certificate could not be checked."
msgstr "Το πιστοποιητικό του εξυπηρετητή τροφοδοσίας δεν ήταν δυνατό να ελεγχθεί."

#, machine, plain1
msgid "The feed server's cursor is not usable."
msgstr "Ο δρομέας του διακομιστή τροφοδοσίας δεν μπορεί να χρησιμοποιηθεί."

#, machine, plain1
msgid "The feed's address sends it somewhere else too many times."
msgstr "Η διεύθυνση της τροφοδοσίας το στέλνει κάπου αλλού πάρα πολλές φορές."

#, machine, plain1
msgid "The feed's answer is too large."
msgstr "Η απάντηση της τροφοδοσίας είναι πολύ μεγάλη."

#, machine, plain1
msgid "The feed's certificate could not be checked."
msgstr "Το πιστοποιητικό τροφοδοσίας δεν ήταν δυνατό να ελεγχθεί."

#, machine, plain1
msgid "The file's size is missing."
msgstr "Το μέγεθος του αρχείου λείπει."

#, machine, plain1, python-format
msgid "The following users are approved to forward to +%(guild)s."
msgstr "Οι ακόλουθοι χρήστες εγκρίνονται για να προωθήσουν στο + %(guild)s."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s guild chat."
msgstr "Απαγορεύεται στους ακόλουθους χρήστες να συμμετέχουν σε συντεχνιακή συνομιλία +%(guild)s."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s."
msgstr "Απαγορεύεται στους ακόλουθους χρήστες να συμμετέχουν στο +%(guild)s."

#, machine, plain1
msgid "The guild"
msgstr "Η συντεχνία"

#, machine, plain1
msgid "The guild already has a category with that name."
msgstr "Η συντεχνία έχει ήδη μια κατηγορία με αυτό το όνομα."

#, machine, plain1
msgid "The guild already has a channel with that name."
msgstr "Η συντεχνία έχει ήδη ένα κανάλι με αυτό το όνομα."

#, machine, plain1
msgid "The guild already has a role with that name."
msgstr "Η συντεχνία έχει ήδη ένα ρόλο με αυτό το όνομα."

#, machine, plain1
msgid "The guild's own rules for what is written in its channels, on top of the site's word filter. Guildmasters are never held to them. A message that breaks one is refused with a short reason that never says which word."
msgstr "Οι κανόνες της ίδιας της συντεχνίας για ό,τι είναι γραμμένο στα κανάλια της, πάνω στο φίλτρο λέξεων της ιστοσελίδας. Οι συντονιστές της συντεχνίας δεν τους κρατούν ποτέ. Ένα μήνυμα που σπάει κάποιον απορρίπτεται με ένα σύντομο λόγο που ποτέ δεν λέει ποια λέξη."

#, machine, plain2
msgid "The hold on your account was lifted. You can post, comment and vote again."
msgstr "Η αναμονή για λογαριασμό σας άρθηκε. Μπορείτε να δημοσιεύσετε, να σχολιάσετε και να ψηφίσετε ξανά."

#, machine, plain1
msgid "The host stays on stage."
msgstr "Ο οικοδεσπότης μένει στη σκηνή."

#, machine, plain1
msgid "The independent social platform"
msgstr "Η ανεξάρτητη κοινωνική πλατφόρμα"

#, machine, plain1
msgid "The internet gremlins have led you to a dark, musty dead-end. There's nothing here."
msgstr "Τα γκρέμλιν του ίντερνετ σε οδήγησαν σε ένα σκοτεινό αδιέξοδο. Δεν υπάρχει τίποτα εδώ."

#, machine, plain1, python-format
msgid "The key that opens your messages in a new app. It is locked with your password and opened here, in this browser: %(site)s never sees it. Anyone with it and your account can read your chats, so never share it."
msgstr "Το κλειδί που ανοίγει τα μηνύματά σας σε μια νέα εφαρμογή. Είναι κλειδωμένο με τον κωδικό σας και άνοιξε εδώ, σε αυτό το πρόγραμμα περιήγησης: %(site)s δεν τον βλέπει ποτέ. Οποιοσδήποτε με αυτό και ο λογαριασμός σας μπορεί να διαβάσει τις συνομιλίες σας, οπότε ποτέ να μην το μοιραστείτε."

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s"
msgstr "Ο σύνδεσμος `%(link)s` δεν επιτρέπεται. Λόγος: %(reason)s"

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s."
msgstr "Ο σύνδεσμος `%(link)s` δεν επιτρέπεται. Λόγος: %(reason)s."

#, machine, plain1, python-format
msgid "The link can be at most %(num)s character."
msgid_plural "The link can be at most %(num)s characters."
msgstr[0] "Ο σύνδεσμος μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Ο σύνδεσμος μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1
msgid "The link can't contain a user name or password."
msgstr "Ο σύνδεσμος δεν μπορεί να περιέχει όνομα χρήστη ή κωδικό πρόσβασης."

#, machine, plain1
msgid "The link can't contain spaces."
msgstr "Ο σύνδεσμος δεν μπορεί να περιέχει κενά."

#, machine, plain1
msgid "The link must start with https:// or http://."
msgstr "Ο σύνδεσμος πρέπει να ξεκινήσει με το https:// or http://."

#, machine, plain1
msgid "The link needs a full address, such as example.com."
msgstr "Ο σύνδεσμος χρειάζεται πλήρη διεύθυνση, όπως παράδειγμα.com."

#, machine, plain1
msgid "The list is open to members so that anyone can see what the filter hides and why. Nothing on it is removed from the site: each member's own filter decides what they see."
msgstr "Η λίστα είναι ανοιχτή στα μέλη έτσι ώστε ο καθένας να μπορεί να δει τι κρύβει το φίλτρο και γιατί. Τίποτα πάνω του δεν αφαιρείται από την ιστοσελίδα: το φίλτρο του κάθε μέλους αποφασίζει τι βλέπει."

#, machine, plain1
msgid "The list isn't shown on the Child filter"
msgstr "Η λίστα δεν εμφανίζεται στο φίλτρο Child"

#, machine, plain1, python-format
msgid "The most a circle can ask is %(num)s coin every 30 days."
msgid_plural "The most a circle can ask is %(num)s coins every 30 days."
msgstr[0] "Ο περισσότερος κύκλος που μπορεί να ζητήσει είναι %(num)s κέρμα κάθε 30 ημέρες."
msgstr[1] "Ο περισσότερος κύκλος μπορεί να ρωτήσει είναι %(num)s νομίσματα κάθε 30 ημέρες."

#, machine, plain1
msgid "The most voted posts of the last seven days."
msgstr "Οι πιο ψηφισμένες θέσεις των τελευταίων επτά ημερών."

#, machine, plain1, python-format
msgid "The name %(host)s could not be found."
msgstr "Το όνομα %(host)s δεν βρέθηκε."

#, machine, plain1
msgid "The newest of what they have done. Only the names of who they chat with are shown, never what a chat says: chats are end-to-end encrypted."
msgstr "Το νεότερο από αυτά που έχουν κάνει. Εμφανίζονται μόνο τα ονόματα με τους οποίους συνομιλούν, ποτέ αυτά που λέει μια συνομιλία: οι συνομιλίες είναι κρυπτογραφημένες."

#, machine, plain2
msgid "The number of an anonymous author"
msgstr "Ο αριθμός ενός ανώνυμου συγγραφέα"

#, machine, plain2
msgid "The number of items you confirmed doesn't match what was chosen. Nothing was changed."
msgstr "Ο αριθμός των αντικειμένων που επιβεβαιώσατε δεν ταιριάζει με αυτό που επιλέξατε. Τίποτα δεν άλλαξε."

#, machine, plain1
msgid "The numbers are always shown on your profile. This decides who can open each list and see the accounts on it. An account is only listed where its own setting allows it too."
msgstr "Οι αριθμοί εμφανίζονται πάντα στο προφίλ σου. Αυτό αποφασίζει ποιος μπορεί να ανοίξει κάθε λίστα και να δει τους λογαριασμούς σε αυτήν. Ένας λογαριασμός παρατίθεται μόνο όταν το επιτρέπει και η δική του ρύθμιση."

#, machine, plain1
msgid "The open-source platform for independent internet communities"
msgstr "Η πλατφόρμα ανοικτού κώδικα για ανεξάρτητες διαδικτυακές κοινότητες"

#, machine, plain1
msgid "The original content is not retained anywhere, including in this history."
msgstr "Το αρχικό περιεχόμενο δεν διατηρείται πουθενά, συμπεριλαμβανομένης και αυτής της ιστορίας."

#, machine, plain1
msgid "The other authors of a shared draft removed you as an author. What you wrote stays credited to you."
msgstr "Οι άλλοι συγγραφείς ενός κοινού σχεδίου σας αφαίρεσαν από συγγραφέα. Ό,τι έγραψες, παραμένει πιστωμένο σε σένα."

#, machine, plain1
msgid "The owner deletes a channel instead of leaving it."
msgstr "Ο ιδιοκτήτης διαγράφει ένα κανάλι αντί να το αφήσει."

#, machine, plain1
msgid "The owner's role can't be changed."
msgstr "Ο ρόλος του ιδιοκτήτη δεν μπορεί να αλλάξει."

#, machine, plain1
msgid "The page's current text isn't shown here; what you save replaces it."
msgstr "Το τρέχον κείμενο της σελίδας δεν εμφανίζεται εδώ· αυτό που αποθηκεύετε το αντικαθιστά."

#, machine, plain1
msgid "The picture could not be stored. Try again later."
msgstr "Η εικόνα δεν μπόρεσε να αποθηκευτεί. Προσπάθησε ξανά αργότερα."

#, machine, plain1
msgid "The picture goes to your own linked storage, not to this site. You can add a few words under it."
msgstr "Η εικόνα πηγαίνει στη δική σας συνδεδεμένη αποθήκη, όχι σε αυτό το site. Μπορείτε να προσθέσετε μερικές λέξεις από κάτω."

#, machine, plain1
msgid "The picture you chose"
msgstr "Η φωτογραφία που διάλεξες"

#, machine, plain1
msgid "The post appears on the profile of whoever publishes it first. Optionally forward it into guilds for community discussion: each guild gets its own independent copy with its own votes and comments. Guilds are forwarded to when the draft is first published."
msgstr "Η δημοσίευση εμφανίζεται στο προφίλ αυτού που την δημοσιεύει πρώτος. Προαιρετικά το προωθεί σε συντεχνίες για συζήτηση της κοινότητας: κάθε συντεχνία παίρνει το δικό της ανεξάρτητο αντίγραφο με δικές της ψήφους και σχόλια. Οι συντεχνίες προωθούνται κατά την πρώτη δημοσίευση του προσχεδίου."

#, machine, plain1
msgid "The post carries your name and is listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your name."
msgstr "Η ανάρτηση φέρει το όνομά σας και αναγράφεται στο προφίλ σας. Οι ψήφοι, τα σχόλια και τα forwards μοιράζονται με τον συγγραφέα του, ο οποίος το επεξεργάζεται και το διαγράφει. Μπορείτε να απομακρυνθείτε ανά πάσα στιγμή: η θέση παραμένει, χωρίς το όνομά σας."

#, machine, plain2
msgid "The post is not listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your credit."
msgstr "Η δημοσίευση δεν είναι καταχωρημένη στο προφίλ σας. Οι ψήφοι, τα σχόλια και τα forwards μοιράζονται με τον συγγραφέα του, ο οποίος το επεξεργάζεται και το διαγράφει. Μπορείτε να απομακρυνθείτε ανά πάσα στιγμή: η θέση παραμένει, χωρίς την πίστωση σας."

#, machine, plain1
msgid "The post refused the change."
msgstr "Η θέση αρνήθηκε την αλλαγή."

#, machine, plain2
msgid "The post stays where it is, with your name taken off it, and leaves your profile. Its Rep leaves you too. Everyone who saw it with your name still knows it was you."
msgstr "Η δημοσίευση μένει εκεί που είναι, με το όνομά σου να βγαίνει και να αφήνει το προφίλ σου. Η φήμη του σε αφήνει κι εσένα. Όλοι όσοι το είδαν με το όνομά σου ξέρουν ότι ήσουν εσύ."

#, machine, plain2
msgid "The post's author"
msgstr "Συγγραφέας της δημοσίευσης"

#, machine, plain2
msgid "The post's author deleted it, so it is shown as Anonymous: no name and no link. The comments under it stay as they were; one its author deleted is shown as Anonymous too."
msgstr "Ο συγγραφέας της δημοσίευσης την διέγραψε, οπότε εμφανίζεται ως Anonymous: no name and no link. Τα σχόλια που βρίσκονται κάτω από αυτό παραμένουν όπως ήταν· ένα συγγραφέα του διαγράφεται εμφανίζεται ως Anonymous πάρα πολύ."

#, machine, plain1, python-format
msgid "The promo code `%(code)s` is not currently valid. Please begin a new transaction."
msgstr "Ο κωδικός promo `%(code)s` δεν είναι επί του παρόντος έγκυρος. Παρακαλώ ξεκινήστε μια νέα συναλλαγή."

#, machine, plain1, python-format
msgid "The proposal for @%(name)s has been withdrawn."
msgstr "Η πρόταση για το @%(name)s αποσύρθηκε."

#, machine, plain1, python-format
msgid "The role %(role)s was deleted."
msgstr "Ο ρόλος %(role)s διαγράφηκε."

#, machine, plain1, python-format
msgid "The role %(role)s was made."
msgstr "Έγινε ο ρόλος %(role)s."

#, machine, plain1, python-format
msgid "The role %(role)s was saved."
msgstr "Ο ρόλος %(role)s σώθηκε."

#, machine, plain1
msgid "The royal bank has told us that you owe them some coin. You'll need to pay off your debts before you can continue."
msgstr "Η βασιλική τράπεζα μας είπε ότι τους χρωστάς χρήματα. Πρέπει να ξεπληρώσεις τα χρέη σου πριν συνεχίσεις."

#, machine, plain1
msgid "The rules"
msgstr "Οι κανόνες"

#, machine, plain1
msgid "The rules below"
msgstr "Οι παρακάτω κανόνες"

#, machine, plain1, python-format
msgid "The rules can be at most %(count)s character."
msgid_plural "The rules can be at most %(count)s characters."
msgstr[0] "Οι κανόνες μπορεί να είναι το πολύ χαρακτήρα %(count)s."
msgstr[1] "Οι κανόνες μπορεί να είναι το πολύ %(count)s χαρακτήρες."

#, machine, plain1
msgid "The rules can't contain control or invisible characters."
msgstr "Οι κανόνες δεν μπορούν να περιέχουν έλεγχο ή αόρατους χαρακτήρες."

#, machine, plain1
msgid "The screenshot you are sending"
msgstr "Το στιγμιότυπο οθόνης που στέλνετε"

#. %(status)s is an HTTP status code
#, machine, plain1, python-format
msgid "The server answered %(status)s."
msgstr "Ο εξυπηρετητής απάντησε %(status)s."

#, machine, plain1, python-format
msgid "The server answers with the posts to show and their order; %(site)s still hides anything a viewer may not see, and tells the server nothing about who is looking. Everyone is told that an outside server ranks this curation."
msgstr "Ο διακομιστής απαντά με τις αναρτήσεις για να δείξει και την παραγγελία τους. %(site)s εξακολουθεί να κρύβει οτιδήποτε ένας θεατής δεν μπορεί να δει, και δεν λέει τίποτα στον εξυπηρετητή για το ποιος ψάχνει. Όλοι λένε ότι ένας εξωτερικός διακομιστής κατατάσσει αυτή την επιμελημένη τροφοδοσία."

#, machine, plain1, python-format
msgid "The server named %(num)s post; you can see %(seen)s of them."
msgid_plural "The server named %(num)s posts; you can see %(seen)s of them."
msgstr[0] "Ο διακομιστής ονομάζεται %(num)s post; μπορείτε να δείτε %(seen)s από αυτούς."
msgstr[1] "Ο διακομιστής ονομάζεται %(num)s δημοσιεύσεις; μπορείτε να δείτε %(seen)s από αυτές."

#, machine, plain1
msgid "The server thinks you're asking something silly. It might take you more seriously if you take off the jester outfit."
msgstr "Ο σέρβερ πιστεύει ότι ρωτάς κάτι ανόητο. Μπορεί να σε πάρει πιο σοβαρά αν βγάλεις τη στολή γελωτοποιού."

#, machine, plain1
msgid "The site refused the bot's session."
msgstr "Η ιστοσελίδα αρνήθηκε τη συνεδρία του ρομπότ."

#, machine, plain2
msgid "The site's admins have it already."
msgstr "Οι διαχειριστές του site το έχουν ήδη."

#, machine, plain1
msgid "The site's admins marked this guild sensitive, so only an admin can change this."
msgstr "Οι διαχειριστές της ιστοσελίδας σημάδεψαν αυτή τη συντεχνία ευαίσθητη, οπότε μόνο ένας διαχειριστής μπορεί να το αλλάξει αυτό."

#, machine, plain2
msgid "The site's admins will read it. They are never told who reported."
msgstr "Οι διαχειριστές του site θα το διαβάσουν. Ποτέ δεν τους λένε ποιος αναφέρθηκε."

#, machine, plain1, python-format
msgid "The stage is full (%(num)s person)."
msgid_plural "The stage is full (%(num)s people)."
msgstr[0] "Το στάδιο είναι πλήρες (%(num)s άτομο)."
msgstr[1] "Το στάδιο είναι γεμάτο (%(num)s άτομα)."

#, machine, plain1
msgid "The storage service is not answering right now. Try again in a moment."
msgstr "Η υπηρεσία αποθήκευσης δεν απαντά τώρα. Προσπάθησε ξανά σε ένα λεπτό."

#, machine, plain1, python-format
msgid "The summary can be at most %(num)s character."
msgid_plural "The summary can be at most %(num)s characters."
msgstr[0] "Η περίληψη μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Η περίληψη μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1
msgid "The summary can be changed while the Space is live."
msgstr "Η περίληψη μπορεί να αλλάξει όσο το Διάστημα είναι ζωντανό."

#, machine, plain1
msgid "The text isn't shown: this was removed by the site's administrators."
msgstr "Το κείμενο δεν εμφανίζεται: αυτό αφαιρέθηκε από τους διαχειριστές της ιστοσελίδας."

#, machine, plain1
msgid "The text of this version was hidden by a site administrator."
msgstr "Το κείμενο αυτής της έκδοσης ήταν κρυμμένο από έναν διαχειριστή της ιστοσελίδας."

#, machine, plain1, python-format
msgid "The time before links must be a whole number of days, 0 to %(max)s."
msgstr "Ο χρόνος πριν από τους συνδέσμους πρέπει να είναι ένας ολόκληρος αριθμός ημερών, 0 έως %(max)s."

#, machine, plain1, python-format
msgid "The time in the guild must be a whole number of days, 0 to %(max)s."
msgstr "Ο χρόνος στη συντεχνία πρέπει να είναι ένας ολόκληρος αριθμός ημερών, 0 έως %(max)s."

#, machine, plain1, python-format
msgid "The title can be at most %(num)s character."
msgid_plural "The title can be at most %(num)s characters."
msgstr[0] "Ο τίτλος μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Ο τίτλος μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1
msgid "The two revisions have the same text."
msgstr "Οι δύο αναθεωρήσεις έχουν το ίδιο κείμενο."

#, machine, plain1
msgid "The upload did not arrive in your Google Drive. Try again."
msgstr "Το ανέβασμα δεν έφτασε στο Google Drive σας. Προσπάθησε ξανά."

#, machine, plain1
msgid "The upload did not arrive in your OneDrive. Try again."
msgstr "Το ανέβασμα δεν έφτασε στο OneDrive σας. Προσπάθησε ξανά."

#, machine, plain1
msgid "The upload did not arrive. Try again."
msgstr "Το ανέβασμα δεν έφτασε. Προσπάθησε ξανά."

#, machine, plain1, python-format
msgid "The username @%(name)s has been pre-emptively reserved for: %(who)s"
msgstr "Το όνομα χρήστη @ %(name)s έχει προκατασκευασθεί για: %(who)s"

#, machine, plain1
msgid "The usual order - everything from the guilds and accounts you add"
msgstr "Η συνηθισμένη σειρά - τα πάντα από τις συντεχνίες και τους λογαριασμούς που προσθέτετε"

#, machine, plain1
msgid "The video did not finish uploading to Dailymotion. Add it again."
msgstr "Το βίντεο δεν τελείωσε την αποστολή στο Dailymotion. Πρόσθεσε το ξανά."

#, machine, plain1
msgid "The video did not finish uploading. Add it again."
msgstr "Το βίντεο δεν τελείωσε την αποστολή. Πρόσθεσε το ξανά."

#, machine, plain1, python-format
msgid "The website can be at most %(num)s character."
msgid_plural "The website can be at most %(num)s characters."
msgstr[0] "Η ιστοσελίδα μπορεί να είναι το πολύ %(num)s χαρακτήρας."
msgstr[1] "Η ιστοσελίδα μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1
msgid "The website can't contain a user name or password."
msgstr "Η ιστοσελίδα δεν μπορεί να περιέχει όνομα χρήστη ή κωδικό πρόσβασης."

#, machine, plain1
msgid "The website can't contain spaces."
msgstr "Η ιστοσελίδα δεν μπορεί να περιέχει κενά."

#, machine, plain1
msgid "The website must start with https:// or http://."
msgstr "Η ιστοσελίδα πρέπει να ξεκινήσει με το https:// or http://."

#, machine, plain1
msgid "The website needs a full address, such as example.com."
msgstr "Η ιστοσελίδα χρειάζεται μια πλήρη διεύθυνση, όπως το παράδειγμα.com."

#, machine, plain1
msgid "The whole site <span class=\"text-muted\">(needs an age limit of a month or less)</span>"
msgstr "Ολόκληρη η ιστοσελίδα <span class=\"text-muted\">(χρειάζεται όριο ηλικίας ενός μήνα ή λιγότερο)</span>"

#, machine, plain1
msgid "The wiki is off: only guildmasters see it."
msgstr "Το wiki είναι κλειστό: μόνο συντονιστές συντεχνιών το βλέπουν."

#, machine, plain1
msgid "The wiki's first page can be emptied but not deleted."
msgstr "Η πρώτη σελίδα του wiki μπορεί να αδειάσει αλλά δεν διαγράφεται."

#, machine, plain1
msgid "The word filter has no words at the moment."
msgstr "Η λέξη φίλτρο δεν έχει λέξεις προς το παρόν."

#, machine, plain1, python-format
msgid "The words for other languages are adapted from %(source)s (%(licence)s): words that are also ordinary, innocent words were left out."
msgstr "Οι λέξεις για άλλες γλώσσες προσαρμόζονται από το %(source)s (%(licence)s): λέξεις που είναι επίσης συνηθισμένες, αθώες λέξεις παραλείφθηκαν."

#, machine, plain1
msgid "The working copy as it is now. Only its authors can see this until it's published."
msgstr "Το αντίγραφο εργασίας όπως είναι τώρα. Μόνο οι συγγραφείς του μπορούν να το δουν αυτό μέχρι να δημοσιευθεί."

#, machine, plain1
msgid "Theater"
msgstr "Θέατρο"

#, machine, plain1
msgid "Their commenting history will show here."
msgstr "Τα σχόλιά τους θα δείξουν εδώ."

#, machine, plain1
msgid "Their forwarding activity will show here."
msgstr "Η δραστηριότητα τους θα δείξει εδώ."

#, machine, plain1
msgid "Their posting history will show here."
msgstr "Το ιστορικό τους θα δείξει εδώ."

#, machine, plain1
msgid "Their posts and comments are left out of your feeds and threads and they cannot notify you. They are not told, and they can still follow you, comment on your posts and message you. Their anonymous posts and comments are not hidden, as hiding only those would tell you who wrote them. Mute someone from the menu on any of their posts or comments, or from their profile."
msgstr "Οι δημοσιεύσεις και τα σχόλιά τους αφήνονται έξω από τις ζωοτροφές και τις κλωστές σας και δεν μπορούν να σας ειδοποιήσουν. Δεν τους λένε, και μπορούν ακόμα να σας ακολουθήσουν, να σχολιάσουν τις θέσεις σας και να σας στείλουν μήνυμα. Οι ανώνυμες δημοσιεύσεις και τα σχόλιά τους δεν κρύβονται, καθώς κρύβοντας μόνο αυτές θα σας έλεγαν ποιος τις έγραψε. Mute κάποιος από το μενού σε οποιαδήποτε από τις δημοσιεύσεις ή σχόλια τους, ή από το προφίλ τους."

#, machine, plain1
msgid "There are no approved users"
msgstr "Δεν υπάρχουν εγκεκριμένοι χρήστες"

#, machine, plain1
msgid "There are no exiled users"
msgstr "Δεν υπάρχουν εξόριστοι χρήστες"

#, machine, plain1
msgid "There are no guildmaster invitations."
msgstr "Δεν υπάρχουν προσκλήσεις για συντονιστή συντεχνιών."

#, machine, plain1
msgid "There are no guildmasters."
msgstr "Δεν υπάρχουν συντονιστές συντεχνιών."

#, machine, plain1
msgid "There are no posts here."
msgstr "Δεν υπάρχουν αναρτήσεις εδώ."

#, machine, plain1, python-format
msgid "There is no account named @%(name)s."
msgstr "Δεν υπάρχει λογαριασμός με το όνομα @%(name)s."

#, machine, plain2
msgid "There is nothing here to appeal."
msgstr "Δεν υπάρχει τίποτα εδώ για έφεση."

#, machine, plain1
msgid "There is nothing to save yet."
msgstr "Δεν υπάρχει τίποτα να σώσουμε ακόμα."

#, machine, plain2
msgid "There is nothing waiting for this ban."
msgstr "Δεν υπάρχει τίποτα που να περιμένει αυτή την απαγόρευση."

#, machine, plain1
msgid "There was a problem. Please try again."
msgstr "Υπήρχε ένα πρόβλημα. Παρακαλώ προσπαθήστε ξανά."

#, machine, plain1
msgid "There were no names in that file."
msgstr "Δεν υπήρχαν ονόματα στον φάκελο."

#, machine, plain1
msgid "There were no survivors."
msgstr "Δεν υπήρχαν επιζώντες."

#, machine, plain1
msgid "There's a shortage of perfect request entities in this world. Would be a pity to damage yours."
msgstr "Υπάρχει έλλειψη από τέλειες οντότητες ζήτησης σε αυτόν τον κόσμο. Θα ήταν κρίμα να βλάψεις το δικό σου."

#, machine, plain1
msgid "There's already an open proposal like this one."
msgstr "Υπάρχει ήδη μια ανοιχτή πρόταση σαν αυτή."

#, machine, plain1
msgid "There's no account with that name."
msgstr "Δεν υπάρχει λογαριασμός με αυτό το όνομα."

#, machine, plain1
msgid "There's no invitation to speak."
msgstr "Δεν υπάρχει πρόσκληση να μιλήσεις."

#, machine, plain2
msgid "There's no recovery code to keep yet."
msgstr "Δεν υπάρχει κωδικός ανάκτησης ακόμα."

#, machine, plain1
msgid "There's nothing here right now."
msgstr "Δεν υπάρχει τίποτα εδώ τώρα."

#, machine, plain1
msgid "There's nothing left here but a giant smouldering crater."
msgstr "Δεν έχει μείνει τίποτα εδώ, παρά ένας τεράστιος κρατήρας."

#, machine, plain1
msgid "These are the users you are subscribed to."
msgstr "Αυτοί είναι οι χρήστες που είστε εγγεγραμμένοι."

#, machine, plain1
msgid "These counts start from the day guild insights were switched on: before that the site did not record when people left a guild or how often its page was opened."
msgstr "Αυτές οι μετρήσεις ξεκινούν από την ημέρα που άνοιξαν οι ιδέες της συντεχνίας: πριν από αυτό η ιστοσελίδα δεν κατέγραφε όταν οι άνθρωποι εγκατέλειψαν μια συντεχνία ή πόσο συχνά άνοιξε η σελίδα της."

#, machine, plain1
msgid "These filters are saved as your default"
msgstr "Αυτά τα φίλτρα αποθηκεύονται ως προεπιλογή σας"

#, machine, plain1
msgid "These topics"
msgstr "Αυτά τα θέματα"

#, machine, plain1, python-format
msgid "These users have been invited to moderate +%(guild)s."
msgstr "Αυτοί οι χρήστες έχουν προσκληθεί σε μέτρια + %(guild)s."

#, machine, plain1
msgid "They already have this role."
msgstr "Έχουν ήδη αυτόν τον ρόλο."

#, machine, plain1
msgid "They are 18 or over, so they can make their own account."
msgstr "Έχουν περάσει τα 18, οπότε μπορούν να κάνουν δικό τους λογαριασμό."

#, machine, plain1
msgid "They are already in this circle."
msgstr "Είναι ήδη σε αυτόν τον κύκλο."

#, machine, plain1
msgid "They are not told. Anyone you block leaves your circles."
msgstr "Δεν τους λένε. Όποιος μπλοκάρεις αφήνει τους κύκλους σου."

#, machine, plain2
msgid "They are signed out everywhere, chat apps included. If they use chat, they may need their recovery code, or a browser where they've used chat, to read their old messages."
msgstr "Αποσυνδέονται παντού, συμπεριλαμβάνονται εφαρμογές συνομιλίας. Εάν χρησιμοποιούν chat, μπορεί να χρειάζονται τον κωδικό ανάκτησης τους, ή ένα πρόγραμμα περιήγησης όπου έχουν χρησιμοποιήσει chat, για να διαβάσουν τα παλιά μηνύματά τους."

#, machine, plain1, python-format
msgid "They aren't in %(circle)s."
msgstr "Δεν είναι στο %(circle)s."

#, machine, plain1
msgid "They aren't in this group."
msgstr "Δεν είναι σε αυτή την ομάδα."

#, machine, plain1
msgid "They aren't muted here."
msgstr "Δεν είναι μουγκοί εδώ."

#, machine, plain1
msgid "They can buy and spend coins, tip, buy Premium and join or run paid circles."
msgstr "Μπορούν να αγοράσουν και να ξοδέψουν νομίσματα, φιλοδώρημα, να αγοράσουν Premium και να ενταχθούν ή να εκτελέσουν κύκλους που έχουν πληρωθεί."

#, machine, plain2
msgid "They can join and listen to Spaces. They can't host one or post in one: a child account only reads. Voice calls in a Space also need Chat to be on."
msgstr "Μπορούν να ενωθούν και να ακούσουν το Spaces. Δεν μπορούν να φιλοξενήσουν ένα ή να δημοσιεύσουν ένα: ένας λογαριασμός παιδιού διαβάζει μόνο. Οι φωνητικές κλήσεις σε ένα Διάστημα χρειάζονται επίσης συνομιλία για να είναι on."

#, machine, plain1
msgid "They can message people, join group chats and make calls. The site never shows you what a chat says: chats are end-to-end encrypted. Whoever knows their password can still sign in and read them."
msgstr "Μπορούν να στέλνουν μηνύματα στους ανθρώπους, να συμμετέχουν σε ομαδικές συζητήσεις και να κάνουν τηλεφωνήματα. Ο ιστότοπος δεν σας δείχνει ποτέ τι λέει μια συνομιλία: οι συνομιλίες είναι κρυπτογραφημένες. Όποιος ξέρει τον κωδικό του μπορεί ακόμα να υπογράψει και να τον διαβάσει."

#, machine, plain1
msgid "They can see what you do on the site: your posts, comments, votes, bookmarks, follows, guilds, who you chat with, that your account was reported, and your recent sign-ins. The site never shows them what your chats say, because chats are end-to-end encrypted. But anyone who knows your password, a parent who chose it included, can sign in as you: change it in Security so that only you know it. They choose which of these are on for your account:"
msgstr "Μπορούν να δουν τι κάνετε στο site: τις δημοσιεύσεις σας, σχόλια, ψήφους, σελιδοδείκτες, ακολουθεί, συντεχνίες, με τους οποίους συνομιλείτε, ότι ο λογαριασμός σας αναφέρθηκε, και τα πρόσφατα σημεία εισόδου σας. Η ιστοσελίδα δεν τους δείχνει ποτέ τι λένε οι συνομιλίες σας, επειδή οι συνομιλίες είναι κρυπτογραφημένες. Αλλά όποιος γνωρίζει τον κωδικό σας, ένας γονέας που τον επέλεξε, μπορεί να υπογράψει όπως εσείς: να τον αλλάξει στην Ασφάλεια, ώστε μόνο εσείς να το ξέρετε. Επιλέγουν ποια από αυτές είναι για λογαριασμό σας:"

#, machine, plain2
msgid "They can start a guild. They still can't post or comment: a child account only reads."
msgstr "Μπορούν να ξεκινήσουν μια συντεχνία. Ακόμα δεν μπορούν να δημοσιεύσουν ή να σχολιάσουν: ένας λογαριασμός παιδιού διαβάζει μόνο."

#, machine, plain1
msgid "They can't comment on your posts or comments, chat with you or notify you by mentioning you. They are not told, but they may work it out if they try to comment on something of yours."
msgstr "Δεν μπορούν να σχολιάσουν τις δημοσιεύσεις ή τα σχόλιά σας, να συνομιλήσουν μαζί σας ή να σας ειδοποιήσουν αναφέροντας σας. Δεν τους λένε, αλλά μπορεί να βρουν λύση αν προσπαθήσουν να σχολιάσουν κάτι δικό σας."

#, machine, plain1
msgid "They don't have this role."
msgstr "Δεν έχουν αυτόν τον ρόλο."

#, machine, plain1
msgid "They go straight to your coin balance."
msgstr "Πάνε κατευθείαν στο υπόλοιπό σου."

#, machine, plain1
msgid "They haven't asked for that."
msgstr "Δεν το ζήτησαν αυτό."

#, machine, plain2
msgid "They leave the site. What they said stays in the Log as Anonymous, except for anything made in the last five minutes that nobody has commented on, which is erased. This can't be undone."
msgstr "Φεύγουν από το σημείο. Αυτά που είπαν μένουν στο Ημερολόγιο ως Ανώνυμοι, εκτός από οτιδήποτε φτιάχτηκε τα τελευταία πέντε λεπτά που κανείς δεν έχει σχολιάσει, το οποίο διαγράφεται. Αυτό δεν μπορεί να αναιρεθεί."

#, machine, plain1
msgid "They need to be in the guild, and not exiled from it."
msgstr "Πρέπει να είναι στη συντεχνία, και όχι να εξοριστούν από αυτήν."

#, machine, plain1
msgid "They need to join the channel first."
msgstr "Πρέπει να μπουν στο κανάλι πρώτα."

#, machine, plain1
msgid "They say they are 18 or over and asked you to release their account. If you do, it becomes their own and you can no longer see it."
msgstr "Λένε ότι είναι 18 ή πάνω και σας ζήτησε να απελευθερώσει το λογαριασμό τους. Αν το κάνεις, γίνεται δικό τους και δεν μπορείς να το δεις πια."

#, machine, plain2
msgid "They stay where they are, with your name taken off them. This can't be undone. Posts that need your name (for a Circle, or with tips) are listed afterwards as not changed."
msgstr "Μένουν εκεί που είναι, με το όνομά σου να τους βγάζει. Αυτό δεν μπορεί να αναιρεθεί. Οι δημοσιεύσεις που χρειάζονται το όνομά σας (για έναν Κύκλο, ή με συμβουλές) αναφέρονται στη συνέχεια ως δεν έχουν αλλάξει."

#, machine, plain2, python-format
msgid "They wrote: %(note)s"
msgstr "Έγραψαν: %(note)s"

#, machine, plain1
msgid "They're already a helper."
msgstr "Είναι ήδη βοηθοί."

#, machine, plain1
msgid "They're already on stage."
msgstr "Είναι ήδη στη σκηνή."

#, machine, plain1
msgid "They've already been invited to speak."
msgstr "Έχουν ήδη προσκληθεί να μιλήσουν."

#, machine, plain1
msgid "This Circle guild is by invitation only."
msgstr "Αυτή η συντεχνία Κύκλου είναι μόνο με πρόσκληση."

#, machine, plain1
msgid "This Google account has no YouTube channel yet. Create one at youtube.com, then try again."
msgstr "Αυτός ο λογαριασμός Google δεν έχει YouTube Κανάλι ακόμα. Δημιουργήστε ένα στο youtube.com, στη συνέχεια, προσπαθήστε ξανά."

#, machine, plain1
msgid "This Space"
msgstr "Αυτός ο χώρος"

#, machine, plain1
msgid "This Space can't take a replay now."
msgstr "Αυτός ο Διάστημα δεν μπορεί να κάνει επανάληψη τώρα."

#, machine, plain1
msgid "This Space has already started."
msgstr "Αυτός ο χώρος έχει ήδη ξεκινήσει."

#, machine, plain1
msgid "This Space has ended."
msgstr "Αυτός ο χώρος τελείωσε."

#, machine, plain1
msgid "This Space has ended. Its board is still here to read."
msgstr "Αυτός ο χώρος τελείωσε. Ο πίνακας του είναι ακόμα εδώ για να διαβάσει."

#, machine, plain1
msgid "This Space has ended. Its chat is still here to read."
msgstr "Αυτός ο χώρος τελείωσε. Η συνομιλία του είναι ακόμα εδώ για να διαβάσει."

#, machine, plain1
msgid "This Space hasn't started yet."
msgstr "Αυτός ο χώρος δεν έχει ξεκινήσει ακόμα."

#, machine, plain1, python-format
msgid "This Space is full (%(num)s listener)."
msgid_plural "This Space is full (%(num)s listeners)."
msgstr[0] "Αυτός ο χώρος είναι γεμάτος (%(num)s ακροατής)."
msgstr[1] "Αυτός ο Χώρος είναι γεμάτος (%(num)s ακροατές)."

#, machine, plain1, python-format
msgid "This Space is live until %(time)s."
msgstr "Αυτό το διάστημα είναι ζωντανό μέχρι %(time)s."

#, machine, plain1
msgid "This Space is live."
msgstr "Αυτός ο χώρος είναι ζωντανός."

#, machine, plain1
msgid "This Space is not recorded: when it ends, it is gone, with everything in it."
msgstr "Αυτός ο Χώρος δεν καταγράφεται: όταν τελειώνει, χάνεται, με όλα μέσα του."

#, machine, plain1
msgid "This Space is recorded"
msgstr "Αυτός ο χώρος καταγράφεται"

#, machine, plain1
msgid "This Space is recorded: its board stays to read when it ends."
msgstr "Αυτός ο χώρος καταγράφεται: ο πίνακας του παραμένει για να διαβάσει όταν τελειώνει."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay with the video."
msgstr "Αυτό το Διάστημα καταγράφεται: ο οικοδεσπότης διατηρεί μια επανάληψη με το βίντεο."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay."
msgstr "Αυτό το Διάστημα καταγράφεται: ο οικοδεσπότης διατηρεί μια επανάληψη."

#, machine, plain1
msgid "This Space isn't available."
msgstr "Αυτός ο χώρος δεν είναι διαθέσιμος."

#, machine, plain1
msgid "This Space isn't waiting to start."
msgstr "Αυτός ο χώρος δεν περιμένει να ξεκινήσει."

#, machine, plain1
msgid "This Space keeps its sound only."
msgstr "Αυτός ο χώρος κρατάει μόνο τον ήχο του."

#, machine, plain1
msgid "This access will expire in one hour, or earlier if you revoke it."
msgstr "Αυτή η πρόσβαση θα λήξει σε μία ώρα, ή νωρίτερα αν την ανακαλέσεις."

#, machine, plain1
msgid "This account can't use chat apps."
msgstr "Αυτός ο λογαριασμός δεν μπορεί να χρησιμοποιήσει εφαρμογές συνομιλίας."

#, machine, plain1, python-format
msgid "This account has been marked 18 or over since %(date)s."
msgstr "Ο λογαριασμός αυτός έχει σημειωθεί 18 ή περισσότερο από το %(date)s."

#, machine, plain1, python-format
msgid "This account has been permanently suspended from %(site)s."
msgstr "Ο λογαριασμός αυτός έχει ανασταλεί οριστικά από το %(site)s."

#, machine, plain1, python-format
msgid "This account has been temporarily suspended from %(site)s. Check back later."
msgstr "Ο λογαριασμός αυτός έχει ανασταλεί προσωρινά από το %(site)s. Θα τα ξαναπούμε αργότερα."

#, machine, plain1
msgid "This account is private"
msgstr "Αυτός ο λογαριασμός είναι ιδιωτικός"

#, machine, plain1
msgid "This account is suspended."
msgstr "Αυτός ο λογαριασμός αναστέλλεται."

#, machine, plain1
msgid "This account owes money, so it can't be deleted yet."
msgstr "Αυτός ο λογαριασμός χρωστάει χρήματα, οπότε δεν μπορεί να διαγραφεί ακόμα."

#, machine, plain1
msgid "This account posts about sensitive topics"
msgstr "Αυτός ο λογαριασμός δημοσιεύει για ευαίσθητα θέματα"

#, machine, plain2
msgid "This also signs out chat everywhere else, chat apps included, except the chat this browser has used since you signed in here."
msgstr "Αυτό αποσυνδέει επίσης συνομιλία παντού αλλού, συμπεριλαμβάνονται εφαρμογές συνομιλίας, εκτός από την συνομιλία που έχει χρησιμοποιήσει αυτό το πρόγραμμα περιήγησης από τότε που υπογράψατε εδώ."

#. %(time)s is a length of time, such as "6 months"
#, machine, plain1, python-format
msgid "This author hasn't been active for %(time)s, so isn't counted."
msgstr "Αυτός ο συγγραφέας δεν ήταν ενεργός για το %(time)s, οπότε δεν έχει μετρηθεί."

#, machine, plain2
msgid "This ban relies on:"
msgstr "Η απαγόρευση αυτή βασίζεται σε:"

#, machine, plain1
msgid "This bot can't take tips right now."
msgstr "Αυτό το ρομπότ δεν μπορεί να πάρει συμβουλές τώρα."

#, machine, plain1
msgid "This bot has not been approved."
msgstr "Αυτό το ρομπότ δεν έχει εγκριθεί."

#, machine, plain1
msgid "This bot is not running."
msgstr "Αυτό το ρομπότ δεν τρέχει."

#, machine, plain1
msgid "This bot's owner can't run it right now."
msgstr "Ο ιδιοκτήτης του ρομπότ δεν μπορεί να το ελέγξει τώρα."

#, machine, plain2
msgid "This bot's owner can't run it while their account is on hold."
msgstr "Ο ιδιοκτήτης του ρομπότ δεν μπορεί να το τρέξει όσο ο λογαριασμός τους είναι σε αναμονή."

#, machine, plain2
msgid "This browser was signed out. Sign in again to carry on."
msgstr "Αυτός ο περιηγητής αποσυνδέθηκε. Υπογράψτε ξανά για να συνεχίσετε."

#, machine, plain2
msgid "This browser's notifications couldn't be turned on. Try again."
msgstr "Αυτό το πρόγραμμα περιήγησης δεν μπορούσε να ενεργοποιηθεί. Προσπάθησε ξανά."

#, machine, plain1, python-format
msgid "This call is full (%(num)s person)."
msgid_plural "This call is full (%(num)s people)."
msgstr[0] "Αυτή η κλήση είναι πλήρης (%(num)s άτομο)."
msgstr[1] "Αυτή η κλήση είναι πλήρης (%(num)s άτομα)."

#, machine, plain1
msgid "This can't be translated right now."
msgstr "Αυτό δεν μπορεί να μεταφραστεί τώρα."

#, machine, plain2
msgid "This can't be undone. The site's admins can always see who wrote something, and if an admin bans or suspends the account for it, the Log may name the account for it."
msgstr "Αυτό δεν μπορεί να αναιρεθεί. Οι διαχειριστές του site μπορούν πάντα να δουν ποιος έγραψε κάτι, και αν ένας διαχειριστής απαγορεύει ή αναστέλλει το λογαριασμό για αυτό, το Log μπορεί να ονομάσει το λογαριασμό για αυτό."

#, machine, plain1
msgid "This channel doesn't ask for its rules to be accepted."
msgstr "Αυτό το κανάλι δεν ζητά να γίνουν δεκτοί οι κανόνες του."

#, machine, plain1
msgid "This channel has no messages."
msgstr "Αυτό το κανάλι δεν έχει μηνύματα."

#, machine, plain1
msgid "This channel is end-to-end encrypted: it is read and written in Chat, where your messages are unlocked."
msgstr "Αυτό το κανάλι είναι κρυπτογραφημένο: διαβάζεται και γράφεται στο Chat, όπου τα μηνύματά σας είναι ξεκλείδωτα."

#, machine, plain1
msgid "This channel is end-to-end encrypted: the site can't read it, so it has no word filter, slow mode, pins, search or reports."
msgstr "Αυτό το κανάλι είναι κρυπτογραφημένο: η τοποθεσία δεν μπορεί να το διαβάσει, οπότε δεν έχει φίλτρο λέξης, αργή λειτουργία, καρφίτσες, αναζήτηση ή αναφορές."

#, machine, plain1
msgid "This channel is full."
msgstr "Αυτό το κανάλι είναι γεμάτο."

#, machine, plain1
msgid "This channel is written from the chat itself."
msgstr "Αυτό το κανάλι είναι γραμμένο από την ίδια την συνομιλία."

#, machine, plain1
msgid "This channel isn't available."
msgstr "Αυτό το κανάλι δεν είναι διαθέσιμο."

#, machine, plain1
msgid "This circle isn't taking subscribers."
msgstr "Αυτός ο κύκλος δεν παίρνει συνδρομητές."

#, machine, plain1
msgid "This code can't be used. Get a new one on the computer, or sign in there with your password."
msgstr "Αυτός ο κώδικας δεν μπορεί να χρησιμοποιηθεί. Πάρτε ένα νέο στον υπολογιστή, ή συνδεθείτε εκεί με τον κωδικό σας."

#, machine, plain1
msgid "This code has run out."
msgstr "Αυτός ο κώδικας έχει εξαντληθεί."

#, machine, plain1
msgid "This comment and the comments under it"
msgstr "Αυτή η παρατήρηση και οι παρατηρήσεις που υποβλήθηκαν"

#, machine, plain1, python-format
msgid "This comment breaks %(site)s policy"
msgstr "Αυτό το σχόλιο σπάει την πολιτική %(site)s"

#, machine, plain1
msgid "This comment can't be forwarded."
msgstr "Αυτό το σχόλιο δεν μπορεί να διαβιβαστεί."

#, machine, plain1
msgid "This comment can't be reposted."
msgstr "Αυτό το σχόλιο δεν μπορεί να αναδημοσιευτεί."

#, machine, plain1
msgid "This comment is on a copy forwarded to a guild - ask that guild's guildmasters to remove it instead."
msgstr "Αυτό το σχόλιο είναι σε ένα αντίγραφο που προωθείται σε μια συντεχνία - ζητήστε από τους συντονιστές συντεχνίας να το αφαιρέσουν αντ 'αυτού."

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a>"
msgstr "Αυτό το τμήμα σχολίων είναι μια πόλη φάντασμα. <a href=\"%(url)s\">Υπογραφή</a>"

#, machine, plain1, python-format
msgid "This comment section is a ghost town. <a href=\"%(url)s\">Sign in</a> to comment!"
msgstr "Αυτό το τμήμα σχολίων είναι μια πόλη φάντασμα. <a href=\"%(url)s\">Υπογραφή</a> να σχολιάσω!"

#, machine, plain1
msgid "This comment section is a ghost town. Be the first to comment!"
msgstr "Αυτό το τμήμα σχολίων είναι μια πόλη φάντασμα. Να είσαι ο πρώτος που θα σχολιάσει!"

#, machine, plain1
msgid "This comment section is a ghost town..."
msgstr "Αυτό το τμήμα σχολίων είναι μια πόλη φάντασμα..."

#, machine, plain1
msgid "This content has already been posted"
msgstr "Το περιεχόμενο αυτό έχει ήδη δημοσιευθεί"

#, machine, plain1
msgid "This copy is no longer kept."
msgstr "Αυτό το αντίγραφο δεν φυλάσσεται πλέον."

#, machine, plain2
msgid "This couldn't be changed right now."
msgstr "Αυτό δεν μπορεί να αλλάξει τώρα."

#, machine, plain1
msgid "This creates a new, independent post in that guild with its own votes and comments. The title is generated from the comment's text. A link back to the original comment will be shown on the new post."
msgstr "Αυτό δημιουργεί μια νέα, ανεξάρτητη θέση στην εν λόγω συντεχνία με τις δικές της ψήφους και σχόλια. Ο τίτλος δημιουργείται από το κείμενο του σχολίου. Ένας σύνδεσμος πίσω στο αρχικό σχόλιο θα εμφανιστεί στη νέα θέση."

#, machine, plain1
msgid "This creates an independent copy of the post with its own votes and comments in that guild. You can forward to any guild that accepts forwards from you."
msgstr "Αυτό δημιουργεί ένα ανεξάρτητο αντίγραφο της θέσης με τις δικές του ψήφους και σχόλια σε εκείνη τη συντεχνία. Μπορείτε να προωθήσετε κάθε συντεχνία που δέχεται μπροστά από εσάς."

#, machine, plain1
msgid "This curation's feed server has been asked too often. Try again in a minute."
msgstr "Αυτός ο διακομιστής τροφοδοσίας έχει ζητηθεί πολύ συχνά. Προσπάθησε ξανά σε ένα λεπτό."

#, machine, plain1
msgid "This curation's feed server has not been answering."
msgstr "Αυτός ο διακομιστής τροφοδοσίας δεν έχει απαντήσει."

#, machine, plain1
msgid "This curation's feed server has not been answering. Showing its last answer."
msgstr "Αυτός ο διακομιστής τροφοδοσίας δεν έχει απαντήσει. Δείχνει την τελευταία του απάντηση."

#, machine, plain1
msgid "This curation's guilds and accounts"
msgstr "Αυτή η επιμέλεια συντεχνιών και λογαριασμών του feed"

#, machine, plain1
msgid "This curation's rules took too long to run. Its owner can make them narrower."
msgstr "Αυτή η επιμέλεια κανόνες του feed πήρε πάρα πολύ καιρό για να τρέξει. Ο ιδιοκτήτης του μπορεί να τους κάνει πιο στενούς."

#, machine, plain2
msgid "This decision can't be appealed."
msgstr "Αυτή η απόφαση δεν μπορεί να γίνει δεκτή."

#, machine, plain2
msgid "This decision has already been lifted."
msgstr "Η απόφαση αυτή έχει ήδη αρθεί."

#, machine, plain2
msgid "This decision is about you. If you think it was wrong, you can appeal it."
msgstr "Αυτή η απόφαση αφορά εσένα. Αν νομίζεις ότι ήταν λάθος, μπορείς να κάνεις έφεση."

#, python-format
msgid "This decision is in the Log, and you can appeal it: [See it in the Log](%(log)s) · [Appeal this decision](%(appeal)s)"
msgstr ""

#, machine, plain1
msgid "This deletes their account and everything on it. It can't be undone. You can download their data first."
msgstr "Αυτό διαγράφει το λογαριασμό τους και τα πάντα σε αυτό. Δεν μπορεί να αναιρεθεί. Μπορείτε να κατεβάσετε τα δεδομένα τους πρώτα."

#, machine, plain2
msgid "This device will be signed out shortly."
msgstr "Αυτή η συσκευή θα αποσυνδεθεί σύντομα."

#, machine, plain1
msgid "This draft hasn't been published."
msgstr "Αυτό το προσχέδιο δεν έχει δημοσιευθεί."

#, machine, plain1
msgid "This event is over."
msgstr "Το γεγονός τελείωσε."

#, machine, plain1
msgid "This event was cancelled."
msgstr "Το γεγονός αυτό ακυρώθηκε."

#, machine, plain1
msgid "This exact phrase"
msgstr "Αυτή ακριβώς η φράση"

#, machine, plain1
msgid "This guild discusses sensitive topics"
msgstr "Αυτή η συντεχνία συζητά ευαίσθητα θέματα"

#, machine, plain1
msgid "This guild discusses sensitive topics (every post here will be blurred by default)."
msgstr "Αυτή η συντεχνία συζητά ευαίσθητα θέματα (κάθε θέση εδώ θα είναι θολή από προεπιλογή)."

#, machine, plain2
msgid "This guild is already banned."
msgstr "Αυτή η συντεχνία έχει ήδη απαγορευτεί."

#, machine, plain1
msgid "This guild is banned."
msgstr "Αυτή η συντεχνία απαγορεύεται."

#, machine, plain1
msgid "This guild is private. Content posted prior to the guild being set to private is visible to everyone."
msgstr "Αυτή η συντεχνία είναι ιδιωτική. Το περιεχόμενο που δημοσιεύτηκε πριν από τη συντεχνία είναι ορατό σε όλους."

#, machine, plain1
msgid "This guild's channels are closed."
msgstr "Τα κανάλια αυτής της συντεχνίας είναι κλειστά."

#, machine, plain2
msgid "This has a legal-level record, which can't be cited."
msgstr "Αυτό έχει ποινικό μητρώο, το οποίο δεν μπορεί να αναφερθεί."

#, machine, plain2
msgid "This has been deleted."
msgstr "Αυτό έχει διαγραφεί."

#, machine, plain1
msgid "This invitation was already answered."
msgstr "Η πρόσκληση αυτή είχε ήδη απαντηθεί."

#, machine, plain1
msgid "This is a Space: its discussion is in the Space."
msgstr "Αυτό είναι ένα Διάστημα: η συζήτησή του είναι στο Διάστημα."

#, machine, plain1, python-format
msgid "This is a Space: its discussion is in the Space. <a href=\"%(url)s\">Open the Space</a>"
msgstr "Αυτό είναι ένα Διάστημα: η συζήτησή του είναι στο Διάστημα. <a href=\"%(url)s\">Άνοιγμα του χώρου</a>"

#, machine, plain1
msgid "This is a Space: its host and co-hosts post its updates from the Space."
msgstr "Αυτό είναι ένα Διάστημα: ο οικοδεσπότης και οι συμπαρουσιαστές του δημοσιεύουν τις ενημερώσεις του από το Διάστημα."

#, machine, plain1, python-format
msgid "This is a log of moderator actions performed in +%(guild)s. The ones everyone may read are also in the site-wide <a href=\"%(url)s\">Log</a>. What members delete themselves is not published."
msgstr "Αυτό είναι ένα αρχείο ενεργειών συντονιστή που εκτελούνται σε +%(guild)s. Αυτά που ο καθένας μπορεί να διαβάσει είναι επίσης σε όλη την ιστοσελίδα <a href=\"%(url)s\">Καταγραφή</a>. Αυτό που τα μέλη διαγράφονται δεν δημοσιεύεται."

#, machine, plain2
msgid "This is already anonymous."
msgstr "Αυτό είναι ήδη ανώνυμο."

#, machine, plain1
msgid "This is already in your language."
msgstr "Αυτό είναι ήδη στη γλώσσα σας."

#, machine, plain2
msgid "This is for chat on this site. A chat app you use outside it follows its own setting."
msgstr "Αυτό είναι για συζήτηση σε αυτό το site. Μια εφαρμογή συνομιλίας που χρησιμοποιείτε έξω ακολουθεί τη δική της ρύθμιση."

#, machine, plain1
msgid "This is for the members of a Circle guild."
msgstr "Αυτό είναι για τα μέλη μιας συντεχνίας Κύκλου."

#. %(name)s is the username of the person who made the post
#, machine, plain1, python-format
msgid "This is for the people in one of <a href=\"%(url)s\">@%(name)s</a>'s circles."
msgstr "Αυτό είναι για τους ανθρώπους σε ένα από τα <a href=\"%(url)s\">@%(name)s</a>Είναι κύκλοι."

#, machine, plain2
msgid "This is in a private place, and a private item can't be cited in the public Log."
msgstr "Αυτό είναι σε ιδιωτικό χώρο, και ένα ιδιωτικό αντικείμενο δεν μπορεί να αναφερθεί στο δημόσιο ημερολόγιο."

#, machine, plain1
msgid "This is the guild's custom CSS file."
msgstr "Αυτό είναι το έθιμο της συντεχνίας. CSS Αρχείο."

#, machine, plain1
msgid "This is too much like what was posted automatically today."
msgstr "Αυτό είναι πάρα πολύ σαν αυτό που δημοσιεύτηκε αυτόματα σήμερα."

#, machine, plain1
msgid "This isn't available while your account is age-restricted. You can confirm your age in Settings > Content."
msgstr "Αυτό δεν είναι διαθέσιμο όσο ο λογαριασμός σας είναι περιορισμένος. Μπορείτε να επιβεβαιώσετε την ηλικία σας στις Settings > Περιεχόμενο."

#, machine, plain2
msgid "This isn't one of the account's own posts or comments."
msgstr "Αυτό δεν είναι ένα από τα άρθρα ή σχόλια του λογαριασμού."

#, machine, plain1
msgid "This isn't shown at your current word filter level. You can review your word filter in your content settings."
msgstr "Αυτό δεν φαίνεται στο τρέχον επίπεδο φίλτρου λέξεων. Μπορείτε να αναθεωρήσετε το φίλτρο λέξεων στις ρυθμίσεις περιεχομένου σας."

#, machine, plain1
msgid "This isn't shown where you are until your age has been confirmed. Sign in to do that in your content settings."
msgstr "Αυτό δεν φαίνεται που είσαι μέχρι να επιβεβαιωθεί η ηλικία σου. Συνδεθείτε για να το κάνετε αυτό στις ρυθμίσεις περιεχομένου σας."

#, machine, plain1
msgid "This isn't shown while your account is age-restricted."
msgstr "Αυτό δεν φαίνεται όσο ο λογαριασμός σου είναι περιορισμένος."

#, machine, plain2
msgid "This isn't yours to change, or it is already gone."
msgstr "Αυτό δεν είναι δικό σου για να αλλάξεις, ή έχει ήδη φύγει."

#, machine, plain1, python-format
msgid "This live thread ended a moment ago. It can go live again in %(num)s min."
msgid_plural "This live thread ended a moment ago. It can go live again in %(num)s min."
msgstr[0] "Αυτή η ζωντανή κλωστή τελείωσε πριν λίγο. Μπορεί να ξαναζωντανέψει σε %(num)s λεπτό."
msgstr[1] "Αυτή η ζωντανή κλωστή τελείωσε πριν λίγο. Μπορεί να ξαναζωντανέψει σε %(num)s λεπτά."

#, machine, plain1
msgid "This live thread has ended"
msgstr "Αυτό το ζωντανό νήμα τελείωσε"

#, machine, plain1
msgid "This may be misleading or needs context (request a community note)"
msgstr "Αυτό μπορεί να είναι παραπλανητικό ή να χρειάζεται πλαίσιο (ζητήστε ένα σημείωμα κοινότητας)"

#, machine, plain1
msgid "This month"
msgstr "Αυτό το μήνα"

#, machine, plain1
msgid "This needs a verified email address."
msgstr "Αυτό χρειάζεται μια επαληθευμένη διεύθυνση ηλεκτρονικού ταχυδρομείου."

#, machine, plain1
msgid "This page is empty."
msgstr "Αυτή η σελίδα είναι άδεια."

#, machine, plain1, python-format
msgid "This page is generated by the %(site)s application introspecting its own routing functions. Nifty."
msgstr "Αυτή η σελίδα δημιουργείται από την εφαρμογή %(site)s που εξετάζει τις δικές της λειτουργίες δρομολόγησης. Νιφτό."

#, machine, plain1
msgid "This page lists offensive words"
msgstr "Αυτή η σελίδα περιέχει προσβλητικές λέξεις"

#, machine, plain1
msgid "This page may not be embedded in other webpages."
msgstr "Αυτή η σελίδα μπορεί να μην είναι ενσωματωμένη σε άλλες ιστοσελίδες."

#, machine, plain1
msgid "This page was opened from a link, not by your camera."
msgstr "Αυτή η σελίδα άνοιξε από ένα σύνδεσμο, όχι από την κάμερα σας."

#, machine, plain1
msgid "This permanently erases the comment text. It cannot be undone, even by an admin."
msgstr "Αυτό διαγράφει μόνιμα το κείμενο σχολίων. Δεν μπορεί να αναιρεθεί, ακόμη και από έναν διαχειριστή."

#, machine, plain1
msgid "This permanently erases the post title, text and link. It cannot be undone, even by an admin."
msgstr "Αυτό διαγράφει μόνιμα τον τίτλο, το κείμενο και το σύνδεσμο. Δεν μπορεί να αναιρεθεί, ακόμη και από έναν διαχειριστή."

#, machine, plain1
msgid "This person is blocking you."
msgstr "Αυτό το άτομο σε μπλοκάρει."

#, machine, plain1
msgid "This phone signed in with a QR code, so it can't approve another one. Enter your password here, then scan a new code."
msgstr "Αυτό το τηλέφωνο υπέγραψε με ένα QR Κωδικός, οπότε δεν μπορεί να εγκρίνει άλλο. Εισάγετε εδώ τον κωδικό σας και μετά σαρώστε έναν νέο κωδικό."

#, machine, plain1
msgid "This poll has ended."
msgstr "Η δημοσκόπηση τελείωσε."

#, machine, plain1
msgid "This poll is no longer available."
msgstr "Αυτή η δημοσκόπηση δεν είναι πλέον διαθέσιμη."

#, machine, plain1
msgid "This post and its comments are archived and can no longer be voted on."
msgstr "Αυτή η δημοσίευση και τα σχόλιά της αρχειοθετούνται και δεν μπορούν πλέον να ψηφιστούν."

#, machine, plain1, python-format
msgid "This post breaks %(site)s policy"
msgstr "Αυτή η θέση σπάει την πολιτική %(site)s"

#, machine, plain1
msgid "This post can't be forwarded."
msgstr "Αυτή η ανάρτηση δεν μπορεί να προωθηθεί."

#, machine, plain1
msgid "This post can't be reposted."
msgstr "Αυτό το πόστο δεν μπορεί να αναδημοσιευτεί."

#, machine, plain1
msgid "This post can't go live."
msgstr "Αυτή η θέση δεν μπορεί να πάει ζωντανά."

#, machine, plain1
msgid "This post does not exist."
msgstr "Αυτή η ανάρτηση δεν υπάρχει."

#, machine, plain1
msgid "This post has no comments on the profile. Choose a guild's."
msgstr "Αυτή η ανάρτηση δεν έχει σχόλια για το προφίλ. Διάλεξε συντεχνία."

#, machine, plain1
msgid "This post has no comments on the profile. Its comments are in the guilds it was posted to."
msgstr "Αυτή η ανάρτηση δεν έχει σχόλια για το προφίλ. Τα σχόλιά του βρίσκονται στις συντεχνίες στις οποίες αναρτήθηκε."

#, machine, plain1
msgid "This post has no comments on your profile now. Its comments are in the guilds."
msgstr "Αυτή η ανάρτηση δεν έχει σχόλια για το προφίλ σας τώρα. Τα σχόλιά του βρίσκονται στις συντεχνίες."

#, machine, plain1
msgid "This post has no live thread."
msgstr "Αυτή η ανάρτηση δεν έχει ζωντανή κλωστή."

#, machine, plain2
msgid "This post is anonymous, so your credit will be too: other members will see it as \"Anonymous\" with a number. Admins and the post's author can still see it is you."
msgstr "Αυτή η ανάρτηση είναι ανώνυμη, έτσι ώστε η πίστωσή σας θα είναι πάρα πολύ: άλλα μέλη θα το δείτε ως \"Ανώνυμο\" με έναν αριθμό. Οι διοικητές και ο συγγραφέας της θέσης μπορούν ακόμα να δουν ότι είσαι εσύ."

#, machine, plain1
msgid "This post is from an account you muted."
msgstr "Αυτή η δημοσίευση είναι από ένα λογαριασμό που σίγησες."

#, machine, plain1
msgid "This post is live already."
msgstr "Αυτή η ανάρτηση είναι ήδη ζωντανή."

#, machine, plain1
msgid "This post is public now."
msgstr "Αυτή η ανάρτηση είναι δημόσια τώρα."

#, machine, plain1
msgid "This post isn't available."
msgstr "Αυτή η ανάρτηση δεν είναι διαθέσιμη."

#, machine, plain1
msgid "This post isn't in any guild, so its comments can only be on your profile."
msgstr "Αυτή η δημοσίευση δεν είναι σε καμία συντεχνία, έτσι τα σχόλιά της μπορεί να είναι μόνο στο προφίλ σας."

#, machine, plain1
msgid "This post isn't live."
msgstr "Αυτό το πόστο δεν είναι ζωντανό."

#, machine, plain1
msgid "This post was deleted."
msgstr "Αυτή η δημοσίευση διαγράφηκε."

#, machine, plain1
msgid "This post was removed, so it can't be changed."
msgstr "Αυτό το πόστο αφαιρέθηκε, οπότε δεν μπορεί να αλλάξει."

#, machine, plain1
msgid "This post was removed."
msgstr "Αυτό το πόστο αφαιρέθηκε."

#, machine, plain1
msgid "This post will be visible to everyone. Confirm to make it public."
msgstr "Αυτή η ανάρτηση θα είναι ορατή σε όλους. Επιβεβαιώστε να δημοσιοποιηθεί."

#, machine, plain1
msgid "This post's authors are decided in its shared draft."
msgstr "Οι συγγραφείς αυτής της ανάρτησης αποφασίζονται στο κοινό προσχέδιο της."

#, machine, plain1
msgid "This promotion has already ended. Sorry about that."
msgstr "Αυτή η προαγωγή έχει ήδη τελειώσει. Συγγνώμη γι' αυτό."

#, machine, plain1
msgid "This promotion hasn't started yet. Try again later."
msgstr "Αυτή η προαγωγή δεν έχει ξεκινήσει ακόμα. Προσπάθησε ξανά αργότερα."

#, machine, plain1
msgid "This proposal is closed."
msgstr "Η πρόταση αυτή έληξε."

#, machine, plain1
msgid "This queue is empty. (That's a good thing.)"
msgstr "Αυτή η ουρά είναι άδεια. Αυτό είναι καλό"

#, machine, plain2
msgid "This relies on the anonymous post or comment you opened it from. The site keeps a private copy of it as it is now."
msgstr "Αυτό βασίζεται στην ανώνυμη δημοσίευση ή σχόλιο που το ανοίξατε. Το site κρατά ένα ιδιωτικό αντίγραφο του όπως είναι τώρα."

#, machine, plain1
msgid "This requires entering a randomly-generated, 6-digit code and your password to login. See <a href=\"#\">Google Authenticator</a> or <a href=\"#\">Authy</a> for more details."
msgstr "Αυτό απαιτεί την εισαγωγή ενός τυχαία δημιουργημένου, 6-ψηφίου κώδικα και του κωδικού πρόσβασης σας για σύνδεση. Βλέπεις; <a href=\"#\">Google Ταυτοποιητής</a> ή <a href=\"#\">Όθι</a> για περισσότερες λεπτομέρειες."

#, machine, plain1
msgid "This revision was removed by the site's admins."
msgstr "Αυτή η αναθεώρηση αφαιρέθηκε από τους διαχειριστές της ιστοσελίδας."

#. %(error)s is the reason, a whole sentence such as "You are posting too
#. fast."
#, machine, plain1, python-format
msgid "This scheduled post could not be published: %(error)s Fix it, then post it or schedule it again."
msgstr "Αυτή η προγραμματισμένη δημοσίευση δεν μπορεί να δημοσιευθεί: %(error)s Φτιάξ' το, μετά στείλ' το ή προγραμμάτισέ το ξανά."

#. from:, in: are search operators and stay as they are
#, machine, plain1
msgid "This search took too long. Add words, or narrow it with from:, in: or a date."
msgstr "Η έρευνα πήρε πολύ χρόνο. Προσθέστε λέξεις, ή να το στενεύουν με:, σε: ή μια ημερομηνία."

#, machine, plain1
msgid "This sign-in can't go on"
msgstr "Αυτή η υπογραφή δεν μπορεί να συνεχιστεί"

#, machine, plain1
msgid "This sign-in lasts 12 hours, and chat, coins, apps, following, who can see what you share and account settings ask for your password first."
msgstr "Αυτή η είσοδος διαρκεί 12 ώρες, και η συνομιλία, κέρματα, εφαρμογές, που ακολουθούν, ποιος μπορεί να δει τι μοιράζεστε και τις ρυθμίσεις λογαριασμού ζητούν τον κωδικό πρόσβασης σας πρώτα."

#, machine, plain1
msgid "This sign-in request didn't come from a chat app this site knows."
msgstr "Αυτή η αίτηση εγγραφής δεν προήλθε από μια εφαρμογή συνομιλίας που ξέρει αυτή η ιστοσελίδα."

#, machine, plain1
msgid "This topic has dropped off the list. <a href=\"/trending\">See what is trending now</a>."
msgstr "Αυτό το θέμα έπεσε από τη λίστα. <a href=\"/trending\">Δείτε τι είναι τάση τώρα</a>."

#, machine, plain1
msgid "This user has blocked you"
msgstr "Αυτός ο χρήστης σας έχει μπλοκάρει"

#, machine, plain1
msgid "This user has enabled private mode to cloak their posting history."
msgstr "Αυτός ο χρήστης έχει ενεργοποιήσει την ιδιωτική λειτουργία για να καλύψει το ιστορικό αποστολής τους."

#, machine, plain1
msgid "This user is blocking you."
msgstr "Αυτός ο χρήστης σε μπλοκάρει."

#, machine, plain1, python-format
msgid "This voice channel is full (%(num)s person)."
msgid_plural "This voice channel is full (%(num)s people)."
msgstr[0] "Αυτό το κανάλι φωνής είναι πλήρες (%(num)s άτομο)."
msgstr[1] "Αυτό το κανάλι φωνής είναι γεμάτο (%(num)s άτομα)."

#, machine, plain1
msgid "This voice channel isn't available right now."
msgstr "Αυτό το κανάλι φωνής δεν είναι διαθέσιμο τώρα."

#, machine, plain2
msgid "This was erased within five minutes of being made, so it has no public record to attach to."
msgstr "Αυτό διαγράφηκε μέσα σε πέντε λεπτά από τότε που έγινε, οπότε δεν έχει κανένα δημόσιο αρχείο να επισυναφθεί."

#, machine, plain1
msgid "This will also invalidate any existing recovery links associated with this account."
msgstr "Αυτό θα ακυρώσει επίσης τυχόν υπάρχοντες συνδέσεις ανάκτησης που σχετίζονται με αυτόν τον λογαριασμό."

#, machine, plain1
msgid "This will hide your post and comment history from others. We will also ask search engines to not index your profile page. (Your content will still be accessible via direct link.)"
msgstr "Αυτό θα κρύψει το post σας και να σχολιάσει την ιστορία από τους άλλους. Θα ζητήσουμε επίσης από τις μηχανές αναζήτησης να μην ευρετηριάζουν τη σελίδα προφίλ σας. (Το περιεχόμενό σας θα εξακολουθεί να είναι προσβάσιμο μέσω άμεσης σύνδεσης.)"

#, machine, plain1, python-format
msgid "This will permanently delete your %(site)s Account. Be careful, this cannot be undone."
msgstr "Αυτό θα διαγράψει οριστικά το %(site)s σας Λογαριασμός. Πρόσεχε, αυτό δεν μπορεί να αναιρεθεί."

#, machine, plain1
msgid "Those are already the rules."
msgstr "Αυτοί είναι ήδη οι κανόνες."

#, machine, plain1
msgid "Those dates leave no days to search."
msgstr "Αυτές οι ημερομηνίες δεν αφήνουν μέρες για αναζήτηση."

#, machine, plain2
msgid "Those keys couldn't be used."
msgstr "Αυτά τα κλειδιά δεν μπορούσαν να χρησιμοποιηθούν."

#, machine, plain1
msgid "Through the app"
msgstr "Μέσω της εφαρμογής"

#, machine, plain1
msgctxt "weekday"
msgid "Thu"
msgstr "Θου"

#, machine, plain1
msgid "Tick the box to agree to the Terms for them."
msgstr "Ενεργοποιήστε το πλαίσιο για να συμφωνήσετε με τους Όρους τους."

#, machine, plain1
msgid "Tick the box to agree to the rules first."
msgstr "Ενεργοποιήστε πρώτα το πλαίσιο για να συμφωνήσετε με τους κανόνες."

#. the tooltip of a category's tick box in the Categorical list
#, machine, plain1
msgid "Ticks all its subcategories. Untick them to keep only the guilds filed under the category itself."
msgstr "Γράφει όλες τις υποκατηγορίες του. Ξεκολλήστε τους για να κρατήσουν μόνο τις συντεχνίες καταχωρημένες στην ίδια την κατηγορία."

#, glossary, machine, plain2
msgid "Time"
msgstr "Περίοδος"

#, machine, plain1
msgid "Time range"
msgstr "Χρονικό εύρος"

