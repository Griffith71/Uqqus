msgstr "Μπλοκάρετε αυτόν τον χρήστη, αλλά μπορείτε να δείτε αυτό το σχόλιο επειδή είστε διαχειριστής."

#, glossary, machine, plain2
msgid "You're blocking this user."
msgstr "Έχετε αποκλείσει αυτόν τον χρήστη."

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "Το κάνεις πάρα πολύ. Προσπάθησε ξανά αργότερα."

#, machine, plain1, python-format
msgid "You're in. It renews in 30 days for %(num)s coins unless you cancel."
msgid_plural "You're in. It renews in 30 days for %(num)s coins unless you cancel."
msgstr[0] "Είσαι μέσα. Ανανεώνεται σε 30 ημέρες για %(num)s νομίσματα εκτός αν ακυρώσετε."
msgstr[1] "Είσαι μέσα. Ανανεώνεται σε 30 ημέρες για %(num)s νομίσματα εκτός αν ακυρώσετε."

#, machine, plain1
msgid "You're invited to speak."
msgstr "Είσαι καλεσμένος να μιλήσεις."

#, python-format
msgid "You're invited to write a shared draft with others. [See the invitation](%(link)s)"
msgstr ""

#, machine, plain1
msgid "You're no longer signed in here. Sign in again to use chat."
msgstr "Δεν είσαι πλέον εδώ. Συνδεθείτε ξανά για να χρησιμοποιήσετε συνομιλία."

#, machine, plain1
msgid "You're not following any curations yet."
msgstr "Δεν ακολουθείς ακόμα καμία επιμελημένη τροφοδοσία."

#, machine, plain1
msgid "You're not in this Space."
msgstr "Δεν είσαι σε αυτό το διάστημα."

#, machine, plain1
msgid "You're sending messages too quickly. Wait a moment."
msgstr "Στέλνεις μηνύματα πολύ γρήγορα. Περίμενε ένα λεπτό."

#, machine, plain1, python-format
msgid "You're subscribed. It renews in 30 days for %(num)s coins unless you cancel."
msgid_plural "You're subscribed. It renews in 30 days for %(num)s coins unless you cancel."
msgstr[0] "Είσαι συνδρομητής. Ανανεώνεται σε 30 ημέρες για %(num)s νομίσματα εκτός αν ακυρώσετε."
msgstr[1] "Είσαι συνδρομητής. Ανανεώνεται σε 30 ημέρες για %(num)s νομίσματα εκτός αν ακυρώσετε."

#, machine, plain2
msgid "You're told of new messages and calls in your chats, never what a message says. Each group can be set to every message, calls only or nothing, in the group's people sheet."
msgstr "Σας λένε για νέα μηνύματα και κλήσεις στις συνομιλίες σας, ποτέ τι λέει ένα μήνυμα. Κάθε ομάδα μπορεί να οριστεί σε κάθε μήνυμα, κλήσεις μόνο ή τίποτα, στο φύλλο των ανθρώπων της ομάδας."

#, machine, plain1
msgid "You're writing very fast. Wait a moment."
msgstr "Γράφεις πολύ γρήγορα. Περίμενε ένα λεπτό."

#, machine, plain1
msgid "You've added a lot of people to groups today. Try again tomorrow."
msgstr "Προσθέσατε πολλούς ανθρώπους σε ομάδες σήμερα. Προσπάθησε ξανά αύριο."

#, machine, plain1
msgid "You've already answered this. Only an admin can change your answer."
msgstr "Έχεις ήδη απαντήσει σε αυτό. Μόνο ένας διαχειριστής μπορεί να αλλάξει την απάντησή σου."

#, machine, plain1
msgid "You've already reported this Space."
msgstr "Έχετε ήδη αναφέρει αυτό το Διάστημα."

#, machine, plain1
msgid "You've already reported this message."
msgstr "Έχεις ήδη αναφέρει αυτό το μήνυμα."

#, machine, plain1
msgid "You've already reposted this."
msgstr "Ήδη το επαναδημοσίευσες αυτό."

#, machine, plain1, python-format
msgid "You've been in this voice channel for %(num)s hour. Join again if you're still here."
msgid_plural "You've been in this voice channel for %(num)s hours. Join again if you're still here."
msgstr[0] "Είσαι σ' αυτό το κανάλι για %(num)s ώρα. Έλα ξανά αν είσαι ακόμα εδώ."
msgstr[1] "Είσαι σε αυτό το κανάλι για %(num)s ώρες. Έλα ξανά αν είσαι ακόμα εδώ."

#, machine, plain1, python-format
msgid "You've been invited to be a guildmaster of <span class=\"font-weight-bold\">+%(guild)s</span>. You will have full permissions over the guild."
msgstr "Προσκλήθηκες να γίνεις συντονιστής συντεχνιών. <span class=\"font-weight-bold\">+%(guild)s</span>Θα έχετε πλήρεις άδειες για τη συντεχνία."

#, machine, plain1
msgid "You've joined voice channels a lot in the last hour. Try again later."
msgstr "Μπήκες συχνά σε φωνητικά κανάλια την τελευταία ώρα. Προσπάθησε ξανά αργότερα."

#, machine, plain1
msgid "You've sent a lot of feedback today. Try again tomorrow."
msgstr "Έστειλες πολλά σχόλια σήμερα. Προσπάθησε ξανά αύριο."

#, machine, plain2
msgid "You've sent a lot of files today. Try again tomorrow."
msgstr "Έστειλες πολλούς φακέλους σήμερα. Προσπάθησε ξανά αύριο."

#, machine, plain1
msgid "You've sent a lot of reports today. Try again tomorrow."
msgstr "Έστειλες πολλές αναφορές σήμερα. Προσπάθησε ξανά αύριο."

#, machine, plain2
msgid "You've sent a lot of reports. Try again later."
msgstr "Έστειλες πολλές αναφορές. Προσπάθησε ξανά αργότερα."

#, machine, plain1
msgid "You've started a lot of calls in the last hour. Try again later."
msgstr "Ξεκίνησες πολλά τηλεφωνήματα την τελευταία ώρα. Προσπάθησε ξανά αργότερα."

#, machine, plain1
msgid "YouTube did not accept that video."
msgstr "YouTube Δεν δέχτηκε το βίντεο."

#, machine, plain1
msgid "YouTube is not taking more uploads right now. Try again later."
msgstr "Το YouTube δεν παίρνει περισσότερα ανεβάσματα τώρα. Προσπάθησε ξανά αργότερα."

#, machine, plain1
msgid "YouTube link"
msgstr "YouTube σύνδεση"

#, machine, plain1, python-format
msgid "Your %(site)s account has been permanently suspended due to a Terms of Service violation."
msgstr "Το δικό σου %(site)s Ο λογαριασμός έχει ανασταλεί μόνιμα λόγω παραβίασης των όρων υπηρεσίας."

#, machine, plain1, python-format
msgid ""
"Your %(site)s account has been permanently suspended for the following reason:\n"
"\n"
"> %(message)s"
msgstr ""
"Ο λογαριασμός σας %(site)s έχει ανασταλεί οριστικά για τον ακόλουθο λόγο:\n"
"\n"
"> %(message)s"

#, python-format
msgid "Your %(site)s account has been reinstated. Please carefully review and abide by the [terms of service](/help/terms) and [rules and guidelines](/help/rules) to ensure that you don't get suspended again."
msgstr ""

#, python-format
msgid ""
"Your %(site)s account has been reinstated. Please carefully review and abide by the [terms of service](/help/terms) and [rules and guidelines](/help/rules) to ensure that you don't get suspended again.\n"
"\n"
"It is still on hold, so it can't post, comment or act on others for now. A member of the staff will look at it."
msgstr ""

#, machine, plain1, python-format
msgid "Your %(site)s account has been suspended for %(days)s days due to a Terms of Service violation."
msgstr "Το δικό σου %(site)s ο λογαριασμός έχει ανασταλεί για %(days)s ημέρες λόγω παραβίασης των όρων υπηρεσίας."

#, machine, plain1, python-format
msgid ""
"Your %(site)s account has been suspended for %(days)s days for the following reason:\n"
"\n"
"> %(message)s"
msgstr ""
