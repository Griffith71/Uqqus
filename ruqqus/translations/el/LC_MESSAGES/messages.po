msgstr "Μια εικόνα μπορεί να είναι 8 MB το πολύ."

#, machine, plain1
msgid "A picture must be a PNG, JPEG, GIF or WebP file."
msgstr "Μια εικόνα πρέπει να είναι ένα αρχείο PNG, JPEG, GIF ή WebP."

#, machine, plain1, python-format
msgid "A place can be at most %(num)s character."
msgid_plural "A place can be at most %(num)s characters."
msgstr[0] "Ένα μέρος μπορεί να είναι το πολύ ένας χαρακτήρας."
msgstr[1] "Ένα μέρος μπορεί να είναι το πολύ %(num)s χαρακτήρες."

#, machine, plain1
msgid "A place is plain text."
msgstr "Ένα μέρος είναι απλό κείμενο."

#, machine, plain1, python-format
msgid "A point needs an account at least %(num)s day old that is not banned or deleted. Your own votes and comments never count."
msgid_plural "A point needs an account at least %(num)s days old that is not banned or deleted. Your own votes and comments never count."
msgstr[0] "Ένα σημείο χρειάζεται ένα λογαριασμό τουλάχιστον μιας ημέρας που δεν απαγορεύεται ή διαγράφεται. Οι ψήφοι και τα σχόλιά σας δεν μετράνε ποτέ."
msgstr[1] "Ένα σημείο χρειάζεται ένα λογαριασμό τουλάχιστον %(num)s ημερών που δεν απαγορεύεται ή διαγράφεται. Οι ψήφοι και τα σχόλιά σας δεν μετράνε ποτέ."

#, machine, plain1, python-format
msgid "A poll can have %(num)s option at most."
msgid_plural "A poll can have %(num)s options at most."
msgstr[0] "Μια δημοσκόπηση μπορεί να έχει %(num)s επιλογή το πολύ."
msgstr[1] "Μια δημοσκόπηση μπορεί να έχει %(num)s επιλογές το πολύ."

#, machine, plain1, python-format
msgid "A poll needs at least %(num)s option."
msgid_plural "A poll needs at least %(num)s options."
msgstr[0] "Μια δημοσκόπηση χρειάζεται τουλάχιστον %(num)s επιλογή."
msgstr[1] "Μια δημοσκόπηση χρειάζεται τουλάχιστον %(num)s επιλογές."

#, machine, plain1, python-format
msgid "A poll option can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A poll option can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] "Μια επιλογή δημοσκόπησης μπορεί να είναι %(num)s χαρακτήρα (κινέζικα, ιαπωνικά και κορεατικά χαρακτήρες και emoji μετρούν ως 2)."
msgstr[1] "Μια επιλογή δημοσκόπησης μπορεί να είναι %(num)s χαρακτήρες (κινέζοι, Ιάπωνες και Κορεάτες χαρακτήρες και emoji μετρούν ως 2)."

