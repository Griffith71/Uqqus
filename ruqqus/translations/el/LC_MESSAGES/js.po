#, machine, plain1
msgid "Your browser blocked the window for connecting. Allow pop-ups for this site, or connect in the settings."
msgstr "Ο περιηγητής σας μπλόκαρε το παράθυρο για σύνδεση. Επιτρέπονται αναδυόμενα για αυτό το site, ή σύνδεση στις ρυθμίσεις."

#, machine, plain1
msgid "Your chat devices can't be listed right now."
msgstr "Οι συσκευές συνομιλίας σας δεν μπορούν να καταχωρηθούν τώρα."

#, machine, plain2
msgid "Your chat recovery code"
msgstr "Ο κωδικός αποκατάστασης συνομιλίας σας"

#, machine, plain1
msgid "Your chats"
msgstr "Οι συζητήσεις σας"

#, machine, plain1
msgid "Your chats will work again on this device, but messages from before can't be read here (or anywhere without your old key)."
msgstr "Οι συνομιλίες σας θα δουλέψουν ξανά σε αυτή τη συσκευή, αλλά μηνύματα από πριν δεν μπορούν να διαβαστούν εδώ (ή οπουδήποτε χωρίς το παλιό κλειδί σας)."

#, machine, plain1
msgid "Your comment could not be posted. Try again."
msgstr "Το σχόλιό σας δεν μπόρεσε να δημοσιευτεί. Προσπάθησε ξανά."

#, machine, plain2
msgid "Your current recovery code will stop working."
msgstr "Ο τρέχων κωδικός σου θα σταματήσει να λειτουργεί."

#, machine, plain1
msgid "Your edit couldn't be saved. Please check your connection and try again."
msgstr "Η επεξεργασία σου δεν μπόρεσε να σωθεί. Παρακαλώ ελέγξτε τη σύνδεσή σας και προσπαθήστε ξανά."

#, machine, plain1
msgid "Your edit couldn't be saved. Please try again."
msgstr "Η επεξεργασία σου δεν μπόρεσε να σωθεί. Παρακαλώ προσπαθήστε ξανά."

#, machine, plain1
msgid "Your files stay in your own account there, using its free space. This site only shows them in your posts."
msgstr "Τα αρχεία σας παραμένουν στο δικό σας λογαριασμό εκεί, χρησιμοποιώντας τον ελεύθερο χώρο του. Αυτή η ιστοσελίδα τους δείχνει μόνο στις θέσεις σας."

#, machine, plain1
msgid "Your guilds' chats"
msgstr "Οι συζητήσεις των συντεχνιών σου"

#. placeholder text a member replaces: the headline of a "Call to action"
#. block, and its button's label
#, machine, plain1
msgid "Your headline"
msgstr "Ο τίτλος σου"

#, machine, plain1
msgid "Your key can't be shown right now."
msgstr "Το κλειδί σου δεν φαίνεται τώρα."

#, machine, plain1
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "Το κλειδί σου ήταν κλειδωμένο με παλιότερο κωδικό πρόσβασης. Ανοίξτε συνομιλία σε αυτό το site και εισάγετε τον κωδικό ανάκτησης σας μία φορά; τότε ανοίγει εδώ."

#, machine, plain1, python-format
msgid "Your message will be sent once chat is unlocked on this device."
msgid_plural "Your %(num)s messages will be sent once chat is unlocked on this device."
msgstr[0] "Το μήνυμά σας θα σταλεί μόλις η συνομιλία ξεκλειδωθεί σε αυτή τη συσκευή."
msgstr[1] "Τα %(num)s μηνύματά σας θα σταλούν μόλις η συνομιλία ξεκλειδωθεί σε αυτή τη συσκευή."

#, machine, plain2
msgid "Your name will show on this comment. Your own words can still give away that you wrote the post, and a comment under your name is not linked to the post by anything we show."
msgstr "Το όνομά σας θα δείξει σε αυτό το σχόλιο. Τα δικά σας λόγια μπορούν ακόμη να δώσουν ότι γράψατε τη δημοσίευση, και ένα σχόλιο με το όνομά σας δεν συνδέεται με τη δημοσίευση από οτιδήποτε δείχνουμε."

#, machine, plain2
msgid "Your old recovery code no longer works."
msgstr "Ο παλιός κωδικός σου δεν λειτουργεί πλέον."

#, machine, plain1
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "Ο κωδικός σας άλλαξε από τότε που το κλειδί συνομιλίας ήταν κλειδωμένο με αυτό. Ο κωδικός ανάκτησης που αποθηκεύσατε όταν δημιουργήθηκε η συνομιλία το ανοίγει."

#, machine, plain1
msgid "Your password was changed for you, so chat is starting again here."
msgstr "Ο κωδικός σου άλλαξε για σένα, οπότε η συνομιλία αρχίζει ξανά εδώ."

#, machine, plain1
msgid "Your password was changed, so chat is starting again here."
msgstr "Ο κωδικός σου άλλαξε, οπότε η συνομιλία αρχίζει πάλι εδώ."

#, machine, plain1
msgid "Your password was reset, so chat is starting again here."
msgstr "Ο κωδικός σου επανατοποθετήθηκε, οπότε η συνομιλία αρχίζει ξανά εδώ."

#, machine, plain1
msgid "Your recovery code"
msgstr "Ο κωδικός ανάκτησής σας"

#, machine, plain1
msgid "Your saved templates show up here."
msgstr "Τα αποθηκευμένα πρότυπα σας εμφανίζονται εδώ."

#, machine, plain2
msgid "Your screen can be shared only while you're on video in this call."
msgstr "Η οθόνη σας μπορεί να μοιραστεί μόνο ενώ είστε σε βίντεο σε αυτή την κλήση."

#, machine, plain2
msgid "Your screen couldn't be shared."
msgstr "Η οθόνη σου δεν μπορούσε να μοιραστεί."

#, machine, plain1
msgid "Your settings have been updated."
msgstr "Οι ρυθμίσεις σας έχουν ενημερωθεί."

#, machine, plain1
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "Η αποθήκευσή σου χρειάζεται σύνδεση ξανά. Στείλτε τον ήχο σας σε:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your pictures to:"
msgstr "Η αποθήκευσή σου χρειάζεται σύνδεση ξανά. Στείλτε τις φωτογραφίες σας στο:"

#, machine, plain1
msgid "Your storage needs connecting again. Send your videos to:"
msgstr "Η αποθήκευσή σου χρειάζεται σύνδεση ξανά. Στείλτε τα βίντεο σας σε:"

#. %(zone)s is a time zone name such as Europe/London
#, machine, plain1, python-format
msgid "Your time zone: %(zone)s"
msgstr "Η ζώνη ώρας σας: %(zone)s"

#, machine, plain1
msgid "Your vote is on another copy of this Space, or it can't change any more."
msgstr "Η ψήφος σου είναι σε άλλο αντίγραφο αυτού του Χώρου, αλλιώς δεν μπορεί να αλλάξει πια."

#, machine, plain1
msgid "You’re all caught up"
msgstr "Είστε όλοι προφθάστε"

#, machine, plain1
msgid "You’re all caught up."
msgstr "Είστε όλοι πρόφθασαν."

