msgid ""
"Your %(site)s account has been permanently suspended for the following reason:\n"
"\n"
"> ban evasion"
msgstr ""
"Ang iyong ulat sa %(site)s ay permanenteng nasuspende sa sumusunod na dahilan:\n"
"\n"
"> Ipagbawal ang Pag - iwas"

#, machine, plain1, python-format
msgid "Your %(site)s account has been reinstated. Please carefully review and abide by the [terms of service](/help/terms) and [rules and guidelines](/help/rules) to ensure that you don't get suspended again."
msgstr "Ang iyong ulat tungkol sa %(site)s ay naibalik na. Pakisuyong repasuhin at sundin ang [terms of service](/help/terms) at [mga tuntunin at panuntunan](/help/rules) upang matiyak na hindi ka muling suspinde."

#, machine, plain1, python-format
msgid "Your %(site)s account has been suspended for %(days)s days due to a Terms of Service violation."
msgstr "Ang iyong %(site)s ay nasuspinde sa loob ng %(days)s na araw dahil sa isang Terminong paglabag sa Service."

#, machine, plain1, python-format
msgid ""
"Your %(site)s account has been suspended for %(days)s days for the following reason:\n"
"\n"
"> %(message)s"
msgstr ""
"Ang iyong %(site)s ay nasuspinde sa loob ng %(days)s na araw sa sumusunod na dahilan:\n"
"\n"
"> %(message)s"

#, machine, plain1, python-format
msgid ""
"Your %(site)s account has been suspended for 1 day for the following reason:\n"
"\n"
"> Too much spam!"
msgstr ""
"Ang iyong %(site)s ay nasuspinde sa loob ng 1 araw sa sumusunod na dahilan:\n"
"\n"
"> Labis na spam!"

#, machine, plain1, python-format
msgid "Your %(site)s password"
msgstr "Ang iyong password na %(site)s"

#, machine, plain1
msgid "Your API Applications"
msgstr "Ang iyong API Mga Pakinabang"

#, machine, plain1
msgid "Your Authorized Applications"
msgstr "Ang Iyong Authorized Supports"

#, machine, plain1
msgid "Your Following feed is empty"
msgstr "Walang laman ang iyong sumusunod na pagkain"

#, machine, plain1
msgid "Your For You feed has been reset."
msgstr "Ang Iyong Pagkain Para sa Iyo ay binago."

#, machine, plain1
msgid "Your Google Drive is full. Free some space and try again."
msgstr "Ang iyong Google Drive ay ganap. Itapon ang ilang espasyo at subukan muli."

#, machine, plain1
msgid "Your ID is verified so you can't change your username."
msgstr "Ang inyong ID ay pinatutunayan upang hindi ninyo mabago ang inyong username."

#, machine, plain1
msgid "Your OneDrive is full. Free some space and try again."
msgstr "Ang iyong OneDrive ay ganap. Itapon ang ilang espasyo at subukan muli."

#, machine, plain1
