msgid ""
"Your %(site)s account has been permanently suspended for the following reason:\n"
"\n"
"> %(message)s"
msgstr ""
"Ang iyong sarili %(site)s ay permanenteng nasuspende sa sumusunod na dahilan:\n"
"\n"
"> %(message)s"

