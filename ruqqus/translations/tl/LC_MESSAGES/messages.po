msgid_plural "You need %(num)s coins to join and you don't have enough."
msgstr[0] "Kailangan mo ng %(num)s barya at wala kang sapat na pera."
msgstr[1] "Kailangan mo ng %(num)s barya para sumali at wala kang sapat."

#, machine, plain1, python-format
msgid "You need %(num)s coins to subscribe and you don't have enough."
msgid_plural "You need %(num)s coins to subscribe and you don't have enough."
msgstr[0] "Kailangan mo ng %(num)s barya para magskriba at wala kang sapat na pera."
msgstr[1] "Kailangan mo ng %(num)s barya upang magskriba at wala kang sapat."

#, machine, plain1
msgid "You need 250 Rep to create a guild. Rep is the upvotes other people give your posts and comments."
msgstr "Kailangan mo ng 250 Reputasyon upang lumikha ng isang samahan. Ang reputasyon ang upvotes na ibinibigay ng ibang tao sa iyong mga post at comments."

#, machine, plain1
msgid "You need more Reputation before you can make a Guild."
msgstr "Kailangan mo ng higit pang reputasyon bago ka makagawa ng Guild."

#, machine, plain1
msgid "You need more Reputation."
msgstr "Kailangan mo ng higit pang Reputasyon."

#, machine, plain1
msgid "You need to actually write something!"
msgstr "Kailangan mo talagang sumulat!"

#, machine, plain1
msgid "You need to log in if you want to get into this castle."
msgstr "Kailangan mong mag - logo kung gusto mong makapasok sa kastilyong ito."

#, machine, plain1
msgid "You need to step down from a guild before you can make any more."
msgstr "Kailangan mong bumaba mula sa isang samahan bago mo pa magawa ito."

#, machine, plain1
msgid "You need to wait 7 days between name changes."
msgstr "Kailangan mong maghintay ng 7 araw sa pagitan ng mga pagbabago ng pangalan."

#, machine, plain1
msgid "You need to wait 7 days between siege attempts."
msgstr "Kailangan mong maghintay ng 7 araw sa pagitan ng pag - aangkin."

#, machine, plain1
msgid "You need to wait a bit."
msgstr "Kailangan mong maghintay nang kaunti."

#, machine, plain1
msgid "You post timestamped updates as things happen; everyone comments under them."
msgstr "Nagpo - post ka ng mga timestamped update habang nangyayari ang mga bagay - bagay; lahat ay nagkokomento sa ilalim ng mga ito."

#, machine, plain1, python-format
msgid "You told us you wanted to change your %(site)s account email. To finish this process, please verify your new email address:"
msgstr "Sinabi mo sa amin na nais mong baguhin ang iyong %(site)s account email. Upang matapos ang prosesong ito, pakisuyong tiyakin ang inyong bagong adres sa email:"

#, machine, plain1
msgid "You won't be notified of comments on this post."
msgstr "Hindi ka mabibigyan ng mga komento sa post na ito."

#, machine, plain1
msgid "You'll be notified of comments on this post."
msgstr "Ipagbibigay - alam sa iyo ang mga komento sa post na ito."

#, machine, plain1, python-format
msgid "You'll be told about everything @%(name)s does."
msgstr "Sasabihin sa iyo ang tungkol sa lahat ng ginagawa ng @i%(name)s."

#, machine, plain1, python-format
msgid "You'll be told when +%(guild)s's guildmasters make an announcement."
msgstr "Sasabihin sa iyo kung kailan gumagawa ng patalastas ang samahan ng +i%(guild)s."

#, machine, plain1
msgid "You're all caught up"
msgstr "Naabutan kayong lahat"

#, machine, plain1
msgid "You're already in this Space in another window."
msgstr "Nasa Kalawakan ka na sa ibang bintana."

#, machine, plain1
msgid "You're already in this call in another window."
msgstr "Nasa ibang bintana ka na sa tawag na ito."

#, machine, plain1
msgid "You're already in this group."
msgstr "Kasama ka na sa grupong ito."

#, machine, plain1
msgid "You're blocking this user, but you can see this comment because it's an admin comment."
msgstr "Hinaharang mo ang gumagamit na ito, subalit makikita mo ang komentong ito sapagkat ito'y isang admin comment."

#, machine, plain1
msgid "You're blocking this user, but you can see this comment because it's in your guild."
msgstr "Hinaharang mo ang gumagamit na ito, subalit makikita mo ang komentong ito sapagkat ito'y nasa iyong samahan."

#, machine, plain1
msgid "You're blocking this user, but you can see this comment because you're an admin."
msgstr "Hinaharang mo ang gumagamit na ito, ngunit makikita mo ang komentong ito sapagkat ikaw ay isang admin."

#, glossary, machine, plain1
msgid "You're blocking this user."
msgstr "Bina-block mo ang user na ito."

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "Ginagawa mo iyan nang labis. Subukan muli mamaya."

#, machine, plain1, python-format
msgid "You're in. It renews in 30 days for %(num)s coins unless you cancel."
msgid_plural "You're in. It renews in 30 days for %(num)s coins unless you cancel."
msgstr[0] "Ikaw ay nasa loob. Ito'y nagbabago sa loob ng 30 araw sa loob ng %(num)s barya malibang kanselahin mo."
msgstr[1] "Ikaw ay nasa loob. Ito'y nagbabago sa loob ng 30 araw sa halagang %(num)s barya malibang kanselahin mo."

#, machine, plain1
msgid "You're invited to speak."
msgstr "Inaanyayahan kang magsalita."

#, python-format
msgid "You're invited to write a shared draft with others. [See the invitation](%(link)s)"
msgstr ""

#, machine, plain1
msgid "You're not following any curations yet."
msgstr "Hindi ka pa sumusunod sa anumang kulot na pagkain."

#, machine, plain1
msgid "You're not in this Space."
msgstr "Wala ka sa Kalawakang ito."

#, machine, plain1
msgid "You're sending messages too quickly. Wait a moment."
msgstr "Napakabilis mong magpadala ng mga mensahe. Sandali lang."

#, machine, plain1, python-format
msgid "You're subscribed. It renews in 30 days for %(num)s coins unless you cancel."
msgid_plural "You're subscribed. It renews in 30 days for %(num)s coins unless you cancel."
msgstr[0] "Nasuskribe ka. Ito'y nagbabago sa loob ng 30 araw sa loob ng %(num)s barya malibang kanselahin mo."
msgstr[1] "Nasuskribe ka. Ito'y nagbabago sa loob ng 30 araw sa halagang %(num)s barya malibang kanselahin mo."

#, machine, plain1
msgid "You're writing very fast. Wait a moment."
msgstr "Napakabilis mong sumulat. Sandali lang."

#, machine, plain1
msgid "You've added a lot of people to groups today. Try again tomorrow."
msgstr "Marami kang nadagdag na mga tao sa mga grupo ngayon. Subukan muli bukas."

#, machine, plain1
msgid "You've already reported this Space."
msgstr "Naiulat mo na ang Kalawakang ito."

#, machine, plain1
msgid "You've already reported this message."
msgstr "Naiulat mo na ang mensaheng ito."

#, machine, plain1
msgid "You've already reposted this."
msgstr "Pinalitan mo na ito."

#, machine, plain1, python-format
msgid "You've been in this voice channel for %(num)s hour. Join again if you're still here."
msgid_plural "You've been in this voice channel for %(num)s hours. Join again if you're still here."
msgstr[0] "Nasa voice channel ka na sa loob ng %(num)s oras. Sumali uli kung nandito ka pa."
msgstr[1] "Nasa voice channel ka na sa loob ng %(num)s oras. Sumali uli kung nandito ka pa."

#, machine, plain1, python-format
msgid "You've been invited to be a guildmaster of <span class=\"font-weight-bold\">+%(guild)s</span>. You will have full permissions over the guild."
msgstr "Ikaw ay inanyayahang maging isang tagapamagitan ng samahan <span class=\"font-weight-bold\">+%(guild)s</span>. Buong pahintulot mo sa samahan."

#, machine, plain1
msgid "You've joined voice channels a lot in the last hour. Try again later."
msgstr "Maraming voice channel ang nakasama mo sa huling oras. Subukan muli mamaya."

#, machine, plain1
msgid "You've sent a lot of feedback today. Try again tomorrow."
msgstr "Marami kang ipinadalang impormasyon ngayon. Subukan muli bukas."

#, machine, plain1
msgid "You've sent a lot of reports today. Try again tomorrow."
msgstr "Marami kang naipadalang ulat ngayon. Subukan muli bukas."

#, machine, plain1
msgid "You've started a lot of calls in the last hour. Try again later."
msgstr "Maraming tawag ang sinimulan mo sa huling oras. Subukan muli mamaya."

#, machine, plain1
msgid "YouTube did not accept that video."
msgstr "hindi tinanggap ni YouTube ang video na iyon."

#, machine, plain1
msgid "YouTube is not taking more uploads right now. Try again later."
msgstr "Ang YouTube ay hindi kumukuha ng mas maraming mga loads ngayon. Subukan muli mamaya."

#, machine, plain1
msgid "YouTube link"
msgstr "YouTube link"

#, machine, plain1, python-format
msgid "Your %(site)s account has been permanently suspended due to a Terms of Service violation."
msgstr "Ang iyong %(site)s ay permanenteng nasuspinde dahil sa isang Terminong paglabag sa Serbisyo."

