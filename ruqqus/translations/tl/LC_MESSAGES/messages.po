msgid "The BBC's technology headlines, from its public RSS feed."
msgstr "Ang mga ulong balita ng teknolohiya ng BBC, mula sa pampublikong RSS."

#, machine, plain1
msgid "The Child word filter hides sensitive content everywhere, so this is off."
msgstr "Ang salitang bata na filter ay nagtatago ng sensitibong nilalaman sa lahat ng dako, kaya wala na ito."

#, glossary, machine, plain1
msgid "The Platform"
msgstr "Ang Platform"

#, machine, plain1
msgid "The Royal Bank has minted your Coins. Here is a copy of your order."
msgstr "Ginawa ng Royal Bank ang inyong mga Barya. Narito ang isang kopya ng iyong utos."

#, machine, plain1
msgid "The Sahel"
msgstr "Ang Sahel"

#, machine, plain1
msgid "The Space could not be made."
msgstr "Hindi magawa ang Kalawakan."

#, machine, plain1, python-format
msgid "The account age must be a whole number of days, 0 to %(max)s."
msgstr "Ang edad ng pagsasalaysay ay dapat na isang buong bilang ng mga araw, 0 hanggang %(max)s."

#, machine, plain1
msgid "The account is used as always: only posts from these feeds are made by themselves, each marked as automated."
msgstr "Ang ulat ay ginagamit na gaya ng dati: tanging mga poste mula sa mga pagpapakaing ito ang ginagawa sa ganang sarili, bawat isa'y minarkahan bilang automated."

#, machine, plain1
msgid "The account no longer exists."
msgstr "Ang ulat ay hindi na umiiral."

#, machine, plain1
msgid "The accounts on this list keep it to themselves."
msgstr "Ang mga ulat sa talaang ito ang nag - iingat nito sa kanilang sarili."

#, machine, plain1, python-format
msgid "The admins said: %(note)s"
msgstr "Ang admins ay nagsabi: %(note)s"

#, machine, plain1
msgid "The author"
msgstr "Ang awtor"

#, machine, plain1
msgid "The author of an anonymous post can't be added."
msgstr "Ang may akda ng isang hindi kilalang post ay hindi maaaring idagdag."

#, machine, plain1
msgid "The author says this is commercial promotion: a paid partnership, sponsorship, affiliate link, or advertising of their own products or services"
msgstr "Sinasabi ng awtor na ito'y pagtataguyod ng komersiyo: isang bayarang pagsasama, pagtataguyod, pag - uugnay, o pag - aanunsiyo ng kanilang sariling mga produkto o serbisyo"

#, machine, plain1
msgid "The author says this was made with AI"
msgstr "Sinasabi ng awtor na ito ay ginawa kay AI"

#, machine, plain1
msgid "The author turned comments off for this post."
msgstr "Tinanggihan ng awtor ang mga komento para sa posisyong ito."

#. %(names)s is a comma-separated list of the draft's authors
#, machine, plain1, python-format
msgid "The authors agreed to invite you: %(names)s."
msgstr "Sumang - ayon ang mga awtor na anyayahan ka: %(names)s."

#, machine, plain1
msgid "The auto-moderation was saved."
msgstr "Naligtas ang auto-moderasyon."

#, machine, plain1, python-format
msgid "The base URL is <code>%(url)s</code>"
msgstr "Ang base URL ay <code>%(url)s</code>"

#, machine, plain1
msgid "The board is open while the Space is live."
msgstr "Bukas ang tabla habang nakatira ang Kalawakan."

#, machine, plain1, python-format
msgid "The body can be at most %(num)s character."
msgid_plural "The body can be at most %(num)s characters."
msgstr[0] "Ang katawan ay maaaring maging halos %(num)s karakter."
msgstr[1] "Ang katawan ay maaaring nasa karamihan ng %(num)s karakter."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved."
msgstr "Ang bot @i%(name)s na iminungkahi mo ay hindi sinang-ayunan."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved. The admins said: %(note)s"
msgstr "Ang bot @i%(name)s na iminungkahi mo ay hindi sinang-ayunan. Ang mga anunsiyo ay nagsabi: %(note)s"

#, machine, plain1
msgid "The bot already reads that feed."
msgstr "Binabasa na ng bot ang pagkaing iyon."

#, machine, plain1
msgid "The bot was suspended for posting too much similar content."
msgstr "Ang bot ay sinuspinde para sa paglalagay ng labis na katulad na nilalaman."

#, machine, plain1, python-format
msgid "The bot you proposed, [@%(name)s](/@%(name)s), was approved. It is run by the site from now on and starts posting from its feeds within a few minutes. Thank you!"
msgstr "Ang bot na iminungkahi mo, [@i%(name)s](/@%(name)s), ay inaprubahan. Ito'y pinatatakbo ng site mula ngayon at nagsisimulang magpaskil mula sa pagkain nito sa loob ng ilang minuto. Salamat!"

#, machine, plain1
msgid "The bot's account no longer exists."
msgstr "Ang salaysay ng bot ay hindi na umiiral."

#, machine, plain1
msgid "The bot's owner can't run it right now."
msgstr "Hindi ito kayang patakbuhin ng may-ari ng bot ngayon."

#, machine, plain1, python-format
msgid "The category %(category)s was deleted; its channels stay."
msgstr "Ang kategoryang %(category)s ay inalis; ang mga channel nito ay nanatili."

#, machine, plain1, python-format
msgid "The category %(category)s was made."
msgstr "Ginawa ang kategoryang %(category)s."

#, machine, plain1, python-format
msgid "The category was renamed %(category)s."
msgstr "Ang kategorya ay muling pinanganlang %(category)s."

#, machine, plain1, python-format
msgid "The coins go to the founder, <a href=\"%(url)s\">@%(name)s</a>."
msgstr "Ang mga barya ay napupunta sa tagapagtatag, <a href=\"%(url)s\">@%(name)s</a>."

#, machine, plain1
msgid "The coins you earn from tips, paid circles and the creator fund, for the last 30 days and all time."
msgstr "Ang mga baryang kinikita mo mula sa mga tip, ang binabayarang mga bilog at ang pondo ng manlilikha, sa nakalipas na 30 araw at sa lahat ng panahon."

#, machine, plain1, python-format
msgid "The copy other people forwarded to guilds will stay there."
msgid_plural "The %(num)s copies other people forwarded to guilds will stay there."
msgstr[0] "Ang kopyang ipinadala ng ibang tao sa samahan ay mananatili roon."
msgstr[1] "Ang %(num)s kopya na ipinadala ng ibang tao sa samahan ay mananatili roon."

#. %(guilds)s is a list of guild names, such as "+a, +b and +c"
#, machine, plain1, python-format
msgid "The copy you forwarded to %(guilds)s will be taken down."
msgid_plural "The copies you forwarded to %(guilds)s will be taken down."
msgstr[0] "Ang sipi na ipinadala mo sa %(guilds)s ay ibababa."
msgstr[1] "Ang mga kopya na ipinadala ninyo sa %(guilds)s ay kukunin."

#, machine, plain1
msgid "The dates leave no days."
msgstr "Ang mga petsa ay hindi nag - iiwan ng mga araw."

#, machine, plain1
msgid "The draft has changes the post doesn't show yet."
msgstr "Ang draft ay may mga pagbabago sa post ay hindi pa nagpapakita."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was approved: it is read from now on."
msgstr "Inaprubahan ang %(url)s para sa awtomatikong paglalagay ng inyong account: ito ay binabasa mula ngayon."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was not approved."
msgstr "Hindi sinang - ayunan ang %(url)s para sa awtomatikong paglalagay ng inyong account."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was approved: it is read from now on."
msgstr "Inaprubahan ang %(url)s para sa iyong bit @i%(name)s: ito ay binabasa mula ngayon."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was not approved."
msgstr "Ang pagkain na %(url)s para sa iyong bit @i%(name)s ay hindi sinang-ayunan."

#, machine, plain1, python-format
msgid "The feed answered with an error (%(status)s)."
msgstr "Ang pagkain ay sinagot sa pamamagitan ng isang pagkakamali (%(status)s)."

#, machine, plain1
msgid "The feed asked us to slow down."
msgstr "Ang pagkain ay nag - udyok sa amin na magmabagal."

#, machine, plain1
msgid "The feed did not answer in time."
msgstr "Ang pagkain ay hindi sumagot sa tamang panahon."

#, machine, plain1
msgid "The feed is unavailable for now."
msgstr "Ang pagkain ay hindi na makukuha ngayon."

#, machine, plain1
msgid "The feed server answered with a redirect, which is not followed."
msgstr "Sumagot ang tagapagsilbi sa pamamagitan ng pag - aayos, na hindi sinusundan."

#. status is an HTTP status code, such as 404
#, machine, plain1, python-format
msgid "The feed server answered with an error (%(status)s)."
msgstr "Ang tagapagsilbi ng pagkain ay sumagot sa pamamagitan ng isang pagkakamali (%(status)s)."

#, machine, plain1, python-format
msgid "The feed server answered with more than %(num)s post at once."
msgid_plural "The feed server answered with more than %(num)s posts at once."
msgstr[0] "Sumagot ang tagapagsilbi ng mahigit sa %(num)s puwesto nang sabay - sabay."
msgstr[1] "Sumagot kaagad ang tagapagsilbi ng pagkain na may mahigit sa %(num)s poste."

#, machine, plain1
msgid "The feed server did not answer in time."
msgstr "Ang tagapagsilbi ng pagkain ay hindi sumagot sa tamang panahon."

#, machine, plain1
msgid "The feed server took too long to answer."
msgstr "Ang tagapagsilbi ay napakatagal sumagot."

#, machine, plain1
msgid "The feed server's answer has no list of posts."
msgstr "Ang sagot ng tagapagsilbi sa pagpapakain ay walang talaan ng mga poste."

#, machine, plain1
msgid "The feed server's answer holds something that is not a post id."
msgstr "Ang sagot ng tagapagsilbi sa pagpapakain ay may taglay na hindi isang post id."

#, machine, plain1
msgid "The feed server's answer is not JSON."
msgstr "Ang sagot ng tagapagsilbi ng pagkain ay hindi JSON."

#, machine, plain1
msgid "The feed server's answer is not a JSON object."
msgstr "Ang sagot ng tagapagsilbi ng pagkain ay hindi JSON."

#, machine, plain1
msgid "The feed server's answer is too large."
msgstr "Ang sagot ng tagapagsilbi sa pagpapakain ay napakalaki."

#, machine, plain1
msgid "The feed server's certificate could not be checked."
msgstr "Hindi matiyak ang sertipiko ng tagapagsilbi ng pagkain."

#, machine, plain1
msgid "The feed server's cursor is not usable."
msgstr "Ang pagkain ng server ay hindi maaaring gamitin."

#, machine, plain1
msgid "The feed's address sends it somewhere else too many times."
msgstr "Ang direksiyon ng pagkain ay nagpapadala rito sa ibang lugar nang maraming ulit."

#, machine, plain1
msgid "The feed's answer is too large."
msgstr "Ang sagot ng pagkain ay napakalaki."

#, machine, plain1
msgid "The feed's certificate could not be checked."
msgstr "Ang sertipiko ng pagkain ay hindi maaaring suriin."

#, machine, plain1
msgid "The file's size is missing."
msgstr "Nawawala ang sukat ng talaksan."

#, machine, plain1, python-format
msgid "The following users are approved to forward to +%(guild)s."
msgstr "Ang mga sumusunod na tagagamit ay naaprubahang pasulong sa +i%(guild)s."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s guild chat."
msgstr "Ang mga sumusunod na gumagamit ay pinagbabawalang sumali sa +i%(guild)s guild chat."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s."
msgstr "Ang mga sumusunod na tagagamit ay pinagbabawalang sumali sa +i%(guild)s."

#, machine, plain1
msgid "The guild"
msgstr "Ang samahan"

#, machine, plain1
msgid "The guild already has a category with that name."
msgstr "Ang samahan ay mayroon nang isang kategorya na may ganiyang pangalan."

#, machine, plain1
msgid "The guild already has a channel with that name."
msgstr "Ang samahan ay mayroon nang alulod na may ganiyang pangalan."

#, machine, plain1
msgid "The guild already has a role with that name."
msgstr "Ang samahan ay may bahagi na sa pangalang iyan."

#, machine, plain1
msgid "The guild's own rules for what is written in its channels, on top of the site's word filter. Guildmasters are never held to them. A message that breaks one is refused with a short reason that never says which word."
msgstr "Ang sariling mga alituntunin ng guild para sa nakasulat sa mga lagusan nito, sa ibabaw ng salitang pansala ng lugar. Hindi kailanman hinahawakan sa kanila ang mga may - ari ng moda. Isang mensahe na sumisira sa isa ang tinatanggihan taglay ang maikling dahilan na hindi kailanman nagsasabi ng aling salita."

#, machine, plain1
msgid "The host stays on stage."
msgstr "Ang punong - abala ay nananatili sa entablado."

#, machine, plain1
msgid "The independent social platform"
msgstr "Ang independiyenteng platapormang panlipunan"

#, machine, plain1
msgid "The internet gremlins have led you to a dark, musty dead-end. There's nothing here."
msgstr "Ang internet gremlins ay umakay sa iyo sa isang madilim, maty patay-end. Walang nandito."

#, machine, plain1, python-format
msgid "The key that opens your messages in a new app. It is locked with your password and opened here, in this browser: %(site)s never sees it. Anyone with it and your account can read your chats, so never share it."
msgstr "Ang susi na nagbubukas ng iyong mga mensahe sa isang bagong app. Ito ay naka-lock gamit ang iyong password at binuksan dito, sa browser na ito: %(site)s ay hindi ito nakikita. Maaaring basahin ng sinuman na mayroon nito at ng iyong account ang iyong mga chat, kaya huwag na huwag mong ibabahagi ito."

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s"
msgstr "Ang link `%(link)s` ay hindi pinapayagan. Dahilan: %(reason)s"

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s."
msgstr "Ang link `%(link)s` ay hindi pinapayagan. Dahilan: %(reason)s."

#, machine, plain1, python-format
msgid "The link can be at most %(num)s character."
msgid_plural "The link can be at most %(num)s characters."
msgstr[0] "Ang kawing ay maaaring nasa halos %(num)s karakter."
msgstr[1] "Ang link ay maaaring sa karamihan ng %(num)s character."

#, machine, plain1
msgid "The link can't contain a user name or password."
msgstr "Ang link ay hindi maaaring maglaman ng user na pangalan o password."

#, machine, plain1
msgid "The link can't contain spaces."
msgstr "Ang link ay hindi maaaring maglaman ng mga espasyo."

#, machine, plain1
msgid "The link must start with https:// or http://."
msgstr "Ang link ay dapat magsimula sa https:// o http://."

#, machine, plain1
msgid "The link needs a full address, such as example.com."
msgstr "Kailangan ng link ang isang kumpletong address, tulad ng halimbawa.com."

#, machine, plain1
msgid "The list is open to members so that anyone can see what the filter hides and why. Nothing on it is removed from the site: each member's own filter decides what they see."
msgstr "Ang talaan ay bukas sa mga miyembro upang makita ng sinuman kung ano ang mga balat ng panala at kung bakit. Walang anuman dito ang inaalis sa site: ang sariling panulaan ng bawat miyembro ang nagpapasiya kung ano ang kanilang nakikita."

#, machine, plain1
msgid "The list isn't shown on the Child filter"
msgstr "Ang talaan ay hindi ipinapakita sa Child filter"

#, machine, plain1, python-format
msgid "The most a circle can ask is %(num)s coin every 30 days."
msgid_plural "The most a circle can ask is %(num)s coins every 30 days."
msgstr[0] "Ang pinakamadalas itanong sa bilog ay %(num)s barya tuwing 30 araw."
msgstr[1] "Ang pinakamadalas itanong sa bilog ay %(num)s barya tuwing 30 araw."

#, machine, plain1
msgid "The most voted posts of the last seven days."
msgstr "Ang karamihan ay bumoto ng mga puwesto sa nakalipas na pitong araw."

#, machine, plain1, python-format
msgid "The name %(host)s could not be found."
msgstr "Ang pangalang %(host)s ay hindi matagpuan."

#, machine, plain1
msgid "The numbers are always shown on your profile. This decides who can open each list and see the accounts on it. An account is only listed where its own setting allows it too."
msgstr "Ang mga numero ay laging ipinakikita sa iyong profile. Ito ang nagpapasiya kung sino ang makapagbubukas ng bawat listahan at makikita ang mga ulat dito. Nakatala lamang ang isang salaysay kung saan nagpapahintulot din dito ang sarili nitong kapaligiran."

#, machine, plain1
msgid "The open-source platform for independent internet communities"
msgstr "Ang open-source platform para sa mga nagsasariling komunidad sa internet"

#, machine, plain1
msgid "The original content is not retained anywhere, including in this history."
msgstr "Ang orihinal na nilalaman ay hindi pinananatili saanman, pati na sa kasaysayang ito."

#, machine, plain1
msgid "The other authors of a shared draft removed you as an author. What you wrote stays credited to you."
msgstr "Inalis ka ng ibang awtor ng isang kabahaging burador bilang isang awtor. Ang isinulat ninyo ay nananatiling kapuri - puri sa inyo."

#, machine, plain1
msgid "The owner deletes a channel instead of leaving it."
msgstr "Ang may - ari ay nag - aalis ng channel sa halip na iwan ito."

#, machine, plain1
msgid "The owner's role can't be changed."
msgstr "Hindi mababago ang papel ng may-akda."

#, machine, plain1
msgid "The page's current text isn't shown here; what you save replaces it."
msgstr "Ang kasalukuyang teksto ng pahina ay hindi ipinapakita rito; kung ano ang iyong natitipid ay pinapalitan ito."

#, machine, plain1
msgid "The picture could not be stored. Try again later."
msgstr "Ang larawan ay hindi maaaring itago. Subukan muli mamaya."

#, machine, plain1
msgid "The picture goes to your own linked storage, not to this site. You can add a few words under it."
msgstr "Ang larawan ay nagtutungo sa iyong sariling magkakaugnay na imbakan, hindi sa lugar na ito. Maaari mong idagdag ang ilang salita sa ilalim nito."

#, machine, plain1
msgid "The picture you chose"
msgstr "Ang larawang pinili mo"

#, machine, plain1
msgid "The post appears on the profile of whoever publishes it first. Optionally forward it into guilds for community discussion: each guild gets its own independent copy with its own votes and comments. Guilds are forwarded to when the draft is first published."
msgstr "Ang post ay lumilitaw sa profile ng sinumang unang naglalathala nito. Mapagpipiliang ipadala ito sa mga guild para sa talakayang pangkomunidad: ang bawat guild ay nakakakuha ng sarili nitong independiyenteng kopya na may sariling boto at komento. Ang mga loid ay ipinadadala kung kailan unang inilathala ang draft."

#, machine, plain1
msgid "The post carries your name and is listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your name."
msgstr "Taglay ng post ang iyong pangalan at nakatala sa iyong profile. Ang mga Votes, komento at mga pagsulong ay ibinabahagi sa awtor nito, na nag - aayos at nag - aayos nito. Maaari kang bumaba anumang oras: ang post ay nananatili, nang walang pangalan."

#, machine, plain1
msgid "The post refused the change."
msgstr "Ang post ay tumanggi sa pagbabago."

#, machine, plain1, python-format
msgid "The promo code `%(code)s` is not currently valid. Please begin a new transaction."
msgstr "Ang promo code `%(code)s` ay hindi kasalukuyang tama. Pakisuyong simulan ang isang bagong transaksiyon."

#, machine, plain1, python-format
msgid "The proposal for @%(name)s has been withdrawn."
msgstr "Ang mungkahi para sa @i%(name)s ay binawi."

#, machine, plain1, python-format
msgid "The role %(role)s was deleted."
msgstr "Ang papel na %(role)s ay inalis."

#, machine, plain1, python-format
msgid "The role %(role)s was made."
msgstr "Ginawa ang papel na %(role)s."

#, machine, plain1, python-format
msgid "The role %(role)s was saved."
msgstr "Naligtas ang papel na %(role)s."

#, machine, plain1
msgid "The royal bank has told us that you owe them some coin. You'll need to pay off your debts before you can continue."
msgstr "Sinabi sa amin ng maharlikang bangko na may utang ka sa kanila na barya. Kailangang bayaran mo ang iyong mga utang bago ka makapagpatuloy."

#, machine, plain1
msgid "The rules"
msgstr "Ang mga tuntunin"

#, machine, plain1
msgid "The rules below"
msgstr "Ang mga tuntunin sa ibaba"

#, machine, plain1, python-format
msgid "The rules can be at most %(count)s character."
msgid_plural "The rules can be at most %(count)s characters."
msgstr[0] "Ang mga alituntunin ay maaaring nasa karamihan ng katangiang %(count)s."
msgstr[1] "Ang mga tuntunin ay maaaring sa karamihan ng mga character ng %(count)s."

#, machine, plain1
msgid "The rules can't contain control or invisible characters."
msgstr "Ang mga alituntunin ay hindi maaaring maglaman ng kontrol o hindi nakikitang mga karakter."

#, machine, plain1
msgid "The screenshot you are sending"
msgstr "Ang screenshot na ipinadala mo"

#. %(status)s is an HTTP status code
#, machine, plain1, python-format
msgid "The server answered %(status)s."
msgstr "Sumagot ang server ng %(status)s."

#, machine, plain1, python-format
msgid "The server answers with the posts to show and their order; %(site)s still hides anything a viewer may not see, and tells the server nothing about who is looking. Everyone is told that an outside server ranks this curation."
msgstr "Ang server ay sumasagot sa pamamagitan ng mga posts upang ipakita at ang kanilang order; ang %(site)s ay nagtatago pa rin ng anumang bagay na maaaring hindi nakikita ng isang manonood, at nagsasabi sa server ng walang anumang bagay tungkol sa kung sino ang tumitingin. Ang lahat ay sinabihan na binubuo ng isang server sa labas ang kulot na pagkaing ito."

#, machine, plain1, python-format
msgid "The server named %(num)s post; you can see %(seen)s of them."
msgid_plural "The server named %(num)s posts; you can see %(seen)s of them."
msgstr[0] "Ang server na nagngangalang %(num)s post; makikita mo ang %(seen)s."
msgstr[1] "Ang server na may %(num)s posts; makikita mo ang %(seen)s."

#, machine, plain1
msgid "The server thinks you're asking something silly. It might take you more seriously if you take off the jester outfit."
msgstr "Iniisip ng server na may hinihiling kang isang bagay na hangal. Baka mas maging seryoso ka kung aalisin mo ang pang - uuyam."

#, machine, plain1
msgid "The site refused the bot's session."
msgstr "Tinanggihan ng site ang sesyon ng bit."

#, machine, plain1
msgid "The site's admins marked this guild sensitive, so only an admin can change this."
msgstr "Ang mga admin ng site ang nagmarka sa guild na ito na sensitibo, kaya ang isang admin lamang ang maaaring magbago nito."

#, machine, plain1, python-format
msgid "The stage is full (%(num)s person)."
msgid_plural "The stage is full (%(num)s people)."
msgstr[0] "Punô ang entablado (%(num)s tao)."
msgstr[1] "Punô ang entablado (%(num)s katao)."

#, machine, plain1
msgid "The storage service is not answering right now. Try again in a moment."
msgstr "Ang imbakan ay hindi sumasagot ngayon. Subukang muli sandali."

#, machine, plain1, python-format
msgid "The summary can be at most %(num)s character."
msgid_plural "The summary can be at most %(num)s characters."
msgstr[0] "Ang buod ay maaaring nasa halos %(num)s karakter."
msgstr[1] "Ang buod ay maaaring nasa karamihan ng %(num)s karakter."

#, machine, plain1
msgid "The summary can be changed while the Space is live."
msgstr "Ang buod ay maaaring baguhin habang ang Kalawakan ay buháy."

#, machine, plain1
msgid "The text isn't shown: this was removed by the site's administrators."
msgstr "Ang teksto ay hindi ipinapakita: ito ay inalis ng mga administrador ng site."

#, machine, plain1, python-format
msgid "The time before links must be a whole number of days, 0 to %(max)s."
msgstr "Ang panahon bago ang mga link ay dapat isang buong bilang ng mga araw, 0 sa %(max)s."

#, machine, plain1, python-format
msgid "The time in the guild must be a whole number of days, 0 to %(max)s."
msgstr "Ang panahon sa samahan ay dapat na isang buong bilang ng mga araw, 0 sa %(max)s."

#, machine, plain1, python-format
msgid "The title can be at most %(num)s character."
msgid_plural "The title can be at most %(num)s characters."
msgstr[0] "Ang pamagat ay maaaring nasa halos %(num)s karakter."
msgstr[1] "Ang pamagat ay maaaring sa karamihan %(num)s karakter."

#, machine, plain1
msgid "The two revisions have the same text."
msgstr "Ang dalawang rebisyon ay may parehong teksto."

#, machine, plain1
msgid "The upload did not arrive in your Google Drive. Try again."
msgstr "Ang kargada ay hindi dumating sa iyong Google Drive. Subukan muli."

#, machine, plain1
msgid "The upload did not arrive in your OneDrive. Try again."
msgstr "Ang kargada ay hindi dumating sa iyong OneDrive. Subukan muli."

#, machine, plain1
msgid "The upload did not arrive. Try again."
