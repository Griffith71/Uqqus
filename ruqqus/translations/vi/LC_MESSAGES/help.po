#, machine, plain1
msgid "You cannot siege any Guilds right now. You can only make one siege attempt every 7 days, and your account must be at least 7 days old."
msgstr "Bây giờ anh không thể tiếp quản bất kỳ quân đội nào. Anh chỉ có thể lấy một viên kim cương mỗi 7 ngày, và tài khoản của anh phải ít nhất 7 ngày tuổi."

#, machine, plain1
msgid "You may attempt to siege a guild once every 7 days. Any siege attempt - whether successful or not - will trigger this cool-down period."
msgstr "Anh có thể cố chiếm lấy một hội thẩm mỗi 7 ngày một lần. Bất kỳ nỗ lực nào chiếm được quyền đòi hỏi - dù thành công hay không - sẽ gây ra giai đoạn lạnh giá này."

#, machine, plain1
msgid "You need to be logged in to siege a Guild."
msgstr "Anh cần phải được đăng nhập để tiếp quản một tổ chức."

#, machine, plain1
msgid "You should overwrite the previous access code and expiration timestamp with this new information. Continue to use the access token as in Step 5, until it expires."
msgstr "Bạn nên ghi đè lên mã truy cập trước đó và nhãn thời gian thoát bằng thông tin mới này. Tiếp tục sử dụng bảng truy cập như trong bước 5, cho đến khi nó hết hạn."

#, machine, plain1, python-format
