#. keep the code between backticks exactly as it is
#, machine, plain1, python-format
msgid "`posts`: up to %(num)s post ids. A post's id is the short code in its address: `/post/2k1/a-title` is `2k1`."
msgid_plural "`posts`: up to %(num)s post ids. A post's id is the short code in its address: `/post/2k1/a-title` is `2k1`."
msgstr[0] "`posts`: đến %(num)s Bưu điện. Thẻ căn cước là mã ngắn trong địa chỉ của nó: `/post/2k1/a-title` là `2k1`."

#, machine, plain1
msgid "`redirect_uri` - The redirect URI (or one of the URIs) specified in your application information. Must not use HTTP unless using localhost (use HTTPS instead)."
msgstr "`redirect_uri` - Chuyển hướng URI (hoặc một trong những URI) được chỉ định trong thông tin ứng dụng của bạn. Không được dùng HTTP trừ khi dùng máy cục bộ (hãy dùng) HTTPS thay vào đó)."

#, machine, plain1
msgid "`refresh_token` - the refresh token which you obtained during Step 3"
msgstr "`refresh_token` - những vật kỷ niệm mà bạn nhận được trong bước 3"

#, machine, plain1
msgid "`scope` - A comma-separated list of permission scopes that you are requesting. Valid scopes are: `identity`, `create`, `read`, `update`, `delete`, `vote`, and `guildmaster`."
msgstr "`scope` - Một danh sách cấp phép mà anh yêu cầu. Phạm vi hợp lệ là: `identity`. `create`. `read`. `update`. `delete`. `vote`, và `guildmaster`."

#, machine, plain1
msgid "`state` - The state token from earlier."
msgstr "`state` - Dấu hiệu của bang lúc nãy."

#, machine, plain1
msgid "`state` - This is your own anti-cross-site-forgery token. We don't do anything with this, except give it to the user to pass back to you later. You are responsible for generating and validating the state token."
msgstr "`state` - Đây là biểu tượng chống trộm đồ của anh. Chúng tôi không làm bất cứ điều gì với điều này, ngoại trừ đưa nó cho người dùng để trả lại cho bạn sau này. Bạn phải chịu trách nhiệm về việc tạo ra và xác nhận lại biểu tượng nhà nước."

#, machine, plain1
msgid "a Redirect URI, or a comma-separated list of redirect URIs. May not use HTTP unless using localhost (use HTTPS instead)."
msgstr "vòng lặp URIhoặc một danh sách định giới bằng dấu phẩy gồm chuyển tiếp URI. Có thể không dùng HTTP trừ khi dùng máy cục bộ (hãy dùng) HTTPS thay vào đó)."

