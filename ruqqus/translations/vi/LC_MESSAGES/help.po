msgid "%(company)s may revoke your License at any time and for any reason."
msgstr "%(company)s Có thể hủy giấy phép bất cứ lúc nào và vì bất cứ lý do gì."

#, machine, plain1, python-format
msgid "%(curation)s: a public curation, by its name or the short name under it. Search %(curation)s to find them; <code>%(in_curation)s</code> narrows a post search to that curation's guilds and accounts. Private curations are never found."
msgstr "%(curation)s: một loại thức ăn công cộng, với tên hoặc tên ngắn dưới nó. Tìm kiếm %(curation)s để tìm họ; <code>%(in_curation)s</code> Thu hẹp việc tìm kiếm đến các giao dịch và tài khoản của nguồn cấp dữ liệu đó. Nguồn cấp dữ liệu tư nhân không bao giờ được tìm thấy."

