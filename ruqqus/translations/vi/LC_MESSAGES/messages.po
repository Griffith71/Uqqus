msgid "You're not following any curations yet."
msgstr "Anh vẫn chưa theo dõi nguồn cấp dữ liệu nào."

#, machine, plain1
msgid "You're not in this Space."
msgstr "Anh không ở trong không gian này."

#, machine, plain1
msgid "You're sending messages too quickly. Wait a moment."
msgstr "Anh gửi tin nhắn quá nhanh. Chờ một chút."

#, machine, plain1, python-format
msgid "You're subscribed. It renews in 30 days for %(num)s coins unless you cancel."
msgid_plural "You're subscribed. It renews in 30 days for %(num)s coins unless you cancel."
msgstr[0] "Anh được đăng ký. Nó sẽ được làm lại trong 30 ngày cho%(num)s Trừ khi anh hủy bỏ."

#, machine, plain2
msgid "You're told of new messages and calls in your chats, never what a message says. Each group can be set to every message, calls only or nothing, in the group's people sheet."
msgstr "Bạn được kể về tin nhắn mới và cuộc gọi trong các cuộc trò chuyện, không bao giờ là tin nhắn. Mỗi nhóm có thể được đặt vào mỗi thông điệp, chỉ gọi hoặc không gọi, trong người của nhóm."

#, machine, plain1
msgid "You're writing very fast. Wait a moment."
msgstr "Anh viết rất nhanh. Chờ một chút."

#, machine, plain1
msgid "You've added a lot of people to groups today. Try again tomorrow."
msgstr "Bạn đã thêm rất nhiều người vào các nhóm ngày nay. Ngày mai hãy thử lại."

#, machine, plain1
msgid "You've already answered this. Only an admin can change your answer."
msgstr "Anh đã trả lời rồi. Chỉ có người quản lý mới có thể thay đổi câu trả lời của anh."

#, machine, plain1
msgid "You've already reported this Space."
msgstr "Anh đã báo cáo không gian này."

#, machine, plain1
msgid "You've already reported this message."
msgstr "Bạn đã báo cáo thông điệp này."

#, machine, plain1
msgid "You've already reposted this."
msgstr "Anh đã viết lại rồi."

#, machine, plain1, python-format
msgid "You've been in this voice channel for %(num)s hour. Join again if you're still here."
msgid_plural "You've been in this voice channel for %(num)s hours. Join again if you're still here."
msgstr[0] "Bạn đã trong kênh giọng nói này %(num)s giờ. Hãy tham gia lần nữa nếu anh còn ở đây."

#, machine, plain1, python-format
msgid "You've been invited to be a guildmaster of <span class=\"font-weight-bold\">+%(guild)s</span>. You will have full permissions over the guild."
msgstr "Bạn đã được mời để là một người điều hòa của <span class=\"font-weight-bold\">+%(guild)s</span>Anh sẽ được toàn quyền quản lý hội thẩm."

#, machine, plain1
msgid "You've joined voice channels a lot in the last hour. Try again later."
msgstr "Anh đã gia nhập nhiều kênh giọng nói trong giờ qua. Hãy thử lại sau."

#, machine, plain1
msgid "You've sent a lot of feedback today. Try again tomorrow."
msgstr "Hôm nay anh đã gửi rất nhiều phản hồi. Ngày mai hãy thử lại."

#, machine, plain2
msgid "You've sent a lot of files today. Try again tomorrow."
msgstr "Hôm nay anh đã gửi rất nhiều hồ sơ. Ngày mai hãy thử lại."

#, machine, plain1
msgid "You've sent a lot of reports today. Try again tomorrow."
msgstr "Anh đã gửi rất nhiều báo cáo hôm nay. Ngày mai hãy thử lại."

#, machine, plain2
msgid "You've sent a lot of reports. Try again later."
msgstr "Anh đã gửi rất nhiều báo cáo. Hãy thử lại sau."

#, machine, plain1
msgid "You've started a lot of calls in the last hour. Try again later."
msgstr "Anh đã bắt đầu rất nhiều cuộc gọi trong giờ qua. Hãy thử lại sau."

#, machine, plain1
msgid "YouTube did not accept that video."
msgstr "YouTube đã không chấp nhận video đó."

#, machine, plain1
msgid "YouTube is not taking more uploads right now. Try again later."
msgstr "YouTube sẽ không tải lên nữa. Hãy thử lại sau."

#, machine, plain1
msgid "YouTube link"
msgstr "liên kếtYouTube"

