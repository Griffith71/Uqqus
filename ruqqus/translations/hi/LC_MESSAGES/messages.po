msgid "Your membership of [+%(guild)s](/+%(guild)s) ended: you didn't have the %(coins)s coins it renews for. You can join again from its page."
msgstr ""

#, machine, plain1
msgid "Your membership will renew again."
msgstr "आपकी सदस्यता फिर से नवीनीकृत हो जाएगी।"

#, machine, plain1
msgid "Your membership won't renew. You keep access until the day you paid to."
msgstr "आपकी सदस्यता नवीनीकृत नहीं होगी। आप उस दिन तक पहुँचते रहते हैं जब तक आप भुगतान करते हैं।"

#, machine, plain1
msgid "Your message includes a word this guild doesn't allow."
msgstr "आपके संदेश में यह शब्द शामिल है कि यह गिल्ड अनुमति नहीं है।"

#, machine, plain1
msgid "Your new backup codes are below. The old ones no longer work."
msgstr "आपका नया बैकअप कोड नीचे है। पुराने लोग अब काम नहीं करते हैं।"

#, machine, plain1
msgid "Your new custom RSS Feed Token has been generated."
msgstr "आपका नया कस्टम RSS फ़ीड टोकन उत्पन्न किया गया है।"

#, machine, plain1
msgid "Your new key. Copy it now: it is not shown again."
msgstr "आपकी नई कुंजी। इसे अभी कॉपी करें: इसे फिर से नहीं दिखाया गया है।"

#, machine, plain1, python-format
msgid "Your original username will always stay reserved for you: <code>%(name)s</code>"
msgstr "आपका मूल उपयोगकर्ता नाम हमेशा आपके लिए आरक्षित रहेगा: <code>%(name)s</code>"

#, machine, plain2
msgid "Your other devices have been signed out."
msgstr "आपके अन्य उपकरणों को डिस्कनेक्ट किया गया है।"

#, machine, plain1
msgid "Your own circles"
msgstr "अपने स्वयं के सर्कल"

#. %(who)s is the @handle of the account being added, filled in by the page
#, machine, plain1, python-format
msgid "Your own circles. %(who)s is not told."
msgstr "अपने स्वयं के सर्कल। %(who)s को नहीं बताया गया है।"

#, machine, plain1
msgid "Your own mix"
msgstr "अपना खुद का मिश्रण"

