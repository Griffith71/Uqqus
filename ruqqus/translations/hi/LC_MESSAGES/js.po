#, machine, plain1, python-format
msgid "Voice call · %(num)s min"
msgid_plural "Voice call · %(num)s min"
msgstr[0] "वॉयस कॉल · %(num)s मिनट"
msgstr[1] "वॉयस कॉल · %(num)s मिनट"

#, python-format
msgid "Voice call · %(num)s s"
msgid_plural "Voice call · %(num)s s"
msgstr[0] ""
msgstr[1] ""

#. under a voice channel's name: its kind and its guild ("Voice channel ·
#. +pets")
#, machine, plain1, python-format
msgid "Voice channel · +%(guild)s"
msgstr "आवाज चैनल · +%(guild)s"

#, machine, plain1, python-format
msgid "Voice goes browser to browser through the site's relay, so nobody sees anyone's address. Up to %(num)s person."
msgid_plural "Voice goes browser to browser through the site's relay, so nobody sees anyone's address. Up to %(num)s people."
msgstr[0] "वॉयस साइट के रिले के माध्यम से ब्राउज़र में जाता है, इसलिए कोई भी किसी के पते को नहीं देखता है। %(num)s व्यक्ति तक।"
msgstr[1] "वॉयस साइट के रिले के माध्यम से ब्राउज़र में जाता है, इसलिए कोई भी किसी के पते को नहीं देखता है। %(num)s लोगों तक।"

#, machine, plain2
msgid "Voice note"
msgstr "वॉयस नोट"

#, machine, plain1
msgid "Wait a moment: your last changes are still being saved."
msgstr "एक पल प्रतीक्षा करें: आपके अंतिम बदलाव अभी भी बच रहे हैं।"

#, machine, plain1
msgid "Waiting for the app"
msgstr "ऐप के लिए प्रतीक्षा करना"

#, machine, plain2
msgid "We found your chat on this browser"
msgstr "हमने इस ब्राउज़र पर अपना चैट पाया"

#, machine, plain1
msgid "We'll show fewer posts like this."
msgstr "हम इस तरह के कुछ पोस्ट दिखाई देंगे।"

#, machine, plain1
msgid "We'll take it from here."
msgstr "हम इसे यहां से लेंगे।"

#, machine, plain1
msgid "What it would do (not saved yet)"
msgstr "यह क्या करेगा (लेकिन अभी तक बचाया नहीं)"

#, machine, plain1
msgid "What's wrong with this Space? (optional)"
msgstr "इस स्पेस के साथ क्या गलत है? (वैकल्पिक)"

#, machine, plain1
msgid "What's wrong with this message? (optional)"
msgstr "इस संदेश के साथ क्या गलत है? (वैकल्पिक)"

#, machine, plain2
msgid "Where should the files you send in chats go?"
msgstr "आप चैट में कहाँ भेज सकते हैं?"

#, machine, plain1
msgid "Where should your audio go?"
msgstr "आपके ऑडियो कहाँ जाना चाहिए?"

#, machine, plain1
msgid "Where should your pictures go?"
msgstr "आपके चित्र कहाँ जाना चाहिए?"

#, machine, plain1
msgid "Where should your videos go?"
msgstr "आपका वीडियो कहाँ जाना चाहिए?"

#. %(service)s is the video site (YouTube)
#, machine, plain1, python-format
msgid "Who can find the video on %(service)s"
msgstr "Who can find the video on %(service)s"

#, machine, plain1
msgid "Who said it"
msgstr "उसने कहा"

#, machine, plain1
msgid "Who upvoted"
msgstr "कौन उत्साहित"

#, glossary, machine, plain2
msgid "Why"
msgstr "क्यों"

#, machine, plain1
msgid "Why are you reporting this story? (optional)"
msgstr "आप इस कहानी की रिपोर्ट क्यों कर रहे हैं? (वैकल्पिक)"

#, machine, plain1
msgid "Why does this break your guild's rules? This will be shown to anyone who looks up this comment's history."
msgstr "क्यों यह आपके गिल्ड के नियमों को तोड़ देता है? यह उन लोगों को दिखाया जाएगा जो इस टिप्पणी के इतिहास को देखते हैं।"

#, machine, plain1
msgid "Why does this break your guild's rules? This will be shown to anyone who looks up this post/comment's history."
msgstr "क्यों यह आपके गिल्ड के नियमों को तोड़ देता है? यह उन लोगों को दिखाया जाएगा जो इस पोस्ट / प्रतियोगिता के इतिहास को देखते हैं।"

#, machine, plain1
msgid "Why is this comment being removed? Your reason is shown in the public log."
msgstr "इस टिप्पणी को क्यों हटाया जा रहा है? आपका कारण सार्वजनिक लॉग में दिखाया गया है।"

#, machine, plain1
msgid "Working it out…"
msgstr "इसे बाहर करना…"

#. a tab: write the post's text (beside Preview)
#, machine, plain1
msgid "Write"
msgstr "लेखक"

#, machine, plain1
msgid "Write something first."
msgstr "पहले कुछ लिखें।"

#, machine, plain1
msgid "Write what you want to tell us."
msgstr "क्या आप हमें बताना चाहते हैं."

#, glossary, machine, plain2
msgid "Yes"
msgstr "हाँ"

#, machine, plain1
msgid "Yes, cancel it"
msgstr "हाँ, इसे रद्द करें"

#. the name under your own picture in a call; "Someone" stands for a person
#. whose name is unknown
#. beside your own name in a group chat's list of people
#. in place of your own name among the people in a Space
#. the label on your own camera's picture in a Space's call
#. in place of your own name over your messages on a Space's board
#, machine, plain1
msgid "You"
msgstr "आप"

#, glossary, machine, plain2
msgid "You already did that"
msgstr "आप यह पहले ही कर चुके हैं"

#, machine, plain1
msgid "You already reported this comment."
msgstr "आपने पहले ही इस टिप्पणी की सूचना दी।"

#, machine, plain1
msgid "You already reported this post."
msgstr "आपने पहले ही इस पोस्ट की सूचना दी थी।"

#, machine, plain1
msgid "You already voted on this post."
msgstr "आप पहले से ही इस पोस्ट पर मतदान करते हैं।"

#, glossary, machine, plain2, python-format
msgid "You are blocking @%(name)s"
msgstr "आपने @%(name)s को ब्लॉक किया है"

#, machine, plain1, python-format
msgid "You are following @%(name)s."
msgstr "आप निम्नलिखित हैं%(name)s।"

#, machine, plain1, python-format
msgid "You called · video · %(when)s · %(length)s"
msgstr "आप कहते हैं · वीडियो · %(when)s · %(length)s"

#, machine, plain1, python-format
msgid "You called · voice · %(when)s · %(length)s"
msgstr "आप कहते हैं · आवाज · %(when)s · %(length)s"

#, machine, plain1
msgid "You can ask for a community note once for each comment, and not on your own comment."
msgstr "आप प्रत्येक टिप्पणी के लिए एक बार सामुदायिक नोट के लिए पूछ सकते हैं, न कि अपनी टिप्पणी पर।"

#, machine, plain1
msgid "You can ask for a community note once for each post, and not on your own post."
msgstr "आप प्रत्येक पोस्ट के लिए एक बार सामुदायिक नोट मांग सकते हैं, न कि अपने पोस्ट पर।"

#, machine, plain1, python-format
msgid "You can have %(num)s folder at most."
msgid_plural "You can have %(num)s folders at most."
msgstr[0] "आपके पास %(num)s फ़ोल्डर हो सकता है।"
msgstr[1] "आपके पास %(num)s फ़ोल्डर हो सकते हैं।"

#, machine, plain1
msgid "You can read this channel but not write in it."
msgstr "आप इस चैनल को पढ़ सकते हैं लेकिन इसमें नहीं लिख सकते।"

#, machine, plain1
msgid "You can see who is here, but you can't speak in this channel."
msgstr "आप देख सकते हैं कि कौन है."

#, glossary, machine, plain2
msgid "You can't do that."
msgstr "आप यह नहीं कर सकते।"

#, machine, plain1
msgid "You can't message that person."
msgstr "आप उस व्यक्ति को संदेश नहीं दे सकते।"

#, machine, plain1
msgid "You can't send to that chat."
msgstr "आप उस चैट को नहीं भेज सकते।"

#, machine, plain1
msgid "You can't start a chat with them."
msgstr "आप उनके साथ बातचीत शुरू नहीं कर सकते।"

#, machine, plain1
msgid "You can’t edit this draft any more (you may have left it or been removed)."
msgstr "आप इस मसौदा को संपादित नहीं कर सकते (आप इसे छोड़ सकते हैं या हटा सकते हैं)।"

#, machine, plain1
msgid "You ended the Space."
msgstr "आपने अंतरिक्ष को समाप्त कर दिया।"

#, machine, plain1
msgid "You have no curations yet."
msgstr "आपके पास अभी तक कोई क्यूरेट फ़ीड नहीं है।"

#, machine, plain1
msgid "You have no stories yet. Share one first."
msgstr "अभी तक कोई कहानियां नहीं हैं। पहले शेयर करें।"

#, machine, plain1
msgid "You haven't made a circle of your own yet. Your Friends circle is automatic: it is everyone you follow who follows you back."
msgstr "आपने अभी तक अपनी खुद की एक सर्कल नहीं बनाई है। आपका मित्र चक्र स्वत: है: यह सब आप का पालन करते हैं जो आपको पीछे छोड़ देता है।"

#, machine, plain1
msgid "You left the Space."
msgstr "आप अंतरिक्ष छोड़ दिया।"

#, machine, plain1
msgid "You left the call."
msgstr "आपने कॉल छोड़ दिया।"

#, machine, plain2
msgid "You logged out everywhere from another device, so chat is starting again here."
msgstr "आप किसी अन्य डिवाइस से हर जगह डिस्कनेक्ट हो गए हैं, इसलिए चैट फिर से शुरू हो रही है।"

#, machine, plain1
msgid "You signed in with your two-factor recovery code, so chat is starting again here."
msgstr "आप अपने दो-फैक्टर वसूली कोड के साथ साइन इन करें, इसलिए चैट फिर से शुरू हो रहा है।"

#, machine, plain1, python-format
msgid "You unfollowed @%(name)s."
msgstr "You unfollowed @%(name)s."

#, machine, plain1
msgid "You were removed from this Space."
msgstr "आप इस अंतरिक्ष से हटा दिए गए थे।"

#, machine, plain2
msgid "You'll get a new recovery code, and the old one will stop working."
msgstr "आपको एक नया रिकवरी कोड मिलेगा, और पुराना काम करना बंद कर देगा।"

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "आप बहुत कुछ कर रहे हैं। बाद में फिर से प्रयास करें।"

#, machine, plain1
msgid "You're no longer in this Space."
msgstr "अब आप इस स्पेस में नहीं हैं।"

#, machine, plain1
msgid "You're the only one here."
msgstr "आप यहाँ एकमात्र हैं।"

#, machine, plain1
msgid "Your app is verified"
msgstr "आपका ऐप सत्यापित है"

#, machine, plain1
msgid "Your browser blocked the window for connecting. Allow pop-ups for this site, or connect in the settings."
msgstr "आपका ब्राउज़र कनेक्ट करने के लिए विंडो को अवरुद्ध करता है। इस साइट के लिए पॉप-अप की अनुमति दें, या सेटिंग्स में कनेक्ट करें।"

#, machine, plain1
msgid "Your chat devices can't be listed right now."
msgstr "आपके चैट डिवाइस को अभी सूचीबद्ध नहीं किया जा सकता है।"

#, machine, plain2
msgid "Your chat recovery code"
msgstr "आपका चैट रिकवरी कोड"

#, machine, plain1
msgid "Your chats"
msgstr "आपका चैट"

#, machine, plain1
msgid "Your chats will work again on this device, but messages from before can't be read here (or anywhere without your old key)."
msgstr "आपका चैट इस डिवाइस पर फिर से काम करेगा, लेकिन पहले से संदेश यहां नहीं पढ़े जा सकते हैं (या कहीं भी आपकी पुरानी कुंजी के बिना)।"

#, machine, plain1
msgid "Your comment could not be posted. Try again."
msgstr "आपकी टिप्पणी पोस्ट नहीं की जा सकती। फिर से कोशिश करो।"

#, machine, plain2
msgid "Your current recovery code will stop working."
msgstr "आपका वर्तमान वसूली कोड काम करना बंद कर देगा।"

#, machine, plain1
msgid "Your edit couldn't be saved. Please check your connection and try again."
msgstr "आपका संपादन बचाया नहीं जा सकता। कृपया अपने कनेक्शन की जांच करें और फिर से प्रयास करें।"

#, machine, plain1
msgid "Your edit couldn't be saved. Please try again."
msgstr "आपका संपादन बचाया नहीं जा सकता। फिर से प्रयास करें।"

#, machine, plain1
msgid "Your files stay in your own account there, using its free space. This site only shows them in your posts."
msgstr "आपकी फ़ाइलें वहाँ अपने स्वयं के खाते में रहती हैं, अपने खाली स्थान का उपयोग करती हैं। यह साइट केवल आपके पोस्ट में दिखाई देती है।"

#, machine, plain1
msgid "Your guilds' chats"
msgstr "आपका गिल्ड्स चैट"

#. placeholder text a member replaces: the headline of a "Call to action"
#. block, and its button's label
#, machine, plain1
msgid "Your headline"
msgstr "आपका हेडलाइन"

#, machine, plain1
msgid "Your key can't be shown right now."
msgstr "आपकी कुंजी अभी नहीं दिखाई दे सकती है।"

#, machine, plain1
msgid "Your key was locked with an older password. Open Chat on this site and enter your recovery code once; then it opens here."
msgstr "आपकी कुंजी एक पुराने पासवर्ड के साथ बंद कर दिया गया था। इस साइट पर ओपन चैट करें और एक बार अपना रिकवरी कोड दर्ज करें; फिर यह यहां खुलता है।"

#, machine, plain1, python-format
msgid "Your message will be sent once chat is unlocked on this device."
msgid_plural "Your %(num)s messages will be sent once chat is unlocked on this device."
msgstr[0] "इस उपकरण पर एक बार चैट अनलॉक होने के बाद आपका संदेश भेजा जाएगा।"
msgstr[1] "आपके %(num)s संदेशों को एक बार चैट इस डिवाइस पर अनलॉक करने के लिए भेजा जाएगा।"

#, machine, plain2
msgid "Your old recovery code no longer works."
msgstr "आपका पुराना रिकवरी कोड अब काम नहीं करता है।"

#, machine, plain1
msgid "Your password changed since this chat key was locked with it. The recovery code you saved when chat was set up opens it."
msgstr "तब से आपका पासवर्ड बदल गया क्योंकि इस चैट कुंजी को उसके साथ बंद कर दिया गया था। जब चैट शुरू किया गया था तो आपके द्वारा सहेजे गए वसूली कोड इसे खोलता है।"

#, machine, plain1
msgid "Your password was changed for you, so chat is starting again here."
msgstr "आपका पासवर्ड आपके लिए बदल गया था, इसलिए यहां फिर से चैट शुरू हो रहा है।"

#, machine, plain1
msgid "Your password was changed, so chat is starting again here."
msgstr "आपका पासवर्ड बदल गया था, इसलिए यहां फिर से चैट शुरू हो रहा है।"

#, machine, plain1
msgid "Your password was reset, so chat is starting again here."
msgstr "आपका पासवर्ड रीसेट हो गया था, इसलिए यहां फिर से चैट शुरू हो रहा है।"

#, machine, plain1
msgid "Your recovery code"
msgstr "आपकी वसूली कोड"

#, machine, plain1
msgid "Your saved templates show up here."
msgstr "आपके सेव्ड टेम्प्लेट यहां दिखाई देते हैं।"

#, machine, plain2
msgid "Your screen can be shared only while you're on video in this call."
msgstr "जब आप इस कॉल में वीडियो देख रहे हों तो आपकी स्क्रीन केवल साझा की जा सकती है।"

#, machine, plain2
msgid "Your screen couldn't be shared."
msgstr "आपकी स्क्रीन साझा नहीं की जा सकती।"

#, machine, plain1
msgid "Your settings have been updated."
msgstr "आपकी सेटिंग्स को अपडेट किया गया है।"

#, machine, plain1
msgid "Your storage needs connecting again. Send your audio to:"
msgstr "फिर से जुड़ने की आपकी आवश्यकता है। अपने ऑडियो को भेजें:"

