#, machine, plain1
msgid "`client_id` - Your application's Client ID"
msgstr "`client_id` – مشتری شما"

#, machine, plain1
msgid "`client_secret` - Your application's Client Secret"
msgstr "`client_secret` مشتری مخفی شما"

#, machine, plain1
msgid "`code` - The `code` parameter that was given to you in the previous step."
msgstr "`code` پارامتر `code` که در گام قبلی به شما داده شد."

#, machine, plain1
msgid "`code` - a **single-use** authorization code."
msgstr "`code` - یک کد مجوز واحد ** استفاده."

#. keep the code between backticks exactly as it is
#, machine, plain1, python-format
msgid "`cursor`: any text up to %(num)s characters that lets you continue. Leave it out when there is nothing more."
msgid_plural "`cursor`: any text up to %(num)s characters that lets you continue. Leave it out when there is nothing more."
msgstr[0] "`cursor` هر متن به کاراکترهای %(num)s که به شما اجازه می دهد ادامه دهید. آن را رها کنید زمانی که چیزی دیگر وجود ندارد."

#. the word in quotes is a value the application sends as it is: keep it in
#. English.
#, machine, plain1
msgid "`grant_type` - Set to the word \"code\""
msgstr "`grant_type` به کلمه \"کد\" تنظیم کنید"

#. the word in quotes is a value the application sends as it is: keep it in
#. English.
#, machine, plain1
msgid "`grant_type` - set to the word \"refresh\""
msgstr "`grant_type` به کلمه \"تازه\" تنظیم شده است"

#, machine, plain1
msgid "`permanent` - optional. Set to `true` if you are requesting indefinite access. Omit if not."
msgstr "`permanent` اختیاری تنظیم برای `true` اگر شما درخواست دسترسی نامحدود دارید. اگر نه."

#. keep the code between backticks exactly as it is
#, machine, plain1, python-format
msgid "`posts`: up to %(num)s post ids. A post's id is the short code in its address: `/post/2k1/a-title` is `2k1`."
msgid_plural "`posts`: up to %(num)s post ids. A post's id is the short code in its address: `/post/2k1/a-title` is `2k1`."
msgstr[0] "`posts` تا %(num)s شناسه های پست. یک کد کوتاه در آدرس آن است: `/post/2k1/a-title` `2k1`."

#, machine, plain1
msgid "`redirect_uri` - The redirect URI (or one of the URIs) specified in your application information. Must not use HTTP unless using localhost (use HTTPS instead)."
msgstr "`redirect_uri` ریدایرکت URI (یا یکی از URI ها) در اطلاعات درخواست شما مشخص شده است. نباید استفاده کرد HTTP مگر اینکه از localhost استفاده کنید. HTTPS در عوض)."

#, machine, plain1
msgid "`refresh_token` - the refresh token which you obtained during Step 3"
msgstr "`refresh_token` توکن تازه ای که در مرحله 3 به دست آورده اید"

#, machine, plain1
msgid "`scope` - A comma-separated list of permission scopes that you are requesting. Valid scopes are: `identity`, `create`, `read`, `update`, `delete`, `vote`, and `guildmaster`."
msgstr "`scope` – لیستی از محدوده های مجاز که شما درخواست می کنید. `identity`، `create`، `read`، `update`، `delete`، `vote` و `guildmaster`."

#, machine, plain1
msgid "`state` - The state token from earlier."
msgstr "`state` توکن دولت از قبل."

#, machine, plain1
msgid "`state` - This is your own anti-cross-site-forgery token. We don't do anything with this, except give it to the user to pass back to you later. You are responsible for generating and validating the state token."
msgstr "`state` – این توکن ضد زنگی شماست. ما هیچ کاری را با این کار انجام نمی دهیم، مگر اینکه به کاربر اجازه دهید بعدا به شما بازگردد. شما مسئول تولید و اعتباربخشی به توکن دولتی هستید."

#, machine, plain1
msgid "a Redirect URI, or a comma-separated list of redirect URIs. May not use HTTP unless using localhost (use HTTPS instead)."
msgstr "Redirect URIیا یک لیست پیچیده از URI های ریدایرکت. استفاده نکردن HTTP مگر اینکه از localhost استفاده کنید. HTTPS در عوض)."

#, machine, plain1
msgid "a brief description of what your application is intended to do"
msgstr "شرح مختصری از آنچه که درخواست شما قصد دارد انجام دهد"

