msgstr "به روز رسانی stylesheet"

#. url: is a search operator and stays as it is
#, machine, plain1, python-format
msgid "url: can be at most %(num)s character."
msgid_plural "url: can be at most %(num)s characters."
msgstr[0] "url: می تواند در اکثر شخصیت های %(num)s باشد."

#, machine, plain1
msgid "username"
msgstr "نام کاربری"

#. "v." is short for version; the name is the company that runs the site
#, machine, plain1, python-format
msgid "v. %(version)s, © 2021 %(company)s"
msgstr "v. %(version)s, © 2021 %(company)s"

#, machine, plain1
msgid "video"
msgstr "ویدئو ویدئویی"

#, glossary, machine, plain1
msgid "video preview"
msgstr "پیش‌نمایش ویدیو"

#, machine, plain1
msgid "voice, up to 8 people"
msgstr "صدا، تا 8 نفر"

#, machine, plain1
msgid "waiting for them to accept"
msgstr "انتظار برای پذیرش آنها"

#. follows the app's name, shown just above as a heading
#, machine, plain1, python-format
msgid "wants to access your @%(name)s account."
msgstr "می خواهید به @%(name)s حساب"

#, machine, plain1
msgctxt "time filter"
msgid "week"
msgstr "هفته"

#, machine, plain1
msgid "when it ends it disappears, with everything in it"
msgstr "هنگامی که آن را به پایان می رساند، با همه چیز در آن ناپدید می شود"

#, machine, plain1
msgid "who wrote what"
msgstr "چه کسی نوشت چه"

#. beside a post's author, its co-authors: names is their names, linked
#, machine, plain1, python-format
msgid "with %(names)s"
msgstr "همراه با %(names)s"

#. beside a post's author, its co-authors: names is the first five, linked; num
#. is how many more there are
#, machine, plain1, python-format
msgid "with %(names)s and <a href=\"%(url)s\">%(num)s other</a>"
msgid_plural "with %(names)s and <a href=\"%(url)s\">%(num)s others</a>"
msgstr[0] "همراه با %(names)s و <a href=\"%(url)s\">%(num)s دیگران</a>"

#, machine, plain1, python-format
msgid "with promo code <code>%(code)s</code>"
msgstr "کد promo <code>%(code)s</code>"

#, machine, plain1
msgid "words or phrases, separated by commas"
msgstr "کلمات یا عبارات، جدا شده توسط کاما"

#. follows the moderator's name in a guild's moderation log; %(target)s is a
#. link
#, machine, plain1, python-format
msgid "yanked post %(target)s"
msgstr "پست نوشته شده %(target)s"

#, machine, plain1
msgctxt "time filter"
msgid "year"
msgstr "سال"

#, machine, plain1
msgctxt "badge beside your own name"
msgid "you"
msgstr "شما هستید"

#, machine, plain1
msgid "you voted no"
msgstr "شما رای نداده اید"

#, machine, plain1
msgid "you voted yes"
msgstr "رای دادید بله"

#, machine, plain1
msgid "you were posting too fast, and it couldn't wait any longer."
msgstr "خیلی سریع پست می کردید و دیگر نمی توانستید صبر کنید."

#, machine, plain1
msgid "you were signed out."
msgstr "امضا کرده اید."

#, machine, plain1
msgid "you're invited to write it"
msgstr "دعوت شده اید که آن را بنویسید"

#, machine, plain1
msgid "your account couldn't post it at that moment (a suspension, or the rules of a guild it was forwarded to). Open it and press Post to see what."
msgstr "حساب شما نمی تواند آن را در آن لحظه ارسال کند (یک تعلیق یا قوانینی که به آن پایبند بود). آن را باز کنید و پست را فشار دهید تا ببینید چه."

#. "~" means about; an action is a post or comment counted towards the posting
#. cooldown
#, machine, plain1, python-format
msgid "~%(num)s action left before a cooldown"
msgid_plural "~%(num)s actions left before a cooldown"
msgstr[0] "~%(num)s اقدامات قبل از سرد شدن"

#, machine, plain1, python-format
msgid "“%(name)s” is already used for a view of your bookmarks. Pick another name."
msgstr "\"%(name)s در حال حاضر برای مشاهده نشانه های شما استفاده می شود. نام دیگری را انتخاب کنید."

#, machine, plain1, python-format
msgid "“%(name)s” isn't a guild name."
msgstr "\"\"%(name)s«یک اسم نیست."

#, machine, plain1, python-format
msgid "“%(option)s” is in the poll twice."
msgstr "\"\"%(option)s\"در نظرسنجی دو بار است."

