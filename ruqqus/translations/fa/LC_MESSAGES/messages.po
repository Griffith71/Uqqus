msgstr "باز کردن اصل در %(domain)s در یک برگه جدید"

#, machine, plain1
msgid "Open the post"
msgstr "باز کردن پست"

#, machine, plain1
msgid "Open the quoted post"
msgstr "باز کردن پست نقل شده"

#, glossary, machine, plain1
