msgctxt "button"
msgid "Open"
msgstr "باز"

#, machine, plain1
msgid "Open Chat"
msgstr "چت باز"

#, machine, plain1
msgid "Open Chat on the site once first, so your chats and their keys are ready."
msgstr "چت باز در سایت یک بار اول، بنابراین چت شما و کلید آنها آماده است."

#, machine, plain1
