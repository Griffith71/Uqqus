msgid "You are blocking @%(name)s"
msgstr "@%(name)s را مسدود کرده‌اید"

#, machine, plain1, python-format
msgid "You are following @%(name)s."
msgstr "شما دنبال می کنید @%(name)s."

#, machine, plain1, python-format
msgid "You called · video · %(when)s · %(length)s"
msgstr "شما به نام · ویدیو · %(when)s · %(length)s"

#, machine, plain1, python-format
msgid "You called · voice · %(when)s · %(length)s"
msgstr "شما صدا می گویید · %(when)s · %(length)s"

#, machine, plain1
msgid "You can ask for a community note once for each comment, and not on your own comment."
msgstr "شما می توانید یک بار برای هر نظر یک یادداشت اجتماعی درخواست کنید و نه در نظر خودتان."

#, machine, plain1
msgid "You can ask for a community note once for each post, and not on your own post."
msgstr "شما می توانید یک بار برای هر پست یک یادداشت اجتماعی درخواست کنید و نه در پست خود."

#, machine, plain1, python-format
msgid "You can have %(num)s folder at most."
msgid_plural "You can have %(num)s folders at most."
msgstr[0] "در بیشتر موارد می توانید پوشه های %(num)s داشته باشید."

#, machine, plain1
msgid "You can read this channel but not write in it."
msgstr "شما می توانید این کانال را بخوانید اما در آن بنویسید."

#, machine, plain1
msgid "You can see who is here, but you can't speak in this channel."
msgstr "شما می توانید ببینید که چه کسی اینجا است، اما شما نمی توانید در این کانال صحبت کنید."

#, glossary, machine, plain2
msgid "You can't do that."
msgstr "اجازه این کار را ندارید."

#, machine, plain1
msgid "You can't message that person."
msgstr "شما نمی توانید این شخص را پیام کنید."

#, machine, plain1
msgid "You can't send to that chat."
msgstr "شما نمی توانید به این چت ارسال کنید."

#, machine, plain1
msgid "You can't start a chat with them."
msgstr "شما نمی توانید یک چت با آنها شروع کنید."

#, machine, plain1
msgid "You can’t edit this draft any more (you may have left it or been removed)."
msgstr "شما نمی توانید این پیش نویس را بیشتر ویرایش کنید (ممکن است آن را ترک کرده باشید یا حذف شده باشید)."

#, machine, plain1
msgid "You ended the Space."
msgstr "فضا را به پایان رساندید."

#, machine, plain1
msgid "You have no curations yet."
msgstr "هنوز هیچ تغذیه ای ندارید."

#, machine, plain1
msgid "You have no stories yet. Share one first."
msgstr "هنوز قصه ای ندارید. اول به اشتراک بگذارید."

#, machine, plain1
msgid "You haven't made a circle of your own yet. Your Friends circle is automatic: it is everyone you follow who follows you back."
msgstr "شما هنوز حلقه ای از خودتان ساخته اید. دایره دوستان شما اتوماتیک است: هر کسی که شما را دنبال می کند، شما را دنبال می کند."

#, machine, plain1
msgid "You left the Space."
msgstr "شما فضا را ترک کردید."

#, machine, plain1
msgid "You left the call."
msgstr "شما تماس را ترک کردید."

#, machine, plain2
msgid "You logged out everywhere from another device, so chat is starting again here."
msgstr "شما در همه جا از دستگاه دیگری جدا می شوید، بنابراین چت دوباره شروع می شود."

#, machine, plain1
msgid "You signed in with your two-factor recovery code, so chat is starting again here."
msgstr "شما با کد بازیابی دو مرحله ای خود امضا کرده اید، بنابراین چت دوباره در اینجا شروع می شود."

#, machine, plain1, python-format
msgid "You unfollowed @%(name)s."
msgstr "دانلود زیرنویس فارسی فیلم You Unfollowed%(name)s."

#, machine, plain1
msgid "You were removed from this Space."
msgstr "شما از این فضا خارج شده اید."

#, machine, plain2
msgid "You'll get a new recovery code, and the old one will stop working."
msgstr "شما یک کد بازیابی جدید دریافت خواهید کرد و قدیمی کار را متوقف خواهد کرد."

#, machine, plain1
msgid "You're doing that too much. Try again later."
msgstr "شما این کار را خیلی زیاد انجام می دهید. دوباره امتحان کنید."

#, machine, plain1
msgid "You're no longer in this Space."
msgstr "شما دیگر در این فضا نیستید."

#, machine, plain1
msgid "You're the only one here."
msgstr "شما تنها کسی هستید که اینجا هستید."

#, machine, plain1
msgid "Your app is verified"
msgstr "برنامه شما تایید شده است"

#, machine, plain1
msgid "Your browser blocked the window for connecting. Allow pop-ups for this site, or connect in the settings."
msgstr "مرورگر شما پنجره اتصال را مسدود کرد. اجازه دهید پاپ آپ ها برای این سایت یا اتصال در تنظیمات."

