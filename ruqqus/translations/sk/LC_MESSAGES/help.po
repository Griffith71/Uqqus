msgctxt "formatting"
msgid "Code"
msgstr "Kód"

#, machine, plain1
msgid "Code Block"
msgstr "Kód"

#, machine, plain1
msgid "Coloring"
msgstr "Farbenie"

#, machine, plain1
msgid "Colour, highlight, alignment and buttons"
msgstr "Farba, zvýraznenie, nastavenie a tlačidlá"

