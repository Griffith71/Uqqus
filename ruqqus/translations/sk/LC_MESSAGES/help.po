msgid "To create a \"share to %(site)s\" button, create an element which has `onclick=\"window.location.href='https://ruqqus.com/submit?url='+window.location.href\"`"
msgstr "Ak chcete vytvoriť tlačidlo \"zdieľať sa s %(site)s,\" vytvorte prvok, ktorý má `onclick=\"window.location.href='https://ruqqus.com/submit?url='+window.location.href\"`"

#, machine, plain1, python-format
msgid "To help protect user privacy and safety, %(site)s forces HTTPS on all assets uploaded and submitted to %(site)s. This includes automatic conversion of all \"http://\" schemas into \"https://\"."
msgstr "Aby sa pomohlo chrániť súkromie a bezpečnosť používateľov, %(site)s vynúti HTTPS na všetky nahrané aktíva a predložené na %(site)s. To zahŕňa automatickú konverziu všetkých \" http://\" schém na \" https://\"."

#, machine, plain1, python-format
msgid "To indicate the presence of a %(site)s-powered embed of content from %(site)s."
msgstr "Na označenie prítomnosti obsahu %(site)s poháňaného %(site)s."

#, machine, plain1, python-format
msgid "To link to %(site)s, enable sharing to %(site)s, or refer to your presence on %(site)s."
msgstr "Pre odkaz na %(site)s, povoliť zdieľanie na %(site)s alebo odkaz na vašu prítomnosť na %(site)s."

#, machine, plain1
msgid "To request ruqqus API keys, visit [this page](/help/apps)"
msgstr "Ak chcete požiadať o ruqqus API kľúče, navštívte [túto stránku] (/help/apps)"

#, machine, plain1
msgid "To search for the words themselves, put them in quotes: <code>\"#gaming\"</code>."
msgstr "Ak chcete hľadať slová sami, dať ich v úvodzovkách: <code>\"#gaming\"</code>."

