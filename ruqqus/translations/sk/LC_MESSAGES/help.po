msgid "\"%(site)s\" is pronounced identically to the standard English word \"ruckus\""
msgstr "\"%(site)s\" je vyslovovaný rovnako ako štandardné anglické slovo \"ruccus\""

#, machine, plain1
msgid "\"Ruqqie\" is pronounced \"RUCK-ee\""
msgstr "\"Ruqqie\" sa vyslovuje \"RUCK-Ee\""

