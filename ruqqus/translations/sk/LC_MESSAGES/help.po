#, machine, plain1, python-format
msgid "You already lead the maximum number of guilds. You cannot siege a new guild unless you lead %(num)s or fewer guilds, but you can try to overthrow a top guildmaster in a guild you already lead."
msgid_plural "You already lead the maximum number of guilds. You cannot siege a new guild unless you lead %(num)s or fewer guilds, but you can try to overthrow a top guildmaster in a guild you already lead."
msgstr[0] "Už si viedol maximálny počet cechov. Nemôžete prevziať nárok na nový cech, pokiaľ nepovediete %(num)s alebo menej cechov, ale môžete sa pokúsiť zvrhnúť najlepšieho cechového moderátora v cechu, ktorý už vediete."
msgstr[1] "Už si viedol maximálny počet cechov. Nemôžete prevziať nárok na nový cech, ak nevedú %(num)s alebo menej cechov, ale môžete sa pokúsiť zvrhnúť najlepšieho cechového moderátora v cechu, ktorý už vediete."
msgstr[2] "Už si viedol maximálny počet cechov. Nemôžete prevziať nárok na nový cech, ak nepovediete %(num)s alebo menej cechov, ale môžete sa pokúsiť zvrhnúť najlepšieho cechového moderátora v cechu, ktorý už vediete."

#, machine, plain1, python-format
msgid "You are currently suspended from %(site)s. You cannot siege any guilds at this time."
msgstr "Momentálne ste suspendovaný. %(site)sNemôžete si teraz nárokovať žiadne cechy."

#, machine, plain1
msgid "You cannot siege any Guilds right now. You can only make one siege attempt every 7 days, and your account must be at least 7 days old."
msgstr "Práve teraz si nemôžeš prebrať žiadnych Guildov. Môžete vykonať len jeden pokus o prevzatie pohľadávky každých 7 dní, a váš účet musí byť aspoň 7 dní."

#, machine, plain1
msgid "You may attempt to siege a guild once every 7 days. Any siege attempt - whether successful or not - will trigger this cool-down period."
msgstr "Môžete sa pokúsiť prevziať nárok na cech raz za 7 dní. Akýkoľvek pokus o prevzatie pohľadávky - či už úspešný, alebo nie - spustí toto obdobie chladenia."

#, machine, plain1
msgid "You need to be logged in to siege a Guild."
msgstr "Musíš byť prihlásený, aby si získal Guild."

#, machine, plain1
