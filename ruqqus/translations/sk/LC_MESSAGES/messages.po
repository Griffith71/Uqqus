msgstr[1] "Kanál môže mať najviac %(num)s roboty kŕmenie."
msgstr[2] "Kanál môže mať najviac %(num)s robotov, ktoré ho kŕmia."

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s helper."
msgid_plural "A channel can have at most %(num)s helpers."
msgstr[0] "Kanál môže mať najviac %(num)s pomocníka."
msgstr[1] "Kanál môže mať najviac dvoch pomocníkov."
msgstr[2] "Kanál môže mať najviac %(num)s pomocníkov."

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s message a day."
msgid_plural "A channel can have at most %(num)s messages a day."
msgstr[0] "Kanál môže mať najviac %(num)s správu denne."
msgstr[1] "Kanál môže mať najviac %(num)s správy denne."
msgstr[2] "Kanál môže mať najviac %(num)s správ denne."

#, machine, plain1, python-format
msgid "A channel can have at most %(num)s pinned message."
msgid_plural "A channel can have at most %(num)s pinned messages."
msgstr[0] "Kanál môže mať najviac %(num)s pripnutú správu."
msgstr[1] "Kanál môže mať najviac %(num)s prilepené správy."
msgstr[2] "Kanál môže mať najviac %(num)s prišpendovaných správ."

#, machine, plain1
msgid "A channel is one-to-many: its owner and helpers write, members read and react. A public channel is open to everyone and can be moderated; a channel for circles is end-to-end encrypted and only for the people in them."
msgstr "Kanál je one-to-mnoho: jeho majiteľ a pomocníci písať, členovia čítať a reagovať. Verejný kanál je otvorený pre všetkých a môže byť moderovaný; kanál pre kruhy je end-to-end šifrovaný a len pre ľudí v nich."

#, python-format
msgid "A channel name can be %(num)s character (Chinese, Japanese and Korean characters and emoji count as 2)."
msgid_plural "A channel name can be %(num)s characters (Chinese, Japanese and Korean characters and emoji count as 2)."
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#, machine, plain1, python-format
msgid "A channel name can be at most %(num)s character."
msgid_plural "A channel name can be at most %(num)s characters."
msgstr[0] "Názov kanála môže byť najviac %(num)s znak."
msgstr[1] "Názov kanála môže byť najviac %(num)s znaky."
msgstr[2] "Názov kanála môže byť najviac %(num)s znakov."

#, machine, plain1
msgid "A channel name can't contain < or >."
msgstr "Názov kanála nemôže obsahovať < alebo >."

#, machine, plain1
msgid "A channel name can't contain @: it would read as a handle."
msgstr "Názov kanála nemôže obsahovať @: bude čítať ako rukoväť."

#, machine, plain1
msgid "A channel name can't contain control or invisible characters."
msgstr "Názov kanála nemôže obsahovať ovládanie alebo neviditeľné znaky."

#, machine, plain1, python-format
msgid "A chat app wants to sign in to your chats as <strong>@%(name)s</strong>."
msgstr "Aplikácia chatu sa chce prihlásiť do chatu ako <strong>@%(name)s</strong>."

#, python-format
msgid "A chat app was signed in to your %(site)s account. If that wasn't you, sign it out in [Settings > Chat apps](/settings/chat_apps) and change your password."
msgstr ""

#, machine, plain2, python-format
msgid "A chat can have at most %(num)s pinned messages. Unpin one first."
msgstr "Rozhovor môže mať najviac %(num)s pripnuté odkazy. Unpin jeden prvý."

#, machine, plain1, python-format
msgid "A circle can have %(num)s person at most."
msgid_plural "A circle can have %(num)s people at most."
msgstr[0] "Kruh môže mať najviac %(num)s osobu."
msgstr[1] "Kruh môže mať najviac %(num)s ľudí."
msgstr[2] "Kruh môže mať najviac %(num)s ľudí."

#. %(label)s is the label people see on such a post, "Shared with a circle"
#, machine, plain1, python-format
msgid "A circle of your own. The people in it are not told, and nothing they see names it: your posts for it show as \"%(label)s\"."
msgstr "Tvoj vlastný kruh. Ľudia v ňom nie sú povedané, a nič, čo vidia mená: vaše príspevky pre to ukazujú ako \"%(label)s.\"."

#, machine, plain1, python-format
msgid "A circle's name can be %(num)s character at most."
msgid_plural "A circle's name can be %(num)s characters at most."
msgstr[0] "Meno kruhu môže byť najviac %(num)s znak."
msgstr[1] "Meno kruhu môže byť maximálne %(num)s znaky."
msgstr[2] "Meno kruhu môže byť maximálne %(num)s znakov."

#, machine, plain2
msgid "A comment"
msgstr "Poznámka"

#, machine, plain2
msgid "A comment by an account you blocked or that blocked you."
msgstr "Komentár účtu, ktorý ste zablokovali alebo ktorý vás zablokoval."

#, machine, plain2
msgid "A comment hidden by a guildmaster."
msgstr "Komentár skrytý cechovým moderátorom."

#, machine, plain2
msgid "A comment hidden by your word filter."
msgstr "Komentár skrytý filtrom vášho slova."

#, machine, plain2
msgid "A comment its author deleted. What it said isn't shown here."
msgstr "Komentár jeho autor vymazal. To, čo sa tam píše, sa tu neukazuje."

#, machine, plain1
msgid "A comment on a post for a Circle can't be forwarded to a guild."
msgstr "Komentár na príspevok pre Circle nemôže byť odoslaný do cechu."

#, machine, plain1
msgid "A comment on a post for a Circle can't be reposted."
msgstr "Komentár na príspevok pre Circle nemožno repostovať."

#, machine, plain2
msgid "A comment removed by the site's admins."
msgstr "Komentár odstránený admins stránky."

#, python-format
msgid "A community note was added to a comment you asked about: [view it](%(link)s)"
msgstr ""

#, python-format
msgid "A community note was added to a post you asked about: [view it](%(link)s)"
msgstr ""

#, machine, plain2
msgid "A copy of this as it was when it was hidden, removed, deleted or relied on for a decision. Only its author, the guildmasters of the guild that decided and the site's administrators can open it here. Most copies are cleared after a while; the copy of something its author deleted stays in the public Log."
msgstr "Kópia tak, ako bola vtedy, keď bola skrytá, odstránená, vymazaná alebo spoliehala sa na rozhodnutie. Iba autor, cech moderátori cechu, ktorý sa rozhodol a správcovia webu ho môžu otvoriť tu. Väčšina kópií sú vymazané po chvíli; kópia niečoho, čo autor vymazal zostane vo verejnom denníku."

#, machine, plain1
msgid "A curation of the whole site needs an age limit of a month or less."
msgstr "Vyliečený krmivo z celého webu potrebuje vekovú hranicu najviac jedného mesiaca."

#, machine, plain1
msgid "A day"
msgstr "Deň"

#, machine, plain2
msgid "A decision in the Log"
