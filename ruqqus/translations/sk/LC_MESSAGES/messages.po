msgid ""
"Your appeal of %(decision_link)s was not taken further.\n"
"\n"
"%(note_block)s"
msgstr ""
"Vaše odvolanie na %(decision_link)s nebolo prijaté ďalej.\n"
"\n"
"%(note_block)s"

#, machine, plain2, python-format
msgid ""
"Your appeal of the hold on your account was accepted, and the hold was lifted. You can post, comment and vote again.\n"
"\n"
"%(note_block)s"
msgstr ""
"Vaše odvolanie na účet bolo prijaté a držanie bolo zrušené. Môžete písať, komentovať a hlasovať znova.\n"
"\n"
"%(note_block)s"

#, machine, plain2, python-format
msgid ""
"Your appeal of the hold on your account was looked at, and the hold stands.\n"
"\n"
"%(note_block)s"
msgstr ""
"Pozreli sa na tvoje odvolanie na účet a držanie stojí.\n"
"\n"
"%(note_block)s"

