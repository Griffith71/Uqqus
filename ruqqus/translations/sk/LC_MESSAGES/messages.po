msgid_plural "A call has up to %(num)s people on stage and %(listeners)s listening, for at most 4 hours."
msgstr[0] "Volanie má až %(num)s osobu na pódiu a %(listeners)s počúvanie, najviac 4 hodiny."
msgstr[1] "Volanie má až %(num)s ľudí na pódiu a %(listeners)s počúvanie, najviac 4 hodiny."
msgstr[2] "Volanie má až %(num)s ľudí na javisku a %(listeners)s počúvanie, najviac 4 hodiny."

#, machine, plain1
msgid "A cancelled event can't be changed."
msgstr "Zrušená udalosť nemôže byť zmenená."

#, machine, plain1
