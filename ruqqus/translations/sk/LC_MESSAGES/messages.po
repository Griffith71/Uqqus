msgid_plural "A description can be %(num)s characters at most."
msgstr[0] "Opis môže byť najviac %(num)s znak."
msgstr[1] "Opis môže byť najviac %(num)s znaky."
msgstr[2] "Opis môže byť najviac %(num)s znakov."

#, machine, plain1, python-format
