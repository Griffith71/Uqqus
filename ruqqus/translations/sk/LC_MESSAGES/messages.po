msgstr[1] "Jeden účet vám dáva najviac %(num)s body mesačne, akokoľvek veľa hlasuje a komentáre."
msgstr[2] "Jeden účet vám dáva najviac %(num)s bodov za mesiac, akokoľvek veľa hlasuje a komentáre."

#, machine, plain1, python-format
msgid "One address a line, up to %(max)s. Each is read once now to check it is a feed."
msgstr "Jedna adresa riadok, až %(max)sKaždý z nich je teraz prečítaný, aby zistil, či je to krmivo."

#, machine, plain1
msgid "One coin buys one week of Premium. Coins are only spent on Premium when you redeem one or switch on renewal below."
msgstr "Jedna minca si kúpi jeden týždeň PremiumMince sa míňajú len na Premium keď vykúpite jeden alebo zapnete obnovenie nižšie."

#, machine, plain1
msgid "One file with your profile, posts, comments, votes, follows, blocks, mutes, bookmarks, drafts, circles, stories, shared drafts and where you signed in from. Chats aren't in it: they're end-to-end encrypted and the site can't read them."
msgstr "Jeden súbor s vaším profilom, príspevky, komentáre, hlasy, nasledujúce, bloky, záložky, záložky, návrhy, kruhy, príbehy, zdieľané návrhy a odkiaľ ste sa prihlásili. Nie sú v ňom reči: sú end-to-end šifrované a stránka ich nevie prečítať."

#, machine, plain1
msgid "One of these revisions can't be shown to you."
msgstr "Jednu z týchto revízií vám nemožno ukázať."

#, machine, plain1
msgid "One of those circles isn't yours any more. Choose again."
msgstr "Jeden z tých kruhov už nie je tvoj. Vyber si znova."

#, machine, plain1
msgid "One of your child accounts owes money, so your account can't be deleted yet."
msgstr "Jeden z vašich detských účtov dlhuje peniaze, takže váš účet ešte nie je možné vymazať."

#, machine, plain1
msgid "One-time codes for the day you lose your authenticator. Making a new set replaces every earlier code, used or not."
msgstr "Jednorazové kódy na deň, keď stratíte svojho autentifikátora. Vytvorenie novej sady nahrádza každý skorší kód, použitý alebo nie."

