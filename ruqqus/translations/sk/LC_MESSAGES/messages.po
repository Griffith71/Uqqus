msgid ""
"Your appeal of %(decision_link)s was accepted, and the decision was reversed.\n"
"\n"
"%(note_block)s"
msgstr ""
"Vaše odvolanie na %(decision_link)s bolo prijaté a rozhodnutie bolo zrušené.\n"
"\n"
"%(note_block)s"

#, machine, plain2, python-format
msgid ""
"Your appeal of %(decision_link)s was looked at, and the decision stands.\n"
"\n"
"%(note_block)s"
msgstr ""
"Vaše odvolanie na %(decision_link)s bolo preskúmané a rozhodnutie platí.\n"
"\n"
"%(note_block)s"

