msgstr "visnovsky@ kde. org %(email)s bola overená. Ďakujem."

#, machine, plain1, python-format
msgid "Your feedback was marked fixed: \"%(excerpt)s\""
msgstr "Vaša spätná väzba bola označená ako pevná: \"%(excerpt)s\""

