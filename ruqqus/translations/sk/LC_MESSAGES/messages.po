msgstr "<strong>E-mail:</strong> %(email)s"

#, machine, plain2
msgid "<strong>If it wasn't you,</strong> change your password now. Changing it also signs out every other device."
msgstr "<strong>Keby si to nebol ty,</strong> Zmeňte heslo. Zmena tiež odpojí všetky ostatné zariadenia."

#, machine, plain1, python-format
msgid "<strong>Member bot</strong>: you run it with your own key or pay for its source (for example X). It stays yours, says \"Automated by @%(name)s\" and you manage it."
msgstr "<strong>Členský štát</strong>: spustíte ho s vlastným kľúčom alebo zaplatíte za jeho zdroj (napríklad X). Je to vaše, hovorí \"Automatizované @%(name)s\"a ty to zvládneš."

#, machine, plain2
msgid "<strong>Not in apps:</strong> files, pictures and voice notes. Those sent on this site are kept, encrypted, in the sender's own storage, which an app can't reach, and an app can't send one."
msgstr "<strong>Nie v aplikáciách:</strong> súbory, obrázky a hlasové poznámky. Tie zaslané na tejto stránke sú uchovávané, šifrované, vo vlastnom úložisku odosielateľa, ku ktorému sa aplikácia nemôže dostať, a aplikácia ho nemôže poslať."

#, machine, plain1
msgid "<strong>On this site only:</strong> starting a chat, accepting a message request, making a group or adding people, calls and Spaces. An app can't find people, make rooms or start a call on this server: the site keeps who can reach you as it does here."
msgstr "<strong>Len na tejto stránke:</strong> začatie rozhovoru, prijatie žiadosti o správu, vytvorenie skupiny alebo pridanie ľudí, hovorov a priestorov. Aplikácia nemôže nájsť ľudí, vytvoriť izby alebo spustiť hovor na tomto serveri: stránka udržuje, kto môže dosiahnuť vás, ako to robí tu."

#, machine, plain1, python-format
msgid "<strong>P.S.</strong> Feel free to tweet at us on Twitter <a href=\"%(url)s\">%(handle)s</a>."
msgstr "<strong>P.S.</strong> Neváhajte na nás tweetovať na Twitteri <a href=\"%(url)s\">%(handle)s</a>."

#, machine, plain1, python-format
