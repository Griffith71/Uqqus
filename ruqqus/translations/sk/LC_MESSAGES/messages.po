msgstr[0] "Ukážu sa iba hodnoty, nikdy kto. Každodenné údaje sa objavia, keď má cech %(num)s člen, takže malé cechové čísla nemôžu ukazovať na jednu osobu."
msgstr[1] "Ukážu sa iba hodnoty, nikdy kto. Každodenné čísla sa objavujú, keď má cech %(num)s členov, takže malé cechové čísla nemôžu ukazovať na jednu osobu."
msgstr[2] "Ukážu sa iba hodnoty, nikdy kto. Každodenné čísla sa objavujú, keď má cech %(num)s členov, takže malé cechové čísla nemôžu ukazovať na jednu osobu."

#, machine, plain1
