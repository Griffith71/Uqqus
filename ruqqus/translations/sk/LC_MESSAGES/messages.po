msgstr "kto napísal čo"

#. beside a post's author, its co-authors: names is their names, linked
#, machine, plain1, python-format
msgid "with %(names)s"
msgstr "s %(names)s"

#. beside a post's author, its co-authors: names is the first five, linked; num
#. is how many more there are
#, machine, plain1, python-format
msgid "with %(names)s and <a href=\"%(url)s\">%(num)s other</a>"
msgid_plural "with %(names)s and <a href=\"%(url)s\">%(num)s others</a>"
msgstr[0] "s %(names)s a <a href=\"%(url)s\">%(num)s iná</a>"
msgstr[1] "s %(names)s a <a href=\"%(url)s\">%(num)s iné</a>"
msgstr[2] "s %(names)s a <a href=\"%(url)s\">%(num)s iné</a>"

#, machine, plain1, python-format
msgid "with promo code <code>%(code)s</code>"
msgstr "s promo kódom <code>%(code)s</code>"

#, machine, plain1
msgid "words or phrases, separated by commas"
msgstr "slová alebo frázy oddelené čiarkami"

#. follows the moderator's name in a guild's moderation log; %(target)s is a
#. link
#, machine, plain1, python-format
msgid "yanked post %(target)s"
msgstr "odtrhnutý post %(target)s"

#, machine, plain1
msgctxt "time filter"
msgid "year"
msgstr "rok"

#, machine, plain1
msgctxt "badge beside your own name"
msgid "you"
msgstr "vy"

#, machine, plain1
msgid "you voted no"
msgstr "ste hlasovali nie"

#, machine, plain1
msgid "you voted yes"
msgstr "vy ste hlasovali áno"

#, machine, plain1
msgid "you were posting too fast, and it couldn't wait any longer."
msgstr "posielali ste príliš rýchlo, a už to nemohlo dlhšie čakať."

#, machine, plain2
msgid "you were signed out."
msgstr "bol si odpojený."

#, machine, plain1
msgid "you're invited to write it"
msgstr "si pozvaný, aby si to napísal"

#, machine, plain2
msgid "your account couldn't post it at that moment (it is on hold or suspended, or the rules of a guild it was forwarded to). Open it and press Post to see what."
msgstr "váš účet nemohol poslať v tej chvíli (je nadržaný alebo pozastavený, alebo pravidlá cechu bol prevedený). Otvorte to a stlačte Post zistiť, čo."

#. "~" means about; an action is a post or comment counted towards the posting
#. cooldown
#, machine, plain1, python-format
msgid "~%(num)s action left before a cooldown"
msgid_plural "~%(num)s actions left before a cooldown"
msgstr[0] "~%(num)s akcia vľavo pred chladom"
msgstr[1] "~%(num)s akcie ponechané pred chladom"
msgstr[2] "~%(num)s akcie ponechané pred chladom"

#, machine, plain1, python-format
msgid "“%(name)s” is already used for a view of your bookmarks. Pick another name."
msgstr "%(name)sUž sa používa na zobrazenie záložiek. Vyber si iné meno."

#, machine, plain1, python-format
msgid "“%(name)s” isn't a guild name."
msgstr "%(name)sNie je cechové meno."

#, machine, plain1, python-format
msgid "“%(option)s” is in the poll twice."
msgstr "%(option)sDvakrát je v prieskume."

