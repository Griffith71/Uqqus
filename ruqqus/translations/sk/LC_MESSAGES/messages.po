#, machine, plain1, python-format
msgid "The admins said: %(note)s"
msgstr "Administi povedali: %(note)s"

#, machine, plain1
msgid "The age check didn't finish. Nothing has changed, and you can try again."
msgstr "Vek sa neskončil. Nič sa nezmenilo a môžete to skúsiť znova."

#, machine, plain1
msgid "The age check found that you are under the youngest age allowed to have an account where you are."
msgstr "Veková kontrola zistila, že ste v najmladšom veku, kde môžete mať účet."

#, machine, plain1
msgid "The age check found that you're under 18, so the child lock stays on."
msgstr "Vekový šek zistil, že máte menej ako 18 rokov, takže detský zámok zostáva zapnutý."

#, machine, plain2
msgid "The age check found that you're under 18. Accounts here are for people 18 or over, so this account was closed."
msgstr "Vekový šek zistil, že máš menej ako 18. Tu sú účty pre ľudí 18 a viac, takže tento účet bol uzavretý."

#, machine, plain1
msgid "The author"
msgstr "Autor"

#, machine, plain1
msgid "The author of an anonymous post can't be added."
msgstr "Autor anonymného príspevku nemôže byť pridaný."

#, machine, plain1
msgid "The author says this is commercial promotion: a paid partnership, sponsorship, affiliate link, or advertising of their own products or services"
msgstr "Autor hovorí, že je to komerčná propagácia: platené partnerstvo, sponzorstvo, affiliate link, alebo reklama ich vlastných produktov alebo služieb"

#, machine, plain1
msgid "The author says this was made with AI"
msgstr "Autor hovorí, že to bolo vyrobené s AI"

#, machine, plain1
msgid "The author turned comments off for this post."
msgstr "Autor vypol komentáre pre tento príspevok."

#. %(names)s is a comma-separated list of the draft's authors
#, machine, plain1, python-format
msgid "The authors agreed to invite you: %(names)s."
msgstr "Autori súhlasili, že vás pozvú: %(names)s."

#, machine, plain1
msgid "The auto-moderation was saved."
msgstr "Automatická moderácia bola uložená."

#, machine, plain2, python-format
msgid "The ban relies on %(num)s of your anonymous posts and comments. If a second administrator approves (or, on a site with a single administrator, its owner), the Log will name your account beside them. %(which_link)s"
msgstr "Zákaz sa opiera o %(num)s vašich anonymných príspevkov a komentárov. Ak druhý správca schváli (alebo, na mieste s jediným správcom, jeho vlastníkom), Log bude pomenovať váš účet vedľa nich. %(which_link)s"

#, machine, plain1, python-format
msgid "The base URL is <code>%(url)s</code>"
msgstr "Základ URL ci <code>%(url)s</code>"

#, machine, plain1
msgid "The board is open while the Space is live."
msgstr "Rada je otvorená, kým je priestor naživo."

#, machine, plain1, python-format
msgid "The body can be at most %(num)s character."
msgid_plural "The body can be at most %(num)s characters."
msgstr[0] "Telo môže byť najviac %(num)s znak."
msgstr[1] "Telo môže byť najviac %(num)s znaky."
msgstr[2] "Telo môže byť najviac %(num)s znakov."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved."
msgstr "Bot @%(name)s ste navrhli, že nebude schválený."

#, machine, plain1, python-format
msgid "The bot @%(name)s you proposed was not approved. The admins said: %(note)s"
msgstr "Bot @%(name)s ste navrhli, že nebude schválený. Administi povedali: %(note)s"

#, machine, plain1
msgid "The bot already reads that feed."
msgstr "Ten robot to už prečíta."

#, python-format
msgid "The bot you proposed, [@%(name)s](/@%(name)s), was approved. It is run by the site from now on and starts posting from its feeds within a few minutes. Thank you!"
msgstr ""

#, machine, plain1
msgid "The bot's account no longer exists."
msgstr "Účet robota už neexistuje."

#, machine, plain1
msgid "The bot's owner can't run it right now."
msgstr "Majiteľ robota to teraz nemôže riadiť."

#, machine, plain1, python-format
msgid "The category %(category)s was deleted; its channels stay."
msgstr "Kategória %(category)s bola vymazaná; jej kanály zostávajú."

#, machine, plain1, python-format
msgid "The category %(category)s was made."
msgstr "Bola vytvorená kategória %(category)s."

#, machine, plain1, python-format
msgid "The category was renamed %(category)s."
msgstr "Kategória bola premenovaná na %(category)s."

#, machine, plain1, python-format
msgid "The coins go to the founder, <a href=\"%(url)s\">@%(name)s</a>."
msgstr "Mince idú zakladateľovi, <a href=\"%(url)s\">@%(name)s</a>."

#, machine, plain1
msgid "The coins you earn from tips, paid circles and the creator fund, for the last 30 days and all time."
msgstr "Mince, ktoré získate z tipov, platených kruhov a fondu tvorcov, za posledných 30 dní a po celý čas."

#, machine, plain2
msgid "The comment stays where it is, with your name taken off it. Everyone who saw it with your name still knows it was you."
msgstr "Komentár zostáva tam, kde je, s vaším menom odstránená. Každý, kto to videl s tvojím menom, stále vie, že si to ty."

#, machine, plain1, python-format
msgid "The copy other people forwarded to guilds will stay there."
msgid_plural "The %(num)s copies other people forwarded to guilds will stay there."
msgstr[0] "Kópia, ktorú ostatní ľudia poslali cechom, tam zostane."
msgstr[1] "%(num)s výtlačky ďalších ľudí zaslaných cechom tam zostanú."
msgstr[2] "Tých %(num)s výtlačkov odovzdajú cechom."

#. %(guilds)s is a list of guild names, such as "+a, +b and +c"
#, machine, plain1, python-format
msgid "The copy you forwarded to %(guilds)s will be taken down."
msgid_plural "The copies you forwarded to %(guilds)s will be taken down."
msgstr[0] "Kópia, ktorú ste poslali na %(guilds)s bude zničená."
msgstr[1] "Kópie, ktoré ste poslali %(guilds)s budú stiahnuté."
msgstr[2] "Kópie, ktoré ste poslali %(guilds)s budú stiahnuté."

#, machine, plain1
msgid "The dates leave no days."
msgstr "Dátumy neopúšťajú žiadne dni."

#, machine, plain2
msgid "The decision stands"
msgstr "Rozhodnutie platí"

#, machine, plain1
msgid "The decisions made about it, newest first: who, when, where, which rule and why. It never shows the title or the text of what was hidden or removed."
msgstr "Rozhodnutia o tom, najnovšie ako prvé: kto, kedy, kde, ktoré pravidlo a prečo. Nikdy neukazuje názov alebo text toho, čo bolo skryté alebo odstránené."

#, machine, plain1
msgid "The draft has changes the post doesn't show yet."
msgstr "Návrh zmenil poštu ešte neukazuje."

#, machine, plain1
msgid "The earlier versions aren't shown while this is hidden."
msgstr "Predchádzajúce verzie nie sú zobrazené, zatiaľ čo toto je skryté."

#, machine, plain2
msgid "The earlier versions aren't shown: this was deleted and its text has been cleared."
msgstr "Skoršie verzie nie sú zobrazené: tento bol vymazaný a jeho text bol vymazaný."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was approved: it is read from now on."
msgstr "Zdroj %(url)s pre automatické vyslanie vášho účtu bol schválený: odteraz sa číta."

#, machine, plain1, python-format
msgid "The feed %(url)s for your account's automated posting was not approved."
msgstr "Zdroj %(url)s pre automatické vyslanie vášho účtu nebol schválený."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was approved: it is read from now on."
msgstr "Krmivo %(url)s pre váš bot @%(name)s bolo schválené: odteraz sa bude čítať."

#, machine, plain1, python-format
msgid "The feed %(url)s for your bot @%(name)s was not approved."
msgstr "Krmivo %(url)s pre váš bot @%(name)s nebol schválený."

#, machine, plain1, python-format
msgid "The feed answered with an error (%(status)s)."
msgstr "Na krmivo odpovedala chyba (%(status)s)."

#, machine, plain1
msgid "The feed asked us to slow down."
msgstr "Krmivo nás požiadalo, aby sme spomalili."

#, machine, plain1
msgid "The feed did not answer in time."
msgstr "Krmivo neodpovedalo včas."

#, machine, plain1
msgid "The feed is unavailable for now."
msgstr "Nateraz je krmivo nedostupné."

#, machine, plain1
msgid "The feed server answered with a redirect, which is not followed."
msgstr "Feed server odpovedal presmerovaním, ktorý nie je sledovaný."

#. status is an HTTP status code, such as 404
#, machine, plain1, python-format
msgid "The feed server answered with an error (%(status)s)."
msgstr "Pripájací server odpovedal s chybou (%(status)s)."

#, machine, plain1, python-format
msgid "The feed server answered with more than %(num)s post at once."
msgid_plural "The feed server answered with more than %(num)s posts at once."
msgstr[0] "Feed server odpovedal viac ako %(num)s post naraz."
msgstr[1] "Feed server odpovedal s viac ako %(num)s príspevky naraz."
msgstr[2] "Feed server odpovedal s viac ako %(num)s príspevky naraz."

#, machine, plain1
msgid "The feed server did not answer in time."
msgstr "Napájací server neodpovedal včas."

#, machine, plain1
msgid "The feed server took too long to answer."
msgstr "Napájanie servera trvalo príliš dlho odpovedať."

#, machine, plain1
msgid "The feed server's answer has no list of posts."
msgstr "Odpoveď feed servera nemá zoznam príspevkov."

#, machine, plain1
msgid "The feed server's answer holds something that is not a post id."
msgstr "Odpoveď feed servera obsahuje niečo, čo nie je post ID."

#, machine, plain1
msgid "The feed server's answer is not JSON."
msgstr "Odpoveď feed servera nie je JSON."

#, machine, plain1
msgid "The feed server's answer is not a JSON object."
msgstr "Odpoveď feed servera nie je JSON objekt."

#, machine, plain1
msgid "The feed server's answer is too large."
msgstr "Odpoveď feed servera je príliš veľká."

#, machine, plain1
msgid "The feed server's certificate could not be checked."
msgstr "Certifikát napájacieho servera nebolo možné skontrolovať."

#, machine, plain1
msgid "The feed server's cursor is not usable."
msgstr "Kurzor napájacieho servera nie je použiteľný."

#, machine, plain1
msgid "The feed's address sends it somewhere else too many times."
msgstr "Adresa feedu to posiela niekde inde príliš veľakrát."

#, machine, plain1
msgid "The feed's answer is too large."
msgstr "Odpoveď krmiva je príliš veľká."

#, machine, plain1
msgid "The feed's certificate could not be checked."
msgstr "Certifikát krmiva nebolo možné skontrolovať."

#, machine, plain1
msgid "The file's size is missing."
msgstr "Veľkosť súboru chýba."

#, machine, plain1, python-format
msgid "The following users are approved to forward to +%(guild)s."
msgstr "Nasledujúci používatelia sú schválení zaslať na +%(guild)s."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s guild chat."
msgstr "Nasledujúcim používateľom je zakázané zúčastňovať sa na cechu + %(guild)s."

#, machine, plain1, python-format
msgid "The following users are prohibited from participating in +%(guild)s."
msgstr "Nasledujúcim používateľom je zakázané zúčastňovať sa na +%(guild)s."

#, machine, plain1
msgid "The guild"
msgstr "The guild"

#, machine, plain1
msgid "The guild already has a category with that name."
msgstr "Guild už má kategóriu s týmto menom."

#, machine, plain1
msgid "The guild already has a channel with that name."
msgstr "Guild už má kanál s týmto menom."

#, machine, plain1
msgid "The guild already has a role with that name."
msgstr "Guild už má rolu s týmto menom."

#, machine, plain1
msgid "The guild's own rules for what is written in its channels, on top of the site's word filter. Guildmasters are never held to them. A message that breaks one is refused with a short reason that never says which word."
msgstr "Vlastné pravidlá cechu pre to, čo je napísané v jeho kanáloch, na vrchole slovného filtra webu. Sudcovia sa im nikdy nedržia. Odkaz, ktorý prelomí človeka, je odmietnutý s krátkym dôvodom, ktorý nikdy nehovorí, ktoré slovo."

#, machine, plain2
msgid "The hold on your account was lifted. You can post, comment and vote again."
msgstr "Držanie vášho účtu bolo zrušené. Môžete písať, komentovať a hlasovať znova."

#, machine, plain1
msgid "The host stays on stage."
msgstr "Hostiteľ zostáva na pódiu."

#, machine, plain1
msgid "The independent social platform"
msgstr "Nezávislá sociálna platforma"

#, machine, plain1
msgid "The internet gremlins have led you to a dark, musty dead-end. There's nothing here."
msgstr "Internetoví škriatkovia ťa priviedli k temnej, zatuchnutej slepej uličke. Nič tu nie je."

#, machine, plain1, python-format
msgid "The key that opens your messages in a new app. It is locked with your password and opened here, in this browser: %(site)s never sees it. Anyone with it and your account can read your chats, so never share it."
msgstr "Kľúč, ktorý otvára vaše správy v novej aplikácii. Je zamknuté heslom a otvorené tu, v tomto prehliadači: %(site)s to nikdy nevidí. Každý, kto s ním a vaším účtom si môže prečítať vaše rozhovory, takže nikdy zdieľať."

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s"
msgstr "Odkaz `%(link)s` nie je povolený. Dôvod: %(reason)s"

#, machine, plain1, python-format
msgid "The link `%(link)s` is not allowed. Reason: %(reason)s."
msgstr "Odkaz `%(link)s` nie je povolený. Dôvod: %(reason)s."

#, machine, plain1, python-format
msgid "The link can be at most %(num)s character."
msgid_plural "The link can be at most %(num)s characters."
msgstr[0] "Odkaz môže byť najviac %(num)s znak."
msgstr[1] "Odkaz môže byť najviac %(num)s znaky."
msgstr[2] "Odkaz môže byť najviac %(num)s znakov."

#, machine, plain1
msgid "The link can't contain a user name or password."
msgstr "Odkaz nemôže obsahovať užívateľské meno alebo heslo."

#, machine, plain1
msgid "The link can't contain spaces."
msgstr "Spojenie nemôže obsahovať medzery."

#, machine, plain1
msgid "The link must start with https:// or http://."
msgstr "Odkaz musí začať s https:// alebo http://."

#, machine, plain1
msgid "The link needs a full address, such as example.com."
msgstr "Odkaz potrebuje úplnú adresu, ako napríklad príklad.com."

#, machine, plain1
msgid "The list is open to members so that anyone can see what the filter hides and why. Nothing on it is removed from the site: each member's own filter decides what they see."
msgstr "Zoznam je otvorený pre členov, aby každý mohol vidieť, čo filter skrýva a prečo. Nič na ňom nie je odstránené z webu: každý člen vlastný filter rozhoduje, čo vidí."

#, machine, plain1
msgid "The list isn't shown on the Child filter"
msgstr "Zoznam nie je zobrazený na detskom filtri"

#, machine, plain1, python-format
msgid "The most a circle can ask is %(num)s coin every 30 days."
msgid_plural "The most a circle can ask is %(num)s coins every 30 days."
msgstr[0] "Najväčší kruh si môže vyžiadať %(num)s mincu každých 30 dní."
msgstr[1] "Najviac kruh môže požiadať, je %(num)s mince každých 30 dní."
msgstr[2] "Najväčší kruh si môže vyžiadať %(num)s mincí každých 30 dní."

#, machine, plain1
msgid "The most voted posts of the last seven days."
msgstr "Najviac volených pozícií za posledných sedem dní."

#, machine, plain1, python-format
msgid "The name %(host)s could not be found."
msgstr "Meno %(host)s sa nepodarilo nájsť."

#, machine, plain1
msgid "The newest of what they have done. Only the names of who they chat with are shown, never what a chat says: chats are end-to-end encrypted."
msgstr "Najnovší z toho, čo urobili. Zobrazujú sa len mená toho, s kým sa rozprávajú, nikdy to, čo hovorí chat: chaty sú end-to-end šifrované."

#, machine, plain2
msgid "The number of an anonymous author"
msgstr "Číslo anonymného autora"

#, machine, plain2
msgid "The number of items you confirmed doesn't match what was chosen. Nothing was changed."
msgstr "Počet položiek, ktoré ste potvrdili nezodpovedá tomu, čo bolo vybrané. Nič sa nezmenilo."

#, machine, plain1
msgid "The numbers are always shown on your profile. This decides who can open each list and see the accounts on it. An account is only listed where its own setting allows it too."
msgstr "Čísla sú vždy zobrazené na vašom profile. To rozhodne, kto môže otvoriť každý zoznam a vidieť účty na ňom. Účet je uvedený len tam, kde to umožňuje aj jeho vlastné nastavenie."

#, machine, plain1
msgid "The open-source platform for independent internet communities"
msgstr "Platforma open source pre nezávislé internetové komunity"

#, machine, plain1
msgid "The original content is not retained anywhere, including in this history."
msgstr "Pôvodný obsah nie je nikde uchovávaný, ani v tejto histórii."

#, machine, plain1
msgid "The other authors of a shared draft removed you as an author. What you wrote stays credited to you."
msgstr "Ostatní autori zdieľaného návrhu vás odstránili ako autora. To, čo ste napísali, vám pripisuje zásluhy."

#, machine, plain1
msgid "The owner deletes a channel instead of leaving it."
msgstr "Majiteľ vymaže kanál namiesto toho, aby ho opustil."

#, machine, plain1
msgid "The owner's role can't be changed."
msgstr "Úloha majiteľa sa nemôže zmeniť."

#, machine, plain1
msgid "The page's current text isn't shown here; what you save replaces it."
msgstr "Aktuálny text stránky tu nie je zobrazený; to, čo uložíte, ho nahrádza."

#, machine, plain1
msgid "The picture could not be stored. Try again later."
msgstr "Obrázok sa nepodarilo uložiť. Skús to neskôr."

#, machine, plain1
msgid "The picture goes to your own linked storage, not to this site. You can add a few words under it."
msgstr "Obrázok ide do vášho vlastného prepojeného úložiska, nie do tohto webu. Môžete pridať pár slov pod to."

#, machine, plain1
msgid "The picture you chose"
msgstr "Obrázok, ktorý si si vybral"

#, machine, plain1
msgid "The post appears on the profile of whoever publishes it first. Optionally forward it into guilds for community discussion: each guild gets its own independent copy with its own votes and comments. Guilds are forwarded to when the draft is first published."
msgstr "Príspevok sa objavuje na profile toho, kto ho zverejní ako prvý. Voliteľne ho posúvajte do cechov pre komunitnú diskusiu: každý cech dostane vlastnú nezávislú kópiu s vlastnými hlasmi a komentármi. Guilds sa zasiela pri prvom zverejnení návrhu."

#, machine, plain1
msgid "The post carries your name and is listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your name."
msgstr "Príspevok nesie vaše meno a je uvedený vo vašom profile. Hlasy, komentáre a dopredu sú zdieľané s autorom, ktorý ich edituje a vymaže. Môžete vystúpiť kedykoľvek: príspevok zostáva, bez vášho mena."

#, machine, plain2
msgid "The post is not listed on your profile. Votes, comments and forwards are shared with its author, who edits and deletes it. You can step off at any time: the post stays, without your credit."
msgstr "Príspevok nie je uvedený vo vašom profile. Hlasy, komentáre a dopredu sú zdieľané s autorom, ktorý ich edituje a vymaže. Môžete vystúpiť kedykoľvek: príspevok zostáva, bez vášho úveru."

#, machine, plain1
msgid "The post refused the change."
msgstr "Pošta odmietla zmenu."

#, machine, plain2
msgid "The post stays where it is, with your name taken off it, and leaves your profile. Its Rep leaves you too. Everyone who saw it with your name still knows it was you."
msgstr "Pošta zostáva tam, kde je, s Vaším menom odstránená, a zanechá váš profil. Jeho reputácia opúšťa aj teba. Každý, kto to videl s tvojím menom, stále vie, že si to ty."

#, machine, plain2
msgid "The post's author"
msgstr "Autor príspevku"

#, machine, plain2
msgid "The post's author deleted it, so it is shown as Anonymous: no name and no link. The comments under it stay as they were; one its author deleted is shown as Anonymous too."
msgstr "Autor príspevku ho vymazal, takže je zobrazený ako Anonymous: žiadne meno a žiadny odkaz. Komentáre pod ním zostávajú také, aké boli; jeden jej autor vymazal je zobrazený ako Anonymous príliš."

#, machine, plain1, python-format
msgid "The promo code `%(code)s` is not currently valid. Please begin a new transaction."
msgstr "Promo kód `%(code)s` v súčasnosti neplatí. Prosím, začnite novú transakciu."

#, machine, plain1, python-format
msgid "The proposal for @%(name)s has been withdrawn."
msgstr "Návrh @%(name)s bola stiahnutá."

#, machine, plain1, python-format
msgid "The role %(role)s was deleted."
msgstr "Úloha %(role)s bola vymazaná."

#, machine, plain1, python-format
msgid "The role %(role)s was made."
msgstr "Úloha %(role)s bol vyrobený."

#, machine, plain1, python-format
msgid "The role %(role)s was saved."
msgstr "Úloha %(role)s bol zachránený."

#, machine, plain1
msgid "The royal bank has told us that you owe them some coin. You'll need to pay off your debts before you can continue."
msgstr "Kráľovská banka nám povedala, že im dlhuješ nejakú mincu. Budete musieť splatiť svoje dlhy, než budete môcť pokračovať."

#, machine, plain1
msgid "The rules"
msgstr "Pravidlá"

#, machine, plain1
msgid "The rules below"
msgstr "Nasledujúce pravidlá"

#, machine, plain1, python-format
msgid "The rules can be at most %(count)s character."
msgid_plural "The rules can be at most %(count)s characters."
msgstr[0] "Pravidlá môžu byť najviac %(count)s znak."
msgstr[1] "Pravidlá môžu byť najviac %(count)s znakov."
msgstr[2] "Pravidlá môžu byť najviac %(count)s znakov."

#, machine, plain1
msgid "The rules can't contain control or invisible characters."
msgstr "Pravidlá nemôžu obsahovať kontrolu alebo neviditeľné znaky."

#, machine, plain1
msgid "The screenshot you are sending"
msgstr "Snímka obrazovky, ktorú posielate"

#. %(status)s is an HTTP status code
#, machine, plain1, python-format
msgid "The server answered %(status)s."
msgstr "Server odpovedal %(status)s."

#, machine, plain1, python-format
msgid "The server answers with the posts to show and their order; %(site)s still hides anything a viewer may not see, and tells the server nothing about who is looking. Everyone is told that an outside server ranks this curation."
msgstr "Server odpovedá s príspevky ukázať a ich poradie; %(site)s stále skrýva všetko, čo divák nemusí vidieť, a hovorí server nič o tom, kto hľadá. Každému je povedané, že vonkajší server radí tento vyliečený kanál."

#, machine, plain1, python-format
msgid "The server named %(num)s post; you can see %(seen)s of them."
msgid_plural "The server named %(num)s posts; you can see %(seen)s of them."
msgstr[0] "Server s názvom %(num)s post; môžete vidieť %(seen)s z nich."
msgstr[1] "Server s názvom %(num)s príspevky; môžete vidieť %(seen)s z nich."
msgstr[2] "Server s názvom %(num)s príspevky; môžete vidieť %(seen)s z nich."

#, machine, plain1
msgid "The server thinks you're asking something silly. It might take you more seriously if you take off the jester outfit."
msgstr "Server si myslí, že sa pýtaš na niečo hlúpe. Mohlo by ťa to brať vážnejšie, ak by si si vyzliekol šaty."

#, machine, plain1
msgid "The site refused the bot's session."
msgstr "Stránka odmietla sedenie robota."

#, machine, plain2
msgid "The site's admins have it already."
msgstr "Administrátori stránky ho už majú."

#, machine, plain1
msgid "The site's admins marked this guild sensitive, so only an admin can change this."
msgstr "Administrátori stránky označili tento cech citlivý, takže to môže zmeniť iba admin."

#, machine, plain2
msgid "The site's admins will read it. They are never told who reported."
msgstr "Administrátori si ju prečítajú. Nikdy im nie je povedané, kto hlásil."

#, machine, plain1, python-format
msgid "The stage is full (%(num)s person)."
msgid_plural "The stage is full (%(num)s people)."
msgstr[0] "Fáza je plná (%(num)s osoba)."
msgstr[1] "Fáza je plná (%(num)s osoby)."
msgstr[2] "Fáza je plná (%(num)s ľudí)."

#, machine, plain1
msgid "The storage service is not answering right now. Try again in a moment."
msgstr "Skladová služba práve neodpovedá. Skús to znova za chvíľu."

#, machine, plain1, python-format
msgid "The summary can be at most %(num)s character."
msgid_plural "The summary can be at most %(num)s characters."
msgstr[0] "Súhrn môže byť najviac %(num)s znak."
msgstr[1] "Súhrn môže byť najviac %(num)s znaky."
msgstr[2] "Súhrn môže byť najviac %(num)s znakov."

#, machine, plain1
msgid "The summary can be changed while the Space is live."
msgstr "Súhrn môže byť zmenený, kým priestor je živý."

#, machine, plain1
msgid "The text isn't shown: this was removed by the site's administrators."
msgstr "Text nie je zobrazený: bol odstránený administrátormi webu."

#, machine, plain1
msgid "The text of this version was hidden by a site administrator."
msgstr "Text tejto verzie bol skrytý správcom stránky."

#, machine, plain1, python-format
msgid "The time before links must be a whole number of days, 0 to %(max)s."
msgstr "Čas pred prepojením musí byť celý počet dní, 0 až %(max)s."

#, machine, plain1, python-format
msgid "The time in the guild must be a whole number of days, 0 to %(max)s."
msgstr "Čas v cechu musí byť celý rad dní, 0 až %(max)s."

#, machine, plain1, python-format
msgid "The title can be at most %(num)s character."
msgid_plural "The title can be at most %(num)s characters."
msgstr[0] "Názov môže byť najviac %(num)s znak."
msgstr[1] "Názov môže byť najviac %(num)s znaky."
msgstr[2] "Názov môže byť najviac %(num)s znakov."

#, machine, plain1
msgid "The two revisions have the same text."
msgstr "Tieto dve revízie majú rovnaký text."

#, machine, plain1
msgid "The upload did not arrive in your Google Drive. Try again."
msgstr "Upload nedorazil vo vašom Google Drive. Skús to znova."

#, machine, plain1
msgid "The upload did not arrive in your OneDrive. Try again."
msgstr "Upload nedorazil vo vašom OneDrive. Skús to znova."

#, machine, plain1
msgid "The upload did not arrive. Try again."
msgstr "Upload neprišiel. Skús to znova."

#, machine, plain1, python-format
msgid "The username @%(name)s has been pre-emptively reserved for: %(who)s"
msgstr "Užívateľské meno @%(name)s bola vopred vyhradená pre: %(who)s"

#, machine, plain1
msgid "The usual order - everything from the guilds and accounts you add"
msgstr "Zvyčajná objednávka - všetko z cechov a účtov, ktoré pridáte"

#, machine, plain1
msgid "The video did not finish uploading to Dailymotion. Add it again."
msgstr "Video nedokončilo nahrávanie na Dailymotion. Pridaj to znova."

#, machine, plain1
msgid "The video did not finish uploading. Add it again."
msgstr "Video nedokončilo nahrávanie. Pridaj to znova."

#, machine, plain1, python-format
msgid "The website can be at most %(num)s character."
msgid_plural "The website can be at most %(num)s characters."
msgstr[0] "Webová stránka môže byť najviac %(num)s znak."
msgstr[1] "Webové stránky môžu byť najviac %(num)s znaky."
msgstr[2] "Webová stránka môže byť najviac %(num)s znakov."

#, machine, plain1
msgid "The website can't contain a user name or password."
msgstr "Webová stránka nemôže obsahovať užívateľské meno alebo heslo."

#, machine, plain1
msgid "The website can't contain spaces."
msgstr "Stránka nemôže obsahovať medzery."

#, machine, plain1
msgid "The website must start with https:// or http://."
msgstr "Webová stránka musí začať s https:// alebo http://."

#, machine, plain1
msgid "The website needs a full address, such as example.com."
msgstr "Webová stránka potrebuje úplnú adresu, ako napríklad príklad.com."

#, machine, plain1
msgid "The whole site <span class=\"text-muted\">(needs an age limit of a month or less)</span>"
msgstr "Celá lokalita <span class=\"text-muted\">(potrebuje vekovú hranicu jedného mesiaca alebo menej)</span>"

#, machine, plain1
msgid "The wiki is off: only guildmasters see it."
msgstr "Wiki je vypnutý: iba cech moderátori to vidia."

#, machine, plain1
msgid "The wiki's first page can be emptied but not deleted."
msgstr "Prvá stránka wiki je možné vyprázdniť, ale nie vymazať."

#, machine, plain1
msgid "The word filter has no words at the moment."
msgstr "Filter nemá v tejto chvíli žiadne slová."

#, machine, plain1, python-format
msgid "The words for other languages are adapted from %(source)s (%(licence)s): words that are also ordinary, innocent words were left out."
msgstr "Slová pre iné jazyky sú upravené od %(source)s (%(licence)s): slová, ktoré sú tiež bežné, nevinné slová boli vynechané."

#, machine, plain1
msgid "The working copy as it is now. Only its authors can see this until it's published."
msgstr "Pracovná kópia ako je teraz. Iba jeho autori to môžu vidieť, kým nie je publikovaná."

#, machine, plain1
msgid "Theater"
msgstr "Divadlo"

#, machine, plain1
msgid "Their commenting history will show here."
msgstr "Ich komentáre histórie sa ukáže tu."

#, machine, plain1
msgid "Their forwarding activity will show here."
msgstr "Ich posúvacia činnosť sa ukáže tu."

#, machine, plain1
msgid "Their posting history will show here."
msgstr "Ich vysielanie histórie sa ukáže tu."

#, machine, plain1
msgid "Their posts and comments are left out of your feeds and threads and they cannot notify you. They are not told, and they can still follow you, comment on your posts and message you. Their anonymous posts and comments are not hidden, as hiding only those would tell you who wrote them. Mute someone from the menu on any of their posts or comments, or from their profile."
msgstr "Ich príspevky a komentáre sú vynechané z vašich krmív a vlákien a nemôžu vás informovať. Nie je im povedané, a môžu stále sledovať vás, komentovať svoje príspevky a správy vás. Ich anonymné príspevky a komentáre nie sú skryté, pretože skrývať len tí by vám povedať, kto ich napísal. Mutovať niekoho z menu na niektorom z ich príspevkov alebo komentárov, alebo z ich profilu."

#, machine, plain1
msgid "There are no approved users"
msgstr "Nie sú žiadni schválení používatelia"

#, machine, plain1
msgid "There are no exiled users"
msgstr "Neexistujú žiadni exilovaní používatelia"

#, machine, plain1
msgid "There are no guildmaster invitations."
msgstr "Nie sú žiadne pozvánky na moderátora."

#, machine, plain1
msgid "There are no guildmasters."
msgstr "Neexistujú žiadni cechovní moderátori."

#, machine, plain1
msgid "There are no posts here."
msgstr "Nie sú tu žiadne príspevky."

#, machine, plain1, python-format
msgid "There is no account named @%(name)s."
msgstr "Neexistuje žiadny účet s názvom @%(name)s."

#, machine, plain2
msgid "There is nothing here to appeal."
msgstr "Nie je tu čo odvolať."

#, machine, plain1
msgid "There is nothing to save yet."
msgstr "Ešte nie je čo zachrániť."

#, machine, plain2
msgid "There is nothing waiting for this ban."
msgstr "Na tento zákaz nič nečaká."

#, machine, plain1
msgid "There was a problem. Please try again."
msgstr "Bol tu problém. Prosím, skúste to znova."

#, machine, plain1
msgid "There were no names in that file."
msgstr "V tom spise neboli žiadne mená."

#, machine, plain1
msgid "There were no survivors."
msgstr "Nikto neprežil."

#, machine, plain1
msgid "There's a shortage of perfect request entities in this world. Would be a pity to damage yours."
msgstr "Na tomto svete je nedostatok dokonalých entít. Bola by škoda poškodiť tvoju."

#, machine, plain1
msgid "There's already an open proposal like this one."
msgstr "Takýto návrh je už otvorený."

#, machine, plain1
msgid "There's no account with that name."
msgstr "Nie je žiadny účet s tým menom."

#, machine, plain1
msgid "There's no invitation to speak."
msgstr "Nie je tu žiadne pozvanie hovoriť."

#, machine, plain2
msgid "There's no recovery code to keep yet."
msgstr "Ešte nie je žiadny kód na obnovu."

#, machine, plain1
msgid "There's nothing here right now."
msgstr "Teraz tu nič nie je."

#, machine, plain1
msgid "There's nothing left here but a giant smouldering crater."
msgstr "Nič tu nezostalo, len obrovský smoulderujúci kráter."

#, machine, plain1
msgid "These are the users you are subscribed to."
msgstr "Toto sú užívatelia, ktorým ste prihlásení."

#, machine, plain1
msgid "These counts start from the day guild insights were switched on: before that the site did not record when people left a guild or how often its page was opened."
msgstr "Tieto počty začínajú odo dňa, keď boli cechové náhľady zapnuté: predtým, než web nenahral, keď ľudia opustili cech alebo ako často bola otvorená jeho stránka."

#, machine, plain1
msgid "These filters are saved as your default"
msgstr "Tieto filtre sú uložené ako predvolené"

#, machine, plain1
msgid "These topics"
msgstr "Tieto témy"

#, machine, plain1, python-format
msgid "These users have been invited to moderate +%(guild)s."
msgstr "Títo používatelia boli vyzvaní na mierne +%(guild)s."

#, machine, plain1
msgid "They already have this role."
msgstr "Túto úlohu už majú."

#, machine, plain1
msgid "They are 18 or over, so they can make their own account."
msgstr "Majú 18 alebo viac rokov, takže si môžu vytvoriť vlastný účet."

#, machine, plain1
msgid "They are already in this circle."
msgstr "Už sú v tomto kruhu."

#, machine, plain1
msgid "They are not told. Anyone you block leaves your circles."
msgstr "Nie je im povedané. Ktokoľvek zablokuje opustí tvoje kruhy."

#, machine, plain2
msgid "They are signed out everywhere, chat apps included. If they use chat, they may need their recovery code, or a browser where they've used chat, to read their old messages."
msgstr "Sú odpojené všade, vrátane chatových aplikácií. Ak používajú chat, môžu potrebovať svoj kód obnovy, alebo prehliadač, kde používajú chat, aby mohli čítať svoje staré správy."

#, machine, plain1, python-format
msgid "They aren't in %(circle)s."
msgstr "Nie sú v %(circle)s."

#, machine, plain1
msgid "They aren't in this group."
msgstr "Nie sú v tejto skupine."

#, machine, plain1
msgid "They aren't muted here."
msgstr "Nie sú tu tlmené."

#, machine, plain1
msgid "They can buy and spend coins, tip, buy Premium and join or run paid circles."
msgstr "Môžu kúpiť a minúť mince, tip, kúpiť Premium a pripojiť alebo spustiť platené kruhy."

#, machine, plain2
msgid "They can join and listen to Spaces. They can't host one or post in one: a child account only reads. Voice calls in a Space also need Chat to be on."
msgstr "Môžu sa pripojiť a počúvať Spaces. Nemôžu hostiť jeden alebo post v jednom: detský účet len číta. Hlasové hovory vo vesmíre tiež potrebujú rozhovor."

#, machine, plain1
msgid "They can message people, join group chats and make calls. The site never shows you what a chat says: chats are end-to-end encrypted. Whoever knows their password can still sign in and read them."
msgstr "Môžu ľudí informovať, pripojiť sa k skupinovým chatom a volať. Stránka vám nikdy neukazuje, čo hovorí chat: chaty sú end-to-end šifrované. Ktokoľvek pozná svoje heslo, stále sa môže prihlásiť a prečítať si ho."

#, machine, plain1
msgid "They can see what you do on the site: your posts, comments, votes, bookmarks, follows, guilds, who you chat with, that your account was reported, and your recent sign-ins. The site never shows them what your chats say, because chats are end-to-end encrypted. But anyone who knows your password, a parent who chose it included, can sign in as you: change it in Security so that only you know it. They choose which of these are on for your account:"
msgstr "Môžu vidieť, čo robíte na webe: vaše príspevky, komentáre, hlasy, záložky, nasledujúce, cechy, s kým ste chatovať, že váš účet bol hlásený, a vaše nedávne prihlásenie. Stránka im nikdy neukazuje, čo hovoria vaše rozhovory, pretože chaty sú end-to-end šifrované. Ale každý, kto pozná vaše heslo, rodič, ktorý si ho vybral, sa môže prihlásiť ako vy: zmeniť ho v bezpečnosti, aby ste ho poznali len vy. Vyberajú si, ktoré z nich sú na vašom účte:"

#, machine, plain2
msgid "They can start a guild. They still can't post or comment: a child account only reads."
msgstr "Môžu založiť cech. Stále nemôžu písať alebo komentovať: detský účet len číta."

#, machine, plain1
msgid "They can't comment on your posts or comments, chat with you or notify you by mentioning you. They are not told, but they may work it out if they try to comment on something of yours."
msgstr "Nemôžu komentovať vaše príspevky alebo komentáre, chatovať s vami alebo vás informovať tým, že vás zmieni. Nie je im to povedané, ale možno to vyriešia, ak sa pokúsia komentovať niečo vaše."

#, machine, plain1
msgid "They don't have this role."
msgstr "Nemajú túto úlohu."

#, machine, plain1
msgid "They go straight to your coin balance."
msgstr "Idú rovno k vašej minci."

#, machine, plain1
msgid "They haven't asked for that."
msgstr "Nežiadali o to."

#, machine, plain2
msgid "They leave the site. What they said stays in the Log as Anonymous, except for anything made in the last five minutes that nobody has commented on, which is erased. This can't be undone."
msgstr "Opúšťajú stránku. To, čo povedali, zostáva v denníku ako Anonymous, okrem toho, čo bolo vyrobené za posledných päť minút, ktoré nikto nekomentoval, čo je vymazané. Toto sa nedá odstrániť."

#, machine, plain1
msgid "They need to be in the guild, and not exiled from it."
msgstr "Musia byť v cechu a nie vyhnaní z neho."

#, machine, plain1
msgid "They need to join the channel first."
msgstr "Najprv sa musia pripojiť k kanálu."

#, machine, plain1
msgid "They say they are 18 or over and asked you to release their account. If you do, it becomes their own and you can no longer see it."
msgstr "Hovoria, že majú 18 alebo viac rokov a žiadajú vás, aby ste zverejnili ich účet. Ak to urobíš, stane sa to ich vlastné a už to viac neuvidíš."

#, machine, plain2
msgid "They stay where they are, with your name taken off them. This can't be undone. Posts that need your name (for a Circle, or with tips) are listed afterwards as not changed."
msgstr "Zostanú tam, kde sú, s vaším menom odstránená z nich. Toto sa nedá odstrániť. Posts that need your name (for a Circle, or with tips) are following as not changed."

#, machine, plain2, python-format
msgid "They wrote: %(note)s"
msgstr "Napísali: %(note)s"

#, machine, plain1
msgid "They're already a helper."
msgstr "Už sú to pomocníci."

#, machine, plain1
msgid "They're already on stage."
msgstr "Už sú na javisku."

#, machine, plain1
msgid "They've already been invited to speak."
msgstr "Už boli pozvaní hovoriť."

#, machine, plain1
msgid "This Circle guild is by invitation only."
msgstr "Tento Circle ceild je len pozvánka."

#, machine, plain1
msgid "This Google account has no YouTube channel yet. Create one at youtube.com, then try again."
msgstr "Toto Google účet nemá YouTube Zatiaľ kanál. Vytvorte jeden na youtube.com, potom skúste znova."

#, machine, plain1
msgid "This Space"
msgstr "Tento priestor"

#, machine, plain1
msgid "This Space can't take a replay now."
msgstr "Vesmír teraz nemôže trvať opakovaný záznam."

#, machine, plain1
msgid "This Space has already started."
msgstr "Vesmír už začal."

#, machine, plain1
msgid "This Space has ended."
msgstr "Tento priestor skončil."

#, machine, plain1
msgid "This Space has ended. Its board is still here to read."
msgstr "Tento priestor skončil. Jeho doska je stále tu na čítanie."

#, machine, plain1
msgid "This Space has ended. Its chat is still here to read."
msgstr "Tento priestor skončil. Jeho rozhovor je stále tu na čítanie."

#, machine, plain1
msgid "This Space hasn't started yet."
msgstr "Tento priestor ešte nezačal."

#, machine, plain1, python-format
msgid "This Space is full (%(num)s listener)."
msgid_plural "This Space is full (%(num)s listeners)."
msgstr[0] "Tento priestor je plný (%(num)s poslucháč)."
msgstr[1] "Tento priestor je plný (%(num)s poslucháčov)."
msgstr[2] "Tento priestor je plný (%(num)s poslucháčov)."

#, machine, plain1, python-format
msgid "This Space is live until %(time)s."
msgstr "Tento priestor je živý až do %(time)s."

#, machine, plain1
msgid "This Space is live."
msgstr "Tento priestor je naživo."

#, machine, plain1
msgid "This Space is not recorded: when it ends, it is gone, with everything in it."
msgstr "Tento priestor nie je zaznamenaný: keď sa skončí, je preč, so všetkým v ňom."

#, machine, plain1
msgid "This Space is recorded"
msgstr "Tento priestor je zaznamenaný"

#, machine, plain1
msgid "This Space is recorded: its board stays to read when it ends."
msgstr "Tento priestor je zaznamenaný: jeho doska zostane čítať, keď skončí."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay with the video."
msgstr "Tento priestor je zaznamenaný: hostiteľ drží opakovaný záznam s videom."

#, machine, plain1
msgid "This Space is recorded: the host keeps a replay."
msgstr "Tento priestor je zaznamenaný: hostiteľ drží opakovaný záznam."

#, machine, plain1
msgid "This Space isn't available."
msgstr "Tento priestor nie je dostupný."

#, machine, plain1
msgid "This Space isn't waiting to start."
msgstr "Tento priestor nečaká na začiatok."

#, machine, plain1
msgid "This Space keeps its sound only."
msgstr "Tento priestor má svoj zvuk len."

#, machine, plain1
msgid "This access will expire in one hour, or earlier if you revoke it."
msgstr "Tento prístup vyprší o hodinu, alebo skôr, ak ho zrušíte."

#, machine, plain1
msgid "This account can't use chat apps."
msgstr "Tento účet nemôže používať aplikácie chatu."

#, machine, plain1, python-format
msgid "This account has been marked 18 or over since %(date)s."
msgstr "Tento účet je označený od %(date)s 18 alebo viac."

#, machine, plain1, python-format
msgid "This account has been permanently suspended from %(site)s."
msgstr "Tento účet bol natrvalo odložený od %(site)s."

#, machine, plain1, python-format
msgid "This account has been temporarily suspended from %(site)s. Check back later."
msgstr "Tento účet bol dočasne odložený od %(site)s. Skontroluj to neskôr."

#, machine, plain1
msgid "This account is private"
msgstr "Tento účet je súkromný"

#, machine, plain1
msgid "This account is suspended."
msgstr "Toto konto je pozastavené."

#, machine, plain1
msgid "This account owes money, so it can't be deleted yet."
msgstr "Tento účet dlhuje peniaze, takže ho ešte nemožno vymazať."

#, machine, plain1
msgid "This account posts about sensitive topics"
msgstr "Tento účet príspevky o citlivých témach"

#, machine, plain2
msgid "This also signs out chat everywhere else, chat apps included, except the chat this browser has used since you signed in here."
msgstr "To tiež odpája chat všade inde, vrátane chatových aplikácií, okrem chatu, ktorý tento prehliadač používa od vášho prihlásenia sem."

#. %(time)s is a length of time, such as "6 months"
#, machine, plain1, python-format
msgid "This author hasn't been active for %(time)s, so isn't counted."
msgstr "Tento autor nebol aktívny pre %(time)s, takže sa nepočíta."

#, machine, plain2
msgid "This ban relies on:"
msgstr "Tento zákaz sa opiera o:"

#, machine, plain1
msgid "This bot can't take tips right now."
msgstr "Tento robot teraz nemôže brať sprepitné."

#, machine, plain1
msgid "This bot has not been approved."
msgstr "Tento robot nebol schválený."

#, machine, plain1
msgid "This bot is not running."
msgstr "Tento robot neuteká."

#, machine, plain1
msgid "This bot's owner can't run it right now."
msgstr "Majiteľ tohto robota to teraz nemôže riadiť."

#, machine, plain2
msgid "This bot's owner can't run it while their account is on hold."
msgstr "Majiteľ tohto robota to nemôže viesť, kým ich účet je na linke."

#, machine, plain2
msgid "This browser was signed out. Sign in again to carry on."
msgstr "Prehliadač bol odpojený. Prihláste sa znovu pokračovať."

#, machine, plain2
msgid "This browser's notifications couldn't be turned on. Try again."
msgstr "Oznámenia prehliadača nemohli byť zapnuté. Skús to znova."

#, machine, plain1, python-format
msgid "This call is full (%(num)s person)."
msgid_plural "This call is full (%(num)s people)."
msgstr[0] "Tento hovor je plný (%(num)s osoba)."
msgstr[1] "Táto výzva je plná (%(num)s osoby)."
msgstr[2] "Tento hovor je plný (%(num)s ľudí)."

#, machine, plain1
msgid "This can't be translated right now."
msgstr "Toto teraz nemožno preložiť."

#, machine, plain2
msgid "This can't be undone. The site's admins can always see who wrote something, and if an admin bans or suspends the account for it, the Log may name the account for it."
msgstr "Toto sa nedá odstrániť. Administrátori stránky môžu vždy vidieť, kto niečo napísal, a ak admin zákazy alebo pozastavenie účtu pre neho, Log môže pomenovať účet pre neho."

#, machine, plain1
msgid "This channel doesn't ask for its rules to be accepted."
msgstr "Tento kanál nežiada o prijatie jeho pravidiel."

#, machine, plain1
msgid "This channel has no messages."
msgstr "Tento kanál nemá žiadne správy."

#, machine, plain1
msgid "This channel is end-to-end encrypted: it is read and written in Chat, where your messages are unlocked."
msgstr "Tento kanál je end-to-end zašifrovaný: je čítaný a napísaný v chate, kde sú vaše správy odomknuté."

#, machine, plain1
msgid "This channel is end-to-end encrypted: the site can't read it, so it has no word filter, slow mode, pins, search or reports."
msgstr "Tento kanál je end-to-end zašifrovaný: stránka nevie čítať, takže nemá žiadny textový filter, pomalý režim, kolíky, vyhľadávanie alebo správy."

#, machine, plain1
msgid "This channel is full."
msgstr "Tento kanál je plný."

#, machine, plain1
msgid "This channel is written from the chat itself."
