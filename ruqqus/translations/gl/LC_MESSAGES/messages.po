#, machine, plain1
msgid "<strong>Not yet:</strong> pictures and files. The chat server keeps no files, so an app can't send one."
msgstr "<strong>Aínda non:</strong> Fotos e arquivos. O servidor de chat non garda ficheiros, polo que unha aplicación non pode enviar un."

#, machine, plain1
msgid "<strong>On this site only:</strong> starting a chat, accepting a message request, making a group or adding people, calls and Spaces. An app can't find people, make rooms or start a call on this server: the site keeps who can reach you as it does here."
msgstr "<strong>Só neste sitio:</strong> Iniciar un chat, aceptar unha solicitude de mensaxe, facer un grupo ou engadir persoas, chamadas e espazos. Unha aplicación non pode atopar persoas, facer salas ou iniciar unha chamada neste servidor: o sitio web mantén quen pode chegar a vostede como fai aquí."

#, machine, plain1, python-format
msgid "<strong>P.S.</strong> Feel free to tweet at us on Twitter <a href=\"%(url)s\">%(handle)s</a>."
msgstr "<strong>P.S.</strong> Sinto-se libre para tweet en Twitter <a href=\"%(url)s\">%(handle)s</a>."

#, machine, plain1, python-format
