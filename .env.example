# Legacy Flask app (repo root). Copy to .env and fill in real values; never commit .env.
# The Next.js app in web/ has its own web/.env.example.
# docker-compose.yml no longer ships defaults for MASTER_KEY or the Matrix tokens:
# run `python scripts/gen_dev_env.py` to generate them into an untracked .env.
# In production, load every secret from your secret store, never from git.

# --- Core ---
SERVER_NAME=localhost
domain=localhost
SHORT_DOMAIN=
SITE_NAME=
SITE_COLOR=
admin_email=
FORCE_HTTPS=0
# Generate with: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=

# --- Datastores ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_CONNECTION_POOL_URL=
REDIS_URL=redis://localhost:6379

# --- Captcha / Cloudflare ---
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
CLOUDFLARE_KEY=
CLOUDFLARE_ZONE=

# --- Linked media storage (ruqqus/helpers/media) ---
# A "Web application" OAuth client in a Google Cloud project with the Drive API (and, for
# video, the YouTube Data API v3) enabled. Redirect URI: <site>/settings/media/google/callback
# Leave empty to switch Google storage off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 = a stand-in storage that keeps uploads on this machine. Local testing only, never on a live site.
MEDIA_DEV_PROVIDER=

# --- AWS S3 ---
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email / media APIs ---
MAILGUN_KEY=
GIPHY_KEY=
TENOR_KEY=

# --- Matrix (chat) ---
MATRIX_INTERNAL_URL=
MATRIX_PUBLIC_URL=
MATRIX_SERVER_NAME=
MATRIX_USER_PREFIX=
MATRIX_AS_TOKEN=
MATRIX_HS_TOKEN=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SERVER_ID=
DISCORD_WEBHOOK=
