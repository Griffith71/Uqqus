# Legacy Flask app (repo root). Copy to .env and fill in real values; never commit .env.
# The Next.js app in web/ has its own web/.env.example.
# docker-compose.yml no longer ships defaults for MASTER_KEY or the Matrix tokens:
# run `python scripts/gen_dev_env.py` to generate them into an untracked .env.
# In production, load every secret from your secret store, never from git.

# --- Core ---
SERVER_NAME=localhost
domain=localhost
SHORT_DOMAIN=
SITE_NAME=
SITE_COLOR=
admin_email=
FORCE_HTTPS=0
# Generate with: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=

# --- Datastores ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_CONNECTION_POOL_URL=
REDIS_URL=redis://localhost:6379

# --- Captcha / Cloudflare ---
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
CLOUDFLARE_KEY=
CLOUDFLARE_ZONE=

# --- Linked media storage (ruqqus/helpers/media) ---
# A "Web application" OAuth client in a Google Cloud project with the Drive API (and, for
# video, the YouTube Data API v3) enabled. Redirect URI: <site>/settings/media/google/callback
# Leave empty to switch Google storage off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A free Microsoft Entra app registration ("Web" platform) for pictures and audio in the member's
# OneDrive app folder. Redirect URI: <site>/settings/media/microsoft/callback
# MICROSOFT_TENANT: consumers (personal accounts, the default) or common (also work and school).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
# A free Dailymotion API key for videos on the member's own channel.
# Redirect URI: <site>/settings/media/dailymotion/callback
DAILYMOTION_API_KEY=
DAILYMOTION_API_SECRET=
# 1 = a stand-in storage that keeps uploads on this machine. Local testing only, never on a live site.
MEDIA_DEV_PROVIDER=

# --- Trending topics (ruqqus/helpers/trending.py) ---
# How many different accounts must post about something before it can trend (default 3, never under 2).
TRENDING_MIN_AUTHORS=

# --- Outside feed servers for curations (ruqqus/helpers/feed_server.py) ---
# 0 = no curation may be ranked by an outside server.
FEED_SERVERS_ENABLED=1
# 1 = a feed server may be on this machine or network, over plain http. Local testing only,
# never on a live site: it removes the guard that keeps members from making the site call its own network.
FEED_SERVER_ALLOW_LOCAL=

# --- Bot accounts (ruqqus/helpers/bots.py, scripts/run_bots.py) ---
# 0 = no bot posts: the feed runner does nothing and bot keys are refused. Bot feeds are fetched through the
# same guard as feed servers, so FEED_SERVER_ALLOW_LOCAL also lets a local test feed be read.
BOTS_ENABLED=1

# --- Call relay: coturn (ruqqus/helpers/turn_usage.py, coturn/turnserver.conf.template) ---
# Every call and Space sends its media through the site's own relay, so members never learn each other's IP address.
# The secret is shared by coturn (static-auth-secret) and Synapse (turn_shared_secret_path); gen_dev_env.py makes one.
# On a live site the relay's UDP ports can't go through Cloudflare, so it reveals the server's address: give it a
# DNS-only hostname (turn.<site>) and let the origin's firewall accept 80/443 from Cloudflare's addresses only.
TURN_SHARED_SECRET=
# coturn's Prometheus page, on an address only this server can reach (never published).
TURN_METRICS_URL=
# What the relay may send in a month, in GB (the server's included bandwidth it may use). From 80% calls are audio only,
# from 100% no call or Space starts until the 1st. Empty = calls stay paused (it fails closed, on cost).
TURN_MONTHLY_GB=

# --- Livestream status (ruqqus/helpers/livestream_status.py) ---
# Optional: whether a linked YouTube or Twitch stream is live. Without them the card says "Stream on Twitch" and a
# YouTube link shows no card. Only the video id or channel name is ever sent.
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Creator fund (ruqqus/helpers/creator_fund.py) ---
# Points a member needs in a month to share its budget (default 50, never under 10).
CREATOR_FUND_MIN_POINTS=

# --- Ads: Google AdSense (ruqqus/helpers/ads.py) ---
# Empty = no ads anywhere (no script, no ad boxes, no /ads.txt). The client id is "ca-pub-" and digits; each slot is the
# id of an ad unit made in AdSense (an in-feed unit for FEED, display units for POST and SIDEBAR). Turn on
# Privacy & messaging in AdSense for the UK, EEA and Switzerland: Google requires its consent banner there.
ADSENSE_CLIENT=
ADSENSE_SLOT_FEED=
ADSENSE_SLOT_POST=
ADSENSE_SLOT_SIDEBAR=
# the in-feed unit's layout key, from AdSense's code for it (data-ad-layout-key)
ADSENSE_FEED_LAYOUT_KEY=

# --- AWS S3 ---
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email / media APIs ---
MAILGUN_KEY=
GIPHY_KEY=
TENOR_KEY=

# --- Matrix (chat) ---
MATRIX_INTERNAL_URL=
MATRIX_PUBLIC_URL=
MATRIX_SERVER_NAME=
MATRIX_USER_PREFIX=
MATRIX_AS_TOKEN=
MATRIX_HS_TOKEN=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SERVER_ID=
DISCORD_WEBHOOK=
